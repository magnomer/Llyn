<Project>

  <!--
    version.json (repo root) is the single source of truth for all version info.
    Bump it with version.ps1. These properties flow into every project's
    assembly metadata at compile time, so runtime code can read the version via
    reflection (e.g. Assembly.GetEntryAssembly().GetName().Version).
  -->
  <PropertyGroup>
    <VersionJsonPath>$(MSBuildThisFileDirectory)version.json</VersionJsonPath>
    <VersionJsonContent Condition="Exists('$(VersionJsonPath)')">$([System.IO.File]::ReadAllText('$(VersionJsonPath)'))</VersionJsonContent>
    <LlynVersion Condition="'$(VersionJsonContent)' != ''">$([System.Text.RegularExpressions.Regex]::Match($(VersionJsonContent), '"current-version"\s*:\s*"([^"]+)"').Groups[1].Value)</LlynVersion>
    <LlynVersion Condition="'$(LlynVersion)' == ''">0.0.0</LlynVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Version>$(LlynVersion)</Version>
    <VersionPrefix>$(LlynVersion)</VersionPrefix>
    <AssemblyVersion>$(LlynVersion)</AssemblyVersion>
    <FileVersion>$(LlynVersion)</FileVersion>
    <InformationalVersion>$(LlynVersion)</InformationalVersion>
  </PropertyGroup>

  <!--
    NuGet packages ship IntelliSense .xml beside their assemblies. The SDK copies
    them as reference-related files, and single-file publish leaves them loose
    next to the executable. Keep only .pdb so the install folder stays clean.
  -->
  <PropertyGroup>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

</Project>
