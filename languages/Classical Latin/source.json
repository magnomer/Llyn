{
  "language": "Classical Latin",
  "flag": "va",
  "font": {
    "family": "Segoe UI",
    "size": 40
  },
  "example": {
    "family": "Georgia, Segoe UI",
    "size": 15
  },
  "varieties": {
    "shown": "text",
    "list": [
      { "name": "Classical" },
      { "name": "Ecclesiastical" }
    ]
  },
  "spelling": [
    ["[āă]", "a"],
    ["[ēĕ]", "e"],
    ["[īĭ]", "i"],
    ["[ōŏ]", "o"],
    ["[ūŭ]", "u"],
    ["[ȳ]", "y"],
    ["[ĀĂ]", "A"],
    ["[ĒĔ]", "E"],
    ["[ĪĬ]", "I"],
    ["[ŌŎ]", "O"],
    ["[ŪŬ]", "U"],
    ["[Ȳ]", "Y"]
  ],
  "pronunciation": [
    {
      "name": "Wiktionary",
      "attempts": [
        {
          "urls": [
            "https://en.wiktionary.org/wiki/{word}",
            "https://en.m.wiktionary.org/wiki/{word}"
          ],
          "readings": [
            {
              "variety": "Classical",
              "strategy": "span",
              "match": "title=\"w:Classical Latin\">Classical Latin</a>(?:(?!class=\"IPA)[\\s\\S])*?<span class=\"IPA nowrap\">",
              "normalize": true
            },
            {
              "variety": "Ecclesiastical",
              "strategy": "span",
              "match": "Ecclesiastical</a>(?:(?!class=\"IPA)[\\s\\S])*?<span class=\"IPA nowrap\">",
              "normalize": true
            }
          ]
        }
      ]
    }
  ],
  "audio": [
    {
      "name": "Wikimedia Commons",
      "attempts": [
        {
          "urls": [
            "https://commons.wikimedia.org/w/api.php?action=query&generator=search&gsrnamespace=6&gsrlimit=20&gsrsearch=intitle%3A%22{word}%22%20intitle%3A%22La-cls%22&prop=videoinfo&viprop=derivatives&format=json&formatversion=2&utf8=1"
          ],
          "variety": "Classical",
          "strategy": "regex",
          "match": "\"title\":\"File:La-cls-{word}(?:-[a-z]+)?\\.[A-Za-z0-9]+\"(?:(?!\"title\")[\\s\\S])*?\"src\":\"(https://upload\\.wikimedia\\.org/wikipedia/commons/transcoded/[^\"]*\\.mp3)\"",
          "group": 1,
          "every": true
        },
        {
          "urls": [
            "https://commons.wikimedia.org/w/api.php?action=query&generator=search&gsrnamespace=6&gsrlimit=20&gsrsearch=intitle%3A%22{word}%22%20intitle%3A%22La-ecc%22&prop=videoinfo&viprop=derivatives&format=json&formatversion=2&utf8=1"
          ],
          "variety": "Ecclesiastical",
          "strategy": "regex",
          "match": "\"title\":\"File:La-ecc-{word}(?:-[a-z]+)?\\.[A-Za-z0-9]+\"(?:(?!\"title\")[\\s\\S])*?\"src\":\"(https://upload\\.wikimedia\\.org/wikipedia/commons/transcoded/[^\"]*\\.mp3)\"",
          "group": 1,
          "every": true
        },
        {
          "urls": [
            "https://commons.wikimedia.org/w/api.php?action=query&generator=search&gsrnamespace=6&gsrlimit=20&gsrsearch=intitle%3A%22{word}%22%20intitle%3A%22LL-Q397%22&prop=videoinfo&viprop=derivatives&format=json&formatversion=2&utf8=1"
          ],
          "strategy": "regex",
          "match": "\"title\":\"File:LL-Q397 \\(lat\\)-[^\"]*-{word}\\.[A-Za-z0-9]+\"(?:(?!\"title\")[\\s\\S])*?\"src\":\"(https://upload\\.wikimedia\\.org/wikipedia/commons/transcoded/[^\"]*\\.mp3)\"",
          "group": 1,
          "every": true
        }
      ]
    }
  ],
  "frequency": [
    {
      "name": "Logeion",
      "attempts": [
        {
          "urls": [
            "https://anastrophe.uchicago.edu/logeion-api/info?w={word}"
          ],
          "strategy": "regex",
          "match": "\"rank\":\"(?:the )?(\\d+|unranked)",
          "group": 1
        }
      ]
    }
  ],
  "bands": [
    { "upTo": 500, "name": "Very common" },
    { "upTo": 2000, "name": "Common" },
    { "upTo": 10000, "name": "Uncommon" },
    { "match": "^\\d", "name": "Rare" },
    { "match": "^unranked", "name": "Rare" }
  ]
}
