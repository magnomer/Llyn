{
  "language": "Cantonese",
  "flag": "hk",
  "separator": "none",
  "tonal": true,
  "phonemic": true,
  "transcription": [
    {
      "name": "Jyutping",
      "sources": [
        {
          "name": "Wiktionary",
          "attempts": [
            {
              "urls": [
                "https://en.wiktionary.org/w/api.php?action=parse&prop=wikitext&format=json&redirects=1&page={word}"
              ],
              "follow": {
                "strategy": "json",
                "path": "parse.wikitext.*",
                "match": "\\{\\{zh-see\\|([^|}]+)",
                "group": 1,
                "normalize": false
              },
              "strategy": "json",
              "path": "parse.wikitext.*",
              "match": "\\{\\{zh-pron[^}]*?\\|c=([^|},\\n=]+(?:,[^|},\\n=]+)*)(?=[|},\\n])",
              "group": 1,
              "normalize": true,
              "every": true
            }
          ]
        }
      ]
    },
    {
      "name": "Yale",
      "sources": [
        {
          "name": "Wiktionary",
          "attempts": [
            {
              "urls": [
                "https://en.wiktionary.org/wiki/{word}",
                "https://en.wiktionary.org/api/rest_v1/page/html/{word}"
              ],
              "follow": {
                "strategy": "regex",
                "match": "see <span[^>]*lang=\"zh\"[^>]*><a [^>]*title=\"([^\"]+)\"",
                "group": 1,
                "normalize": false
              },
              "strategy": "span",
              "match": "title=\"w:Yale romanization of Cantonese\"[^>]*>Yale</a></i></small>: <span class=\"zhpron-monospace\">",
              "normalize": true,
              "every": true
            }
          ]
        }
      ]
    }
  ],
  "glyph": {
    "name": "Traditional",
    "language": "Classical Chinese",
    "font": {
      "family": "SimSun, Microsoft YaHei",
      "size": 26
    },
    "sources": [
      {
        "name": "Wiktionary",
        "attempts": [
          {
            "urls": [
              "https://en.wiktionary.org/w/api.php?action=parse&prop=wikitext&format=json&redirects=1&page={word}"
            ],
            "strategy": "json",
            "path": "parse.wikitext.*",
            "match": "\\{\\{zh-see\\|([^|}]+)",
            "group": 1,
            "normalize": false,
            "every": true
          }
        ]
      }
    ]
  },
  "respelling": [
    {
      "name": "Standard",
      "rules": [
        ["ː", ""],
        ["͡", ""],
        ["̯", ""],
        ["ɛ", "e"],
        ["ɵ", "œ"],
        ["ɔ", "o"],
        ["ɪ", "i"],
        ["ʊ", "u"]
      ]
    }
  ],
  "font": {
    "family": "Microsoft JhengHei",
    "size": 40
  },
  "example": {
    "family": "PMingLiU, Microsoft JhengHei",
    "size": 16
  },
  "pronunciation": [
    {
      "name": "Wiktionary",
      "attempts": [
        {
          "urls": [
            "https://en.wiktionary.org/wiki/{word}",
            "https://en.m.wiktionary.org/wiki/{word}"
          ],
          "follow": {
            "strategy": "regex",
            "match": "see <span[^>]*lang=\"zh\"[^>]*><a [^>]*title=\"([^\"]+)\"",
            "group": 1,
            "normalize": false
          },
          "strategy": "span",
          "match": "title=\"w:Cantonese phonology\"[^>]*>key</a>\\)</sup></small>: <span class=\"IPA\">",
          "normalize": true,
          "every": true
        }
      ]
    },
    {
      "name": "Chinese Wiktionary",
      "attempts": [
        {
          "urls": [
            "https://zh.wiktionary.org/wiki/{word}",
            "https://zh.m.wiktionary.org/wiki/{word}"
          ],
          "follow": {
            "strategy": "regex",
            "match": "請見「</b><span[^>]*lang=\"zh\"[^>]*><a [^>]*title=\"([^\"]+)\"",
            "group": 1,
            "normalize": false
          },
          "strategy": "span",
          "match": "title=\"w:粵語音系\"[^>]*>幫助</a>\\)</sup></small>：<span class=\"IPA\">",
          "normalize": true,
          "every": true
        }
      ]
    }
  ],
  "audio": [
    {
      "name": "Wiktionary",
      "attempts": [
        {
          "urls": [
            "https://en.wiktionary.org/wiki/{word}",
            "https://en.m.wiktionary.org/wiki/{word}"
          ],
          "follow": {
            "strategy": "regex",
            "match": "see <span[^>]*lang=\"zh\"[^>]*><a [^>]*title=\"([^\"]+)\"",
            "group": 1,
            "normalize": false
          },
          "strategy": "regex",
          "match": "(//upload\\.wikimedia\\.org/wikipedia/commons/transcoded/[^\"]*/(?:LL-Q9186_%28yue%29-|Zh-yue-)[^\"/]*\\.mp3)",
          "group": 1,
          "prefix": "https:",
          "every": true
        }
      ]
    },
    {
      "name": "Wikimedia Commons",
      "attempts": [
        {
          "urls": [
            "https://commons.wikimedia.org/w/api.php?action=query&generator=search&gsrnamespace=6&gsrlimit=20&gsrsearch=intitle%3A%22{word}%22%20intitle%3Ayue&prop=videoinfo&viprop=derivatives&format=json&formatversion=2&utf8=1"
          ],
          "strategy": "regex",
          "match": "\"title\":\"File:(?:LL-Q9186 \\(yue\\)-[^\"]*-|Zh-yue-){word}\\.[A-Za-z0-9]+\"(?:(?!\"title\")[\\s\\S])*?\"src\":\"(https://upload\\.wikimedia\\.org/wikipedia/commons/transcoded/[^\"]*\\.mp3)\"",
          "group": 1,
          "every": true
        }
      ]
    }
  ],
  "frequency": [
    {
      "name": "CantoDict",
      "attempts": [
        {
          "urls": [
            "https://www.cantonese.sheik.co.uk/dictionary/words/{word}/"
          ],
          "strategy": "regex",
          "match": "(Level: *[0-9]+)",
          "group": 1
        },
        {
          "urls": [
            "https://www.cantonese.sheik.co.uk/dictionary/characters/{word}/"
          ],
          "strategy": "regex",
          "match": "(Level: *[0-9]+)",
          "group": 1
        }
      ]
    }
  ],
  "bands": [
    { "match": "^Level: *1$", "name": "Very common" },
    { "match": "^Level: *2$", "name": "Common" },
    { "match": "^Level: *3$", "name": "Uncommon" },
    { "match": "^Level: *[0-9]+$", "name": "Rare" }
  ]
}
