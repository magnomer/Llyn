  "pronunciation": [
    {
      "name": "Wiktionary",
      "attempts": [
        {
          "urls": [
            "https://en.wiktionary.org/api/rest_v1/page/html/{word}",
            "https://en.wiktionary.org/wiki/{word}"
          ],
          "strategy": "span",
          "match": "<h2 id=\"German\"(?:(?!class=\"IPA)[\\s\\S])*?<span class=\"IPA nowrap\"[^>]*>",
          "normalize": true
        }
      ]
    },
    {
      "name": "Wiktionary (de)",
      "attempts": [
        {
          "urls": [
            "https://de.wiktionary.org/w/api.php?action=parse&prop=wikitext&format=json&redirects=1&page={word}"
          ],
          "strategy": "json",
          "path": "parse.wikitext.*",
          "match": "\\{\\{Sprache\\|Deutsch\\}\\}[\\s\\S]*?\\{\\{Lautschrift\\|([^|}]+)\\}\\}",
          "group": 1,
          "normalize": true
        }
      ]
    }
