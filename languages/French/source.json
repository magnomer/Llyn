  "pronunciation": [
    {
      "name": "Wiktionnaire",
      "attempts": [
        {
          "urls": [
            "https://fr.wiktionary.org/w/api.php?action=parse&prop=wikitext&format=json&redirects=1&page={word}"
          ],
          "strategy": "json",
          "path": "parse.wikitext.*",
          "match": "\\{\\{langue\\|fr\\}\\}[\\s\\S]*?\\{\\{pron\\|([^|}]+)\\|fr\\}\\}",
          "group": 1,
          "normalize": true
        }
      ]
    },
    {
      "name": "Wiktionary",
      "attempts": [
        {
          "urls": [
            "https://en.wiktionary.org/api/rest_v1/page/html/{word}",
            "https://en.wiktionary.org/wiki/{word}"
          ],
          "strategy": "span",
          "match": "<h2 id=\"French\">[\\s\\S]*?<span class=\"IPA[^\"]*\"[^>]*>",
          "normalize": true
        }
      ]
    }
  ],
  "audio": [
    {
      "name": "Naver",
      "attempts": [
        {
          "urls": [
            "https://dict.naver.com/api3/frko/search?query={word}&m=pc&range=word&page=1"
          ],
          "headers": {
            "Referer": "https://dict.naver.com/"
          },
          "strategy": "regex",
          "match": "\"symbolFile\":\"(https?://[^\"]+)\"(?:(?!\"symbolFile\")[\\s\\S])*?\"handleEntry\":\"{word}\"",
          "group": 1
        }
      ]
    },
    {
      "name": "Wiktionary",
      "attempts": [
        {
          "urls": [
            "https://en.wiktionary.org/api/rest_v1/page/html/{word}"
          ],
          "strategy": "regex",
          "match": "\"2\":\\{\"wt\":\"(?:Fr-|LL-Q150 \\(fra\\)-[^\"]*-){word}(?:-fr-FR[^\"]*)?\\.(?:ogg|oga|wav|flac|opus|mp3)\"\\}(?:,\"a\":\\{\"wt\":\"(?:&lt;&lt;)?(?:France|Paris)\\b[^\"]*\"\\})?\\}(?:(?!\"wt\":\"audio\")[\\s\\S])*?<source src=\"(//upload\\.wikimedia\\.org/wikipedia/commons/transcoded/[^\"]*\\.mp3)\"",
          "group": 1,
          "prefix": "https:",
          "every": true
        }
      ]
    },
    {
      "name": "Le Robert",
      "attempts": [
        {
          "urls": [
            "https://dictionnaire.lerobert.com/definition/{word}"
          ],
          "prefix": "https://dictionnaire.lerobert.com",
          "strategy": "regex",
          "match": "Définition de</span>\\s*{word}\\b[^<]*<span class=\"d_sound_cont\"(?:(?!</sound>)[\\s\\S])*?src='(/medias/SOUNDS/[^']+\\.mp3)'",
          "group": 1
        }
      ]
    }
  ],
  "frequency": [
    {
      "name": "Leipzig",
      "attempts": [
        {
          "urls": [
            "https://api.wortschatz-leipzig.de/ws/words/fra_news_2011_1M/word/{word}"
          ],
          "confirm": "\"word\":\"{word}\"",
          "strategy": "regex",
          "match": "\"frequencyClass\":([0-9]+)",
          "group": 1
        }
      ],
      "once": { "factor": 22, "base": 2 }
    }
  ],
  "morphology": [
