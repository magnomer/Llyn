            { "variety": "7", "strategy": "regex", "match": "class=\"Latn form-of lang-fr m\\|p-form-of\"[^>]*><a[^>]*>([^<]+)<", "group": 1, "normalize": false },
            { "variety": "8", "strategy": "regex", "match": "class=\"Latn form-of lang-fr f\\|p-form-of\"[^>]*><a[^>]*>([^<]+)<", "group": 1, "normalize": false },
            { "variety": "10", "strategy": "regex", "match": "class=\"Latn form-of lang-fr ppr-form-of\"[^>]*><a[^>]*>([^<]+)<", "group": 1, "normalize": false },
