          "every": true
        }
      ]
    },
    {
      "name": "Chinese Wiktionary",
      "attempts": [
        {
          "urls": [
            "https://zh.wiktionary.org/wiki/{word}",
            "https://zh.m.wiktionary.org/wiki/{word}"
          ],
          "follow": {
            "strategy": "regex",
            "match": "請見「</b><span[^>]*lang=\"zh\"[^>]*><a [^>]*title=\"([^\"]+)\"",
            "group": 1,
            "normalize": false
          },
          "strategy": "span",
          "match": "title=\"Wiktionary:漢語發音表記\"[^>]*>幫助</a>\\)</sup></small>：<span class=\"IPA\">",
