          "name": "Wiktionary",
          "attempts": [
            {
              "urls": [
                "https://en.wiktionary.org/w/api.php?action=parse&prop=wikitext&format=json&redirects=1&page={word}"
              ],
              "follow": {
                "strategy": "json",
                "path": "parse.wikitext.*",
                "match": "\\{\\{zh-see\\|([^|}]+)",
                "group": 1,
                "normalize": false
