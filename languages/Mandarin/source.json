              "strategy": "json",
              "path": "parse.wikitext.*",
              "match": "\\{\\{zh-pron[^}]*?\\|m=([^|},\\n=]+(?:,[^|},\\n=]+)*)(?=[|},\\n])",
              "group": 1,
              "normalize": true,
              "every": true
            },
            {
              "urls": [
                "https://en.wiktionary.org/wiki/{word}",
                "https://en.wiktionary.org/api/rest_v1/page/html/{word}"
              ],
              "follow": {
                "strategy": "regex",
                "match": "see <span[^>]*lang=\"zh\"[^>]*><a [^>]*title=\"([^\"]+)\"",
                "group": 1,
                "normalize": false
              },
              "strategy": "span",
              "match": "Hanyu Pinyin</a></i></small>: <span class=\"zhpron-monospace\"[^>]*><span class=\"Latn\"[^>]*>",
              "normalize": true,
              "every": true
