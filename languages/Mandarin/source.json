          "urls": [
            "https://en.wiktionary.org/wiki/{word}",
            "https://en.m.wiktionary.org/wiki/{word}"
          ],
          "follow": {
            "strategy": "regex",
            "match": "see <span[^>]*lang=\"zh\"[^>]*><a [^>]*title=\"([^\"]+)\"",
            "group": 1,
            "normalize": false
          },
          "strategy": "span",
          "match": "title=\"Appendix:Mandarin pronunciation\"[^>]*>key</a>\\)</sup></small>: <span class=\"IPA\">",
