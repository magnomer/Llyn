  "audio": [
    {
      "name": "Naver",
      "attempts": [
        {
          "urls": [
            "https://zh.dict.naver.com/api3/zhko/search?query={word}&m=pc&range=word&page=1"
          ],
          "headers": {
            "Referer": "https://zh.dict.naver.com/"
          },
          "readings": [
            {
              "strategy": "regex",
              "match": "^[\\s\\S]*?\"matchType\":\"exact:(?:entry|subEntry)\"(?:(?!\"rank\":)[\\s\\S])*?\"symbolFile\":\"(https://[^\"|]*\\.mp3[^\"|]*)(?:\\|(https://[^\"|]*\\.mp3[^\"|]*))?\"",
              "group": 1
            },
            {
              "strategy": "regex",
              "match": "^[\\s\\S]*?\"matchType\":\"exact:(?:entry|subEntry)\"(?:(?!\"rank\":)[\\s\\S])*?\"symbolFile\":\"(https://[^\"|]*\\.mp3[^\"|]*)(?:\\|(https://[^\"|]*\\.mp3[^\"|]*))?\"",
              "group": 2
            }
          ]
        }
      ]
    },
    {
      "name": "Daum",
      "attempts": [
        {
          "urls": [
            "https://dic.daum.net/search.do?q={word}&dic=ch"
          ],
          "follow": {
            "strategy": "regex",
            "match": "URL=/word/view\\.do\\?wordid=([a-z0-9]+)",
            "group": 1,
            "normalize": false
          },
          "strategy": "regex",
          "match": "class=\"txt_(?:cleansch|searchword)\"[^>]*>(?:<span class=\"txt_emph1\">)?{word}(?:</span>)?</a>\\s*(?:</strong>\\s*)?<span class=\"desc_listen\">(?:(?!name=\"searchItem\")[\\s\\S])*?data-url=\"http://(t1\\.daumcdn\\.net/language/[A-Z0-9]+)\"",
          "group": 1,
          "prefix": "https://",
          "every": true
        },
        {
          "urls": [
            "https://dic.daum.net/word/view.do?wordid={word}"
          ],
          "strategy": "regex",
          "match": "wordPronFileUrl : 'http://(t1\\.daumcdn\\.net/language/[A-Z0-9]+)'",
          "group": 1,
          "prefix": "https://"
        }
      ]
    },
    {
      "name": "Wiktionary",
      "attempts": [
        {
          "urls": [
            "https://en.wiktionary.org/wiki/{word}",
            "https://en.m.wiktionary.org/wiki/{word}"
          ],
          "follow": {
            "strategy": "regex",
            "match": "see <span[^>]*lang=\"zh\"[^>]*><a [^>]*title=\"([^\"]+)\"",
            "group": 1,
            "normalize": false
          },
          "strategy": "regex",
          "match": "(//upload\\.wikimedia\\.org/wikipedia/commons/transcoded/[^\"]*/(?:LL-Q9192_%28cmn%29-|Zh[-_](?!yue-|nan-))[^\"/]*\\.mp3)",
          "group": 1,
          "prefix": "https:",
          "every": true
        }
      ]
    },
    {
      "name": "Wikimedia Commons",
      "attempts": [
        {
          "urls": [
            "https://commons.wikimedia.org/w/api.php?action=query&generator=search&gsrnamespace=6&gsrlimit=20&gsrsearch=intitle%3A%22{word}%22%20intitle%3Acmn&prop=videoinfo&viprop=derivatives&format=json&formatversion=2&utf8=1"
          ],
          "strategy": "regex",
          "match": "\"title\":\"File:LL-Q9192 \\(cmn\\)-[^\"]*-{word}\\.[A-Za-z0-9]+\"(?:(?!\"title\")[\\s\\S])*?\"src\":\"(https://upload\\.wikimedia\\.org/wikipedia/commons/transcoded/[^\"]*\\.mp3)\"",
          "group": 1,
          "every": true
        }
      ]
    }
  ],
  "frequency": [
    {
      "name": "Purple Culture",
      "attempts": [
        {
          "urls": [
            "https://www.purpleculture.net/dictionary_details/?word={word}"
          ],
          "confirm": "<title>Chinese Word: {word} -",
          "strategy": "regex",
          "match": "class='badge bg-success[^']*'>(HSK [1-6])</span>",
          "group": 1
        }
      ],
      "bands": [
        { "match": "^HSK [12]$", "name": "Core" },
        { "match": "^HSK [34]$", "name": "Everyday" },
        { "match": "^HSK [56]$", "name": "Advanced" }
      ]
    }
  ]
}
