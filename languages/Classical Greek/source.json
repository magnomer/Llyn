{
  "language": "Classical Greek",
  "flag": "gr",
  "font": {
    "family": "Segoe UI",
    "size": 40
  },
  "example": {
    "family": "Palatino Linotype, Cambria, Segoe UI",
    "size": 15
  },
  "varieties": {
    "shown": "text",
    "list": [
      { "name": "Attic" },
      { "name": "Koine" },
      { "name": "Byzantine" }
    ]
  },
  "pronunciation": [
    {
      "name": "Wiktionary",
      "attempts": [
        {
          "urls": [
            "https://en.wiktionary.org/wiki/{word}",
            "https://en.m.wiktionary.org/wiki/{word}"
          ],
          "readings": [
            {
              "variety": "Attic",
              "strategy": "span",
              "match": "BCE</small> Attic</a>(?:(?!class=\"IPA)[\\s\\S])*?<span class=\"IPA nowrap\">",
              "normalize": true
            },
            {
              "variety": "Koine",
              "strategy": "span",
              "match": "CE</small> Egyptian</a>(?:(?!class=\"IPA)[\\s\\S])*?<span class=\"IPA nowrap\">",
              "normalize": true
            },
            {
              "variety": "Byzantine",
              "strategy": "span",
              "match": "CE</small> Byzantine</a>(?:(?!class=\"IPA)[\\s\\S])*?<span class=\"IPA nowrap\">",
              "normalize": true
            }
          ]
        }
      ]
    }
  ],
  "audio": [
    {
      "name": "Wikimedia Commons",
      "attempts": [
        {
          "urls": [
            "https://commons.wikimedia.org/w/api.php?action=query&generator=search&gsrnamespace=6&gsrlimit=20&gsrsearch=intitle%3A%22{word}%22%20intitle%3A%22LL-Q35497%22&prop=videoinfo&viprop=derivatives&format=json&formatversion=2&utf8=1"
          ],
          "strategy": "regex",
          "match": "\"title\":\"File:LL-Q35497 \\(grc\\)-[^\"]*-{word}\\.[A-Za-z0-9]+\"(?:(?!\"title\")[\\s\\S])*?\"src\":\"(https://upload\\.wikimedia\\.org/wikipedia/commons/transcoded/[^\"]*\\.mp3)\"",
          "group": 1,
          "every": true
        }
      ]
    }
  ],
  "frequency": [
    {
      "name": "Logeion",
      "attempts": [
        {
          "urls": [
            "https://anastrophe.uchicago.edu/logeion-api/info?w={word}"
          ],
          "strategy": "regex",
          "match": "\"rank\":\"(?:the )?(\\d+|unranked)",
          "group": 1
        }
      ]
    }
  ],
  "bands": [
    { "upTo": 500, "name": "Very common" },
    { "upTo": 2000, "name": "Common" },
    { "upTo": 10000, "name": "Uncommon" },
    { "match": "^\\d", "name": "Rare" },
    { "match": "^unranked", "name": "Rare" }
  ]
}
