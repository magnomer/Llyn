{
  "language": "Classical Chinese",
  "flag": "flag.svg",
  "separator": "none",
  "tonal": true,
  "silent": true,
  "font": {
    "family": "SimSun, Microsoft YaHei",
    "size": 40
  },
  "example": {
    "family": "SimSun, Microsoft YaHei",
    "size": 16
  },
  "script": [
    {
      "name": "金文",
      "url": "https://xiaoxue.iis.sinica.edu.tw/jinwen/PageResult/PageResult",
      "form": {
        "ZiOrder": "",
        "EudcFontChar": "{word}",
        "PageNo": "",
        "QiOrder": "",
        "QiMing": "",
        "PaginalZiNum": "20",
        "ImageSize": "36"
      },
      "match": "class=\"VariantList[AB]\"[^>]*>\\s*<img src=\"([^\"]+)\"[^>]*class=\"charValue\"[^>]*/>([\\s\\S]*?)<td>",
      "image": 1,
      "caption": 2,
      "prefix": "https://xiaoxue.iis.sinica.edu.tw",
      "rewrite": [
        [
          "size=\\d+",
          "size=200"
        ]
      ]
    },
    {
      "name": "小篆",
      "url": "https://xiaoxue.iis.sinica.edu.tw/xiaozhuan/PageResult/PageResult",
      "form": {
        "ZiOrder": "",
        "EudcFontChar": "{word}",
        "PageNo": "",
        "ImageSize": "36"
      },
      "match": "class=\"VariantList[AB]\"[^>]*>\\s*<img src=\"([^\"]+)\"[^>]*class=\"charValue\"[^>]*/>([\\s\\S]*?)<td>",
      "image": 1,
      "caption": 2,
      "prefix": "https://xiaoxue.iis.sinica.edu.tw",
      "rewrite": [
        [
          "size=\\d+",
          "size=200"
        ]
      ],
      "gloss": "<dd class=\"size\">(《說文》[\\s\\S]*?)</dd>"
    },
    {
      "name": "隸書",
      "url": "https://xiaoxue.iis.sinica.edu.tw/lishu/PageResult/PageResult",
      "form": {
        "ZiOrder": "",
        "EudcFontChar": "{word}",
        "PaginalZiNum": "20",
        "ImageSize": "36"
      },
      "match": "class=\"VariantList[AB]\"[^>]*>\\s*<img src=\"([^\"]+)\"[^>]*class=\"charValue\"[^>]*/>([\\s\\S]*?)<td>",
      "image": 1,
      "caption": 2,
      "prefix": "https://xiaoxue.iis.sinica.edu.tw",
      "rewrite": [
        [
          "size=\\d+",
          "size=200"
        ]
      ]
    },
    {
      "name": "異體",
      "url": "https://xiaoxue.iis.sinica.edu.tw/variants/PageResult/PageResult",
      "form": {
        "ZiOrder": "",
        "EudcFontChar": "{word}",
        "PageNo": "false",
        "PaginalZiNum": "20",
        "ImageSize": "36"
      },
      "match": "class=\"VariantList[AB]\"[^>]*>\\s*<img src=\"([^\"]+)\"[^>]*class=\"charValue\"[^>]*/>([\\s\\S]*?)<td>",
      "image": 1,
      "caption": 2,
      "prefix": "https://xiaoxue.iis.sinica.edu.tw",
      "rewrite": [
        [
          "size=\\d+",
          "size=200"
        ]
      ]
    }
  ],
  "fanqie": [
    {
      "name": "廣韻",
      "source": "Kaom",
      "url": "http://www.kaom.net/zgy_dw8.php",
      "form": {
        "word": "{word}",
        "t": "g",
        "bianti": "no"
      },
      "match": "<span class='string'>{word}</span>",
      "busy": "點擊過頻",
      "interval": 4,
      "split": "<br\\s*/?>",
      "head": "<b>(?<rime>[^<]+)</b>\\[(?<heading>[^\\]]+)\\]<s>(?<division>[^<]*)</s>",
      "column": "^(?<division>.)等(?<tone>.)$",
      "rounded": "<u>(?:<[^>]+>)*<span class='string'>{word}</span>",
      "spelling": "<a[^>]*>([^<]*)</a>"
    },
    {
      "name": "廣韻",
      "source": "Wiktionary",
      "url": "https://en.wiktionary.org/w/index.php?title=Module:zh/data/ltc-pron/{word}&action=raw",
      "match": "{word}",
      "line": "\"(?<initial>.)(?<rime>.)(?<division>.)(?<rounded>[開合]) (?<tone>.)(?<spelling>..)\"",
      "rounded": "合"
    },
    {
      "name": "集韻",
      "source": "Kaom",
      "url": "http://www.kaom.net/zgy_dw8.php",
      "form": {
        "word": "{word}",
        "t": "j",
        "bianti": "no"
      },
      "match": "<span class='string'>{word}</span>",
      "busy": "點擊過頻",
      "interval": 4,
      "split": "<br\\s*/?>",
      "head": "<b>(?<rime>[^<]+)</b>\\[(?<heading>[^\\]]+)\\]<s>(?<division>[^<]*)</s>",
      "column": "^(?<division>.)等(?<tone>.)$",
      "rounded": "<u>(?:<[^>]+>)*<span class='string'>{word}</span>",
      "spelling": "<a[^>]*>([^<]*)</a>"
    }
  ],
  "reflex": [
      {
          "language": "Korean",
          "url": "https://hanja.dict.naver.com/api3/ccko/search?query={word}&m=pc&range=letter&page=1",
          "headers": {
              "Referer": "https://hanja.dict.naver.com/"
          },
          "match": "(?<=\"items\":\\[\\{[^\\[\\]]*\"expKoreanPron\":\"[^\"]*)(?<note>[^\" ,/][^\",/]*?) (?<text>[^\" ,/]+)(?=[\",/])",
          "every": true,
          "epithet": "{note} {text}",
          "clip": "\\(.*\\)",
          "first": true
      },
      {
          "language": "Mandarin",
          "url": "https://en.wiktionary.org/wiki/{word}",
          "match": "Standard Chinese</a></i>\\)</small>.{0,600}?Hanyu Pinyin</a></i></small>: <span[^>]*><span[^>]*><a[^>]*>(?<note>[^<]+)</a>.{0,1500}?Sinological <a[^>]*>IPA</a> <sup>\\(<a[^>]*>key</a>\\)</sup></small>: <span class=\"IPA\">/(?<text>[^/<]+)/",
          "format": "[{text}]",
          "every": true,
          "first": true
      },
      {
          "language": "Cantonese",
          "url": "https://en.wiktionary.org/wiki/{word}",
          "match": "Standard Cantonese</a>.{0,400}?Jyutping</a></i></small>: <span[^>]*>(?<note>(?:[^<]|</?sup>)+)</span>.{0,2500}?Sinological <a[^>]*>IPA</a> <sup>\\(<a[^>]*>key</a>\\)</sup></small>: <span class=\"IPA\">(?<text>[^<]+)</span>",
          "rewrite": [
              ["/([^/]+)/", "[$1]"]
          ],
          "every": true,
          "first": true
      },
      {
          "language": "Japanese",
          "url": "https://en.wiktionary.org/wiki/{word}",
          "match": "<i class=\"Hira mention\" lang=\"ja\">(?<=<b><a[^>]*>(?<kind>Go-on|Kan-on|Tō-on|Sō-on|Kan\\'yō-on)</a></b>:\\s*<span class=\"on-yomi\">(?:(?!</li>).){0,2000}?(?<main><span class=\"jouyou-reading\">)?<i class=\"Hira mention\" lang=\"ja\">)<a[^>]*>(?<text>[^<]+)</a>",
          "every": true
      }
  ],
  "hypothesis": "hypothesis.json",
  "pronunciation": [],
  "audio": []
}
