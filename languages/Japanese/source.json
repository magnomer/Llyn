      "name": "Wiktionary",
      "attempts": [
        {
          "urls": [
            "https://en.wiktionary.org/wiki/{word}",
            "https://en.wiktionary.org/api/rest_v1/page/html/{word}"
          ],
          "follow": {
            "strategy": "regex",
            "match": "class=\"wikitable ja-see\"[\\s\\S]*?<a [^>]*title=\"([^\"]+)\"",
            "group": 1,
            "normalize": false
          },
          "strategy": "span",
          "match": "title=\"Appendix:Japanese pronunciation\">key</a>\\)</sup>:(?:(?!<span class=\"IPA)[\\s\\S]){0,80}<span class=\"IPA[^\"]*\"[^>]*>",
          "normalize": true
        }
