  "frequency": [
    {
      "name": "Jisho",
      "attempts": [
        {
          "urls": [
            "https://jisho.org/api/v1/search/words?keyword={word}"
          ],
          "strategy": "regex",
          "match": "\"jlpt\":\\[(\"jlpt-n[1-5]\"(?:,\"jlpt-n[1-5]\")*)\\],\"japanese\":\\[\\{(?:\"word\":\"{word}\"|(?:\"word\":\"[^\"]*\",)?\"reading\":\"{word}\")",
          "group": 1
        },
        {
          "urls": [
            "https://jisho.org/api/v1/search/words?keyword={word}"
          ],
          "strategy": "regex",
          "match": "\"is_(common)\":true,\"tags\":\\[[^\\]]*\\],\"jlpt\":\\[\\],\"japanese\":\\[\\{(?:\"word\":\"{word}\"|(?:\"word\":\"[^\"]*\",)?\"reading\":\"{word}\")",
          "group": 1
        }
      ],
      "bands": [
        { "match": "jlpt-n[45]", "name": "Core" },
        { "match": "jlpt-n[23]", "name": "Everyday" },
        { "match": "jlpt-n1", "name": "Advanced" },
        { "match": "^common$", "name": "Advanced" }
