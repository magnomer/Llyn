  "audio": [
    {
      "name": "Naver",
      "attempts": [
        {
          "urls": [
            "https://dict.naver.com/tts?speech_fmt=mp3&speed=50&speaker=ja_jp&service=jadic&from=pc&text={word}"
          ],
          "strategy": "link"
        }
      ]
    },
    {
      "name": "Wiktionary",
      "attempts": [
        {
          "urls": [
            "https://en.wiktionary.org/wiki/{word}",
            "https://en.wiktionary.org/api/rest_v1/page/html/{word}"
          ],
          "follow": {
            "strategy": "regex",
            "match": "class=\"wikitable ja-see\"[\\s\\S]*?<a [^>]*title=\"([^\"]+)\"",
            "group": 1,
            "normalize": false
          },
          "strategy": "regex",
          "match": "<h2 id=\"Japanese\"[\\s\\S]*?(//upload\\.wikimedia\\.org/wikipedia/commons/transcoded/[^\"]*/Ja-[^\"/]*\\.mp3)",
          "group": 1,
          "prefix": "https:"
        },
        {
          "urls": [
            "https://en.wiktionary.org/wiki/{word}",
            "https://en.wiktionary.org/api/rest_v1/page/html/{word}"
          ],
          "strategy": "regex",
          "match": "(//upload\\.wikimedia\\.org/wikipedia/commons/transcoded/[^\"]*/LL-Q5287_%28jpn%29-[^\"/]*\\.mp3)",
          "group": 1,
          "prefix": "https:"
        }
