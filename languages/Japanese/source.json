  "transcription": [
    {
      "name": "Kana",
      "sources": [
        {
          "name": "Wiktionary",
          "attempts": [
            {
              "urls": [
                "https://en.wiktionary.org/w/api.php?action=parse&prop=wikitext&format=json&redirects=1&page={word}"
              ],
              "follow": {
                "strategy": "json",
                "path": "parse.wikitext.*",
                "match": "\\{\\{ja-see\\|(?:[a-z]+=[^|}]*\\|)*([^|}]+)",
                "group": 1,
                "normalize": false
              },
              "strategy": "json",
              "path": "parse.wikitext.*",
              "match": "==Japanese==[\\s\\S]*?\\{\\{ja-pron\\|(?:[a-z_]+=[^|}]*\\|)*([^|}=]+)(?=[|}])",
              "group": 1,
              "normalize": false
            }
          ]
        }
      ]
    },
    {
      "name": "Romaji",
      "sources": [
        {
          "name": "Wiktionary",
          "attempts": [
            {
              "urls": [
                "https://en.wiktionary.org/wiki/{word}",
                "https://en.wiktionary.org/api/rest_v1/page/html/{word}"
              ],
              "follow": {
                "strategy": "regex",
                "match": "class=\"wikitable ja-see\"[\\s\\S]*?<a [^>]*title=\"([^\"]+)\"",
                "group": 1,
                "normalize": false
              },
              "strategy": "regex",
              "match": "<h2 id=\"Japanese\"(?:(?!headword-tr)[\\s\\S])*?class=\"headword-tr[^\"]*\"[^>]*>(?:<span class=\"Latn\" lang=\"ja\">)?(?:<a[^>]*>)?([^<]+)<",
              "group": 1,
              "normalize": false
            }
          ]
        }
      ]
    },
    {
      "name": "Pitch",
      "sources": [
        {
          "name": "Wiktionary",
          "attempts": [
            {
              "urls": [
                "https://en.wiktionary.org/wiki/{word}",
                "https://en.wiktionary.org/api/rest_v1/page/html/{word}"
              ],
              "follow": {
                "strategy": "regex",
                "match": "class=\"wikitable ja-see\"[\\s\\S]*?<a [^>]*title=\"([^\"]+)\"",
                "group": 1,
                "normalize": false
              },
              "strategy": "regex",
              "match": "<h2 id=\"Japanese\"(?:(?!<samp>)[\\s\\S])*?<samp>(\\[[^<\\]]+\\])</samp>",
