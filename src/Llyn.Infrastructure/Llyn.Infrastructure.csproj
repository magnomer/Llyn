<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.11" />
    <!-- Microsoft.Data.Sqlite 9.0.11 still pins SQLitePCLRaw 2.1.10, which carries a high-severity
         SQLite advisory (GHSA-2m69-gcr7-jv3q). Override the transitive bundle to the patched 2.1.11. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Llyn.Core\Llyn.Core.csproj" />
  </ItemGroup>
</Project>
