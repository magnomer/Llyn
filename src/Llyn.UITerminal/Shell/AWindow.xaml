<Blueprint
    x:Name="AWindow"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Split Rows="1,*,1,1">
        <Text x:Name="ARoof" Theme="roof" />
        <Split Columns="*,*">
            <Frame x:Name="AIndex" Theme="side" Glyphs="double" Rows="*,1" />
            <Frame Theme="side" Glyphs="double" Rows="*,1">
                <Text x:Name="ADisplay" />
                <Text x:Name="AVoyage" Theme="side" />
            </Frame>
        </Split>
        <Text x:Name="AEstablishment" Theme="text" Margin="1,0,0,0" />
        <Legend x:Name="ALegend" Theme="legend" />
    </Split>
</Blueprint>
