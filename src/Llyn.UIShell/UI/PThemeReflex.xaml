<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn;component/UI/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PThemePronunciation.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PThemeAccent.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PThemeCommand.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Reflex.Surface" TargetType="Border" BasedOn="{StaticResource Theme.Pronunciation.Surface}">
        <Setter Property="Height" Value="31" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PReflexItemHidden}" Value="True">
                <Setter Property="Visibility" Value="Hidden" />
                <Setter Property="Height" Value="0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Reflex.Label" TargetType="TextBlock" BasedOn="{StaticResource Theme.Pronunciation.Label}">
        <Setter Property="Text" Value="{Binding PReflexItemLabel}" />
        <Setter Property="ToolTip" Value="{Binding PReflexItemArea}" />
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Hidden" />
            </Trigger>
            <DataTrigger Binding="{Binding PReflexItemArea}" Value="">
                <Setter Property="ToolTip" Value="{x:Null}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Reflex.Text" TargetType="TextBlock" BasedOn="{StaticResource Theme.Pronunciation.Text}">
        <Setter Property="Margin" Value="0,-3,0,3" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="Text" Value="{Binding PReflexItemText}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PReflexItemMain}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Reflex.Edge" TargetType="TextBlock" BasedOn="{StaticResource Theme.Pronunciation.Text}">
        <Setter Property="Margin" Value="0,-3,0,3" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
            <DataTrigger Binding="{Binding PReflexItemMain}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Reflex.Fold" TargetType="ToggleButton">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Content" Value="{DynamicResource Reflex.More}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <Path
                                x:Name="PSurfaceMark"
                                Width="12"
                                Height="12"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Data="{local:PIcon expand, 12}"
                                Fill="{TemplateBinding Foreground}"
                                RenderTransformOrigin="0.5,0.5"
                                Stretch="None" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PSurfaceMark" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Content" Value="{DynamicResource Reflex.Less}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Reflex.Tag" TargetType="TextBlock" BasedOn="{StaticResource Theme.Pronunciation.Text}">
        <Setter Property="Margin" Value="0,0,6,2" />
        <Setter Property="MaxWidth" Value="160" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Text" Value="{Binding PReflexItemTag}" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Hidden" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Reflex.Side" TargetType="TextBlock" BasedOn="{StaticResource Theme.Reflex.Tag}">
        <Setter Property="Margin" Value="12,0,3,2" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="Text" Value="{Binding PReflexItemNote}" />
    </Style>

    <Style x:Key="Theme.Reflex.Remark" TargetType="TextBlock" BasedOn="{StaticResource Theme.Reflex.Tag}">
        <Setter Property="Margin" Value="6,0,3,2" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="Text" Value="{Binding PReflexItemRemark}" />
    </Style>

    <Style x:Key="Theme.Reflex.Field" TargetType="TextBox" BasedOn="{StaticResource Theme.Pronunciation.Field}">
        <Setter Property="MaxWidth" Value="424" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PReflexItemMain}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Reflex.Prompt" TargetType="TextBlock" BasedOn="{StaticResource Theme.Reflex.Text}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding PReflexItemText}" Value="">
                <Setter Property="Text" Value="{DynamicResource Input.Reflex}" />
                <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Reflex.Name" TargetType="TextBox" BasedOn="{StaticResource Theme.Pronunciation.Field}">
        <Setter Property="Margin" Value="-2,0" />
        <Setter Property="ToolTip" Value="{Binding PReflexItemArea}" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="MaxWidth" Value="160" />
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PReflexItemArea}" Value="">
                <Setter Property="ToolTip" Value="{x:Null}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Reflex.Note" TargetType="TextBox" BasedOn="{StaticResource Theme.Pronunciation.Field}">
        <Setter Property="Margin" Value="-2,0" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="MaxWidth" Value="424" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
    </Style>

    <Style x:Key="Theme.Reflex.Star" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Handle}">
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Command" Value="{x:Static local:PReflexCommand.PReflexCommandMain}" />
        <Setter Property="ToolTip" Value="{DynamicResource Reflex.Main}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Path Width="12" Height="12" Data="{local:PIcon star, 12}" Stretch="None">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Fill" Value="{StaticResource Theme.Muted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PReflexItemMain}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Theme.Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Reflex.Addition" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Addition}">
        <Setter Property="Command" Value="{x:Static local:PReflexCommand.PReflexCommandAddition}" />
    </Style>

    <Style x:Key="Theme.Reflex.Remove" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Remove}">
        <Setter Property="Command" Value="{x:Static local:PReflexCommand.PReflexCommandRemoval}" />
    </Style>

    <Style x:Key="Theme.Reflex.Rebuild" TargetType="Button" BasedOn="{StaticResource Theme.Command.Icon}">
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="ToolTip" Value="{DynamicResource Reflex.Rebuild}" />
        <Setter Property="Command" Value="{x:Static local:PReflexCommand.PReflexCommandRenewal}" />
        <Setter Property="Content" Value="" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Path
                        x:Name="PSurfaceMark"
                        Width="24"
                        Height="24"
                        Data="{local:PIcon rebuild, 24}"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        RenderTransformOrigin="0.5,0.5"
                        Stretch="None">
                        <Path.RenderTransform>
                            <RotateTransform Angle="0" />
                        </Path.RenderTransform>
                    </Path>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="PSurfaceSpin">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="PSurfaceMark"
                                            Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                            From="0"
                                            To="360"
                                            Duration="0:0:1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="PSurfaceSpin" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Reflex.Loading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Margin" Value="0,6,0,6" />
        <Setter Property="Text" Value="{DynamicResource Reflex.Loading}" />
    </Style>

    <DataTemplate x:Key="Theme.Reflex.Control">
        <StackPanel Style="{StaticResource Theme.Accent.Control}">
            <Button Style="{StaticResource Theme.Reflex.Star}" />
            <Button Style="{StaticResource Theme.Reflex.Addition}" />
            <Button Style="{StaticResource Theme.Reflex.Remove}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Reflex.Row">
        <Border Style="{StaticResource Theme.Reflex.Surface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReadingLabel" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReflexKind" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReflexText" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource Theme.Pronunciation.Lead}">
                    <Grid Margin="0,0,8,0" MinWidth="12" Background="Transparent" Tag="Theme.Reflex.Name PReflexItemHead">
                        <TextBlock Margin="0" Style="{StaticResource Theme.Reflex.Label}" />
                    </Grid>
                </StackPanel>
                <Grid
                    Grid.Column="1"
                    Margin="0,0,6,2"
                    MinWidth="12"
                    HorizontalAlignment="Left"
                    Background="Transparent" Tag="Theme.Reflex.Note PReflexItemKind">
                    <TextBlock Margin="0" Style="{StaticResource Theme.Reflex.Tag}" />
                </Grid>
                <StackPanel Grid.Column="2" Margin="3,0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Theme.Reflex.Edge}" Text="{Binding PReflexItemOpener}" />
                    <Grid HorizontalAlignment="Left" Background="Transparent" Tag="Theme.Reflex.Field PReflexItemText Input.Reflex">
                        <TextBlock Style="{StaticResource Theme.Reflex.Prompt}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Theme.Reflex.Edge}" Text="{Binding PReflexItemCloser}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Style="{StaticResource Theme.Pronunciation.Body}">
                    <Grid Margin="12,0,3,2" MinWidth="12" Background="Transparent" Tag="Theme.Reflex.Note PReflexItemNote">
                        <TextBlock Margin="0" Style="{StaticResource Theme.Reflex.Side}" />
                    </Grid>
                    <Grid Margin="6,0,3,2" MinWidth="12" Background="Transparent" Tag="Theme.Reflex.Note PReflexItemRemark">
                        <TextBlock Margin="0" Style="{StaticResource Theme.Reflex.Remark}" />
                    </Grid>
                    <ContentControl Focusable="False" Tag="Theme.Reflex.Control" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Reflex.Display">
        <Border Style="{StaticResource Theme.Reflex.Surface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReadingLabel" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReflexKind" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReflexText" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource Theme.Pronunciation.Lead}">
                    <TextBlock Style="{StaticResource Theme.Reflex.Label}" />
                </StackPanel>
                <TextBlock Grid.Column="1" HorizontalAlignment="Left" Style="{StaticResource Theme.Reflex.Tag}" />
                <StackPanel Grid.Column="2" Margin="3,0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Theme.Reflex.Edge}" Text="{Binding PReflexItemOpener}" />
                    <TextBlock Style="{StaticResource Theme.Reflex.Text}" />
                    <TextBlock Style="{StaticResource Theme.Reflex.Edge}" Text="{Binding PReflexItemCloser}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Theme.Reflex.Side}" />
                    <TextBlock Style="{StaticResource Theme.Reflex.Remark}" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
