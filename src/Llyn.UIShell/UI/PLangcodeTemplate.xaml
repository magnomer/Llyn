<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Llyn.UIShell.PLangcodeTemplate">

    <!-- One language in the language dropdown: its flag, or a neutral globe when the pack declares none. -->
    <DataTemplate x:Key="Theme.Langcode.Row">
        <Button Height="31" Padding="12,0" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="PLangcodeHandle" Foreground="{DynamicResource Theme.Ink}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="19" Height="14" VerticalAlignment="Center">
                    <Image Source="{Binding PLangcodeItemFlag}" Stretch="Uniform" />
                    <Ellipse Width="12" Height="12" Stroke="{DynamicResource Theme.Muted}" StrokeThickness="1.2">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PLangcodeItemFlag}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
                <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontSize="13" Text="{Binding PLangcodeItemName}" />
            </Grid>
        </Button>
    </DataTemplate>
</ResourceDictionary>
