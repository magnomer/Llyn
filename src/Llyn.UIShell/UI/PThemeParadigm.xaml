<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn;component/UI/PThemePalette.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Paradigm.Box" TargetType="Border">
        <Setter Property="Padding" Value="14,10,18,8" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="Background" Value="{StaticResource Theme.SurfaceRaised}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Theme.Paradigm.Part" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Paradigm.Name" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Theme.Paradigm.Text" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Text" Value="{Binding PParadigmItemText}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PParadigmItemText}" Value="">
                <Setter Property="Text" Value="…" />
                <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
                <Setter Property="ToolTip" Value="{DynamicResource Paradigm.Absent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding PParadigmItemPending}" Value="True">
                <Setter Property="Text" Value="…" />
                <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
                <Setter Property="ToolTip" Value="{DynamicResource Paradigm.Pending}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding PParadigmItemLost}" Value="True">
                <Setter Property="Text" Value="…" />
                <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
                <Setter Property="ToolTip" Value="{DynamicResource Paradigm.Lost}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding PParadigmItemUnknown}" Value="True">
                <Setter Property="Text" Value="—" />
                <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
                <Setter Property="ToolTip" Value="{DynamicResource Paradigm.Unknown}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="Theme.Paradigm.Row">
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="PParadigmPart" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PParadigmName" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Theme.Paradigm.Part}" Text="{Binding PParadigmItemPart}" />
            <TextBlock Grid.Column="1" Style="{StaticResource Theme.Paradigm.Name}" Text="{Binding PParadigmItemName}" />
            <TextBlock Grid.Column="2" Style="{StaticResource Theme.Paradigm.Text}" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>
