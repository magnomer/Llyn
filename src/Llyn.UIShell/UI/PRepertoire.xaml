<UserControl
    x:Class="Llyn.UIShell.PRepertoire"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    >

    <UserControl.Resources>
        <Style x:Key="Theme.Atlas.Kind" TargetType="TextBlock" BasedOn="{StaticResource Theme.Catalog.Meta}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding PAtlasItemKind}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Theme.Atlas.Row" TargetType="Button" BasedOn="{StaticResource Theme.Catalog.Row}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding PAtlasItemChosen}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Theme.Accent}" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                    <Setter Property="Padding" Value="9,9,12,9" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Theme.Display.Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        </Style>

        <Style x:Key="Theme.Display.Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Theme.Occurrence.Row" TargetType="Button" BasedOn="{StaticResource Theme.Choice.Row}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

    </UserControl.Resources>

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            x:Name="PTier"
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,20,18"
            Style="{StaticResource Theme.Search.Bar}">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ToggleButton
                x:Name="PTierDropper"
                Grid.Column="0"
                Style="{StaticResource Theme.Search.Dropper}"
                ToolTip="{DynamicResource Tier.Title}">
                <Canvas Width="16" Height="13">
                    <Rectangle Canvas.Top="1" Width="16" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    <Rectangle Canvas.Top="6.2" Width="11" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    <Rectangle Canvas.Top="11.4" Width="6" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                </Canvas>
            </ToggleButton>
            <Rectangle Grid.Column="1" Style="{StaticResource Theme.Search.Divider}" />
            <Popup
                x:Name="PTierDropdown"
                Width="238"
                AllowsTransparency="True"
                IsOpen="{Binding IsChecked, ElementName=PTierDropper, Mode=TwoWay}"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=PTier}"
                StaysOpen="False"
                VerticalOffset="6">
                <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                    <StackPanel>
                        <TextBlock Margin="10,7,10,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Tier.Title}" />
                        <RadioButton GroupName="PTierChoice" IsChecked="True" Click="PTierHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Name" Content="{DynamicResource Tier.Name}" />
                        <RadioButton GroupName="PTierChoice" Click="PTierHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Kind" Content="{DynamicResource Tier.Kind}" />
                        <RadioButton GroupName="PTierChoice" Click="PTierHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Usage" Content="{DynamicResource Tier.Usage}" />
                    </StackPanel>
                </Border>
            </Popup>
            <TextBox
                x:Name="PInquest"
                Grid.Column="2"
                Style="{StaticResource Theme.Search.Field}"
                Tag="{DynamicResource Situation.Search}"
                TextChanged="PInquestHandle" />
            </Grid>
        </Border>

        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,18">
            <Border HorizontalAlignment="Left" Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="PRepertoireFresh"
                        Click="PRepertoireFreshHandle"
                        Content="{DynamicResource Scribe.New}"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="pack://application:,,,/Llyn;component/icons/plus.svg" />
                    <Rectangle Style="{StaticResource Theme.Command.Divider}" />
                    <Button
                        Content="{DynamicResource Scribe.Export}"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="pack://application:,,,/Llyn;component/icons/upload-simple.svg" />
                    <Button
                        Content="{DynamicResource Scribe.Print}"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="pack://application:,,,/Llyn;component/icons/printer.svg" />
                </StackPanel>
            </Border>
            <Border
                x:Name="PRepertoireMode"
                HorizontalAlignment="Right"
                IsEnabled="False"
                Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        x:Name="PRepertoireViewer"
                        Click="PRepertoireScribeHandle"
                        Content="{DynamicResource Scribe.View}"
                        GroupName="PRepertoireMode"
                        IsChecked="True"
                        Style="{StaticResource Theme.Command.Mode}"
                        Tag="pack://application:,,,/Llyn;component/icons/eye.svg" />
                    <RadioButton
                        x:Name="PRepertoireScribe"
                        Click="PRepertoireScribeHandle"
                        Content="{DynamicResource Scribe.Edit}"
                        GroupName="PRepertoireMode"
                        Style="{StaticResource Theme.Command.Mode}"
                        Tag="pack://application:,,,/Llyn;component/icons/pencil-simple.svg" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PAtlas" Margin="0,0,4,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="PAtlasHandle" Style="{StaticResource Theme.Atlas.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource Theme.Catalog.Title}" Text="{Binding PAtlasItemTitle}" />
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Theme.Atlas.Kind}" Text="{Binding PAtlasItemKind}" />
                                    <Border Grid.Column="2" Style="{StaticResource Theme.Catalog.Pellet}">
                                        <TextBlock Style="{StaticResource Theme.Catalog.Tally}" Text="{Binding PAtlasItemCount}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="PAtlasEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Situation.Empty}" />
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" ClipToBounds="True" Style="{StaticResource Theme.Input.Card}">
            <Grid>
                <Grid x:Name="PVignette">
                    <ScrollViewer Padding="24,22,24,20" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PVignetteBody" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Theme.Display.Label}" Text="{DynamicResource Situation.Title}" />
                            <TextBlock x:Name="PVignetteTitle" Margin="0,5,0,0" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Display.Label}" Text="{DynamicResource Situation.Kind}" />
                            <TextBlock x:Name="PVignetteKind" Margin="0,5,0,0" Style="{StaticResource Theme.Display.Value}" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Display.Label}" Text="{DynamicResource Situation.Description}" />
                            <TextBlock x:Name="PVignetteDescription" Margin="0,5,0,0" Style="{StaticResource Theme.Display.Value}" />

                            <TextBlock Margin="0,26,0,10" Style="{StaticResource Theme.Display.Label}" Text="{DynamicResource Situation.Usage}" />
                            <ItemsControl x:Name="POccurrence">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="POccurrenceHandle" Style="{StaticResource Theme.Occurrence.Row}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding PUsageItemHeadword}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Theme.Accent}" Text="{Binding PUsageItemOwner}" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource Theme.Muted}" Text="{Binding PUsageItemTitle}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                                    <Image Width="19" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" Source="{Binding PUsageItemFlag}" Stretch="Uniform" />
                                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Theme.Muted}" Text="{Binding PUsageItemLanguage}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock
                                x:Name="POccurrenceEmpty"
                                Margin="0,2,0,0"
                                Foreground="{StaticResource Theme.Muted}"
                                Text="{DynamicResource Situation.UsageEmpty}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock
                        x:Name="PVignetteUnselected"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Theme.Muted}"
                        IsHitTestVisible="False"
                        Text="{DynamicResource Situation.Unselected}"
                        TextWrapping="Wrap" />
                </Grid>

                <Grid x:Name="PScenario" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Padding="24,22,24,10" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Situation.Title}" />
                            <TextBox
                                x:Name="PScenarioTitle"
                                Height="44"
                                Margin="0,7,0,0"
                                Padding="12,7"
                                Style="{StaticResource Theme.Input.Field}"
                                TextChanged="PScenarioTitleHandle" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Situation.Kind}" />
                            <TextBox
                                x:Name="PScenarioKind"
                                Height="44"
                                Margin="0,7,0,0"
                                Padding="12,7"
                                Style="{StaticResource Theme.Input.Field}"
                                TextChanged="PScenarioKindHandle" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Situation.Description}" />
                            <TextBox
                                x:Name="PScenarioDescription"
                                MinHeight="120"
                                Margin="0,7,0,0"
                                Padding="12,9"
                                AcceptsReturn="True"
                                Style="{StaticResource Theme.Input.Field}"
                                TextChanged="PScenarioDescriptionHandle"
                                TextWrapping="Wrap"
                                VerticalContentAlignment="Top" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="24,10,24,20" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            x:Name="PScenarioRemoval"
                            Height="44"
                            Margin="0,0,8,0"
                            Click="PScenarioRemovalHandle"
                            Content="{DynamicResource Situation.Delete}"
                            IsEnabled="False"
                            Style="{StaticResource Theme.Input.Pill}" />
                        <Button
                            x:Name="PScenarioDiscard"
                            Height="44"
                            Margin="0,0,8,0"
                            Click="PScenarioDiscardHandle"
                            Content="{DynamicResource Situation.Discard}"
                            Style="{StaticResource Theme.Input.Pill}" />
                        <Button
                            x:Name="PScenarioStore"
                            Height="44"
                            Click="PScenarioStoreHandle"
                            Content="{DynamicResource Situation.Store}"
                            Style="{StaticResource Theme.Input.Primary}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
