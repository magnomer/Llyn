<UserControl
    x:Class="Llyn.UIShell.PRepertoire"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    >

    <UserControl.Resources>
        <Style x:Key="Theme.Atlas.Kind" TargetType="TextBlock" BasedOn="{StaticResource Theme.Catalog.Meta}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding PAtlasItemKind}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Theme.Atlas.Row" TargetType="Button" BasedOn="{StaticResource Theme.Catalog.Row}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding PAtlasItemChosen}" Value="True">
                    <Setter Property="Tag" Value="Chosen" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Theme.Display.Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        </Style>

        <Style x:Key="Theme.Display.Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Theme.Occurrence.Row" TargetType="Button" BasedOn="{StaticResource Theme.Catalog.Row}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding POccurrenceItemChosen}" Value="True">
                    <Setter Property="Tag" Value="Chosen" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="-34,0,-34,0" Style="{StaticResource Theme.Panel.SeamRow}" />
        <local:PSeam Grid.Row="1" Grid.Column="1" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />
        <local:PSeam Grid.Row="1" Grid.Column="2" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />

        <Border
            x:Name="PTier"
            Grid.Row="0"
            Grid.Column="0"
            Margin="{StaticResource Theme.Catalog.HeaderMargin}"
            Style="{StaticResource Theme.Search.Bar}">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ToggleButton
                x:Name="PTierDropper"
                Grid.Column="0"
                Style="{StaticResource Theme.Search.Dropper}"
                ToolTip="{DynamicResource Tier.Title}">
                <Path Width="24" Height="24" Data="{local:PIcon sort, 24}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Stretch="None" />
            </ToggleButton>
            <Rectangle Grid.Column="1" Style="{StaticResource Theme.Search.Divider}" />
            <Popup
                x:Name="PTierDropdown"
                Width="238"
                AllowsTransparency="True"
                IsOpen="{Binding IsChecked, ElementName=PTierDropper, Mode=TwoWay}"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=PTier}"
                StaysOpen="False"
                VerticalOffset="6">
                <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                    <StackPanel>
                        <TextBlock Margin="10,7,10,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Tier.Title}" />
                        <RadioButton GroupName="PTierChoice" IsChecked="True" Click="PTierHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Name" Content="{DynamicResource Tier.Name}" />
                        <RadioButton GroupName="PTierChoice" Click="PTierHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Kind" Content="{DynamicResource Tier.Kind}" />
                        <RadioButton GroupName="PTierChoice" Click="PTierHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Usage" Content="{DynamicResource Tier.Usage}" />
                    </StackPanel>
                </Border>
            </Popup>
            <TextBox
                x:Name="PInquest"
                Grid.Column="2"
                Style="{StaticResource Theme.Search.Field}"
                Tag="{DynamicResource Situation.Search}"
                TextChanged="PInquestHandle" />
            </Grid>
        </Border>

        <Border
            x:Name="PMesh"
            Grid.Row="0"
            Grid.Column="1"
            Margin="-4,0,16,18"
            Style="{StaticResource Theme.Search.Bar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="PSortie"
                    Grid.Column="0"
                    Style="{StaticResource Theme.Search.Field}"
                    Tag="{DynamicResource Sortie.Search}"
                    TextChanged="PSortieHandle" />
                <Rectangle Grid.Column="1" Margin="2,0,5,0" Style="{StaticResource Theme.Search.Divider}" />
                <ToggleButton
                    x:Name="PMeshDropper"
                    Grid.Column="2"
                    Style="{StaticResource Theme.Search.Dropper}"
                    ToolTip="{DynamicResource Mesh.Title}">
                    <Grid Width="24" Height="24">
                        <Path Width="24" Height="24" Data="{local:PIcon filter, 24}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Stretch="None" />
                        <Ellipse
                            x:Name="PMeshMark"
                            Width="6"
                            Height="6"
                            Margin="0,2,1,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Fill="{StaticResource Theme.Accent}"
                            Visibility="Collapsed" />
                    </Grid>
                </ToggleButton>
                <Popup
                    x:Name="PMeshDropdown"
                    Width="190"
                    AllowsTransparency="True"
                    HorizontalOffset="-151"
                    IsOpen="{Binding IsChecked, ElementName=PMeshDropper}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=PMeshDropper}"
                    StaysOpen="False"
                    VerticalOffset="6">
                    <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                        <StackPanel x:Name="PMeshList" />
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <local:PRail Grid.Row="0" Grid.Column="2" Margin="0,0,0,18">
            <Border Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="PRepertoireFresh"
                        Click="PRepertoireFreshHandle"
                        Content="{DynamicResource Scribe.New}"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="{local:PIcon new, 24}" />
                    <Button
                        x:Name="PRepertoireStore"
                        Click="PRepertoireStoreHandle"
                        Content="{DynamicResource Scribe.Save}"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Primary}"
                        Tag="{local:PIcon save, 24}"
                        Visibility="Collapsed" />
                    <Rectangle Style="{StaticResource Theme.Command.Divider}" />
                    <Button
                        Content="{DynamicResource Scribe.Export}"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="{local:PIcon export, 24}" />
                    <Button
                        Content="{DynamicResource Scribe.Print}"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="{local:PIcon print, 24}" />
                </StackPanel>
            </Border>
            <Border
                x:Name="PRepertoireMode"
                IsEnabled="False"
                Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        x:Name="PRepertoireViewer"
                        Click="PRepertoireScribeHandle"
                        Content="{DynamicResource Scribe.View}"
                        GroupName="PRepertoireMode"
                        IsChecked="True"
                        Style="{StaticResource Theme.Command.Mode}"
                        Tag="{local:PIcon view, 24}" />
                    <RadioButton
                        x:Name="PRepertoireScribe"
                        Click="PRepertoireScribeHandle"
                        Content="{DynamicResource Scribe.Edit}"
                        GroupName="PRepertoireMode"
                        Style="{StaticResource Theme.Command.Mode}"
                        Tag="{local:PIcon edit, 24}" />
                </StackPanel>
            </Border>
        </local:PRail>

        <Grid Grid.Row="1" Grid.Column="0" Style="{StaticResource Theme.Catalog.Frame}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl x:Name="PAtlas">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="PAtlasHandle" Style="{StaticResource Theme.Atlas.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Data="{local:PIcon situation, 16}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="None" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Theme.Catalog.Title}" Text="{Binding PAtlasItemTitle}" />
                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Theme.Atlas.Kind}" Text="{Binding PAtlasItemKind}" />
                                    <Border Grid.Column="3" Style="{StaticResource Theme.Catalog.Pellet}">
                                        <TextBlock Style="{StaticResource Theme.Catalog.Tally}" Text="{Binding PAtlasItemCount}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="PAtlasEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Situation.Empty}" />
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" Style="{StaticResource Theme.Catalog.Middle}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl x:Name="POccurrence">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="POccurrenceHandle" Style="{StaticResource Theme.Occurrence.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Source="{Binding POccurrenceItemFlag}" Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Theme.Catalog.Title}" Text="{Binding POccurrenceItemName}" />
                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource Theme.Catalog.Meta}" Text="{Binding POccurrenceItemLanguage}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="POccurrenceEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Situation.Vacant}" />
        </Grid>

        <Border Grid.Row="1" Grid.Column="2" Margin="0,14,0,0" ClipToBounds="True" Style="{StaticResource Theme.Panel.Surface}">
            <Grid>
                <local:PDisplay x:Name="PDisplay" Visibility="Collapsed" />

                <local:PEditor x:Name="PEditor" Padding="30,18,30,30" Visibility="Collapsed" />

                <Grid x:Name="PVignette">
                    <ScrollViewer Padding="24,22,0,20" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource Theme.Scroll.Gutter}" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PVignetteBody" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Theme.Display.Label}" Text="{DynamicResource Situation.Title}" />
                            <TextBlock x:Name="PVignetteTitle" Margin="0,5,0,0" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Display.Label}" Text="{DynamicResource Situation.Kind}" />
                            <TextBlock x:Name="PVignetteKind" Margin="0,5,0,0" Style="{StaticResource Theme.Display.Value}" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Display.Label}" Text="{DynamicResource Situation.Description}" />
                            <TextBlock x:Name="PVignetteDescription" Margin="0,5,0,0" Style="{StaticResource Theme.Display.Value}" />
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock
                        x:Name="PVignetteUnselected"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Theme.Muted}"
                        IsHitTestVisible="False"
                        Text="{DynamicResource Situation.Unselected}"
                        TextWrapping="Wrap" />
                </Grid>

                <Grid x:Name="PScenario" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Padding="24,22,0,10" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource Theme.Scroll.Gutter}" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Situation.Title}" />
                            <TextBox
                                x:Name="PScenarioTitle"
                                Height="44"
                                Margin="0,7,0,0"
                                Padding="12,7"
                                Style="{StaticResource Theme.Input.Field}"
                                TextChanged="PScenarioTitleHandle" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Situation.Kind}" />
                            <TextBox
                                x:Name="PScenarioKind"
                                Height="44"
                                Margin="0,7,0,0"
                                Padding="12,7"
                                Style="{StaticResource Theme.Input.Field}"
                                TextChanged="PScenarioKindHandle" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Situation.Description}" />
                            <TextBox
                                x:Name="PScenarioDescription"
                                MinHeight="120"
                                Margin="0,7,0,0"
                                Padding="12,9"
                                AcceptsReturn="True"
                                Style="{StaticResource Theme.Input.Field}"
                                TextChanged="PScenarioDescriptionHandle"
                                TextWrapping="Wrap"
                                VerticalContentAlignment="Top" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="24,10,24,20" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            x:Name="PScenarioRemoval"
                            Height="44"
                            Margin="0,0,8,0"
                            Click="PScenarioRemovalHandle"
                            Content="{DynamicResource Situation.Delete}"
                            IsEnabled="False"
                            Style="{StaticResource Theme.Input.Pill}" />
                        <Button
                            x:Name="PScenarioDiscard"
                            Height="44"
                            Margin="0,0,8,0"
                            Click="PScenarioDiscardHandle"
                            Content="{DynamicResource Situation.Discard}"
                            Style="{StaticResource Theme.Input.Pill}" />
                        <Button
                            x:Name="PScenarioStore"
                            Height="44"
                            Click="PScenarioStoreHandle"
                            Content="{DynamicResource Situation.Store}"
                            Style="{StaticResource Theme.Input.Primary}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
