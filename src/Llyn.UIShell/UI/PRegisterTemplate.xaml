<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    x:Class="Llyn.UIShell.PRegisterTemplate">

    <local:PStateConverter x:Key="Theme.State.Show" />

    <DataTemplate x:Key="Theme.Register.Chip">
        <Border Margin="0,0,9,7" Padding="10,4,5,4" Cursor="Arrow" Style="{DynamicResource Theme.Card.Register}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource Theme.Card.RegisterSize}" Foreground="{DynamicResource Theme.Helper}">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource Theme.State.Show}">
                            <Binding Path="PRegisterUnreadable" />
                            <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                            <Binding Path="PRegisterText" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <Button Width="16" Height="16" Margin="7,0,0,0" Padding="0" Cursor="Hand" Click="PRegisterChipHandle">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Path Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0,0 L 7,7 M 7,0 L 0,7" Stroke="{DynamicResource Theme.Helper}" StrokeEndLineCap="Round" StrokeThickness="1.4" />
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Register.Entry">
        <TextBox
            MinWidth="128"
            Margin="9,0,9,7"
            Padding="0,5"
            VerticalContentAlignment="Center"
            FontSize="{DynamicResource Theme.Card.RegisterSize}"
            Foreground="{DynamicResource Theme.Ink}"
            LostKeyboardFocus="PRegisterCloseHandle"
            PreviewKeyDown="PRegisterCaretHandle"
            Style="{DynamicResource Theme.Input.Bare}"
            Tag="{Binding PRegisterCaretHint}"
            Text="{Binding PRegisterCaretText, UpdateSourceTrigger=PropertyChanged}" />
    </DataTemplate>

    <local:PRegisterSelector
        x:Key="Theme.Register.Item"
        PRegisterSelectorChip="{StaticResource Theme.Register.Chip}"
        PRegisterSelectorCaret="{StaticResource Theme.Register.Entry}" />

    <Style x:Key="Theme.Register.Field" TargetType="ItemsControl">
        <Setter Property="ItemTemplateSelector" Value="{StaticResource Theme.Register.Item}" />
        <Setter Property="Margin" Value="{DynamicResource Theme.Card.RegisterMargin}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <Border Background="Transparent" Cursor="IBeam" MouseLeftButtonDown="PRegisterFocusHandle">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
