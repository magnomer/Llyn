<UserControl
    x:Class="Llyn.UIShell.PLibrary"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
    >

    <UserControl.Resources>
        <Style x:Key="Theme.Index.Row" TargetType="Button" BasedOn="{StaticResource Theme.Catalog.Row}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding PIndexItemChosen}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Theme.Accent}" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                    <Setter Property="Padding" Value="9,9,12,9" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            x:Name="POrder"
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,20,18"
            Style="{StaticResource Theme.Search.Bar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton
                    x:Name="POrderDropper"
                    Grid.Column="0"
                    Style="{StaticResource Theme.Search.Dropper}"
                    ToolTip="{DynamicResource Order.Title}">
                    <Canvas Width="16" Height="14">
                        <Rectangle Canvas.Top="1" Width="16" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        <Rectangle Canvas.Top="6.2" Width="11" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        <Rectangle Canvas.Top="11.4" Width="6" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    </Canvas>
                </ToggleButton>
                <Rectangle Grid.Column="1" Style="{StaticResource Theme.Search.Divider}" />
                <TextBox
                    x:Name="PInquiry"
                    Grid.Column="2"
                    Style="{StaticResource Theme.Search.Field}"
                    Tag="{DynamicResource List.Search}"
                    TextChanged="PInquiryHandle" />
                <Popup
                    x:Name="POrderDropdown"
                    Width="252"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsChecked, ElementName=POrderDropper}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=POrder}"
                    StaysOpen="False"
                    VerticalOffset="6">
                    <Border Margin="10" Padding="8" Style="{StaticResource Theme.Popup.Surface}">
                        <StackPanel>
                            <TextBlock Margin="10,7,10,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Order.Title}" />

                            <RadioButton GroupName="POrderChoice" IsChecked="True" Click="POrderHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Headword" Content="{DynamicResource Order.Headword}" />
                            <RadioButton GroupName="POrderChoice" Click="POrderHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Reverse" Content="{DynamicResource Order.Reverse}" />
                            <RadioButton GroupName="POrderChoice" Click="POrderHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Recent" Content="{DynamicResource Order.Recent}" />
                            <RadioButton GroupName="POrderChoice" Click="POrderHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Earliest" Content="{DynamicResource Order.Earliest}" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PIndex" Margin="0,0,4,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="PIndexHandle" Style="{StaticResource Theme.Index.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Source="{Binding PIndexItemFlag}" Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Theme.Catalog.Title}" Text="{Binding PIndexItemHeadword}" />
                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource Theme.Catalog.Meta}" Text="{Binding PIndexItemLanguage}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="PIndexEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource List.Empty}" />
        </Grid>

        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,18">
            <Border HorizontalAlignment="Left" Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="PLibraryFresh"
                        Click="PLibraryFreshHandle"
                        Content="{DynamicResource Scribe.New}"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="pack://application:,,,/Llyn;component/icons/plus.svg" />
                    <Button
                        x:Name="PLibraryStore"
                        Click="PLibraryStoreHandle"
                        Content="{DynamicResource Scribe.Save}"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Primary}"
                        Tag="pack://application:,,,/Llyn;component/icons/floppy-disk.svg" />
                    <Rectangle Style="{StaticResource Theme.Command.Divider}" />
                    <Button
                        Click="PLibraryMarkupHandle"
                        Content="{DynamicResource List.Import}"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="pack://application:,,,/Llyn;component/icons/download-simple.svg" />
                    <Button
                        Content="{DynamicResource Scribe.Export}"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="pack://application:,,,/Llyn;component/icons/upload-simple.svg" />
                    <Button
                        Content="{DynamicResource Scribe.Print}"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="pack://application:,,,/Llyn;component/icons/printer.svg" />
                </StackPanel>
            </Border>
            <Border
                x:Name="PLibraryMode"
                HorizontalAlignment="Right"
                IsEnabled="False"
                Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        x:Name="PLibraryViewer"
                        Click="PLibraryScribeHandle"
                        Content="{DynamicResource Scribe.View}"
                        GroupName="PLibraryMode"
                        IsChecked="True"
                        Style="{StaticResource Theme.Command.Mode}"
                        Tag="pack://application:,,,/Llyn;component/icons/eye.svg" />
                    <RadioButton
                        x:Name="PLibraryScribe"
                        Click="PLibraryScribeHandle"
                        Content="{DynamicResource Scribe.Edit}"
                        GroupName="PLibraryMode"
                        Style="{StaticResource Theme.Command.Mode}"
                        Tag="pack://application:,,,/Llyn;component/icons/pencil-simple.svg" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" ClipToBounds="True" Style="{StaticResource Theme.Input.Card}">
            <Grid>
                <local:PDisplay x:Name="PDisplay" />

                <local:PEditor x:Name="PEditor" Grid.Row="1" Padding="30,18,30,30" Visibility="Collapsed" />

                <Button
                    x:Name="PLibraryBin"
                    Margin="0,14,14,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="PLibraryBinHandle"
                    IsEnabled="False"
                    Style="{StaticResource Theme.Input.Bin}"
                    ToolTip="{DynamicResource Scribe.Delete}">
                    <Rectangle Width="15" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform">
                                <VisualBrush.Visual>
                                    <svgc:SvgViewbox Width="15" Height="16" Source="pack://application:,,,/Llyn;component/icons/trash.svg" />
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>

