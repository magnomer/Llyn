<UserControl
    x:Class="Llyn.UIShell.PLibrary"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    >

    <UserControl.Resources>
        <Style x:Key="Theme.Index.Row" TargetType="Button" BasedOn="{StaticResource Theme.Catalog.Row}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding PIndexItemChosen}" Value="True">
                    <Setter Property="Tag" Value="Chosen" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <UserControl.CommandBindings>
        <CommandBinding CanExecute="PLibraryPressCheck" Command="ApplicationCommands.Print" Executed="PLibraryPressHandle" />
        <CommandBinding CanExecute="PLibraryPressCheck" Command="local:PDisplayCommand.PDisplayCommandPortrait" Executed="PLibraryPortraitHandle" />
    </UserControl.CommandBindings>

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="-34,0,-34,0" Style="{StaticResource Theme.Panel.SeamRow}" />
        <local:PSeam Grid.Row="1" Grid.Column="1" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />

        <Border
            x:Name="POrder"
            Grid.Row="0"
            Grid.Column="0"
            Margin="{StaticResource Theme.Catalog.HeaderMargin}"
            Style="{StaticResource Theme.Search.Bar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton
                    x:Name="POrderDropper"
                    Grid.Column="0"
                    Style="{StaticResource Theme.Search.Dropper}"
                    ToolTip="{DynamicResource Order.Title}">
                    <Path Width="24" Height="24" Data="{local:PIcon sort, 24}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Stretch="None" />
                </ToggleButton>
                <Rectangle Grid.Column="1" Style="{StaticResource Theme.Search.Divider}" />
                <TextBox
                    x:Name="PInquiry"
                    Grid.Column="2"
                    Style="{StaticResource Theme.Search.Field}"
                    Tag="{DynamicResource List.Search}"
                    TextChanged="PInquiryHandle" />
                <Rectangle Grid.Column="3" Margin="2,0,5,0" Style="{StaticResource Theme.Search.Divider}" />
                <ToggleButton
                    x:Name="PSieveDropper"
                    Grid.Column="4"
                    Style="{StaticResource Theme.Search.Dropper}"
                    ToolTip="{DynamicResource Sieve.Title}">
                    <Grid Width="24" Height="24">
                        <Path Width="24" Height="24" Data="{local:PIcon filter, 24}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Stretch="None" />
                        <Ellipse
                            x:Name="PSieveMark"
                            Width="6"
                            Height="6"
                            Margin="0,2,1,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Fill="{StaticResource Theme.Accent}"
                            Visibility="Collapsed" />
                    </Grid>
                </ToggleButton>
                <Popup
                    x:Name="POrderDropdown"
                    Width="252"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsChecked, ElementName=POrderDropper}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=POrder}"
                    StaysOpen="False"
                    VerticalOffset="6">
                    <Border Margin="10" Padding="8" Style="{StaticResource Theme.Popup.Surface}">
                        <StackPanel>
                            <TextBlock Margin="10,7,10,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Order.Title}" />

                            <RadioButton GroupName="POrderChoice" IsChecked="True" Click="POrderHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Headword" Content="{DynamicResource Order.Headword}" />
                            <RadioButton GroupName="POrderChoice" Click="POrderHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Reverse" Content="{DynamicResource Order.Reverse}" />
                            <RadioButton GroupName="POrderChoice" Click="POrderHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Recent" Content="{DynamicResource Order.Recent}" />
                            <RadioButton GroupName="POrderChoice" Click="POrderHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Earliest" Content="{DynamicResource Order.Earliest}" />
                        </StackPanel>
                    </Border>
                </Popup>
                <Popup
                    x:Name="PSieveDropdown"
                    Width="190"
                    AllowsTransparency="True"
                    HorizontalOffset="-151"
                    IsOpen="{Binding IsChecked, ElementName=PSieveDropper}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=PSieveDropper}"
                    StaysOpen="False"
                    VerticalOffset="6">
                    <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                        <StackPanel x:Name="PSieveList" />
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0" Style="{StaticResource Theme.Catalog.Frame}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl x:Name="PIndex">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="PIndexHandle" Style="{StaticResource Theme.Index.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Source="{Binding PIndexItemFlag}" Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Theme.Catalog.Title}" Text="{Binding PIndexItemName}" />
                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource Theme.Catalog.Meta}" Text="{Binding PIndexItemLanguage}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="PIndexEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource List.Empty}" />
        </Grid>

        <local:PRail Grid.Row="0" Grid.Column="1" Margin="0,0,0,18">
            <Border Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="PLibraryFresh"
                        Click="PLibraryFreshHandle"
                        Content="{DynamicResource Scribe.New}"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="{local:PIcon new, 24}" />
                    <Button
                        x:Name="PLibraryStore"
                        Click="PLibraryStoreHandle"
                        Content="{DynamicResource Scribe.Save}"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Primary}"
                        Tag="{local:PIcon save, 24}" />
                    <Rectangle Style="{StaticResource Theme.Command.Divider}" />
                    <Button
                        Click="PLibraryMarkupHandle"
                        Content="{DynamicResource List.Import}"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="{local:PIcon import, 24}" />
                    <Button
                        Command="local:PDisplayCommand.PDisplayCommandPortrait"
                        Content="{DynamicResource Scribe.Export}"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="{local:PIcon export, 24}" />
                    <Button
                        Command="ApplicationCommands.Print"
                        Content="{DynamicResource Scribe.Print}"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="{local:PIcon print, 24}" />
                </StackPanel>
            </Border>
            <Border
                x:Name="PLibraryMode"
                IsEnabled="False"
                Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        x:Name="PLibraryViewer"
                        Click="PLibraryScribeHandle"
                        Content="{DynamicResource Scribe.View}"
                        GroupName="PLibraryMode"
                        IsChecked="True"
                        Style="{StaticResource Theme.Command.Mode}"
                        Tag="{local:PIcon view, 24}" />
                    <RadioButton
                        x:Name="PLibraryScribe"
                        Click="PLibraryScribeHandle"
                        Content="{DynamicResource Scribe.Edit}"
                        GroupName="PLibraryMode"
                        Style="{StaticResource Theme.Command.Mode}"
                        Tag="{local:PIcon edit, 24}" />
                </StackPanel>
            </Border>
        </local:PRail>

        <Border Grid.Row="1" Grid.Column="1" Margin="0,14,-18,-38" ClipToBounds="True" Style="{StaticResource Theme.Panel.Surface}">
            <Grid>
                <local:PDisplay x:Name="PDisplay" />

                <local:PEditor x:Name="PEditor" Grid.Row="1" Padding="30,18,30,30" Visibility="Collapsed" />

                <Button
                    x:Name="PLibraryBin"
                    Margin="0,17,26,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="PLibraryBinHandle"
                    IsEnabled="False"
                    Style="{StaticResource Theme.Input.Bin}"
                    ToolTip="{DynamicResource Scribe.Delete}">
                    <Path Width="24" Height="24" Data="{local:PIcon delete, 24}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="None" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>

