<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    x:Class="Llyn.UIShell.PMarkerTemplate">

    <DataTemplate x:Key="Theme.Marker.Chip">
        <Border Style="{DynamicResource Theme.Marker.Surface}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Style="{DynamicResource Theme.Marker.Name}" Text="{Binding PMarkerChipName}" />
                <Button Click="PMarkerChipHandle" Style="{DynamicResource Theme.Marker.Remove}">
                    <Path
                        Width="12"
                        Height="12"
                        Data="{local:PIcon close, 12}"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Stretch="None" />
                </Button>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
