<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Llyn.UIShell.PMarkerTemplate">

    <DataTemplate x:Key="Theme.Marker.Chip">
        <Border Style="{DynamicResource Theme.Marker.Surface}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Style="{DynamicResource Theme.Marker.Name}" Text="{Binding PMarkerChipName}" />
                <Button Click="PMarkerChipHandle" Style="{DynamicResource Theme.Marker.Remove}">
                    <Path
                        Width="7"
                        Height="7"
                        Data="M 0,0 L 7,7 M 7,0 L 0,7"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeEndLineCap="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="1.5" />
                </Button>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
