<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell">

    <DataTemplate x:Key="Imprint.Credit.Card">
        <Border Margin="0,0,0,6" Padding="12,6" Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Line}" BorderThickness="1" CornerRadius="9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="13" Text="{Binding PAuthorItemName}" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button IsEnabled="{Binding PAuthorItemEarlier}" Style="{DynamicResource Theme.Popup.IconAction}" Tag="Earlier" ToolTip="{DynamicResource Source.AuthorEarlier}">
                        <Path Width="24" Height="24" Data="{local:PIcon earlier, 24}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="None" />
                    </Button>
                    <Button IsEnabled="{Binding PAuthorItemLater}" Style="{DynamicResource Theme.Popup.IconAction}" Tag="Later" ToolTip="{DynamicResource Source.AuthorLater}">
                        <Path Width="24" Height="24" Data="{local:PIcon later, 24}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="None" />
                    </Button>
                    <Button Style="{DynamicResource Theme.Popup.IconAction}" Tag="Rename" ToolTip="{DynamicResource Source.AuthorRename}">
                        <Path Width="24" Height="24" Data="{local:PIcon edit, 24}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="None" />
                    </Button>
                    <Button Style="{DynamicResource Theme.Popup.IconAction}" Tag="Remove" ToolTip="{DynamicResource Source.AuthorRemove}">
                        <Path Width="24" Height="24" Data="{local:PIcon close, 24}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="None" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Imprint.Author.Row">
        <TextBlock Margin="4,0" VerticalAlignment="Center" Text="{Binding PAuthorItemName}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <Style x:Key="Imprint.Author.Item" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

</ResourceDictionary>
