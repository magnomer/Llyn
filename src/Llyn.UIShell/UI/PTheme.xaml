<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf">

    <SolidColorBrush x:Key="Theme.Ink" Color="{DynamicResource Theme.Ink.Color}" />
    <SolidColorBrush x:Key="Theme.Muted" Color="{DynamicResource Theme.Muted.Color}" />
    <SolidColorBrush x:Key="Theme.Canvas" Color="{DynamicResource Theme.Canvas.Color}" />
    <SolidColorBrush x:Key="Theme.Roof" Color="{DynamicResource Theme.Roof.Color}" />
    <SolidColorBrush x:Key="Theme.Navigation" Color="{DynamicResource Theme.Navigation.Color}" />
    <SolidColorBrush x:Key="Theme.Surface" Color="{DynamicResource Theme.Surface.Color}" />
    <SolidColorBrush x:Key="Theme.SurfaceRaised" Color="{DynamicResource Theme.SurfaceRaised.Color}" />
    <SolidColorBrush x:Key="Theme.Line" Color="{DynamicResource Theme.Line.Color}" />
    <SolidColorBrush x:Key="Theme.LineStrong" Color="{DynamicResource Theme.LineStrong.Color}" />
    <SolidColorBrush x:Key="Theme.Accent" Color="{DynamicResource Theme.Accent.Color}" />
    <SolidColorBrush x:Key="Theme.AccentHover" Color="{DynamicResource Theme.AccentHover.Color}" />
    <SolidColorBrush x:Key="Theme.AccentPress" Color="{DynamicResource Theme.AccentPress.Color}" />
    <SolidColorBrush x:Key="Theme.AccentEdge" Color="{DynamicResource Theme.AccentEdge.Color}" />
    <SolidColorBrush x:Key="Theme.AccentSoft" Color="{DynamicResource Theme.AccentSoft.Color}" />
    <SolidColorBrush x:Key="Theme.Warning" Color="{DynamicResource Theme.Warning.Color}" />
    <SolidColorBrush x:Key="Theme.WarningSoft" Color="{DynamicResource Theme.WarningSoft.Color}" />
    <SolidColorBrush x:Key="Theme.WarningStrong" Color="{DynamicResource Theme.WarningStrong.Color}" />
    <SolidColorBrush x:Key="Theme.DisabledLine" Color="{DynamicResource Theme.DisabledLine.Color}" />
    <SolidColorBrush x:Key="Theme.DisabledInk" Color="{DynamicResource Theme.DisabledInk.Color}" />

    <FontFamily x:Key="Theme.Font">Segoe UI Variable, Segoe UI</FontFamily>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Theme.Canvas}" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="28" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template" Value="{DynamicResource Theme.ScrollBar.Vertical.Template}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="28" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Margin" Value="0,12,0,0" />
                <Setter Property="Template" Value="{DynamicResource Theme.ScrollBar.Horizontal.Template}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Caption.Button" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PSurface" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.SurfaceRaised}" />
                            <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Caption.Close" TargetType="Button" BasedOn="{StaticResource Theme.Caption.Button}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PSurface" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.WarningStrong}" />
                            <Setter Property="Foreground" Value="{StaticResource Theme.Roof}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.WarningStrong}" />
                            <Setter TargetName="PSurface" Property="Opacity" Value="0.7" />
                            <Setter Property="Foreground" Value="{StaticResource Theme.Roof}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Navigation.Button" TargetType="Button">
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="12,2" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PSurface" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.Surface}" />
                            <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Navigation.Selected" TargetType="Button" BasedOn="{StaticResource Theme.Navigation.Button}">
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Background" Value="{StaticResource Theme.AccentSoft}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Theme.Input.Field" TargetType="TextBox">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Background" Value="{StaticResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource Theme.Ink}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />

        <Setter Property="Template" Value="{DynamicResource Theme.Input.Field.Template}" />
    </Style>

    <Style x:Key="Theme.Input.Headword" TargetType="TextBox" BasedOn="{StaticResource Theme.Input.Field}">
        <Setter Property="MinHeight" Value="51" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="Theme.Text.Headword" TargetType="TextBlock">
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="Theme.Input.Action" TargetType="Button">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Background" Value="{StaticResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="PSurface"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.SurfaceRaised}" />
                            <Setter TargetName="PSurface" Property="BorderBrush" Value="{StaticResource Theme.Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Input.Pill" TargetType="Button" BasedOn="{StaticResource Theme.Input.Action}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="PSurface"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.SurfaceRaised}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PSurface" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Input.Primary" TargetType="Button" BasedOn="{StaticResource Theme.Input.Pill}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource Theme.Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="#245FD0" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="#1D50B5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PSurface" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Input.Bin" TargetType="Button" BasedOn="{StaticResource Theme.Input.Action}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="PSurface"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.WarningSoft}" />
                            <Setter TargetName="PSurface" Property="BorderBrush" Value="{StaticResource Theme.Warning}" />
                            <Setter Property="Foreground" Value="{StaticResource Theme.Warning}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.WarningSoft}" />
                            <Setter TargetName="PSurface" Property="BorderBrush" Value="{StaticResource Theme.WarningStrong}" />
                            <Setter Property="Foreground" Value="{StaticResource Theme.WarningStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PSurface" Property="Background" Value="Transparent" />
                            <Setter TargetName="PSurface" Property="BorderBrush" Value="{StaticResource Theme.DisabledLine}" />
                            <Setter Property="Foreground" Value="{StaticResource Theme.DisabledInk}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Choice.Row" TargetType="Button">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />

        <Setter Property="Background" Value="{StaticResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="PSurface"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PSurface" Property="Opacity" Value="0.72" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Choice.Order" TargetType="RadioButton">
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="PSurface"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <Path
                                x:Name="PIndicator"
                                Grid.Column="1"
                                Width="11"
                                Height="8"
                                Margin="12,0,2,0"
                                Data="M 0,4 L 3.5,7.5 L 11,0"
                                Stroke="{StaticResource Theme.Accent}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.8"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.SurfaceRaised}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
                            <Setter TargetName="PIndicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Popup.Surface" TargetType="Border">
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="{StaticResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="28" Direction="270" Opacity="0.13" ShadowDepth="9" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Popup.Title" TargetType="TextBlock">
        <Setter Property="Margin" Value="10,7,10,5" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
    </Style>

    <Style x:Key="Theme.Popup.Notice" TargetType="TextBlock">
        <Setter Property="Margin" Value="10,5,10,9" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
    </Style>

    <Style x:Key="Theme.Popup.Progress" TargetType="Border">
        <Setter Property="Height" Value="2" />
        <Setter Property="Margin" Value="10,1,10,3" />
        <Setter Property="Background" Value="{StaticResource Theme.AccentSoft}" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style x:Key="Theme.Popup.ProgressBar" TargetType="Border">
        <Setter Property="Width" Value="84" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{StaticResource Theme.Accent}" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform X="-84" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="-84" To="268" Duration="0:0:1.15" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Popup.RowSurface" TargetType="Border">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="9" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Theme.SurfaceRaised}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Popup.RowAction" TargetType="Button">

        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Style>
        </Style.Resources>
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PSurface" Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PSurface" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PSurface" Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Popup.RowChoice" TargetType="Button">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="PSurface"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="12">
                        <TextBlock
                            x:Name="PLabel"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            Foreground="{TemplateBinding Foreground}"
                            Text="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.Accent}" />
                            <Setter TargetName="PSurface" Property="BorderBrush" Value="{StaticResource Theme.Accent}" />
                            <Setter TargetName="PLabel" Property="Foreground" Value="{StaticResource Theme.Roof}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.AccentPress}" />
                            <Setter TargetName="PSurface" Property="BorderBrush" Value="{StaticResource Theme.AccentPress}" />
                            <Setter TargetName="PLabel" Property="Foreground" Value="{StaticResource Theme.Roof}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PSurface" Property="Background" Value="Transparent" />
                            <Setter TargetName="PSurface" Property="BorderBrush" Value="{StaticResource Theme.DisabledLine}" />
                            <Setter TargetName="PLabel" Property="Foreground" Value="{StaticResource Theme.DisabledInk}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Popup.IconAction" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PSurface" Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PSurface" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Pronunciation.Surface" TargetType="Border">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Theme.Pronunciation.Bracket" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Theme.Pronunciation.Text" TargetType="TextBlock">
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="MaxWidth" Value="292" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Theme.Pronunciation.Field" TargetType="TextBox" BasedOn="{StaticResource Theme.Input.Field}">
        <Setter Property="Margin" Value="-2,0,-2,0" />
        <Setter Property="MaxWidth" Value="296" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
