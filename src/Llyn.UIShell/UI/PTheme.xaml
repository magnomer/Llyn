<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Theme.Ink" Color="{DynamicResource Theme.Ink.Color}" />
    <SolidColorBrush x:Key="Theme.Muted" Color="{DynamicResource Theme.Muted.Color}" />
    <SolidColorBrush x:Key="Theme.Canvas" Color="{DynamicResource Theme.Canvas.Color}" />
    <SolidColorBrush x:Key="Theme.Roof" Color="{DynamicResource Theme.Roof.Color}" />
    <SolidColorBrush x:Key="Theme.Navigation" Color="{DynamicResource Theme.Navigation.Color}" />
    <SolidColorBrush x:Key="Theme.Surface" Color="{DynamicResource Theme.Surface.Color}" />
    <SolidColorBrush x:Key="Theme.SurfaceRaised" Color="{DynamicResource Theme.SurfaceRaised.Color}" />
    <SolidColorBrush x:Key="Theme.Line" Color="{DynamicResource Theme.Line.Color}" />
    <SolidColorBrush x:Key="Theme.Accent" Color="{DynamicResource Theme.Accent.Color}" />
    <SolidColorBrush x:Key="Theme.AccentSoft" Color="{DynamicResource Theme.AccentSoft.Color}" />
    <SolidColorBrush x:Key="Theme.Warning" Color="{DynamicResource Theme.Warning.Color}" />
    <SolidColorBrush x:Key="Theme.WarningSoft" Color="{DynamicResource Theme.WarningSoft.Color}" />

    <FontFamily x:Key="Theme.Font">Segoe UI Variable, Segoe UI</FontFamily>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Theme.Canvas}" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="28" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template" Value="{DynamicResource Theme.ScrollBar.Vertical.Template}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="28" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Margin" Value="0,12,0,0" />
                <Setter Property="Template" Value="{DynamicResource Theme.ScrollBar.Horizontal.Template}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Caption.Button" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PSurface" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.SurfaceRaised}" />
                            <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Caption.Close" TargetType="Button" BasedOn="{StaticResource Theme.Caption.Button}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Theme.WarningSoft}" />
                <Setter Property="Foreground" Value="{StaticResource Theme.Warning}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Navigation.Button" TargetType="Button">
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="12,2" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PSurface" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.Surface}" />
                            <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Navigation.Selected" TargetType="Button" BasedOn="{StaticResource Theme.Navigation.Button}">
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Background" Value="{StaticResource Theme.AccentSoft}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Theme.Input.Field" TargetType="TextBox">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Background" Value="{StaticResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource Theme.Ink}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />

        <Setter Property="Template" Value="{DynamicResource Theme.Input.Field.Template}" />
    </Style>

    <Style x:Key="Theme.Input.Headword" TargetType="TextBox" BasedOn="{StaticResource Theme.Input.Field}">
        <Setter Property="MinHeight" Value="51" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="Theme.Input.Action" TargetType="Button">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Background" Value="{StaticResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="PSurface"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.SurfaceRaised}" />
                            <Setter TargetName="PSurface" Property="BorderBrush" Value="{StaticResource Theme.Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Input.Pill" TargetType="Button" BasedOn="{StaticResource Theme.Input.Action}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="PSurface"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.SurfaceRaised}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PSurface" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Text.Inverse" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="Theme.Input.Primary" TargetType="Button" BasedOn="{StaticResource Theme.Input.Pill}">
        <Style.Resources>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Theme.Text.Inverse}" />
        </Style.Resources>
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource Theme.Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="#245FD0" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="#1D50B5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PSurface" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Choice.Row" TargetType="Button">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />

        <Setter Property="Background" Value="{StaticResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="PSurface"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PSurface" Property="Opacity" Value="0.72" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Popup.Surface" TargetType="Border">
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="{StaticResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="28" Direction="270" Opacity="0.13" ShadowDepth="9" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Popup.Title" TargetType="TextBlock">
        <Setter Property="Margin" Value="10,7,10,5" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
    </Style>

    <Style x:Key="Theme.Popup.Notice" TargetType="TextBlock">
        <Setter Property="Margin" Value="10,5,10,9" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
    </Style>

    <Style x:Key="Theme.Popup.Progress" TargetType="Border">
        <Setter Property="Height" Value="2" />
        <Setter Property="Margin" Value="10,1,10,3" />
        <Setter Property="Background" Value="{StaticResource Theme.AccentSoft}" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style x:Key="Theme.Popup.RowSurface" TargetType="Border">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="9" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Theme.SurfaceRaised}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Popup.RowAction" TargetType="Button">

        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Style>
        </Style.Resources>
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PSurface" Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PSurface" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PSurface" Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Popup.IconAction" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PSurface" Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PSurface" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Input.TogglePill" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Background" Value="{StaticResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="PSurface"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="24">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.SurfaceRaised}" />
                            <Setter TargetName="PSurface" Property="BorderBrush" Value="{StaticResource Theme.Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PSurface" Property="BorderBrush" Value="{StaticResource Theme.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Input.ToggleAction" TargetType="ToggleButton" BasedOn="{StaticResource Theme.Input.TogglePill}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="PSurface"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="9">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.SurfaceRaised}" />
                            <Setter TargetName="PSurface" Property="BorderBrush" Value="{StaticResource Theme.Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PSurface" Property="BorderBrush" Value="{StaticResource Theme.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Input.Label" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Theme.Input.Tab" TargetType="Button">
        <Setter Property="Width" Value="145" />
        <Setter Property="Height" Value="37" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="PSurface" Background="{TemplateBinding Background}" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Text="{TemplateBinding Content}" />
                        <Border x:Name="PIndicator" Width="148" Height="5" Margin="-5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" CornerRadius="3,3,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.Surface}" />
                            <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Input.Tab.Selected" TargetType="Button" BasedOn="{StaticResource Theme.Input.Tab}">
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Text="{TemplateBinding Content}" />
                        <Border Width="148" Height="5" Margin="-5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{StaticResource Theme.Accent}" CornerRadius="3,3,0,0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Input.Card" TargetType="Border">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{StaticResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

</ResourceDictionary>
