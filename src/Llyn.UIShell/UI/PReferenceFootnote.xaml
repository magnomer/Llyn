<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell">

    <DataTemplate x:Key="Reference.Footnote.Card">
        <Button Style="{DynamicResource Theme.Footnote.Row}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Source="{Binding PFootnoteItemFlag}" Stretch="Uniform" />
                <TextBlock Grid.Column="1" Style="{DynamicResource Theme.Catalog.Title}"><Run Text="{Binding PFootnoteItemName, Mode=OneWay}" /><Run
                    Style="{DynamicResource Theme.Catalog.Epithet}"
                    Text="{Binding PFootnoteItemEpithet, Mode=OneWay, StringFormat='&#x2002;{0}'}" /></TextBlock>
                <TextBlock Grid.Column="2" Margin="10,0,0,0" Style="{DynamicResource Theme.Catalog.Meta}" Text="{Binding PFootnoteItemLanguage}" />
            </Grid>
        </Button>
    </DataTemplate>

</ResourceDictionary>
