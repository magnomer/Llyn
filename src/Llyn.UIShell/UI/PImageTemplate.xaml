<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    x:Class="Llyn.UIShell.PImageTemplate">

    <local:PStateConverter x:Key="Theme.State.Show" />

    <Style x:Key="Theme.Image.Preview" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PImagePreview}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="Theme.Image.Row">
        <Grid Style="{DynamicResource Theme.Card.Reach}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Style="{DynamicResource Theme.Card.Gutter}" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border Style="{StaticResource Theme.Image.Preview}">
                    <Image MaxWidth="320" MaxHeight="200" Source="{Binding PImagePreview}" Stretch="Uniform" />
                </Border>

                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Margin="0,6,16,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource Theme.Muted}"
                        Style="{DynamicResource Theme.Input.Bare}"
                        Text="{Binding PImageLocation, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Tag>
                            <MultiBinding Converter="{StaticResource Theme.State.Show}">
                                <Binding Path="PImageUnreadable" />
                                <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                                <local:PLocalizationBinder PLocalizationBinderKey="Card.LocationHint" />
                            </MultiBinding>
                        </TextBox.Tag>
                    </TextBox>

                    <Button Grid.Column="1" Height="20" Padding="8,0" Click="PImageOpenHandle" Foreground="{DynamicResource Theme.Accent}" Style="{DynamicResource Theme.Input.Pill}">
                        <TextBlock VerticalAlignment="Center" FontSize="11" Text="{DynamicResource Card.Browse}" />
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="30,1,0,0" VerticalAlignment="Top" Orientation="Horizontal" Style="{DynamicResource Theme.Card.Control}">
                <Button Click="PImageRemoveHandle" Style="{DynamicResource Theme.Card.Handle}">
                    <Path Width="9" Height="9" Data="M 0,4.5 L 9,4.5" Stroke="{DynamicResource Theme.Muted}" StrokeEndLineCap="Round" StrokeThickness="1.5" />
                </Button>
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
