<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    x:Class="Llyn.UIShell.PImageTemplate">

    <local:PStateConverter x:Key="Theme.State.Show" />

    <Style x:Key="Theme.Image.Section" TargetType="Grid">
        <Style.Triggers>
            <DataTrigger Binding="{Binding PCardImage.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Image.Preview" TargetType="Border">
        <Setter Property="Margin" Value="0,7,0,0" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PImagePreview}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="Theme.Image.Row">
        <Grid Margin="0,0,0,7">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox MinHeight="42" Padding="12,7" Style="{DynamicResource Theme.Input.Field}" Text="{Binding PImageLocation, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Tag>
                        <MultiBinding Converter="{StaticResource Theme.State.Show}">
                            <Binding Path="PImageUnreadable" />
                            <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                            <local:PLocalizationBinder PLocalizationBinderKey="Card.LocationHint" />
                        </MultiBinding>
                    </TextBox.Tag>
                </TextBox>

                <Button Grid.Column="1" Height="42" Margin="8,0,0,0" Padding="14,0" Click="PImageOpenHandle" Style="{DynamicResource Theme.Input.Pill}">
                    <TextBlock VerticalAlignment="Center" FontSize="13" Text="{DynamicResource Card.Browse}" />
                </Button>
                <Button Grid.Column="2" Width="42" Height="42" Margin="7,0,0,0" Click="PImageRemoveHandle" Style="{DynamicResource Theme.Input.Action}">
                    <Path Width="12" Height="12" Data="M 1,6 L 11,6" Stroke="{DynamicResource Theme.Muted}" StrokeEndLineCap="Round" StrokeThickness="1.5" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Theme.Image.Preview}">
                <Image MaxWidth="320" MaxHeight="200" Source="{Binding PImagePreview}" Stretch="Uniform" />
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
