<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Llyn.UIShell.PLookupTemplate">

    <!-- One pronunciation candidate: the source that offered it, small, and the phonetic itself in
         the brackets the pronunciation field wears. Same row as the downloader row. -->
    <DataTemplate x:Key="Theme.Lookup.Row">
        <Border Style="{DynamicResource Theme.Popup.RowSurface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock MaxWidth="88" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Theme.Muted}" Text="{Binding PLookupCandidateSource}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="PLookupMenuItem" Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><Run Foreground="{DynamicResource Theme.Muted}" Text="[" /><Run Foreground="{DynamicResource Theme.Ink}" Text="{Binding PLookupCandidatePhonetic, Mode=OneWay}" /><Run Foreground="{DynamicResource Theme.Muted}" Text="]" /></TextBlock>
                <Button x:Name="PLookupMenuSelector" Grid.Column="2" VerticalAlignment="Center" Click="PLookupMenuHandle" Content="{DynamicResource Lookup.Use}" Style="{DynamicResource Theme.Popup.RowAction}" />
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
