<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Llyn.UIShell.PLookupTemplate">

    <!-- One pronunciation candidate in the lookup menu: the source it came from and the phonetic it offers. -->
    <DataTemplate x:Key="Theme.Lookup.Row">
        <Button Margin="4,3" Click="PLookupMenuHandle" Style="{DynamicResource Theme.Popup.Row}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="11" Foreground="{DynamicResource Theme.Muted}" Text="{Binding PLookupCandidateSource}" />
                    <TextBlock x:Name="PLookupMenuItem" Margin="0,3,0,0" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Ink}" Text="{Binding PLookupCandidatePhonetic}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,2,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Accent}" Text="{DynamicResource Lookup.Select}" />
                    <Path Width="5" Height="9" Margin="7,0,0,0" Data="M 0,0 L 4,4.5 L 0,9" Stretch="Fill" Stroke="{DynamicResource Theme.Accent}" StrokeLineJoin="Round" StrokeThickness="1.4" />
                </StackPanel>
            </Grid>
        </Button>
    </DataTemplate>
</ResourceDictionary>
