<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Llyn.UIShell.PPhoneticTemplate">

    <DataTemplate x:Key="Theme.Phonetic.Row">
        <Border Style="{DynamicResource Theme.Popup.RowSurface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock MaxWidth="88" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Theme.Muted}" Text="{Binding PPhoneticItemSource}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="PPhoneticReading" Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><Run Foreground="{DynamicResource Theme.Muted}" Text="[" /><Run Foreground="{DynamicResource Theme.Ink}" Text="{Binding PPhoneticItemReading, Mode=OneWay}" /><Run Foreground="{DynamicResource Theme.Muted}" Text="]" /></TextBlock>
                <Button x:Name="PPhoneticSelector" Grid.Column="2" VerticalAlignment="Center" Click="PPhoneticSelectorHandle" Content="{DynamicResource Lookup.Use}" Style="{DynamicResource Theme.Popup.RowAction}" />
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
