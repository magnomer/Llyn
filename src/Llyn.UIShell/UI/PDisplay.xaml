<UserControl
    x:Class="Llyn.UIShell.PDisplay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
    xmlns:local="clr-namespace:Llyn.UIShell">

    <UserControl.Resources>
        <local:PStateConverter x:Key="Display.Card.State" />
        <local:PLinkConverter x:Key="Display.Card.Translation" />

        <Style x:Key="Display.Card.Title" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LCardDraftTitle, Converter={StaticResource Display.Card.State}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Display.Card.Expression" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,18" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LCardDraftExpression, Converter={StaticResource Display.Card.State}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Display.Card.Meaning" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,18" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LCardDraftMeaning, Converter={StaticResource Display.Card.State}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Display.Card.Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="21" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Display.Card.TranslationEmpty" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LCardDraftTranslation.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Theme.Usage.Row" TargetType="Button" BasedOn="{StaticResource Theme.Choice.Row}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="Display.Card.Example" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,18" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LCardDraftExample.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Display.Card.Situation" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,18" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LCardDraftSituation.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Display.Card.Tag" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding LCardDraftTag.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="Display.Card.SituationLine">
            <TextBlock Margin="0,3,0,0" FontSize="14" LineHeight="20" Text="{Binding LSituationDraftText, Converter={StaticResource Display.Card.State}}" TextWrapping="Wrap" />
        </DataTemplate>

        <DataTemplate x:Key="Display.Card.ExampleLine">
            <TextBlock Margin="0,3,0,0" FontSize="14" LineHeight="20" Text="{Binding LExampleDraftText, Converter={StaticResource Display.Card.State}}" TextWrapping="Wrap" />
        </DataTemplate>

        <DataTemplate x:Key="Display.Card.TranslationLine">
            <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                <Image Width="19" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" Source="{Binding PLinkChipFlag}" Stretch="Uniform" />
                <TextBlock VerticalAlignment="Center" FontSize="14" Text="{Binding PLinkChipHeadword}" />
                <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Theme.Muted}" Text="{Binding PLinkChipLanguage}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Display.Card.TagPill">
            <Border Margin="0,4,7,0" Padding="9,4" Background="{StaticResource Theme.AccentSoft}" CornerRadius="10">
                <TextBlock FontSize="12" Foreground="{StaticResource Theme.Accent}" Text="{Binding}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Display.Sense.Card">
            <Border Margin="0,0,0,15" Style="{StaticResource Theme.Input.Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                        <Grid Margin="22,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" Margin="0,0,12,0" Background="{StaticResource Theme.AccentSoft}" CornerRadius="14">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource Theme.Accent}"
                                    Text="{Binding LCardDraftPosition}" />
                            </Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Display.Card.Title}" Text="{Binding LCardDraftTitle, Converter={StaticResource Display.Card.State}}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Display.SenseSingle}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LCardDraftTitle, Converter={StaticResource Display.Card.State}}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="30,23,30,26">
                        <StackPanel Style="{StaticResource Display.Card.Meaning}">
                            <TextBlock Margin="0,0,0,7" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Display.Definition}" />
                            <TextBlock Style="{StaticResource Display.Card.Value}" Text="{Binding LCardDraftMeaning, Converter={StaticResource Display.Card.State}}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Margin="0,0,0,4" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Card.Translation}" />
                            <ItemsControl ItemTemplate="{StaticResource Display.Card.TranslationLine}" ItemsSource="{Binding LCardDraftTranslation, Converter={StaticResource Display.Card.Translation}}" />
                            <TextBlock Style="{StaticResource Display.Card.TranslationEmpty}" Text="{DynamicResource Card.TranslationEmpty}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Display.Card.Example}">
                            <TextBlock Margin="0,0,0,4" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Display.Example}" />
                            <ItemsControl ItemTemplate="{StaticResource Display.Card.ExampleLine}" ItemsSource="{Binding LCardDraftExample}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Display.Card.Situation}">
                            <TextBlock Margin="0,0,0,4" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Display.Situation}" />
                            <ItemsControl ItemTemplate="{StaticResource Display.Card.SituationLine}" ItemsSource="{Binding LCardDraftSituation}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Display.Card.Tag}">
                            <TextBlock Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Display.Tags}" />
                            <ItemsControl ItemTemplate="{StaticResource Display.Card.TagPill}" ItemsSource="{Binding LCardDraftTag}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Display.Collocation.Card">
            <Border Margin="0,0,0,15" Style="{StaticResource Theme.Input.Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                        <Grid Margin="22,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" Margin="0,0,12,0" Background="{StaticResource Theme.AccentSoft}" CornerRadius="14">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource Theme.Accent}"
                                    Text="{Binding LCardDraftPosition}" />
                            </Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Display.Card.Title}" Text="{Binding LCardDraftTitle, Converter={StaticResource Display.Card.State}}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Display.CollocationSingle}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LCardDraftTitle, Converter={StaticResource Display.Card.State}}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="30,23,30,26">
                        <StackPanel Style="{StaticResource Display.Card.Expression}">
                            <TextBlock Margin="0,0,0,7" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Display.Expression}" />
                            <TextBlock Style="{StaticResource Display.Card.Value}" Text="{Binding LCardDraftExpression, Converter={StaticResource Display.Card.State}}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Display.Card.Meaning}">
                            <TextBlock Margin="0,0,0,7" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Display.Meaning}" />
                            <TextBlock Style="{StaticResource Display.Card.Value}" Text="{Binding LCardDraftMeaning, Converter={StaticResource Display.Card.State}}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Margin="0,0,0,4" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Card.Translation}" />
                            <ItemsControl ItemTemplate="{StaticResource Display.Card.TranslationLine}" ItemsSource="{Binding LCardDraftTranslation, Converter={StaticResource Display.Card.Translation}}" />
                            <TextBlock Style="{StaticResource Display.Card.TranslationEmpty}" Text="{DynamicResource Card.TranslationEmpty}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Display.Card.Example}">
                            <TextBlock Margin="0,0,0,4" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Display.Example}" />
                            <ItemsControl ItemTemplate="{StaticResource Display.Card.ExampleLine}" ItemsSource="{Binding LCardDraftExample}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Display.Card.Situation}">
                            <TextBlock Margin="0,0,0,4" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Display.Situation}" />
                            <ItemsControl ItemTemplate="{StaticResource Display.Card.SituationLine}" ItemsSource="{Binding LCardDraftSituation}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Display.Card.Tag}">
                            <TextBlock Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Display.Tags}" />
                            <ItemsControl ItemTemplate="{StaticResource Display.Card.TagPill}" ItemsSource="{Binding LCardDraftTag}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <TextBlock
            x:Name="PDisplayEmpty"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{StaticResource Theme.Muted}"
            Text="{DynamicResource Display.Unselected}" />
        <ScrollViewer x:Name="PDisplayContents" Margin="30,18,30,30" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
                <Grid HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PDisplayHeadword" VerticalAlignment="Center" FontSize="40" FontWeight="Bold" TextWrapping="Wrap" />
                    <Border Grid.Column="1" Margin="14,0,0,0" Padding="10,5" VerticalAlignment="Center" Background="{StaticResource Theme.AccentSoft}" CornerRadius="12">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Grid Width="19" Height="14" VerticalAlignment="Center">
                                <Image x:Name="PDisplayLanguageFlag" Stretch="Uniform">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <Trigger Property="Source" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <Ellipse Width="12" Height="12" Stroke="{StaticResource Theme.Accent}" StrokeThickness="1.2" Visibility="Collapsed">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source, ElementName=PDisplayLanguageFlag}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>
                            <TextBlock x:Name="PDisplayLanguage" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Theme.Accent}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <Border x:Name="PDisplayPronunciationSurface" Padding="13,7" VerticalAlignment="Center" Background="{StaticResource Theme.AccentSoft}" CornerRadius="10" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="15" Text="[" />
                            <TextBlock x:Name="PDisplayPronunciation" Margin="4,0" VerticalAlignment="Center" FontSize="15" />
                            <TextBlock FontSize="15" Text="]" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="PDisplayPlayback" Width="42" Height="42" Margin="10,0,0,0" Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Line}" Foreground="{StaticResource Theme.Accent}" Click="PDisplayPlaybackHandle" Style="{StaticResource Theme.Input.Action}" Visibility="Collapsed">

                        <Rectangle Width="11" Height="13" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                            <Rectangle.OpacityMask>
                                <VisualBrush Stretch="Uniform">
                                    <VisualBrush.Visual>
                                        <svgc:SvgViewbox Width="11" Height="13" Source="icons/play.svg" />
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Button>

                    <ItemsControl x:Name="PDisplaySpeech" Margin="10,0,0,0" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,8,0" Padding="13,7" VerticalAlignment="Center" Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="1" CornerRadius="10">
                                    <TextBlock VerticalAlignment="Center" FontSize="15" Text="{Binding}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="PDisplaySenseSection" Margin="0,34,0,0">
                    <TextBlock Margin="2,0,2,12" FontSize="19" FontWeight="SemiBold" Text="{DynamicResource Display.Sense}" />
                    <ItemsControl x:Name="PDisplaySense" ItemTemplate="{StaticResource Display.Sense.Card}" />
                </StackPanel>

                <StackPanel x:Name="PDisplayCollocationSection" Margin="0,28,0,0">
                    <TextBlock Margin="2,0,2,12" FontSize="19" FontWeight="SemiBold" Text="{DynamicResource Display.Collocation}" />
                    <ItemsControl x:Name="PDisplayCollocation" ItemTemplate="{StaticResource Display.Collocation.Card}" />
                </StackPanel>

                <StackPanel x:Name="PDisplayIncomingSection" Margin="0,28,0,0">
                    <TextBlock Margin="2,0,2,12" FontSize="19" FontWeight="SemiBold" Text="{DynamicResource Display.Translated}" />
                    <Border Padding="26,22" Style="{StaticResource Theme.Input.Card}">
                        <StackPanel>
                            <ItemsControl x:Name="PDisplayIncoming">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="PDisplayIncomingHandle" Style="{StaticResource Theme.Usage.Row}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding PUsageItemHeadword}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Theme.Accent}" Text="{Binding PUsageItemOwner}" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource Theme.Muted}" Text="{Binding PUsageItemTitle}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                                    <Image Width="19" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" Source="{Binding PUsageItemFlag}" Stretch="Uniform" />
                                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Theme.Muted}" Text="{Binding PUsageItemLanguage}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock
                                x:Name="PDisplayIncomingEmpty"
                                Foreground="{StaticResource Theme.Muted}"
                                Text="{DynamicResource Display.TranslatedEmpty}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PDisplayNoteSection" Margin="0,28,0,0">
                    <TextBlock Margin="2,0,2,12" FontSize="19" FontWeight="SemiBold" Text="{DynamicResource Display.Note}" />
                    <Border Padding="26,22" Style="{StaticResource Theme.Input.Card}">
                        <TextBlock x:Name="PDisplayNote" FontSize="14" LineHeight="21" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
