<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn;component/UI/PThemePalette.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Mention.Linked" TargetType="Run">
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
        <Setter Property="TextDecorations" Value="Underline" />
    </Style>

    <Style x:Key="Theme.Mention.Silent" TargetType="Run" />

    <ContextMenu x:Key="Theme.Mention.Menu">
        <MenuItem
            Command="{x:Static local:PMentionCommand.PMentionCommandLink}"
            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
            Header="{DynamicResource Mention.Link}" />
        <MenuItem
            Command="{x:Static local:PMentionCommand.PMentionCommandChoose}"
            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
            Header="{DynamicResource Mention.Choose}" />
        <MenuItem
            Command="{x:Static local:PMentionCommand.PMentionCommandSilence}"
            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
            Header="{DynamicResource Mention.Silence}" />
        <MenuItem
            Command="{x:Static local:PMentionCommand.PMentionCommandUnlink}"
            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
            Header="{DynamicResource Mention.Unlink}" />
        <Separator />
        <MenuItem Command="ApplicationCommands.Cut" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <MenuItem Command="ApplicationCommands.Copy" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <MenuItem Command="ApplicationCommands.Paste" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
    </ContextMenu>

    <Style x:Key="Theme.Mention.Line" TargetType="ItemsControl">
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="HasItems" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Mention.Sense" TargetType="TextBlock">
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Text" Value="{Binding PMentionChipSense}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PMentionChipSense}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="Theme.Mention.Chip">
        <Border Padding="10,4,5,4" Cursor="Arrow" Style="{DynamicResource Theme.Card.Badge}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Theme.Ink}" Text="{Binding PMentionChipWord}" />
                <TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Theme.Muted}" Text="&#8594;" />
                <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Accent}" Text="{Binding PMentionChipName}" />
                <TextBlock Style="{StaticResource Theme.Mention.Sense}" />
                <Button Width="16" Height="16" Margin="7,0,0,0" Padding="0" Command="{x:Static local:PMentionCommand.PMentionCommandUnlink}" CommandParameter="{Binding}" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Path
                                    Width="12"
                                    Height="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="{local:PIcon close, 12}"
                                    Fill="{DynamicResource Theme.Muted}"
                                    Stretch="None" />
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
