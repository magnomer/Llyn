<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn;component/UI/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PThemeInput.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PThemePronunciation.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PThemePlayback.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Accent.Tool" TargetType="Button" BasedOn="{StaticResource Theme.Playback.Action}">
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CommandParameter" Value="{Binding}" />
        <Setter Property="Content" Value="" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Path
                        Width="24"
                        Height="24"
                        Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Stretch="None" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Accent.Playback" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Tool}">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Tag" Value="{local:PIcon play, 24}" />
        <Setter Property="ToolTip" Value="{DynamicResource Downloader.Play}" />
        <Setter Property="Command" Value="{x:Static local:PAccentCommand.PAccentCommandPlayback}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PAccentItemAudio}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Accent.Phonetician" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Tool}">
        <Setter Property="Tag" Value="{local:PIcon lookup, 24}" />
        <Setter Property="ToolTip" Value="{DynamicResource Phonetician.Title}" />
        <Setter Property="Command" Value="{x:Static local:PAccentCommand.PAccentCommandNotation}" />
    </Style>

    <Style x:Key="Theme.Accent.Downloader" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Tool}">
        <Setter Property="Tag" Value="{local:PIcon download, 24}" />
        <Setter Property="ToolTip" Value="{DynamicResource Downloader.Title}" />
        <Setter Property="Command" Value="{x:Static local:PAccentCommand.PAccentCommandClip}" />
    </Style>

    <Style x:Key="Theme.Accent.Flag" TargetType="Image" BasedOn="{StaticResource Theme.Pronunciation.Flag}">
        <Setter Property="Source" Value="{Binding PAccentItemFlag}" />
    </Style>

    <Style x:Key="Theme.Accent.Label" TargetType="TextBlock" BasedOn="{StaticResource Theme.Pronunciation.Label}">
        <Setter Property="Text" Value="{Binding PAccentItemLabel}" />
    </Style>

    <Style x:Key="Theme.Accent.Measure" TargetType="TextBlock" BasedOn="{StaticResource Theme.Pronunciation.Measure}">
        <Setter Property="Text" Value="{Binding PAccentItemText}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PAccentItemText}" Value="">
                <Setter Property="Text" Value="{DynamicResource Input.Pronunciation}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Accent.Blank" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Visibility" Value="Hidden" />
    </Style>

    <Style x:Key="Theme.Accent.Control" TargetType="StackPanel">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="IsHitTestVisible" Value="True" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="IsHitTestVisible" Value="True" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Accent.Handle" TargetType="Button" BasedOn="{StaticResource Theme.Input.Action}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CommandParameter" Value="{Binding}" />
        <Setter Property="Content" Value="" />
    </Style>

    <Style x:Key="Theme.Accent.Addition" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Handle}">
        <Setter Property="Command" Value="{x:Static local:PAccentCommand.PAccentCommandAddition}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Path Width="12" Height="12" Data="{local:PIcon add, 12}" Fill="{StaticResource Theme.Accent}" Stretch="None" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Accent.Remove" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Handle}">
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Command" Value="{x:Static local:PAccentCommand.PAccentCommandRemoval}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Path Width="12" Height="12" Data="{local:PIcon remove, 12}" Fill="{StaticResource Theme.Muted}" Stretch="None" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Theme.Accent.Row">
        <Border Style="{StaticResource Theme.Pronunciation.Surface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReadingLabel" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource Theme.Pronunciation.Lead}">
                    <Image Style="{StaticResource Theme.Accent.Flag}" />
                    <TextBlock Style="{StaticResource Theme.Accent.Label}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Style="{StaticResource Theme.Pronunciation.Body}">
                    <TextBlock Style="{StaticResource Theme.Pronunciation.Bracket}" Text="{Binding PAccentItemOpener}" />
                    <Grid Style="{StaticResource Theme.Pronunciation.Cell}">
                        <TextBlock Style="{StaticResource Theme.Accent.Measure}" />
                        <TextBox Style="{StaticResource Theme.Pronunciation.Field}" Tag="{DynamicResource Input.Pronunciation}" Text="{Binding PAccentItemText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Theme.Pronunciation.Bracket}" Text="{Binding PAccentItemCloser}" />
                    <Button Style="{StaticResource Theme.Accent.Playback}" />
                    <Button Style="{StaticResource Theme.Accent.Phonetician}" />
                    <Button Style="{StaticResource Theme.Accent.Downloader}" />
                    <StackPanel Style="{StaticResource Theme.Accent.Control}">
                        <Button Style="{StaticResource Theme.Accent.Addition}" />
                        <Button Style="{StaticResource Theme.Accent.Remove}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Accent.Display">
        <Border Style="{StaticResource Theme.Pronunciation.Surface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReadingLabel" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource Theme.Pronunciation.Lead}">
                    <Image Style="{StaticResource Theme.Accent.Flag}" />
                    <TextBlock Style="{StaticResource Theme.Accent.Label}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Style="{StaticResource Theme.Pronunciation.Body}">
                    <TextBlock Style="{StaticResource Theme.Pronunciation.Bracket}" Text="{Binding PAccentItemOpener}" />
                    <TextBlock Style="{StaticResource Theme.Pronunciation.Text}" Text="{Binding PAccentItemText}" />
                    <TextBlock Style="{StaticResource Theme.Pronunciation.Bracket}" Text="{Binding PAccentItemCloser}" />
                    <Button Style="{StaticResource Theme.Accent.Playback}" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
