<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn;component/UI/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PThemeInput.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PThemePronunciation.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PThemePlayback.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Accent.Tool" TargetType="Button" BasedOn="{StaticResource Theme.Playback.Action}">
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CommandParameter" Value="{Binding}" />
        <Setter Property="Content" Value="" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Rectangle Width="13" Height="13" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform">
                                <VisualBrush.Visual>
                                    <svgc:SvgViewbox Width="13" Height="13" Source="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Accent.Playback" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Tool}">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Tag" Value="pack://application:,,,/Llyn;component/icons/play.svg" />
        <Setter Property="ToolTip" Value="{DynamicResource Downloader.Play}" />
        <Setter Property="Command" Value="{x:Static local:PAccentCommand.PAccentCommandPlayback}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PAccentItemAudio}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Accent.Transcriber" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Tool}">
        <Setter Property="Tag" Value="pack://application:,,,/Llyn;component/icons/magnifying-glass.svg" />
        <Setter Property="ToolTip" Value="{DynamicResource Transcriber.Title}" />
        <Setter Property="Command" Value="{x:Static local:PAccentCommand.PAccentCommandNotation}" />
    </Style>

    <Style x:Key="Theme.Accent.Downloader" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Tool}">
        <Setter Property="Tag" Value="pack://application:,,,/Llyn;component/icons/box-arrow-down.svg" />
        <Setter Property="ToolTip" Value="{DynamicResource Downloader.Title}" />
        <Setter Property="Command" Value="{x:Static local:PAccentCommand.PAccentCommandClip}" />
    </Style>

    <Style x:Key="Theme.Accent.Flag" TargetType="Image" BasedOn="{StaticResource Theme.Pronunciation.Flag}">
        <Setter Property="Source" Value="{Binding PAccentItemFlag}" />
    </Style>

    <Style x:Key="Theme.Accent.Label" TargetType="TextBlock" BasedOn="{StaticResource Theme.Pronunciation.Label}">
        <Setter Property="Text" Value="{Binding PAccentItemLabel}" />
    </Style>

    <Style x:Key="Theme.Accent.Measure" TargetType="TextBlock" BasedOn="{StaticResource Theme.Pronunciation.Measure}">
        <Setter Property="Text" Value="{Binding PAccentItemIpa}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PAccentItemIpa}" Value="">
                <Setter Property="Text" Value="{DynamicResource Input.Pronunciation}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Accent.Remove" TargetType="Button" BasedOn="{StaticResource Theme.Input.Action}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Command" Value="{x:Static local:PAccentCommand.PAccentCommandRemoval}" />
        <Setter Property="CommandParameter" Value="{Binding}" />
        <Setter Property="Content" Value="" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Path Width="7" Height="7" Data="M 0,0 L 7,7 M 7,0 L 0,7" Stroke="{StaticResource Theme.Muted}" StrokeEndLineCap="Round" StrokeThickness="1.4" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Theme.Accent.Row">
        <Border Style="{StaticResource Theme.Pronunciation.Surface}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Image Style="{StaticResource Theme.Accent.Flag}" />
                <TextBlock Style="{StaticResource Theme.Accent.Label}" />
                <TextBlock Style="{StaticResource Theme.Pronunciation.Bracket}" Text="[" />
                <Grid Margin="3,0">
                    <TextBlock Style="{StaticResource Theme.Accent.Measure}" />
                    <TextBox Style="{StaticResource Theme.Pronunciation.Field}" Tag="{DynamicResource Input.Pronunciation}" Text="{Binding PAccentItemIpa, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <TextBlock Style="{StaticResource Theme.Pronunciation.Bracket}" Text="]" />
                <Button Style="{StaticResource Theme.Accent.Playback}" />
                <Button Style="{StaticResource Theme.Accent.Transcriber}" />
                <Button Style="{StaticResource Theme.Accent.Downloader}" />
                <Button Style="{StaticResource Theme.Accent.Remove}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Accent.Display">
        <Border Style="{StaticResource Theme.Pronunciation.Surface}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Image Style="{StaticResource Theme.Accent.Flag}" />
                <TextBlock Style="{StaticResource Theme.Accent.Label}" />
                <TextBlock Style="{StaticResource Theme.Pronunciation.Bracket}" Text="[" />
                <TextBlock Style="{StaticResource Theme.Pronunciation.Text}" Text="{Binding PAccentItemIpa}" />
                <TextBlock Style="{StaticResource Theme.Pronunciation.Bracket}" Text="]" />
                <Button Style="{StaticResource Theme.Accent.Playback}" />
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
