<UserControl
    x:Class="Llyn.UIShell.PExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    IsVisibleChanged="PExampleHandle">

    <UserControl.Resources>
        <Style x:Key="Theme.Anthology.Meta" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="Theme.Display.Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        </Style>

        <Style x:Key="Theme.Display.Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Theme.Quotation.Row" TargetType="Button" BasedOn="{StaticResource Theme.Choice.Row}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <DataTemplate x:Key="Theme.Citation.Row">
            <TextBlock Margin="4,0" VerticalAlignment="Center" Text="{Binding PCitationItemName}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <Style x:Key="Theme.Citation.Item" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <DataTemplate x:Key="Theme.Tongue.Choice">
            <Button Height="31" Padding="12,0" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="PLanguageHandle" Foreground="{DynamicResource Theme.Ink}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="19" Height="14" VerticalAlignment="Center" Source="{Binding PTongueItemFlag}" Stretch="Uniform" />
                    <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontSize="13" Text="{Binding PTongueItemName}" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="PRank" Grid.Row="0" Grid.Column="0" Margin="0,0,20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ToggleButton
                x:Name="PRankBase"
                Grid.Column="0"
                Width="44"
                Height="44"
                Padding="0"
                ToolTip="{DynamicResource Rank.Title}">
                <ToggleButton.Style>
                    <Style BasedOn="{StaticResource Theme.Input.ToggleAction}" TargetType="ToggleButton">
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
                <Canvas Width="16" Height="13">
                    <Rectangle Canvas.Top="1" Width="16" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    <Rectangle Canvas.Top="6.2" Width="11" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    <Rectangle Canvas.Top="11.4" Width="6" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                </Canvas>
            </ToggleButton>
            <Popup
                x:Name="PRankMenu"
                Width="238"
                AllowsTransparency="True"
                IsOpen="{Binding IsChecked, ElementName=PRankBase, Mode=TwoWay}"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=PRankBase}"
                StaysOpen="False">
                <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                    <StackPanel>
                        <TextBlock Margin="10,7,10,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Rank.Title}" />
                        <RadioButton GroupName="PRankChoice" IsChecked="True" Click="PRankHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Text" Content="{DynamicResource Rank.Text}" />
                        <RadioButton GroupName="PRankChoice" Click="PRankHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Language" Content="{DynamicResource Rank.Language}" />
                        <RadioButton GroupName="PRankChoice" Click="PRankHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Source" Content="{DynamicResource Rank.Source}" />
                        <RadioButton GroupName="PRankChoice" Click="PRankHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Usage" Content="{DynamicResource Rank.Usage}" />
                    </StackPanel>
                </Border>
            </Popup>
            <TextBox
                x:Name="PQuery"
                Grid.Column="2"
                Height="44"
                Style="{StaticResource Theme.Input.Field}"
                Tag="{DynamicResource Example.Search}"
                TextChanged="PQueryHandle" />
        </Grid>

        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,18" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button
                x:Name="PExampleFresh"
                Height="44"
                Margin="0,0,8,0"
                Click="PExampleFreshHandle"
                Content="{DynamicResource Scribe.New}"
                Style="{StaticResource Theme.Input.Pill}" />
            <Button
                x:Name="PExampleScribe"
                Width="96"
                Height="44"
                Margin="0,0,8,0"
                Click="PExampleScribeHandle"
                Content="{DynamicResource Scribe.Edit}"
                IsEnabled="False"
                Style="{StaticResource Theme.Input.Pill}" />
            <Button Height="44" Margin="0,0,8,0" Content="{DynamicResource Scribe.Export}" Style="{StaticResource Theme.Input.Pill}" />
            <Button Height="44" Content="{DynamicResource Scribe.Print}" Style="{StaticResource Theme.Input.Pill}" />
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Margin="0,0,20,0" Style="{StaticResource Theme.Input.Card}">
            <Grid>
                <ScrollViewer Margin="10" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PAnthology">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,6" Click="PAnthologyHandle" Style="{StaticResource Theme.Choice.Row}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontSize="15" Text="{Binding PAnthologyItemText}" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                <Image Width="19" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" Source="{Binding PAnthologyItemFlag}" Stretch="Uniform" />
                                                <TextBlock Style="{StaticResource Theme.Anthology.Meta}" Text="{Binding PAnthologyItemLanguage}" />
                                                <TextBlock MaxWidth="150" Margin="9,0,0,0" Style="{StaticResource Theme.Anthology.Meta}" Text="{Binding PAnthologyItemSource}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="1" Margin="10,0,0,0" Padding="8,2" VerticalAlignment="Center" Background="{StaticResource Theme.AccentSoft}" CornerRadius="7">
                                            <TextBlock FontSize="11" Foreground="{StaticResource Theme.Accent}" Text="{Binding PAnthologyItemCount}" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock
                    x:Name="PAnthologyEmpty"
                    Margin="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Foreground="{StaticResource Theme.Muted}"
                    IsHitTestVisible="False"
                    Text="{DynamicResource Example.Empty}"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" ClipToBounds="True" Style="{StaticResource Theme.Input.Card}">
            <Grid>
                <Grid x:Name="PExcerpt">
                    <ScrollViewer Padding="24,22,24,20" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PExcerptBody" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Theme.Display.Label}" Text="{DynamicResource Example.Language}" />
                            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                <Image x:Name="PExcerptFlag" Width="19" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" Stretch="Uniform" />
                                <TextBlock x:Name="PExcerptLanguage" Style="{StaticResource Theme.Display.Value}" />
                            </StackPanel>

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Display.Label}" Text="{DynamicResource Example.Text}" />
                            <TextBlock x:Name="PExcerptText" Margin="0,5,0,0" FontSize="20" TextWrapping="Wrap" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Display.Label}" Text="{DynamicResource Example.Translation}" />
                            <TextBlock x:Name="PExcerptTranslation" Margin="0,5,0,0" Style="{StaticResource Theme.Display.Value}" TextWrapping="Wrap" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Display.Label}" Text="{DynamicResource Reference.Title}" />
                            <TextBlock x:Name="PExcerptCitation" Margin="0,5,0,0" Style="{StaticResource Theme.Display.Value}" />

                            <TextBlock Margin="0,26,0,10" Style="{StaticResource Theme.Display.Label}" Text="{DynamicResource Example.Usage}" />
                            <ItemsControl x:Name="PQuotation">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="PQuotationHandle" Style="{StaticResource Theme.Quotation.Row}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding PUsageItemHeadword}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Theme.Accent}" Text="{Binding PUsageItemOwner}" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource Theme.Muted}" Text="{Binding PUsageItemTitle}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                                    <Image Width="19" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" Source="{Binding PUsageItemFlag}" Stretch="Uniform" />
                                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Theme.Muted}" Text="{Binding PUsageItemLanguage}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock
                                x:Name="PQuotationEmpty"
                                Margin="0,2,0,0"
                                Foreground="{StaticResource Theme.Muted}"
                                Text="{DynamicResource Example.UsageEmpty}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock
                        x:Name="PExcerptUnselected"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Theme.Muted}"
                        IsHitTestVisible="False"
                        Text="{DynamicResource Example.Unselected}"
                        TextWrapping="Wrap" />
                </Grid>

                <Grid x:Name="PTranscript" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Padding="24,22,24,10" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Example.Language}" />
                            <Grid Margin="0,7,0,0" HorizontalAlignment="Left">
                                <ToggleButton
                                    x:Name="PLanguage"
                                    MinWidth="220"
                                    Height="44"
                                    Padding="12,0"
                                    HorizontalContentAlignment="Stretch"
                                    Style="{StaticResource Theme.Input.ToggleAction}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image x:Name="PLanguageFlag" Width="19" Height="14" VerticalAlignment="Center" Stretch="Uniform" />
                                        <TextBlock x:Name="PLanguageName" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </ToggleButton>
                                <Popup
                                    x:Name="PTongue"
                                    Width="238"
                                    AllowsTransparency="True"
                                    IsOpen="{Binding IsChecked, ElementName=PLanguage, Mode=TwoWay}"
                                    Placement="Bottom"
                                    PlacementTarget="{Binding ElementName=PLanguage}"
                                    StaysOpen="False">
                                    <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                                        <ItemsControl x:Name="PTongueList" ItemTemplate="{StaticResource Theme.Tongue.Choice}" />
                                    </Border>
                                </Popup>
                            </Grid>

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Example.Text}" />
                            <TextBox
                                x:Name="PTranscriptText"
                                MinHeight="88"
                                Margin="0,7,0,0"
                                Padding="12,9"
                                AcceptsReturn="True"
                                Style="{StaticResource Theme.Input.Field}"
                                TextChanged="PTranscriptTextHandle"
                                TextWrapping="Wrap"
                                VerticalContentAlignment="Top" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Example.Translation}" />
                            <TextBox
                                x:Name="PTranscriptTranslation"
                                MinHeight="88"
                                Margin="0,7,0,0"
                                Padding="12,9"
                                AcceptsReturn="True"
                                Style="{StaticResource Theme.Input.Field}"
                                TextChanged="PTranscriptTranslationHandle"
                                TextWrapping="Wrap"
                                VerticalContentAlignment="Top" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Reference.Title}" />
                            <Grid Margin="0,7,0,0" HorizontalAlignment="Left">
                                <ToggleButton
                                    x:Name="PCitation"
                                    MinWidth="220"
                                    Height="44"
                                    Padding="12,0"
                                    Foreground="{StaticResource Theme.Accent}"
                                    Style="{StaticResource Theme.Input.ToggleAction}">
                                    <TextBlock x:Name="PCitationName" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" />
                                </ToggleButton>
                                <Popup
                                    x:Name="PCitationMenu"
                                    Width="264"
                                    AllowsTransparency="True"
                                    IsOpen="{Binding IsChecked, ElementName=PCitation, Mode=TwoWay}"
                                    Placement="Bottom"
                                    PlacementTarget="{Binding ElementName=PCitation}"
                                    StaysOpen="False">
                                    <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Theme.Popup.Title}" Text="{DynamicResource Reference.Title}" />
                                            <TextBlock
                                                x:Name="PCitationEmpty"
                                                Margin="10,5,10,9"
                                                FontSize="12"
                                                Foreground="{StaticResource Theme.Muted}"
                                                Text="{DynamicResource Reference.Empty}"
                                                Visibility="Collapsed" />
                                            <ListBox
                                                x:Name="PCitationList"
                                                MaxHeight="220"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                IsSynchronizedWithCurrentItem="False"
                                                ItemContainerStyle="{StaticResource Theme.Citation.Item}"
                                                ItemTemplate="{StaticResource Theme.Citation.Row}"
                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                SelectedValuePath="PCitationItemId"
                                                SelectionChanged="PCitationHandle" />
                                            <Button
                                                x:Name="PCitationNone"
                                                Height="31"
                                                Padding="12,0"
                                                HorizontalContentAlignment="Left"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="PCitationClearHandle"
                                                Foreground="{StaticResource Theme.Muted}">
                                                <TextBlock VerticalAlignment="Center" FontSize="13" Text="{DynamicResource Reference.None}" />
                                            </Button>
                                            <Grid Margin="10,6,10,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    x:Name="PCitationDraft"
                                                    Height="31"
                                                    Padding="10,4"
                                                    Style="{StaticResource Theme.Input.Field}"
                                                    Tag="{DynamicResource Reference.Name}" />
                                                <Button
                                                    x:Name="PCitationFresh"
                                                    Grid.Column="1"
                                                    Height="31"
                                                    Margin="6,0,0,0"
                                                    Padding="12,0"
                                                    Click="PCitationFreshHandle"
                                                    Content="{DynamicResource Reference.Add}"
                                                    Style="{StaticResource Theme.Input.Pill}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="24,10,24,20" HorizontalAlignment="Right" Orientation="Horizontal">
                        <TextBlock x:Name="PTranscriptCount" Margin="0,0,14,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Theme.Muted}" />
                        <Button
                            x:Name="PTranscriptRemoval"
                            Height="44"
                            Margin="0,0,8,0"
                            Click="PTranscriptRemovalHandle"
                            Content="{DynamicResource Example.Delete}"
                            IsEnabled="False"
                            Style="{StaticResource Theme.Input.Pill}" />
                        <Button
                            x:Name="PTranscriptDiscard"
                            Height="44"
                            Margin="0,0,8,0"
                            Click="PTranscriptDiscardHandle"
                            Content="{DynamicResource Example.Discard}"
                            Style="{StaticResource Theme.Input.Pill}" />
                        <Button
                            x:Name="PTranscriptStore"
                            Height="44"
                            Click="PTranscriptStoreHandle"
                            Content="{DynamicResource Example.Store}"
                            Style="{StaticResource Theme.Input.Primary}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
