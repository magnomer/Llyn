<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    x:Class="Llyn.UIShell.PClipTemplate">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn;component/UI/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PThemePopup.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Clip.Preview" TargetType="Button" BasedOn="{StaticResource Theme.Popup.IconAction}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PSurface" Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PSurface" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
            </Trigger>
            <DataTrigger Binding="{Binding PClipReadingRefused}" Value="True">
                <Setter Property="Background" Value="{StaticResource Theme.Warning}" />
                <Setter Property="Foreground" Value="{StaticResource Theme.Surface}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding PClipReadingFetching}" Value="True">
                <Setter Property="Background" Value="{StaticResource Theme.Pending}" />
                <Setter Property="Foreground" Value="{StaticResource Theme.Surface}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding PClipReadingPlaying}" Value="True">
                <Setter Property="Background" Value="{StaticResource Theme.Accent}" />
                <Setter Property="Foreground" Value="{StaticResource Theme.Surface}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="Theme.Clip.Reading">
        <Grid Margin="0,3,6,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, StringFormat=PClipColumn{0}}" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Image x:Name="PClipReadingFlag" Width="19" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Source="{Binding PClipReadingFlag}" Stretch="Uniform" ToolTip="{Binding PClipReadingLabel}" />
                <TextBlock x:Name="PClipReadingLabel" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Theme.Muted}" Text="{Binding PClipReadingLabel}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PClipReadingFlag}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PClipReadingLabel}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button x:Name="PClipPreview" Margin="0,0,2,0" VerticalAlignment="Center" Click="PClipPreviewHandle" Style="{StaticResource Theme.Clip.Preview}" ToolTip="{DynamicResource Downloader.Play}">
                    <Path Width="24" Height="24" Data="{local:PIcon play, 24}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="None" />
                </Button>
                <Button x:Name="PClipSelector" VerticalAlignment="Center" Click="PClipSelectorHandle" Content="{Binding PClipReadingAction}" IsEnabled="{Binding PClipReadingReady}" Style="{DynamicResource Theme.Popup.RowChoice}" />
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding PClipReadingFlag}" Value="{x:Null}">
                <Setter TargetName="PClipReadingFlag" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Clip.Row">
        <Border x:Name="PClipRow" Style="{DynamicResource Theme.Popup.RowSurface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PClipOption" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Theme.Muted}" Text="{Binding PClipItemSource}" TextTrimming="CharacterEllipsis" />
                <ItemsControl x:Name="PClipReadingList" Grid.Column="1" AlternationCount="8" Margin="4,0,10,0" VerticalAlignment="Center" ItemTemplate="{DynamicResource Theme.Clip.Reading}" ItemsSource="{Binding PClipItemReading}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="PClipNote" Grid.Column="1" Margin="4,0,10,0" VerticalAlignment="Center" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource Theme.Muted}" Text="{Binding PClipItemNotice}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding PClipItemReady}" Value="False">
                <Setter TargetName="PClipReadingList" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PClipNote" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
