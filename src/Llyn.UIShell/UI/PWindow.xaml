<Window
    x:Class="Llyn.UIShell.PWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
    Title="{DynamicResource Terms.Product}"
    Width="1485"
    Height="1001"
    MinWidth="980"
    MinHeight="700"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Theme.Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="PRoof"
                Grid.Row="0"
                Background="{StaticResource Theme.Roof}"
                MouseLeftButtonDown="PRoofHandle">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="PBrand" Grid.Column="0" Margin="18,0,0,0" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="PLogo" Width="34" Height="34" VerticalAlignment="Center">
                        <Border Background="{StaticResource Theme.Accent}" CornerRadius="10" />
                        <Path
                            Width="17"
                            Height="17"
                            Data="M 2,2 L 2,15 L 15,15 M 6,2 L 6,11 L 15,11"
                            Stretch="Fill"
                            Stroke="{StaticResource Theme.Ink}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeThickness="2.3" />
                        <Popup x:Name="PHeadquarter" Placement="Bottom" StaysOpen="False">
                            <Border Width="180" Margin="0,8,0,0" Padding="8" Background="{StaticResource Theme.SurfaceRaised}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock x:Name="PHeadquarterAbout" Padding="10,8" Text="{DynamicResource Headquarter.About}" />
                                    <TextBlock x:Name="PHeadquarterExit" Padding="10,8" Foreground="{StaticResource Theme.Warning}" Text="{DynamicResource Headquarter.Exit}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <TextBlock x:Name="PHeadline" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="{DynamicResource Terms.Product}" />
                </Grid>

                <StackPanel x:Name="PCaption" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="PCaptionMinimize" Click="PCaptionMinimizeHandle" Style="{StaticResource Theme.Caption.Button}" ToolTip="{DynamicResource Caption.Minimize}">
                        <Path Width="10" Data="M 0,0 L 10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                    <Button x:Name="PCaptionMaximize" Click="PCaptionMaximizeHandle" Style="{StaticResource Theme.Caption.Button}" ToolTip="{DynamicResource Caption.Maximize}">
                        <Rectangle Width="10" Height="9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                    <Button x:Name="PCaptionExit" Click="PCaptionExitHandle" Style="{StaticResource Theme.Caption.Close}" ToolTip="{DynamicResource Caption.Close}">
                        <Path Width="10" Height="10" Data="M 0,0 L 10,10 M 10,0 L 0,10" Stretch="Fill" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="PHouse" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource Theme.Navigation}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="0,1,1,0">
                    <Grid x:Name="PNavigation">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <Button x:Name="PNavigationInput" Style="{StaticResource Theme.Navigation.Selected}" Content="{DynamicResource Navigation.Input}" Click="PNavigationHandle" />
                            <Button x:Name="PNavigationList" Style="{StaticResource Theme.Navigation.Button}" Content="{DynamicResource Navigation.List}" Click="PNavigationHandle" />
                            <Button x:Name="PNavigationSound" Style="{StaticResource Theme.Navigation.Button}" Content="{DynamicResource Navigation.Sound}" Click="PNavigationHandle" />
                            <Button x:Name="PNavigationTag" Style="{StaticResource Theme.Navigation.Button}" Content="{DynamicResource Navigation.Tag}" Click="PNavigationHandle" />
                            <Button x:Name="PNavigationSituation" Style="{StaticResource Theme.Navigation.Button}" Content="{DynamicResource Navigation.Situation}" Click="PNavigationHandle" />
                            <Button x:Name="PNavigationFavorite" Style="{StaticResource Theme.Navigation.Button}" Content="{DynamicResource Navigation.Favorite}" Click="PNavigationHandle" />
                            <Button x:Name="PNavigationDuplex" Style="{StaticResource Theme.Navigation.Button}" Content="{DynamicResource Navigation.DualPanel}" Click="PNavigationHandle" />
                        </StackPanel>

                        <Button x:Name="PNavigationSettings" Grid.Row="1" Margin="12,8,12,16" Style="{StaticResource Theme.Navigation.Button}" Content="{DynamicResource Navigation.Settings}" Click="PNavigationHandle" />
                    </Grid>
                </Border>

                <Grid x:Name="PPanel" Grid.Column="1" Background="{StaticResource Theme.Surface}">
                    <Grid x:Name="PInput" Margin="34,20,34,38">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Height="51" Margin="9,0,-8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Margin="0,0,16,0">
                                <TextBlock Margin="0,0,4,0" FontSize="40" FontWeight="Bold" Opacity="0" IsHitTestVisible="False" Text="Headword">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=PHeadword}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="0,0,4,0" FontSize="40" FontWeight="Bold" Opacity="0" IsHitTestVisible="False" Text="{Binding Text, ElementName=PHeadword}" />
                                <TextBox x:Name="PHeadword" HorizontalAlignment="Stretch" Style="{StaticResource Theme.Input.Headword}" Tag="Headword" />
                            </Grid>

                            <Grid x:Name="PLangcode" Grid.Column="1">
                                <ToggleButton
                                    x:Name="PLangcodeBase"
                                    Width="170"
                                    Height="41"
                                    Padding="17,0"
                                    HorizontalContentAlignment="Stretch"
                                    Background="{StaticResource Theme.Surface}"
                                    BorderBrush="{StaticResource Theme.Line}"
                                    BorderThickness="1"
                                    Style="{StaticResource Theme.Input.TogglePill}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="19" Height="14" VerticalAlignment="Center">
                                            <Image x:Name="PLangcodeBaseFlag" Stretch="Uniform" />
                                            <Ellipse x:Name="PLangcodeBaseGlobe" Width="12" Height="12" Stroke="{StaticResource Theme.Muted}" StrokeThickness="1.2" />
                                        </Grid>
                                        <TextBlock x:Name="PLangcodeBaseName" Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontSize="13" Text="English" />
                                        <Path Grid.Column="2" Width="8" Height="4" Data="M 0,0 L 4,3 L 8,0" Stroke="{StaticResource Theme.Muted}" StrokeThickness="1.5" />
                                    </Grid>
                                </ToggleButton>
                                <Popup
                                    x:Name="PLangcodeList"
                                    Width="170"
                                    Margin="0,5,0,0"
                                    AllowsTransparency="True"
                                    IsOpen="{Binding IsChecked, ElementName=PLangcodeBase}"
                                    Placement="Bottom"
                                    PlacementTarget="{Binding ElementName=PLangcodeBase}"
                                    StaysOpen="False">
                                    <Border Padding="5" Background="White" BorderBrush="{StaticResource Theme.Line}" BorderThickness="1" CornerRadius="8">
                                        <ItemsControl x:Name="PLangcodeListMenu">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Height="31" Padding="12,0" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="PLangcodeHandle" Foreground="{StaticResource Theme.Ink}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Width="19" Height="14" VerticalAlignment="Center">
                                                                <Image Source="{Binding PLangcodeItemFlag}" Stretch="Uniform" />
                                                                <Ellipse Width="12" Height="12" Stroke="{StaticResource Theme.Muted}" StrokeThickness="1.2">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding PLangcodeItemFlag}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                            </Grid>
                                                            <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontSize="13" Text="{Binding PLangcodeItemName}" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Popup>
                            </Grid>

                            <Button x:Name="PDiscard" Grid.Column="3" Width="144" Height="51" Margin="0,0,14,0" Style="{StaticResource Theme.Input.Pill}">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Phosphor trash.svg. SvgViewbox has no foreground of its own, so the
                                         glyph is used as an opacity mask over the button's foreground. -->
                                    <Rectangle Width="14" Height="16" Margin="0,0,9,0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                        <Rectangle.OpacityMask>
                                            <VisualBrush Stretch="Uniform">
                                                <VisualBrush.Visual>
                                                    <svgc:SvgViewbox Width="14" Height="16" Source="icons/trash.svg" />
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <TextBlock VerticalAlignment="Center" Text="Discard" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PStore" Grid.Column="4" Width="162" Height="51" Style="{StaticResource Theme.Input.Primary}">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Phosphor floppy-disk.svg, tinted through an opacity mask (see PDiscard). -->
                                    <Rectangle Width="15" Height="15" Margin="0,0,9,0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                        <Rectangle.OpacityMask>
                                            <VisualBrush Stretch="Uniform">
                                                <VisualBrush.Visual>
                                                    <svgc:SvgViewbox Width="15" Height="15" Source="icons/floppy-disk.svg" />
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <TextBlock VerticalAlignment="Center" Text="Save entry" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" Height="49" Margin="9,20,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Height="49" MaxWidth="360" HorizontalAlignment="Left" Background="{StaticResource Theme.AccentSoft}" BorderBrush="{StaticResource Theme.AccentSoft}" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Text="[" />
                                    <TextBox x:Name="PPronunciation" Grid.Column="1" MaxWidth="292" MinHeight="40" Padding="4,0" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" FontSize="15" Foreground="{StaticResource Theme.Ink}" Style="{StaticResource Theme.Input.Field}" Tag="Pronunciation" VerticalContentAlignment="Center" />
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Text="]" />
                                </Grid>
                            </Border>

                            <Button x:Name="PPlayback" Grid.Column="1" Width="50" Height="49" Margin="14,0,0,0" Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Line}" Foreground="{StaticResource Theme.Accent}" Click="PPlaybackHandle" Style="{StaticResource Theme.Input.Action}" Visibility="Collapsed">
                                <!-- Phosphor play.svg, tinted through an opacity mask (see PDiscard). -->
                                <Rectangle Width="13" Height="15" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                    <Rectangle.OpacityMask>
                                        <VisualBrush Stretch="Uniform">
                                            <VisualBrush.Visual>
                                                <svgc:SvgViewbox Width="13" Height="15" Source="icons/play.svg" />
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Button>

                            <Grid Grid.Column="2" Margin="14,0,0,0">
                                <ToggleButton x:Name="PLookup" Width="50" Height="49" Padding="0" Foreground="{StaticResource Theme.Accent}" Checked="PLookupCheckedHandle" Unchecked="PLookupUncheckedHandle" Style="{StaticResource Theme.Input.ToggleAction}">
                                    <!-- Phosphor magnifying-glass.svg, tinted through an opacity mask (see PDiscard). -->
                                    <Rectangle Width="15" Height="15" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
                                        <Rectangle.OpacityMask>
                                            <VisualBrush Stretch="Uniform">
                                                <VisualBrush.Visual>
                                                    <svgc:SvgViewbox Width="15" Height="15" Source="icons/magnifying-glass.svg" />
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </ToggleButton>
                                <Popup
                                    x:Name="PLookupMenu"
                                    Width="328"
                                    Margin="0,6,0,0"
                                    AllowsTransparency="True"
                                    IsOpen="{Binding IsChecked, ElementName=PLookup}"
                                    Placement="Bottom"
                                    PlacementTarget="{Binding ElementName=PLookup}"
                                    StaysOpen="False">
                                    <Border Margin="8" Padding="8" Background="{StaticResource Theme.SurfaceRaised}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="1" CornerRadius="13">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="22" Direction="270" Opacity="0.18" ShadowDepth="7" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <Grid Margin="8,6,8,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30" Background="{StaticResource Theme.AccentSoft}" CornerRadius="8">
                                                    <Path Width="13" Height="13" Data="M 5.5,1 A 4.5,4.5 0 1 0 5.5,10 A 4.5,4.5 0 1 0 5.5,1 M 9,9 L 13,13" Stretch="Fill" Stroke="{StaticResource Theme.Accent}" StrokeEndLineCap="Round" StrokeThickness="1.5" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Theme.Ink}" Text="{DynamicResource Lookup.Title}" />
                                            </Grid>
                                            <Border x:Name="PLookupStatusCard" Margin="4,5" Padding="12,11" Background="{StaticResource Theme.Surface}" CornerRadius="9" Visibility="Collapsed">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock x:Name="PLookupMenuStatus" VerticalAlignment="Center" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Lookup.Searching}" />
                                                    <Border x:Name="PLookupProgress" Grid.Row="1" Height="3" Margin="0,10,0,0" Background="{StaticResource Theme.AccentSoft}" ClipToBounds="True" CornerRadius="2">
                                                        <Border Width="86" HorizontalAlignment="Left" Background="{StaticResource Theme.Accent}" CornerRadius="2">
                                                            <Border.RenderTransform>
                                                                <TranslateTransform X="-86" />
                                                            </Border.RenderTransform>
                                                            <Border.Triggers>
                                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="-86" To="276" Duration="0:0:1.15" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </Border.Triggers>
                                                        </Border>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ScrollViewer MaxHeight="286" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl x:Name="PLookupMenuList" Visibility="Collapsed">
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Margin="4,3" Click="PLookupMenuHandle" Style="{StaticResource Theme.Popup.Row}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock FontSize="11" Foreground="{StaticResource Theme.Muted}" Text="{Binding PLookupCandidateSource}" />
                                                                        <TextBlock x:Name="PLookupMenuItem" Margin="0,3,0,0" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Theme.Ink}" Text="{Binding PLookupCandidatePhonetic}" TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Margin="12,0,2,0" VerticalAlignment="Center" Orientation="Horizontal">
                                                                        <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Theme.Accent}" Text="{DynamicResource Lookup.Select}" />
                                                                        <Path Width="5" Height="9" Margin="7,0,0,0" Data="M 0,0 L 4,4.5 L 0,9" Stretch="Fill" Stroke="{StaticResource Theme.Accent}" StrokeLineJoin="Round" StrokeThickness="1.4" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>

                            <Grid Grid.Column="3" Margin="14,0,0,0">
                                <ToggleButton x:Name="PDownloader" Width="50" Height="49" Foreground="{StaticResource Theme.Accent}" Checked="PDownloaderCheckedHandle" Unchecked="PDownloaderUncheckedHandle" Style="{StaticResource Theme.Input.ToggleAction}">
                                    <!-- Phosphor box-arrow-down.svg, tinted through an opacity mask (see PDiscard). -->
                                    <Rectangle Width="15" Height="15" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
                                        <Rectangle.OpacityMask>
                                            <VisualBrush Stretch="Uniform">
                                                <VisualBrush.Visual>
                                                    <svgc:SvgViewbox Width="15" Height="15" Source="icons/box-arrow-down.svg" />
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </ToggleButton>
                                <Popup
                                    x:Name="PDownloaderMenu"
                                    Width="352"
                                    Margin="0,6,0,0"
                                    AllowsTransparency="True"
                                    IsOpen="{Binding IsChecked, ElementName=PDownloader}"
                                    Placement="Bottom"
                                    PlacementTarget="{Binding ElementName=PDownloader}"
                                    StaysOpen="False">
                                    <Border Margin="8" Padding="8" Background="{StaticResource Theme.SurfaceRaised}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="1" CornerRadius="13">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="22" Direction="270" Opacity="0.18" ShadowDepth="7" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <Grid Margin="8,6,8,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30" Background="{StaticResource Theme.AccentSoft}" CornerRadius="8">
                                                    <Path Width="13" Height="13" Data="M 6.5,0 L 6.5,8 M 3,5 L 6.5,8.5 L 10,5 M 1,11.5 L 12,11.5" Stretch="Fill" Stroke="{StaticResource Theme.Accent}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeThickness="1.5" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Theme.Ink}" Text="{DynamicResource Downloader.Title}" />
                                            </Grid>
                                            <Border x:Name="PDownloaderStatusCard" Margin="4,5" Padding="12,11" Background="{StaticResource Theme.Surface}" CornerRadius="9" Visibility="Collapsed">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock x:Name="PDownloaderMenuStatus" VerticalAlignment="Center" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Downloader.Searching}" />
                                                    <Border x:Name="PDownloaderProgress" Grid.Row="1" Height="3" Margin="0,10,0,0" Background="{StaticResource Theme.AccentSoft}" ClipToBounds="True" CornerRadius="2">
                                                        <Border Width="92" HorizontalAlignment="Left" Background="{StaticResource Theme.Accent}" CornerRadius="2">
                                                            <Border.RenderTransform>
                                                                <TranslateTransform X="-92" />
                                                            </Border.RenderTransform>
                                                            <Border.Triggers>
                                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="-92" To="300" Duration="0:0:1.15" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </Border.Triggers>
                                                        </Border>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ScrollViewer MaxHeight="286" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl x:Name="PDownloaderMenuList" Visibility="Collapsed">
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="4,3" Padding="10" Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="1" CornerRadius="10">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Theme.Ink}" Text="{Binding PDownloaderRecordingSource}" TextTrimming="CharacterEllipsis" />
                                                                    <Button Grid.Column="1" Margin="0,0,7,0" Click="PDownloaderPlayHandle" Style="{StaticResource Theme.Popup.IconAction}" ToolTip="{DynamicResource Downloader.Play}">
                                                                        <Path Width="9" Height="11" Data="M 1,1 L 8,5.5 L 1,10 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Fill" />
                                                                    </Button>
                                                                    <Button Grid.Column="2" Click="PDownloaderMenuHandle" Content="{DynamicResource Downloader.Apply}" Style="{StaticResource Theme.Popup.PrimaryAction}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>

                        <Border Grid.Row="2" Margin="-34,20,-34,0" BorderBrush="{StaticResource Theme.Line}" BorderThickness="0,0,0,1">
                            <StackPanel x:Name="PStack" Margin="29,0,0,0" Orientation="Horizontal">
                                <Button x:Name="PStackMeaning" Content="Meaning" Click="PStackHandle" Style="{StaticResource Theme.Input.Tab.Selected}" />
                                <Button x:Name="PStackCollocation" Content="Collocation" Click="PStackHandle" Style="{StaticResource Theme.Input.Tab}" />
                                <Button x:Name="PStackNote" Content="Note" Click="PStackHandle" Style="{StaticResource Theme.Input.Tab}" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="PContents" Grid.Row="3" Padding="0,22,0,0" Background="Transparent">
                            <Grid>
                                <ScrollViewer x:Name="PMeaning" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <ItemsControl x:Name="PSenseList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,15" Style="{StaticResource Theme.Input.Card}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="55" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <Border
                                                                Background="{StaticResource Theme.Surface}"
                                                                BorderBrush="{StaticResource Theme.Line}"
                                                                BorderThickness="0,0,0,1"
                                                                CornerRadius="12,12,0,0"
                                                                PreviewMouseLeftButtonDown="PCardPressHandle">
                                                                <Grid Margin="14,0,10,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="38" />
                                                                        <ColumnDefinition Width="34" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="38" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <UniformGrid Width="13" Height="19" HorizontalAlignment="Left" VerticalAlignment="Center" Columns="2" Rows="3" Cursor="SizeNS">
                                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Theme.Muted}" />
                                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Theme.Muted}" />
                                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Theme.Muted}" />
                                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Theme.Muted}" />
                                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Theme.Muted}" />
                                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Theme.Muted}" />
                                                                    </UniformGrid>
                                                                    <Border Grid.Column="1" Width="28" Height="28" Background="{StaticResource Theme.AccentSoft}" CornerRadius="14">
                                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Theme.Accent}" FontWeight="SemiBold" Text="{Binding PInputCardOrder}" />
                                                                    </Border>
                                                                    <TextBox
                                                                        Grid.Column="2"
                                                                        Margin="23,0,8,0"
                                                                        Padding="0"
                                                                        VerticalAlignment="Center"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        FontSize="16"
                                                                        FontWeight="SemiBold"
                                                                        Style="{StaticResource Theme.Input.Field}"
                                                                        Tag="{Binding PInputCardTitle}"
                                                                        Text="{Binding PTitle, UpdateSourceTrigger=PropertyChanged}" />
                                                                    <Button Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Right" Click="PCardHandle" Style="{StaticResource Theme.Input.Action}" BorderThickness="0" Background="Transparent">
                                                                        <Path Width="12" Height="12" Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{StaticResource Theme.Muted}" StrokeEndLineCap="Round" StrokeThickness="1.5" />
                                                                    </Button>
                                                                </Grid>
                                                            </Border>

                                                            <Grid Grid.Row="1" Margin="40,25,40,25">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="133" />
                                                                    <RowDefinition Height="61" />
                                                                    <RowDefinition Height="61" />
                                                                    <RowDefinition Height="61" />
                                                                    <RowDefinition Height="42" />
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="96" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <Grid Grid.ColumnSpan="2">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="26" />
                                                                        <RowDefinition Height="89" />
                                                                        <RowDefinition Height="18" />
                                                                    </Grid.RowDefinitions>
                                                                    <TextBlock VerticalAlignment="Top" Style="{StaticResource Theme.Input.Label}" Text="Definition" />
                                                                    <TextBox Grid.Row="1" Height="89" AcceptsReturn="True" Style="{StaticResource Theme.Input.Field}" Tag="Write a clear definition" Text="{Binding PInputCardDefinition, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                                                                </Grid>

                                                                <TextBlock Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Label}" Text="Example" />
                                                                <Grid Grid.Row="1" Grid.Column="1" Height="42" VerticalAlignment="Top">
                                                                    <TextBox Height="42" Padding="12,7,72,7" Style="{StaticResource Theme.Input.Field}" Tag="Add an example sentence" Text="{Binding PInputCardExample, UpdateSourceTrigger=PropertyChanged}" />
                                                                    <StackPanel Margin="0,0,13,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" IsHitTestVisible="False">
                                                                        <Path Width="13" Height="13" Margin="0,0,14,0" Data="M 5,2 L 2,2 L 2,11 L 11,11 L 11,8 M 7,1 L 12,1 L 12,6 M 6,7 L 12,1" Stroke="{StaticResource Theme.Accent}" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeLineJoin="Round" StrokeThickness="1.3" />
                                                                        <Path Width="5" Height="9" Data="M 0,0 L 4,4.5 L 0,9" Stroke="{StaticResource Theme.Muted}" StrokeThickness="1.2" />
                                                                    </StackPanel>
                                                                </Grid>

                                                                <TextBlock Grid.Row="2" Margin="0,10,0,0" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Label}" Text="Situation" />
                                                                <Grid Grid.Row="2" Grid.Column="1" Height="42" VerticalAlignment="Top">
                                                                    <TextBox Height="42" Padding="12,7,72,7" Style="{StaticResource Theme.Input.Field}" Tag="Where or when is it used?" Text="{Binding PInputCardSituation, UpdateSourceTrigger=PropertyChanged}" />
                                                                    <StackPanel Margin="0,0,13,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" IsHitTestVisible="False">
                                                                        <Path Width="13" Height="16" Margin="0,0,14,0" Data="M 6.5,15 C 5,12 2,9 2,6.5 A 4.5,4.5 0 1 1 11,6.5 C 11,9 8,12 6.5,15 M 6.5,4.5 A 2,2 0 1 0 6.5,8.5 A 2,2 0 1 0 6.5,4.5" Stroke="{StaticResource Theme.Accent}" StrokeThickness="1.2" />
                                                                        <Path Width="5" Height="9" Data="M 0,0 L 4,4.5 L 0,9" Stroke="{StaticResource Theme.Muted}" StrokeThickness="1.2" />
                                                                    </StackPanel>
                                                                </Grid>

                                                                <TextBlock Grid.Row="3" Margin="0,10,0,0" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Label}" Text="Synonym" />
                                                                <Grid Grid.Row="3" Grid.Column="1" Height="42" VerticalAlignment="Top">
                                                                    <TextBox Height="42" Padding="12,7,72,7" Style="{StaticResource Theme.Input.Field}" Tag="Add a related word" Text="{Binding PInputCardSynonym, UpdateSourceTrigger=PropertyChanged}" />
                                                                    <StackPanel Margin="0,0,13,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" IsHitTestVisible="False">
                                                                        <Path Width="14" Height="14" Margin="0,0,14,0" Data="M 6,9 L 4,11 A 3,3 0 0 1 0,7 L 3,4 A 3,3 0 0 1 7,4 M 8,5 L 10,3 A 3,3 0 0 1 14,7 L 11,10 A 3,3 0 0 1 7,10 M 5,8 L 9,6" Stroke="{StaticResource Theme.Accent}" StrokeEndLineCap="Round" StrokeThickness="1.2" />
                                                                        <Path Width="5" Height="9" Data="M 0,0 L 4,4.5 L 0,9" Stroke="{StaticResource Theme.Muted}" StrokeThickness="1.2" />
                                                                    </StackPanel>
                                                                </Grid>

                                                                <TextBlock Grid.Row="4" Margin="0,10,0,0" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Label}" Text="Tags" />
                                                                <Grid Grid.Row="4" Grid.Column="1" Height="42" VerticalAlignment="Top">
                                                                    <TextBox Height="42" Padding="12,7,72,7" Style="{StaticResource Theme.Input.Field}" Tag="Add tags" Text="{Binding PInputCardTag, UpdateSourceTrigger=PropertyChanged}" />
                                                                    <StackPanel Margin="0,0,13,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" IsHitTestVisible="False">
                                                                        <Path Width="15" Height="14" Margin="0,0,14,0" Data="M 1,2 L 8,2 L 14,8 L 8,14 L 1,14 Z M 5,6 A 1.2,1.2 0 1 0 5,8.4 A 1.2,1.2 0 1 0 5,6" Stretch="Fill" Stroke="{StaticResource Theme.Accent}" StrokeLineJoin="Round" StrokeThickness="1.2" />
                                                                        <Path Width="5" Height="9" Data="M 0,0 L 4,4.5 L 0,9" Stroke="{StaticResource Theme.Muted}" StrokeThickness="1.2" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Height="56" Margin="0,20,0,0" Foreground="{StaticResource Theme.Accent}" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" Click="PSenseHandle">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="20" Height="20" Margin="0,0,9,0" Background="{StaticResource Theme.Accent}" CornerRadius="10">
                                                    <Grid>
                                                        <Rectangle Width="10" Height="1.5" Fill="White" />
                                                        <Rectangle Width="1.5" Height="10" Fill="White" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Theme.Accent}" Text="Add another sense" />
                                            </StackPanel>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Background="Transparent">
                                                        <Rectangle RadiusX="10" RadiusY="10" Stroke="{StaticResource Theme.Accent}" StrokeDashArray="5,3" StrokeThickness="1" Opacity="0.52" />
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </ScrollViewer>

                                <ScrollViewer x:Name="PCollocation" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                    <StackPanel>
                                        <ItemsControl x:Name="PCollocationList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="391" Margin="0,0,0,15" Style="{StaticResource Theme.Input.Card}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="55" />
                                                                <RowDefinition Height="336" />
                                                            </Grid.RowDefinitions>
                                                            <Border
                                                                Background="{StaticResource Theme.Surface}"
                                                                BorderBrush="{StaticResource Theme.Line}"
                                                                BorderThickness="0,0,0,1"
                                                                CornerRadius="12,12,0,0"
                                                                PreviewMouseLeftButtonDown="PCardPressHandle">
                                                                <Grid Margin="14,0,10,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="38" />
                                                                        <ColumnDefinition Width="34" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="38" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <UniformGrid Width="13" Height="19" HorizontalAlignment="Left" VerticalAlignment="Center" Columns="2" Rows="3" Cursor="SizeNS">
                                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Theme.Muted}" />
                                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Theme.Muted}" />
                                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Theme.Muted}" />
                                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Theme.Muted}" />
                                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Theme.Muted}" />
                                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Theme.Muted}" />
                                                                    </UniformGrid>
                                                                    <Border Grid.Column="1" Width="28" Height="28" Background="{StaticResource Theme.AccentSoft}" CornerRadius="14">
                                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Theme.Accent}" FontWeight="SemiBold" Text="{Binding PInputCardOrder}" />
                                                                    </Border>
                                                                    <TextBox
                                                                        Grid.Column="2"
                                                                        Margin="23,0,8,0"
                                                                        Padding="0"
                                                                        VerticalAlignment="Center"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        FontSize="16"
                                                                        FontWeight="SemiBold"
                                                                        Style="{StaticResource Theme.Input.Field}"
                                                                        Tag="{Binding PInputCardTitle}"
                                                                        Text="{Binding PTitle, UpdateSourceTrigger=PropertyChanged}" />
                                                                    <Button Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Right" Click="PCardHandle" Style="{StaticResource Theme.Input.Action}" BorderThickness="0" Background="Transparent">
                                                                        <Path Width="12" Height="12" Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{StaticResource Theme.Muted}" StrokeEndLineCap="Round" StrokeThickness="1.5" />
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                            <Grid Grid.Row="1" Margin="40,25,40,25">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="61" />
                                                                    <RowDefinition Height="61" />
                                                                    <RowDefinition Height="61" />
                                                                    <RowDefinition Height="61" />
                                                                    <RowDefinition Height="42" />
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="142" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Margin="0,10,0,0" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Label}" Text="Expression" />
                                                                <TextBox Grid.Column="1" Height="42" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Field}" Tag="Add a word combination" Text="{Binding PInputCardExpression, UpdateSourceTrigger=PropertyChanged}" />
                                                                <TextBlock Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Label}" Text="Meaning" />
                                                                <TextBox Grid.Row="1" Grid.Column="1" Height="42" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Field}" Tag="Explain what it means" Text="{Binding PInputCardDefinition, UpdateSourceTrigger=PropertyChanged}" />
                                                                <TextBlock Grid.Row="2" Margin="0,10,0,0" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Label}" Text="Example" />
                                                                <TextBox Grid.Row="2" Grid.Column="1" Height="42" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Field}" Tag="Add an example sentence" Text="{Binding PInputCardExample, UpdateSourceTrigger=PropertyChanged}" />
                                                                <TextBlock Grid.Row="3" Margin="0,10,0,0" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Label}" Text="Situation" />
                                                                <TextBox Grid.Row="3" Grid.Column="1" Height="42" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Field}" Tag="Where or when is it used?" Text="{Binding PInputCardSituation, UpdateSourceTrigger=PropertyChanged}" />
                                                                <TextBlock Grid.Row="4" Margin="0,10,0,0" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Label}" Text="Tags" />
                                                                <TextBox Grid.Row="4" Grid.Column="1" Height="42" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Field}" Tag="Add tags" Text="{Binding PInputCardTag, UpdateSourceTrigger=PropertyChanged}" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Height="56" Margin="0,20,0,0" Foreground="{StaticResource Theme.Accent}" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" Click="PCollocationHandle">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="20" Height="20" Margin="0,0,9,0" Background="{StaticResource Theme.Accent}" CornerRadius="10">
                                                    <Grid>
                                                        <Rectangle Width="10" Height="1.5" Fill="White" />
                                                        <Rectangle Width="1.5" Height="10" Fill="White" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Theme.Accent}" Text="Add another collocation" />
                                            </StackPanel>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Background="Transparent">
                                                        <Rectangle RadiusX="10" RadiusY="10" Stroke="{StaticResource Theme.Accent}" StrokeDashArray="5,3" StrokeThickness="1" Opacity="0.52" />
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </ScrollViewer>

                                <Border x:Name="PNote" VerticalAlignment="Stretch" Style="{StaticResource Theme.Input.Card}" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="55" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                                            <TextBlock Margin="22,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Note" />
                                        </Border>
                                        <Border Grid.Row="1" Margin="22,18,22,22" Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="1" CornerRadius="7">
                                            <Grid>
                                                <TextBlock x:Name="PNotePlaceholder" Margin="14,12" Foreground="{StaticResource Theme.Muted}" IsHitTestVisible="False" Opacity="0.56" Text="Write a note about this entry" />
                                                <RichTextBox x:Name="PNoteContents" Padding="10,6" VerticalAlignment="Stretch" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" TextChanged="PNoteContentsHandle" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="PList" Visibility="Collapsed" />
                    <Grid x:Name="PSound" Visibility="Collapsed" />
                    <Grid x:Name="PTag" Visibility="Collapsed" />
                    <Grid x:Name="PSituation" Visibility="Collapsed" />
                    <Grid x:Name="PFavorite" Visibility="Collapsed" />
                    <Grid x:Name="PDuplex" Visibility="Collapsed" />
                    <Grid x:Name="PSettings" Visibility="Collapsed">
                        <StackPanel Margin="32" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{DynamicResource Settings.Localization}" />
                            <ComboBox x:Name="PLocalization" Width="240" Margin="0,12,0,0" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectionChanged="PLocalizationHandle">
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="한국어" Tag="ko" />
                            </ComboBox>

                            <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,28,0,0" Text="{DynamicResource Settings.Workspace}" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBox x:Name="PWorkspacePath" Width="360" VerticalContentAlignment="Center" LostKeyboardFocus="PWorkspacePathHandle" />
                                <Button x:Name="PWorkspaceBrowse" Margin="8,0,0,0" Padding="12,4" Content="{DynamicResource Workspace.Browse}" Click="PWorkspaceBrowseHandle" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

        </Grid>
    </Border>
</Window>
