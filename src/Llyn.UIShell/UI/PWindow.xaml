<Window
    x:Class="Llyn.UIShell.PWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="{DynamicResource Terms.Product}"
    Width="1485"
    Height="1001"
    MinWidth="980"
    MinHeight="700"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Theme.Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="PRoof"
                Grid.Row="0"
                Background="{StaticResource Theme.Roof}"
                MouseLeftButtonDown="PRoofHandle">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="PBrand" Grid.Column="0" Margin="18,0,0,0" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="PLogo" Width="34" Height="34" VerticalAlignment="Center">
                        <Border Background="{StaticResource Theme.Accent}" CornerRadius="10" />
                        <Path
                            Width="17"
                            Height="17"
                            Data="M 2,2 L 2,15 L 15,15 M 6,2 L 6,11 L 15,11"
                            Stretch="Fill"
                            Stroke="{StaticResource Theme.Ink}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeThickness="2.3" />
                        <Popup x:Name="PHeadquarter" Placement="Bottom" StaysOpen="False">
                            <Border Width="180" Margin="0,8,0,0" Padding="8" Background="{StaticResource Theme.SurfaceRaised}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock x:Name="PHeadquarterAbout" Padding="10,8" Text="{DynamicResource Headquarter.About}" />
                                    <TextBlock x:Name="PHeadquarterExit" Padding="10,8" Foreground="{StaticResource Theme.Warning}" Text="{DynamicResource Headquarter.Exit}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <TextBlock x:Name="PHeadline" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="{DynamicResource Terms.Product}" />
                </Grid>

                <StackPanel x:Name="PCaption" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="PCaptionMinimize" Click="PCaptionMinimizeHandle" Style="{StaticResource Theme.Caption.Button}" ToolTip="{DynamicResource Caption.Minimize}">
                        <Path Width="10" Data="M 0,0 L 10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                    <Button x:Name="PCaptionMaximize" Click="PCaptionMaximizeHandle" Style="{StaticResource Theme.Caption.Button}" ToolTip="{DynamicResource Caption.Maximize}">
                        <Rectangle Width="10" Height="9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                    <Button x:Name="PCaptionExit" Click="PCaptionExitHandle" Style="{StaticResource Theme.Caption.Close}" ToolTip="{DynamicResource Caption.Close}">
                        <Path Width="10" Height="10" Data="M 0,0 L 10,10 M 10,0 L 0,10" Stretch="Fill" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="PHouse" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource Theme.Navigation}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="0,1,1,0">
                    <Grid x:Name="PNavigation">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <Button x:Name="PNavigationInput" Style="{StaticResource Theme.Navigation.Selected}" Content="{DynamicResource Navigation.Input}" Click="PNavigationHandle" />
                            <Button x:Name="PNavigationList" Style="{StaticResource Theme.Navigation.Button}" Content="{DynamicResource Navigation.List}" Click="PNavigationHandle" />
                            <Button x:Name="PNavigationSound" Style="{StaticResource Theme.Navigation.Button}" Content="{DynamicResource Navigation.Sound}" Click="PNavigationHandle" />
                            <Button x:Name="PNavigationTag" Style="{StaticResource Theme.Navigation.Button}" Content="{DynamicResource Navigation.Tag}" Click="PNavigationHandle" />
                            <Button x:Name="PNavigationSituation" Style="{StaticResource Theme.Navigation.Button}" Content="{DynamicResource Navigation.Situation}" Click="PNavigationHandle" />
                            <Button x:Name="PNavigationFavorite" Style="{StaticResource Theme.Navigation.Button}" Content="{DynamicResource Navigation.Favorite}" Click="PNavigationHandle" />
                            <Button x:Name="PNavigationDuplex" Style="{StaticResource Theme.Navigation.Button}" Content="{DynamicResource Navigation.DualPanel}" Click="PNavigationHandle" />
                        </StackPanel>

                        <Button x:Name="PNavigationSettings" Grid.Row="1" Margin="12,8,12,16" Style="{StaticResource Theme.Navigation.Button}" Content="{DynamicResource Navigation.Settings}" Click="PNavigationHandle" />
                    </Grid>
                </Border>

                <Grid x:Name="PPanel" Grid.Column="1" Background="{StaticResource Theme.Surface}">
                    <Grid x:Name="PInput" Margin="34,20,34,38">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Height="51" Margin="9,0,-8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Margin="0,0,16,0">
                                <TextBlock Margin="0,0,4,0" FontSize="40" FontWeight="Bold" Opacity="0" IsHitTestVisible="False" Text="Headword">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=PHeadword}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="0,0,4,0" FontSize="40" FontWeight="Bold" Opacity="0" IsHitTestVisible="False" Text="{Binding Text, ElementName=PHeadword}" />
                                <TextBox x:Name="PHeadword" HorizontalAlignment="Stretch" Style="{StaticResource Theme.Input.Headword}" Tag="Headword" />
                            </Grid>

                            <Grid x:Name="PLangcode" Grid.Column="1">
                                <ToggleButton
                                    x:Name="PLangcodeBase"
                                    Width="170"
                                    Height="41"
                                    Padding="17,0"
                                    HorizontalContentAlignment="Stretch"
                                    Background="{StaticResource Theme.Surface}"
                                    BorderBrush="{StaticResource Theme.Line}"
                                    BorderThickness="1"
                                    Style="{StaticResource Theme.Input.TogglePill}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="19" Height="14" VerticalAlignment="Center">
                                            <Image x:Name="PLangcodeBaseFlag" Stretch="Uniform" />
                                            <Ellipse x:Name="PLangcodeBaseGlobe" Width="12" Height="12" Stroke="{StaticResource Theme.Muted}" StrokeThickness="1.2" />
                                        </Grid>
                                        <TextBlock x:Name="PLangcodeBaseName" Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontSize="13" Text="English" />
                                        <Path Grid.Column="2" Width="8" Height="4" Data="M 0,0 L 4,3 L 8,0" Stroke="{StaticResource Theme.Muted}" StrokeThickness="1.5" />
                                    </Grid>
                                </ToggleButton>
                                <Popup
                                    x:Name="PLangcodeList"
                                    Width="170"
                                    Margin="0,5,0,0"
                                    AllowsTransparency="True"
                                    IsOpen="{Binding IsChecked, ElementName=PLangcodeBase}"
                                    Placement="Bottom"
                                    PlacementTarget="{Binding ElementName=PLangcodeBase}"
                                    StaysOpen="False">
                                    <Border Padding="5" Background="{StaticResource Theme.SurfaceRaised}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="1" CornerRadius="8">
                                        <ItemsControl x:Name="PLangcodeListMenu">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Height="31" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="PLangcodeHandle" Content="{Binding}" Foreground="{StaticResource Theme.Ink}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Popup>
                            </Grid>

                            <Button x:Name="PDiscard" Grid.Column="3" Width="144" Height="51" Margin="0,0,14,0" Style="{StaticResource Theme.Input.Pill}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="16" Margin="0,0,9,0" Data="M 2,4 L 12,4 M 5,4 L 5,2 L 9,2 L 9,4 M 3,4 L 4,15 L 10,15 L 11,4" Stretch="Fill" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeLineJoin="Round" StrokeThickness="1.4" />
                                    <TextBlock VerticalAlignment="Center" Text="Discard" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PStore" Grid.Column="4" Width="162" Height="51" Style="{StaticResource Theme.Input.Primary}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="15" Height="15" Margin="0,0,9,0" Data="M 1,1 L 12,1 L 14,3 L 14,14 L 1,14 Z M 4,1 L 4,6 L 11,6 L 11,1 M 4,10 L 11,10 L 11,14 L 4,14 Z" Stretch="Fill" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeLineJoin="Round" StrokeThickness="1.3" />
                                    <TextBlock VerticalAlignment="Center" Foreground="White" Text="Save entry" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" Height="49" Margin="9,20,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Height="49" Background="{StaticResource Theme.AccentSoft}" BorderBrush="{StaticResource Theme.AccentSoft}" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="16" Text="[" />
                                    <TextBox x:Name="PPronunciation" Grid.Column="1" MinHeight="40" Padding="6,0" Background="Transparent" BorderThickness="0" FontSize="15" Foreground="{StaticResource Theme.Ink}" Style="{StaticResource Theme.Input.Field}" Tag="Pronunciation" VerticalContentAlignment="Center" />
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Text="]" />
                                </Grid>
                            </Border>

                            <Button x:Name="PPlayback" Grid.Column="1" Width="56" Height="49" Margin="13,0,0,0" Background="{StaticResource Theme.AccentSoft}" BorderBrush="{StaticResource Theme.AccentSoft}" Foreground="{StaticResource Theme.Accent}" Style="{StaticResource Theme.Input.Action}">
                                <Path Width="13" Height="15" Data="M 1,1 L 12,7.5 L 1,14 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Fill" />
                            </Button>

                            <Grid Grid.Column="2" Margin="15,0,0,0">
                                <ToggleButton x:Name="PLookup" Width="136" Height="49" Padding="16,0" Checked="PLookupCheckedHandle" Unchecked="PLookupUncheckedHandle" Style="{StaticResource Theme.Input.ToggleAction}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Path Width="15" Height="15" Data="M 6.5,1 A 5.5,5.5 0 1 0 6.5,12 A 5.5,5.5 0 1 0 6.5,1 M 10.5,10.5 L 15,15" Stretch="Fill" Stroke="{StaticResource Theme.Muted}" StrokeEndLineCap="Round" StrokeThickness="1.5" />
                                        <TextBlock Grid.Column="1" Margin="9,0" VerticalAlignment="Center" Text="Lookup" />
                                        <Path Grid.Column="2" Width="8" Height="5" Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource Theme.Muted}" StrokeThickness="1.4" />
                                    </Grid>
                                </ToggleButton>
                                <Popup
                                    x:Name="PLookupMenu"
                                    Width="280"
                                    Margin="0,6,0,0"
                                    AllowsTransparency="True"
                                    IsOpen="{Binding IsChecked, ElementName=PLookup}"
                                    Placement="Bottom"
                                    PlacementTarget="{Binding ElementName=PLookup}"
                                    StaysOpen="False">
                                    <Border Padding="7" Background="{StaticResource Theme.SurfaceRaised}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="1" CornerRadius="9">
                                        <StackPanel>
                                            <TextBlock x:Name="PLookupMenuStatus" Margin="9,8" VerticalAlignment="Center" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Lookup.Searching}" Visibility="Collapsed" />
                                            <ItemsControl x:Name="PLookupMenuList" Visibility="Collapsed">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Height="36">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Margin="2,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding PLookupCandidateSource}" />
                                                            <TextBlock x:Name="PLookupMenuItem" Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Foreground="{StaticResource Theme.Ink}" Text="{Binding PLookupCandidatePhonetic}" TextTrimming="CharacterEllipsis" />
                                                            <RadioButton x:Name="PLookupMenuSelector" Grid.Column="2" VerticalAlignment="Center" Click="PLookupMenuHandle" Content="{DynamicResource Lookup.Select}" GroupName="PLookupMenuSelector" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>

                            <Grid Grid.Column="3" Margin="14,0,0,0">
                                <ToggleButton x:Name="PDownloader" Width="50" Height="49" Checked="PDownloaderCheckedHandle" Unchecked="PDownloaderUncheckedHandle" Style="{StaticResource Theme.Input.ToggleAction}">
                                    <Path Width="15" Height="15" Data="M 7.5,1 L 7.5,10 M 3.5,6 L 7.5,10 L 11.5,6 M 1,13.5 L 14,13.5" Stretch="Fill" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeThickness="1.5" />
                                </ToggleButton>
                                <Popup
                                    x:Name="PDownloaderMenu"
                                    Width="300"
                                    Margin="0,6,0,0"
                                    AllowsTransparency="True"
                                    IsOpen="{Binding IsChecked, ElementName=PDownloader}"
                                    Placement="Bottom"
                                    PlacementTarget="{Binding ElementName=PDownloader}"
                                    StaysOpen="False">
                                    <Border Padding="7" Background="{StaticResource Theme.SurfaceRaised}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="1" CornerRadius="9">
                                        <StackPanel>
                                            <TextBlock x:Name="PDownloaderMenuStatus" Margin="9,8" VerticalAlignment="Center" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Downloader.Searching}" Visibility="Collapsed" />
                                            <ItemsControl x:Name="PDownloaderMenuList" Visibility="Collapsed">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Height="36">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Margin="2,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Theme.Ink}" Text="{Binding PDownloaderRecordingSource}" TextTrimming="CharacterEllipsis" />
                                                            <Button Grid.Column="1" Margin="6,0" VerticalAlignment="Center" Click="PDownloaderPlayHandle" Content="{DynamicResource Downloader.Play}" />
                                                            <Button Grid.Column="2" VerticalAlignment="Center" Click="PDownloaderMenuHandle" Content="{DynamicResource Downloader.Apply}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>

                        <Border Grid.Row="2" Margin="-34,20,-34,0" BorderBrush="{StaticResource Theme.Line}" BorderThickness="0,0,0,1">
                            <StackPanel x:Name="PStack" Margin="29,0,0,0" Orientation="Horizontal">
                                <Button x:Name="PStackMeaning" Content="Meaning" Click="PStackHandle" Style="{StaticResource Theme.Input.Tab.Selected}" />
                                <Button x:Name="PStackCollocation" Content="Collocation" Click="PStackHandle" Style="{StaticResource Theme.Input.Tab}" />
                                <Button x:Name="PStackNote" Content="Note" Click="PStackHandle" Style="{StaticResource Theme.Input.Tab}" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="PContents" Grid.Row="3" Padding="0,22,0,0" Background="Transparent">
                            <Grid>
                                <ScrollViewer x:Name="PMeaning" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                    <StackPanel>
                                        <ItemsControl x:Name="PSenseList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="471" Margin="0,0,0,15" Style="{StaticResource Theme.Input.Card}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="55" />
                                                                <RowDefinition Height="416" />
                                                            </Grid.RowDefinitions>

                                                            <Border Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                                                                <Grid Margin="14,0,10,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="38" />
                                                                        <ColumnDefinition Width="34" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="38" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <UniformGrid Width="13" Height="19" HorizontalAlignment="Left" VerticalAlignment="Center" Columns="2" Rows="3">
                                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Theme.Muted}" />
                                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Theme.Muted}" />
                                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Theme.Muted}" />
                                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Theme.Muted}" />
                                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Theme.Muted}" />
                                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Theme.Muted}" />
                                                                    </UniformGrid>
                                                                    <Border Grid.Column="1" Width="28" Height="28" Background="{StaticResource Theme.AccentSoft}" CornerRadius="14">
                                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Theme.Accent}" FontWeight="SemiBold" Text="{Binding PInputCardOrder}" />
                                                                    </Border>
                                                                    <TextBlock Grid.Column="2" Margin="23,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{Binding PInputCardTitle}" />
                                                                    <Button Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Right" Click="PCardHandle" Style="{StaticResource Theme.Input.Action}" BorderThickness="0" Background="Transparent">
                                                                        <Path Width="12" Height="12" Data="M 1,1 L 11,11 M 11,1 L 1,11" Stretch="Fill" Stroke="{StaticResource Theme.Muted}" StrokeEndLineCap="Round" StrokeThickness="1.5" />
                                                                    </Button>
                                                                </Grid>
                                                            </Border>

                                                            <Grid Grid.Row="1" Margin="22,13,22,20">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="133" />
                                                                    <RowDefinition Height="75" />
                                                                    <RowDefinition Height="61" />
                                                                    <RowDefinition Height="61" />
                                                                    <RowDefinition Height="52" />
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="142" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <Grid Grid.ColumnSpan="2">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="26" />
                                                                        <RowDefinition Height="89" />
                                                                        <RowDefinition Height="18" />
                                                                    </Grid.RowDefinitions>
                                                                    <TextBlock VerticalAlignment="Top" Style="{StaticResource Theme.Input.Label}" Text="Definition" />
                                                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                                                                        <TextBlock Margin="10,0" Foreground="{StaticResource Theme.Muted}" FontWeight="Bold" Text="B" />
                                                                        <TextBlock Margin="10,0" Foreground="{StaticResource Theme.Muted}" FontStyle="Italic" Text="I" />
                                                                        <Path Width="14" Height="12" Margin="10,0" Data="M 1,2 L 3,2 M 6,2 L 13,2 M 1,6 L 3,6 M 6,6 L 13,6 M 1,10 L 3,10 M 6,10 L 13,10" Stroke="{StaticResource Theme.Muted}" StrokeEndLineCap="Round" StrokeThickness="1.4" />
                                                                        <Path Width="15" Height="15" Margin="10,0" Data="M 6,10 L 4,12 A 3,3 0 0 1 0,8 L 3,5 A 3,3 0 0 1 7,5 M 9,5 L 11,3 A 3,3 0 0 1 15,7 L 12,10 A 3,3 0 0 1 8,10 M 5,8 L 10,7" Stretch="Fill" Stroke="{StaticResource Theme.Muted}" StrokeEndLineCap="Round" StrokeThickness="1.3" />
                                                                        <Path Width="14" Height="14" Margin="10,0,2,0" Data="M 1,5 L 1,1 L 5,1 M 9,1 L 13,1 L 13,5 M 13,9 L 13,13 L 9,13 M 5,13 L 1,13 L 1,9" Stroke="{StaticResource Theme.Muted}" StrokeThickness="1.3" />
                                                                    </StackPanel>
                                                                    <TextBox Grid.Row="1" Height="89" AcceptsReturn="True" Style="{StaticResource Theme.Input.Field}" Tag="Write a clear definition" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                                                                </Grid>

                                                                <TextBlock Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Label}" Text="Example" />
                                                                <Grid Grid.Row="1" Grid.Column="1" Height="42" VerticalAlignment="Top">
                                                                    <TextBox Height="42" Padding="12,7,72,7" Style="{StaticResource Theme.Input.Field}" Tag="Add an example sentence" />
                                                                    <StackPanel Margin="0,0,13,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" IsHitTestVisible="False">
                                                                        <Path Width="13" Height="13" Margin="0,0,14,0" Data="M 5,2 L 2,2 L 2,11 L 11,11 L 11,8 M 7,1 L 12,1 L 12,6 M 6,7 L 12,1" Stroke="{StaticResource Theme.Accent}" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeLineJoin="Round" StrokeThickness="1.3" />
                                                                        <Path Width="5" Height="9" Data="M 0,0 L 4,4.5 L 0,9" Stroke="{StaticResource Theme.Muted}" StrokeThickness="1.2" />
                                                                    </StackPanel>
                                                                </Grid>

                                                                <TextBlock Grid.Row="2" Margin="0,10,0,0" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Label}" Text="Situation" />
                                                                <Grid Grid.Row="2" Grid.Column="1" Height="42" VerticalAlignment="Top">
                                                                    <TextBox Height="42" Padding="12,7,72,7" Style="{StaticResource Theme.Input.Field}" Tag="Where or when is it used?" />
                                                                    <StackPanel Margin="0,0,13,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" IsHitTestVisible="False">
                                                                        <Path Width="13" Height="16" Margin="0,0,14,0" Data="M 6.5,15 C 5,12 2,9 2,6.5 A 4.5,4.5 0 1 1 11,6.5 C 11,9 8,12 6.5,15 M 6.5,4.5 A 2,2 0 1 0 6.5,8.5 A 2,2 0 1 0 6.5,4.5" Stroke="{StaticResource Theme.Accent}" StrokeThickness="1.2" />
                                                                        <Path Width="5" Height="9" Data="M 0,0 L 4,4.5 L 0,9" Stroke="{StaticResource Theme.Muted}" StrokeThickness="1.2" />
                                                                    </StackPanel>
                                                                </Grid>

                                                                <TextBlock Grid.Row="3" Margin="0,10,0,0" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Label}" Text="Synonym" />
                                                                <Grid Grid.Row="3" Grid.Column="1" Height="42" VerticalAlignment="Top">
                                                                    <TextBox Height="42" Padding="12,7,72,7" Style="{StaticResource Theme.Input.Field}" Tag="Add a related word" />
                                                                    <StackPanel Margin="0,0,13,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" IsHitTestVisible="False">
                                                                        <Path Width="14" Height="14" Margin="0,0,14,0" Data="M 6,9 L 4,11 A 3,3 0 0 1 0,7 L 3,4 A 3,3 0 0 1 7,4 M 8,5 L 10,3 A 3,3 0 0 1 14,7 L 11,10 A 3,3 0 0 1 7,10 M 5,8 L 9,6" Stroke="{StaticResource Theme.Accent}" StrokeEndLineCap="Round" StrokeThickness="1.2" />
                                                                        <Path Width="5" Height="9" Data="M 0,0 L 4,4.5 L 0,9" Stroke="{StaticResource Theme.Muted}" StrokeThickness="1.2" />
                                                                    </StackPanel>
                                                                </Grid>

                                                                <TextBlock Grid.Row="4" Margin="0,14,0,0" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Label}" Text="Tags" />
                                                                <Grid Grid.Row="4" Grid.Column="1" Height="52">
                                                                    <TextBox Height="52" Padding="12,7,72,7" Style="{StaticResource Theme.Input.Field}" Tag="Add tags" />
                                                                    <StackPanel Margin="0,0,13,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" IsHitTestVisible="False">
                                                                        <Path Width="15" Height="14" Margin="0,0,14,0" Data="M 1,2 L 8,2 L 14,8 L 8,14 L 1,14 Z M 5,6 A 1.2,1.2 0 1 0 5,8.4 A 1.2,1.2 0 1 0 5,6" Stretch="Fill" Stroke="{StaticResource Theme.Accent}" StrokeLineJoin="Round" StrokeThickness="1.2" />
                                                                        <Path Width="5" Height="9" Data="M 0,0 L 4,4.5 L 0,9" Stroke="{StaticResource Theme.Muted}" StrokeThickness="1.2" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Height="56" Margin="0,20,0,0" Foreground="{StaticResource Theme.Accent}" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" Click="PSenseHandle">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="20" Height="20" Margin="0,0,9,0" Background="{StaticResource Theme.Accent}" CornerRadius="10">
                                                    <Grid>
                                                        <Rectangle Width="10" Height="1.5" Fill="White" />
                                                        <Rectangle Width="1.5" Height="10" Fill="White" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Theme.Accent}" Text="Add another sense" />
                                            </StackPanel>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Background="Transparent">
                                                        <Rectangle RadiusX="10" RadiusY="10" Stroke="{StaticResource Theme.Accent}" StrokeDashArray="5,3" StrokeThickness="1" Opacity="0.52" />
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </ScrollViewer>

                                <ScrollViewer x:Name="PCollocation" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
                                    <StackPanel>
                                        <ItemsControl x:Name="PCollocationList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="328" Margin="0,0,0,15" Style="{StaticResource Theme.Input.Card}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="55" />
                                                                <RowDefinition Height="273" />
                                                            </Grid.RowDefinitions>
                                                            <Border Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                                                                <Grid Margin="14,0,10,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="38" />
                                                                        <ColumnDefinition Width="34" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="38" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <UniformGrid Width="13" Height="19" HorizontalAlignment="Left" VerticalAlignment="Center" Columns="2" Rows="3">
                                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Theme.Muted}" />
                                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Theme.Muted}" />
                                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Theme.Muted}" />
                                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Theme.Muted}" />
                                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Theme.Muted}" />
                                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Theme.Muted}" />
                                                                    </UniformGrid>
                                                                    <Border Grid.Column="1" Width="28" Height="28" Background="{StaticResource Theme.AccentSoft}" CornerRadius="14">
                                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Theme.Accent}" FontWeight="SemiBold" Text="{Binding PInputCardOrder}" />
                                                                    </Border>
                                                                    <TextBlock Grid.Column="2" Margin="23,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{Binding PInputCardTitle}" />
                                                                    <Button Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Right" Click="PCardHandle" Style="{StaticResource Theme.Input.Action}" BorderThickness="0" Background="Transparent">
                                                                        <Path Width="12" Height="12" Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{StaticResource Theme.Muted}" StrokeEndLineCap="Round" StrokeThickness="1.5" />
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                            <Grid Grid.Row="1" Margin="22,14,22,15">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="61" />
                                                                    <RowDefinition Height="61" />
                                                                    <RowDefinition Height="61" />
                                                                    <RowDefinition Height="61" />
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="142" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Margin="0,10,0,0" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Label}" Text="Expression" />
                                                                <TextBox Grid.Column="1" Height="42" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Field}" Tag="Add a word combination" />
                                                                <TextBlock Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Label}" Text="Meaning" />
                                                                <TextBox Grid.Row="1" Grid.Column="1" Height="42" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Field}" Tag="Explain what it means" />
                                                                <TextBlock Grid.Row="2" Margin="0,10,0,0" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Label}" Text="Example" />
                                                                <TextBox Grid.Row="2" Grid.Column="1" Height="42" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Field}" Tag="Add an example sentence" />
                                                                <TextBlock Grid.Row="3" Margin="0,10,0,0" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Label}" Text="Tags" />
                                                                <TextBox Grid.Row="3" Grid.Column="1" Height="42" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Field}" Tag="Add tags" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Height="56" Margin="0,20,0,0" Foreground="{StaticResource Theme.Accent}" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" Click="PCollocationHandle">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="20" Height="20" Margin="0,0,9,0" Background="{StaticResource Theme.Accent}" CornerRadius="10">
                                                    <Grid>
                                                        <Rectangle Width="10" Height="1.5" Fill="White" />
                                                        <Rectangle Width="1.5" Height="10" Fill="White" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Theme.Accent}" Text="Add another collocation" />
                                            </StackPanel>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Background="Transparent">
                                                        <Rectangle RadiusX="10" RadiusY="10" Stroke="{StaticResource Theme.Accent}" StrokeDashArray="5,3" StrokeThickness="1" Opacity="0.52" />
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </ScrollViewer>

                                <Border x:Name="PNote" Height="360" Style="{StaticResource Theme.Input.Card}" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="55" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                                            <TextBlock Margin="22,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Note" />
                                        </Border>
                                        <Border Grid.Row="1" Margin="22,18,22,22" Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="1" CornerRadius="7">
                                            <Grid>
                                                <TextBlock x:Name="PNotePlaceholder" Margin="14,12" Foreground="{StaticResource Theme.Muted}" IsHitTestVisible="False" Opacity="0.56" Text="Write a note about this entry" />
                                                <RichTextBox x:Name="PNoteContents" Padding="10,6" Background="Transparent" BorderThickness="0" TextChanged="PNoteContentsHandle" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="PList" Visibility="Collapsed" />
                    <Grid x:Name="PSound" Visibility="Collapsed" />
                    <Grid x:Name="PTag" Visibility="Collapsed" />
                    <Grid x:Name="PSituation" Visibility="Collapsed" />
                    <Grid x:Name="PFavorite" Visibility="Collapsed" />
                    <Grid x:Name="PDuplex" Visibility="Collapsed" />
                    <Grid x:Name="PSettings" Visibility="Collapsed">
                        <StackPanel Margin="32" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{DynamicResource Settings.Localization}" />
                            <ComboBox x:Name="PLocalization" Width="240" Margin="0,12,0,0" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectionChanged="PLocalizationHandle">
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="한국어" Tag="ko" />
                            </ComboBox>

                            <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,28,0,0" Text="{DynamicResource Settings.Workspace}" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBox x:Name="PWorkspacePath" Width="360" VerticalContentAlignment="Center" LostKeyboardFocus="PWorkspacePathHandle" />
                                <Button x:Name="PWorkspaceBrowse" Margin="8,0,0,0" Padding="12,4" Content="{DynamicResource Workspace.Browse}" Click="PWorkspaceBrowseHandle" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

        </Grid>
    </Border>
</Window>
