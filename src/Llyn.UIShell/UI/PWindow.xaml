<Window
    x:Class="Llyn.UIShell.PWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:local="clr-namespace:Llyn.UIShell"
    Title="{DynamicResource Terms.Product}"
    Icon="pack://application:,,,/brand/icon.ico"
    Width="1485"
    Height="1001"
    MinWidth="1180"
    MinHeight="700"
    Style="{StaticResource {x:Type Window}}"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Theme.Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="PRoof"
                Grid.Row="0"
                Background="{StaticResource Theme.Roof}"
                MouseLeftButtonDown="PRoofHandle">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="PBrand" Grid.Column="0" Margin="18,0,0,0" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="PLogo" Width="34" Height="34" VerticalAlignment="Center" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="PLogoHandle">
                        <Image
                            Width="30"
                            Height="30"
                            VerticalAlignment="Center"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="pack://application:,,,/brand/icon.png"
                            Stretch="Uniform" />
                        <Popup x:Name="PHeadquarter" Placement="Bottom" StaysOpen="False">
                            <Border
                                Width="180"
                                Margin="0,8,0,0"
                                Padding="8"
                                Background="{StaticResource Theme.SurfaceRaised}"
                                BorderBrush="{StaticResource Theme.Line}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel>
                                    <TextBlock
                                        x:Name="PHeadquarterAbout"
                                        Padding="10,8"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="PHeadquarterAboutHandle"
                                        Text="{DynamicResource Headquarter.About}" />
                                    <TextBlock
                                        x:Name="PHeadquarterExit"
                                        Padding="10,8"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        Foreground="{StaticResource Theme.Warning}"
                                        MouseLeftButtonDown="PHeadquarterExitHandle"
                                        Text="{DynamicResource Headquarter.Exit}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <TextBlock x:Name="PHeadline" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="{DynamicResource Terms.Product}" />
                </Grid>

                <StackPanel x:Name="PCaption" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="PCaptionMinimize" Click="PCaptionMinimizeHandle" Style="{StaticResource Theme.Caption.Button}" ToolTip="{DynamicResource Caption.Minimize}">
                        <Path Width="10" Data="M 0,0 L 10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                    <Button x:Name="PCaptionMaximize" Click="PCaptionMaximizeHandle" Style="{StaticResource Theme.Caption.Button}" ToolTip="{DynamicResource Caption.Maximize}">
                        <Rectangle Width="10" Height="9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                    <Button x:Name="PCaptionExit" Click="PCaptionExitHandle" Style="{StaticResource Theme.Caption.Close}" ToolTip="{DynamicResource Caption.Close}">
                        <Path
                            Width="10"
                            Height="10"
                            Data="M 0,0 L 10,10 M 10,0 L 0,10"
                            Stretch="Fill"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="PHouse" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource Theme.Navigation}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="0,1,1,0">
                    <Grid x:Name="PNavigation">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <StackPanel x:Name="PVoyage" Margin="12,8,12,2" Orientation="Horizontal">
                                <Button x:Name="PVoyageBackward" Click="PVoyageHandle" IsEnabled="False" Style="{StaticResource Theme.Navigation.Voyage}" ToolTip="{DynamicResource Voyage.Retreat}">
                                    <Path Width="16" Height="16" Data="{local:PIcon earlier, 16}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="None" />
                                </Button>
                                <Button x:Name="PVoyageForward" Click="PVoyageHandle" IsEnabled="False" Style="{StaticResource Theme.Navigation.Voyage}" ToolTip="{DynamicResource Voyage.Advance}">
                                    <Path Width="16" Height="16" Data="{local:PIcon later, 16}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="None" />
                                </Button>
                            </StackPanel>
                            <local:PTab
                                x:Name="PNavigationInput"
                                Click="PNavigationHandle"
                                Content="{DynamicResource Navigation.Input}"
                                PTabChosen="True"
                                PTabFilled="{local:PIcon input-chosen, 24}"
                                PTabOutline="{local:PIcon input, 24}"
                                Style="{StaticResource Theme.Navigation.Tab}" />
                            <local:PTab
                                x:Name="PNavigationLibrary"
                                Click="PNavigationHandle"
                                Content="{DynamicResource Navigation.Library}"
                                PTabFilled="{local:PIcon library-chosen, 24}"
                                PTabOutline="{local:PIcon library, 24}"
                                Style="{StaticResource Theme.Navigation.Tab}" />
                            <local:PTab
                                x:Name="PNavigationFavorite"
                                Click="PNavigationHandle"
                                Content="{DynamicResource Navigation.Favorite}"
                                PTabFilled="{local:PIcon favorite-marked, 24}"
                                PTabOutline="{local:PIcon favorite, 24}"
                                Style="{StaticResource Theme.Navigation.Tab}" />
                            <Rectangle Style="{StaticResource Theme.Navigation.Gap}" />
                            <local:PTab
                                x:Name="PNavigationPhonology"
                                Click="PNavigationHandle"
                                Content="{DynamicResource Navigation.Phonology}"
                                PTabFilled="{local:PIcon phonology-chosen, 24}"
                                PTabOutline="{local:PIcon phonology, 24}"
                                Style="{StaticResource Theme.Navigation.Tab}" />
                            <local:PTab
                                x:Name="PNavigationRepertoire"
                                Click="PNavigationHandle"
                                Content="{DynamicResource Navigation.Repertoire}"
                                PTabFilled="{local:PIcon repertoire-chosen, 24}"
                                PTabOutline="{local:PIcon repertoire, 24}"
                                Style="{StaticResource Theme.Navigation.Tab}" />
                            <local:PTab
                                x:Name="PNavigationTenor"
                                Click="PNavigationHandle"
                                Content="{DynamicResource Navigation.Tenor}"
                                PTabFilled="{local:PIcon tenor-chosen, 24}"
                                PTabOutline="{local:PIcon tenor, 24}"
                                Style="{StaticResource Theme.Navigation.Tab}" />
                            <local:PTab
                                x:Name="PNavigationTaxonomy"
                                Click="PNavigationHandle"
                                Content="{DynamicResource Navigation.Taxonomy}"
                                PTabFilled="{local:PIcon taxonomy-chosen, 24}"
                                PTabOutline="{local:PIcon taxonomy, 24}"
                                Style="{StaticResource Theme.Navigation.Tab}" />
                            <Rectangle Style="{StaticResource Theme.Navigation.Gap}" />
                            <local:PTab
                                x:Name="PNavigationCorpus"
                                Click="PNavigationHandle"
                                Content="{DynamicResource Navigation.Corpus}"
                                PTabFilled="{local:PIcon corpus-chosen, 24}"
                                PTabOutline="{local:PIcon corpus, 24}"
                                Style="{StaticResource Theme.Navigation.Tab}" />
                            <local:PTab
                                x:Name="PNavigationSource"
                                Click="PNavigationHandle"
                                Content="{DynamicResource Navigation.Source}"
                                PTabFilled="{local:PIcon reference-chosen, 24}"
                                PTabOutline="{local:PIcon reference, 24}"
                                Style="{StaticResource Theme.Navigation.Tab}" />
                            <local:PTab
                                x:Name="PNavigationGuild"
                                Click="PNavigationHandle"
                                Content="{DynamicResource Navigation.Guild}"
                                PTabFilled="{local:PIcon guild-chosen, 24}"
                                PTabOutline="{local:PIcon guild, 24}"
                                Style="{StaticResource Theme.Navigation.Tab}" />
                            <Rectangle Style="{StaticResource Theme.Navigation.Gap}" />
                            <local:PTab
                                x:Name="PNavigationYunjing"
                                Click="PNavigationHandle"
                                Content="{DynamicResource Navigation.Yunjing}"
                                PTabFilled="{local:PIcon yunjing-chosen, 24}"
                                PTabOutline="{local:PIcon yunjing, 24}"
                                Style="{StaticResource Theme.Navigation.Tab}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,14">
                            <Rectangle Style="{StaticResource Theme.Navigation.Divider}" />
                            <local:PTab
                                x:Name="PNavigationDuplex"
                                Click="PNavigationHandle"
                                Content="{DynamicResource Navigation.DualPanel}"
                                PTabFilled="{local:PIcon duplex-chosen, 24}"
                                PTabOutline="{local:PIcon duplex, 24}"
                                Style="{StaticResource Theme.Navigation.Tab}" />
                            <local:PTab
                                x:Name="PNavigationSettings"
                                Click="PNavigationHandle"
                                Content="{DynamicResource Navigation.Settings}"
                                PTabFilled="{local:PIcon settings-chosen, 24}"
                                PTabOutline="{local:PIcon settings, 24}"
                                Style="{StaticResource Theme.Navigation.Tab}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="PPanel" Grid.Column="1" Background="{StaticResource Theme.Surface}">
                    <local:PInput x:Name="PInput" />
                    <local:PLibrary x:Name="PLibrary" Visibility="Collapsed" />
                    <local:PPhonology x:Name="PPhonology" Visibility="Collapsed" />
                    <local:PYunjing x:Name="PYunjing" Visibility="Collapsed" />
                    <local:PTaxonomy x:Name="PTaxonomy" Visibility="Collapsed" />
                    <local:PTenor x:Name="PTenor" Visibility="Collapsed" />
                    <local:PRepertoire x:Name="PRepertoire" Visibility="Collapsed" />
                    <local:PCorpus x:Name="PCorpus" Visibility="Collapsed" />
                    <local:PReference x:Name="PReference" Visibility="Collapsed" />
                    <local:PGuild x:Name="PGuild" Visibility="Collapsed" />
                    <local:PFavorite x:Name="PFavorite" Visibility="Collapsed" />
                    <local:PDuplex x:Name="PDuplex" Visibility="Collapsed" />
                    <local:PSettings x:Name="PSettings" Visibility="Collapsed" />
                </Grid>
            </Grid>

            <local:PEstablishment x:Name="PEstablishment" Grid.Row="2" />

            <Popup
                x:Name="PMentionMenu"
                Grid.Row="1"
                Width="320"
                AllowsTransparency="True"
                Placement="Bottom"
                StaysOpen="False">
                <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                    <StackPanel>
                        <TextBlock x:Name="PMentionTitle" Style="{StaticResource Theme.Popup.Title}" />
                        <ListBox
                            x:Name="PMentionList"
                            MaxHeight="264"
                            ItemContainerStyle="{DynamicResource Theme.Mention.Item}"
                            ItemTemplate="{DynamicResource Theme.Mention.Row}"
                            Style="{DynamicResource Theme.Mention.List}" />
                    </StackPanel>
                </Border>
            </Popup>

        </Grid>
    </Border>
</Window>
