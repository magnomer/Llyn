<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell">

    <DataTemplate x:Key="Reference.Shelf.Card">
        <Button Style="{DynamicResource Theme.Shelf.Row}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Data="{local:PIcon source, 16}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="None" />
                <TextBlock Grid.Column="1" Style="{DynamicResource Theme.Catalog.Title}" Text="{Binding PShelfItemName}" />
                <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock MaxWidth="220" Style="{DynamicResource Theme.Shelf.Meta}" Text="{Binding PShelfItemAuthor}" />
                    <TextBlock Style="{DynamicResource Theme.Catalog.Dot}" />
                    <TextBlock Style="{DynamicResource Theme.Shelf.Meta}" Text="{Binding PShelfItemYear}" />
                </StackPanel>
                <Border Grid.Column="3" Style="{DynamicResource Theme.Catalog.Pellet}" ToolTip="{DynamicResource Source.Tally}">
                    <TextBlock Style="{DynamicResource Theme.Catalog.Tally}" Text="{Binding PShelfItemCount}" />
                </Border>
            </Grid>
        </Button>
    </DataTemplate>

</ResourceDictionary>
