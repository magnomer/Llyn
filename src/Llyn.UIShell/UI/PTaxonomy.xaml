<UserControl
    x:Class="Llyn.UIShell.PTaxonomy"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
    >

    <UserControl.Resources>
        <Style x:Key="Theme.Directory.Row" TargetType="Button" BasedOn="{StaticResource Theme.Catalog.Row}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding PDirectoryItemChosen}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Theme.Accent}" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                    <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
                    <Setter Property="Padding" Value="9,9,12,9" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            x:Name="PFunnel"
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,20,18"
            Style="{StaticResource Theme.Search.Bar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton
                    x:Name="PFunnelDropper"
                    Grid.Column="0"
                    Style="{StaticResource Theme.Search.Dropper}"
                    ToolTip="{DynamicResource Funnel.Title}">
                    <Canvas Width="16" Height="14">
                        <Rectangle Canvas.Top="1" Width="16" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        <Rectangle Canvas.Left="2.5" Canvas.Top="6.2" Width="11" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        <Rectangle Canvas.Left="5" Canvas.Top="11.4" Width="6" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    </Canvas>
                </ToggleButton>
                <Rectangle Grid.Column="1" Style="{StaticResource Theme.Search.Divider}" />
                <TextBox
                    x:Name="PExploration"
                    Grid.Column="2"
                    Style="{StaticResource Theme.Search.Field}"
                    Tag="{DynamicResource Tag.Search}"
                    TextChanged="PExplorationHandle" />
                <Popup
                    x:Name="PFunnelDropdown"
                    Width="252"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsChecked, ElementName=PFunnelDropper}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=PFunnel}"
                    StaysOpen="False"
                    VerticalOffset="6">
                    <Border Margin="10" Padding="8" Style="{StaticResource Theme.Popup.Surface}">
                        <StackPanel>
                            <TextBlock Margin="10,7,10,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Funnel.Title}" />

                            <RadioButton GroupName="PFunnelChoice" IsChecked="True" Click="PFunnelHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Name" Content="{DynamicResource Funnel.Name}" />
                            <RadioButton GroupName="PFunnelChoice" Click="PFunnelHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Reverse" Content="{DynamicResource Funnel.Reverse}" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PDirectory" Margin="0,0,4,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="PDirectoryHandle" Style="{StaticResource Theme.Directory.Row}">
                                <TextBlock Style="{StaticResource Theme.Catalog.Title}" Text="{Binding PDirectoryItemText}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="PDirectoryEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Tag.Empty}" />
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" Margin="0,0,20,0" Style="{StaticResource Theme.Input.Card}">
            <Grid>
                <ScrollViewer Margin="10" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PMembership">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,6" Click="PMembershipHandle" Style="{StaticResource Theme.Choice.Row}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{Binding PMembershipItemHeadword}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Image Width="19" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" Source="{Binding PMembershipItemFlag}" Stretch="Uniform" />
                                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Theme.Muted}" Text="{Binding PMembershipItemLanguage}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock
                    x:Name="PMembershipEmpty"
                    Margin="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Foreground="{StaticResource Theme.Muted}"
                    IsHitTestVisible="False"
                    Text="{DynamicResource Tag.Vacant}"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="0" Grid.Column="2" Margin="0,0,0,18">
            <Border HorizontalAlignment="Left" Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="PTaxonomyFresh"
                        Click="PTaxonomyFreshHandle"
                        Content="{DynamicResource Scribe.New}"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="pack://application:,,,/Llyn;component/icons/plus.svg" />
                    <Button
                        x:Name="PTaxonomyStore"
                        Click="PTaxonomyStoreHandle"
                        Content="{DynamicResource Scribe.Save}"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Primary}"
                        Tag="pack://application:,,,/Llyn;component/icons/floppy-disk.svg" />
                    <Rectangle Style="{StaticResource Theme.Command.Divider}" />
                    <Button
                        Content="{DynamicResource Scribe.Export}"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="pack://application:,,,/Llyn;component/icons/upload-simple.svg" />
                    <Button
                        Content="{DynamicResource Scribe.Print}"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="pack://application:,,,/Llyn;component/icons/printer.svg" />
                </StackPanel>
            </Border>
            <Border
                x:Name="PTaxonomyMode"
                HorizontalAlignment="Right"
                IsEnabled="False"
                Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        x:Name="PTaxonomyViewer"
                        Click="PTaxonomyScribeHandle"
                        Content="{DynamicResource Scribe.View}"
                        GroupName="PTaxonomyMode"
                        IsChecked="True"
                        Style="{StaticResource Theme.Command.Mode}"
                        Tag="pack://application:,,,/Llyn;component/icons/eye.svg" />
                    <RadioButton
                        x:Name="PTaxonomyScribe"
                        Click="PTaxonomyScribeHandle"
                        Content="{DynamicResource Scribe.Edit}"
                        GroupName="PTaxonomyMode"
                        Style="{StaticResource Theme.Command.Mode}"
                        Tag="pack://application:,,,/Llyn;component/icons/pencil-simple.svg" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.Column="2" ClipToBounds="True" Style="{StaticResource Theme.Input.Card}">
            <Grid>
                <local:PDisplay x:Name="PDisplay" />

                <local:PEditor x:Name="PEditor" Padding="30,18,30,30" Visibility="Collapsed" />

                <Button
                    x:Name="PTaxonomyBin"
                    Margin="0,14,14,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="PTaxonomyBinHandle"
                    IsEnabled="False"
                    Style="{StaticResource Theme.Input.Bin}"
                    ToolTip="{DynamicResource Scribe.Delete}">
                    <Rectangle Width="15" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform">
                                <VisualBrush.Visual>
                                    <svgc:SvgViewbox Width="15" Height="16" Source="pack://application:,,,/Llyn;component/icons/trash.svg" />
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
