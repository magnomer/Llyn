<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell">

    <local:PStateConverter x:Key="Display.Card.State" />
    <local:PLinkConverter x:Key="Display.Card.Translation" />
    <local:PSentenceConverter x:Key="Display.Card.Frame" />

    <local:PFontConverter x:Key="Display.Card.Inset" />
    <local:PImageConverter x:Key="Display.Card.Preview" />

    <Style x:Key="Display.Card.Title" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,34,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Card.TitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Style.Triggers>
            <DataTrigger Value="">
                <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource Display.Card.State}">
                        <Binding Path="LCardDraftTitle" />
                        <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Display.Card.Kind" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,34,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Card.TitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Value="">
                <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource Display.Card.State}">
                        <Binding Path="LCardDraftTitle" />
                        <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Display.Card.Definition" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Theme.Card.DefinitionSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <DataTrigger Value="">
                <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource Display.Card.State}">
                        <Binding Path="LCardDraftMeaning" />
                        <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Display.Card.Expression" TargetType="TextBlock" BasedOn="{StaticResource Display.Card.Definition}">
        <Setter Property="Margin" Value="{DynamicResource Theme.Card.ExpressionMargin}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Value="">
                <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource Display.Card.State}">
                        <Binding Path="LCardDraftExpression" />
                        <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Display.Card.Situation" TargetType="ItemsControl">
        <Setter Property="Margin" Value="{DynamicResource Theme.Card.SituationMargin}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding LCardDraftSituation.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Display.Card.Chips" TargetType="ItemsControl">
        <Setter Property="Margin" Value="{DynamicResource Theme.Card.ChipTightMargin}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding LCardDraftSituation.Count}" Value="0">
                <Setter Property="Margin" Value="{DynamicResource Theme.Card.ChipMargin}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding LCardDraftTranslation.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Display.Card.Tag" TargetType="ItemsControl">
        <Setter Property="Margin" Value="{DynamicResource Theme.Card.TagMargin}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding LCardDraftTag.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Display.Card.Example" TargetType="Border">
        <Setter Property="Margin" Value="{DynamicResource Theme.Card.ExampleMargin}" />
        <Setter Property="Padding" Value="{DynamicResource Theme.Card.ExamplePadding}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding LCardDraftExample.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Display.Card.Picture" TargetType="ItemsControl">
        <Setter Property="Margin" Value="{DynamicResource Theme.Card.MediaMargin}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding LCardDraftImage.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Display.Card.SituationLink" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PSurface" Style="{DynamicResource Theme.Card.Situation}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="BorderBrush" Value="{DynamicResource Theme.Situation}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PSurface" Property="Opacity" Value="0.72" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Display.Card.SituationChip">
        <Button Style="{StaticResource Display.Card.SituationLink}">
            <TextBlock FontSize="{DynamicResource Theme.Card.SituationSize}" Foreground="{DynamicResource Theme.Situation}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource Display.Card.State}">
                        <Binding Path="LSituationDraftText" />
                        <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Button>
    </DataTemplate>

    <Style x:Key="Display.Card.ExampleFrame" TargetType="TextBlock" BasedOn="{StaticResource Theme.Card.Frame}">
        <Setter Property="Margin" Value="{DynamicResource Theme.Card.FrameMargin}" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="Display.Card.ExampleLine">
        <Grid Margin="{DynamicResource Theme.Card.ExampleLineMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Style="{DynamicResource Theme.Card.Dot}" />

            <TextBlock x:Name="PExampleFrame" Grid.Column="1" Style="{StaticResource Display.Card.ExampleFrame}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource Display.Card.Frame}" ConverterParameter="Head">
                        <Binding Path="LExampleDraftParticle" />
                        <Binding Path="LExampleDraftDependence" />
                        <Binding Path="LExampleDraftText" />
                        <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <TextBlock
                Grid.Column="2"
                FontFamily="{DynamicResource Theme.Card.ExampleFamily}"
                FontSize="{DynamicResource Theme.Card.ExampleSize}"
                TextWrapping="Wrap">
                <TextBlock.Margin>
                    <MultiBinding Converter="{StaticResource Display.Card.Inset}">
                        <Binding Path="FontFamily" ElementName="PExampleFrame" />
                        <Binding Path="FontSize" ElementName="PExampleFrame" />
                        <Binding Path="FontFamily" RelativeSource="{RelativeSource Self}" />
                        <Binding Path="FontSize" RelativeSource="{RelativeSource Self}" />
                    </MultiBinding>
                </TextBlock.Margin>
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource Display.Card.Frame}" ConverterParameter="Text">
                        <Binding Path="LExampleDraftParticle" />
                        <Binding Path="LExampleDraftDependence" />
                        <Binding Path="LExampleDraftText" />
                        <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Display.Card.PictureLine">
        <Border Style="{DynamicResource Theme.Card.Preview}">
            <Image MaxWidth="320" MaxHeight="200" Source="{Binding PImagePreview}" Stretch="Uniform" />
        </Border>
    </DataTemplate>

    <Style x:Key="Display.Card.TranslationLink" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PSurface" BorderBrush="Transparent" BorderThickness="1" Style="{DynamicResource Theme.Card.Pellet}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PSurface" Property="Opacity" Value="0.72" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Display.Card.TranslationChip">
        <Button Style="{StaticResource Display.Card.TranslationLink}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Image Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Source="{Binding PLinkChipFlag}" Stretch="Uniform" />
                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Accent}" Text="{Binding PLinkChipHeadword}" />
                <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Theme.Muted}" Text="{Binding PLinkChipLanguage}" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <Style x:Key="Display.Card.TagLink" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PSurface" Style="{DynamicResource Theme.Card.Badge}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PSurface" Property="Opacity" Value="0.72" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Display.Card.TagChip">
        <Button Style="{StaticResource Display.Card.TagLink}">
            <TextBlock FontSize="12" Foreground="{DynamicResource Theme.Muted}" Text="{Binding}" />
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="Display.Card.Body">
        <StackPanel>
            <ItemsControl ItemTemplate="{StaticResource Display.Card.SituationChip}" ItemsSource="{Binding LCardDraftSituation}" Style="{StaticResource Display.Card.Situation}" />
            <ItemsControl
                ItemTemplate="{StaticResource Display.Card.TranslationChip}"
                ItemsSource="{Binding LCardDraftTranslation, Converter={StaticResource Display.Card.Translation}}"
                Style="{StaticResource Display.Card.Chips}" />
            <Border Style="{StaticResource Display.Card.Example}">
                <ItemsControl ItemTemplate="{StaticResource Display.Card.ExampleLine}" ItemsSource="{Binding LCardDraftExample}" />
            </Border>
            <ItemsControl ItemTemplate="{StaticResource Display.Card.TagChip}" ItemsSource="{Binding LCardDraftTag}" Style="{StaticResource Display.Card.Tag}" />
            <ItemsControl
                ItemTemplate="{StaticResource Display.Card.PictureLine}"
                ItemsSource="{Binding LCardDraftImage, Converter={StaticResource Display.Card.Preview}}"
                Style="{StaticResource Display.Card.Picture}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Display.Meaning.Card">
        <Border Style="{DynamicResource Theme.Card.Shell}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="55" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{DynamicResource Theme.Card.Header}">
                    <Grid Style="{DynamicResource Theme.Card.Crown}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{DynamicResource Theme.Card.Position}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Theme.Accent}"
                                Text="{Binding LCardDraftPosition}" />
                        </Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource Display.Card.Title}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource Display.Card.State}">
                                    <Binding Path="LCardDraftTitle" />
                                    <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Style="{StaticResource Display.Card.Kind}" Text="{DynamicResource Display.MeaningSingle}" />
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Style="{DynamicResource Theme.Card.Body}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Style="{DynamicResource Theme.Card.Gutter}" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Display.Card.Definition}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource Display.Card.State}">
                                    <Binding Path="LCardDraftMeaning" />
                                    <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Display.Card.Body}" Focusable="False" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Display.Collocation.Card">
        <Border Style="{DynamicResource Theme.Card.Shell}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="55" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{DynamicResource Theme.Card.Header}">
                    <Grid Style="{DynamicResource Theme.Card.Crown}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{DynamicResource Theme.Card.Position}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Theme.Accent}"
                                Text="{Binding LCardDraftPosition}" />
                        </Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource Display.Card.Title}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource Display.Card.State}">
                                    <Binding Path="LCardDraftTitle" />
                                    <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Style="{StaticResource Display.Card.Kind}" Text="{DynamicResource Display.CollocationSingle}" />
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Style="{DynamicResource Theme.Card.Body}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Style="{DynamicResource Theme.Card.Gutter}" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Display.Card.Expression}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource Display.Card.State}">
                                    <Binding Path="LCardDraftExpression" />
                                    <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Display.Card.Definition}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource Display.Card.State}">
                                    <Binding Path="LCardDraftMeaning" />
                                    <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Display.Card.Body}" Focusable="False" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
