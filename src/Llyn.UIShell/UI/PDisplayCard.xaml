<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn;component/UI/PDisplayState.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PDisplaySituation.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PDisplayRegister.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PDisplayTranslation.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PDisplayExample.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PDisplayTag.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PDisplayImage.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PDisplayVideo.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PDisplayMeaning.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PDisplayCollocation.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <local:PLinkConverter x:Key="Display.Card.Translation" />
    <local:PImageConverter x:Key="Display.Card.Preview" />
    <local:PVideoConverter x:Key="Display.Card.Reel" />

    <Style x:Key="Display.Card.Title" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,34,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Card.TitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Style.Triggers>
            <DataTrigger Value="">
                <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource Display.Card.State}">
                        <Binding Path="LCardDraftTitle" />
                        <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Display.Card.Kind" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,34,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Card.TitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Value="">
                <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource Display.Card.State}">
                        <Binding Path="LCardDraftTitle" />
                        <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Display.Card.Definition" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Theme.Card.DefinitionSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <DataTrigger Value="">
                <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource Display.Card.State}">
                        <Binding Path="LCardDraftMeaning" />
                        <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Display.Card.Expression" TargetType="TextBlock" BasedOn="{StaticResource Display.Card.Definition}">
        <Setter Property="Margin" Value="{DynamicResource Theme.Card.ExpressionMargin}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Value="">
                <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource Display.Card.State}">
                        <Binding Path="LCardDraftExpression" />
                        <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="Display.Card.Body">
        <StackPanel>
            <ItemsControl ItemTemplate="{StaticResource Display.Card.SituationChip}" ItemsSource="{Binding LCardDraftSituation}" Style="{StaticResource Display.Card.Situation}" />
            <ItemsControl ItemTemplate="{StaticResource Display.Card.RegisterChip}" ItemsSource="{Binding LCardDraftRegister}" Style="{StaticResource Display.Card.Register}" />
            <ItemsControl
                ItemTemplate="{StaticResource Display.Card.TranslationChip}"
                ItemsSource="{Binding LCardDraftTranslation, Converter={StaticResource Display.Card.Translation}}"
                Style="{StaticResource Display.Card.Chips}" />
            <Border Style="{StaticResource Display.Card.Example}">
                <ItemsControl ItemTemplate="{StaticResource Display.Card.ExampleLine}" ItemsSource="{Binding LCardDraftExample}" />
            </Border>
            <ItemsControl ItemTemplate="{StaticResource Display.Card.TagChip}" ItemsSource="{Binding LCardDraftTag}" Style="{StaticResource Display.Card.Tag}" />
            <ItemsControl
                ItemTemplate="{StaticResource Display.Card.PictureLine}"
                ItemsSource="{Binding LCardDraftImage, Converter={StaticResource Display.Card.Preview}}"
                Style="{StaticResource Display.Card.Picture}" />
            <ItemsControl
                ItemTemplate="{StaticResource Display.Card.VideoLine}"
                ItemsSource="{Binding LCardDraftVideo, Converter={StaticResource Display.Card.Reel}}"
                Style="{StaticResource Display.Card.Video}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
