<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:local="clr-namespace:Llyn.UIShell">

    <local:PStateConverter x:Key="Display.Card.State" />
    <local:PLinkConverter x:Key="Display.Card.Translation" />
    <local:PSentenceConverter x:Key="Display.Card.Frame" />

    <FontFamily x:Key="Display.Card.ExampleFamily">Georgia, Segoe UI</FontFamily>
    <sys:Double x:Key="Display.Card.ExampleSize">15</sys:Double>

    <Style x:Key="Display.Card.Title" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <DataTrigger Value="">
                <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource Display.Card.State}">
                        <Binding Path="LCardDraftTitle" />
                        <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Display.Card.Kind" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Value="">
                <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource Display.Card.State}">
                        <Binding Path="LCardDraftTitle" />
                        <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Display.Card.Position" TargetType="Border">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Background" Value="{DynamicResource Theme.AccentSoft}" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <Style x:Key="Display.Card.Header" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Line}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="12,12,0,0" />
    </Style>

    <Style x:Key="Display.Card.Definition" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="25" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <DataTrigger Value="">
                <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource Display.Card.State}">
                        <Binding Path="LCardDraftMeaning" />
                        <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Display.Card.Expression" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="25" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <DataTrigger Value="">
                <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource Display.Card.State}">
                        <Binding Path="LCardDraftExpression" />
                        <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Display.Card.Situation" TargetType="ItemsControl">
        <Setter Property="Margin" Value="0,9,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding LCardDraftSituation.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Display.Card.Chips" TargetType="ItemsControl">
        <Setter Property="Margin" Value="0,15,0,0" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding LCardDraftTranslation.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Display.Card.Tag" TargetType="ItemsControl">
        <Setter Property="Margin" Value="0,13,0,0" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding LCardDraftTag.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Display.Card.Example" TargetType="Border">
        <Setter Property="Margin" Value="3,16,0,0" />
        <Setter Property="Padding" Value="16,1,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.AccentSoft}" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding LCardDraftExample.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="Display.Card.SituationLine">
        <TextBlock
            Margin="0,4,0,0"
            FontSize="13"
            FontStyle="Italic"
            Foreground="{DynamicResource Theme.Muted}"
            LineHeight="19"
            TextWrapping="Wrap">
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource Display.Card.State}">
                    <Binding Path="LSituationDraftText" />
                    <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
    </DataTemplate>

    <DataTemplate x:Key="Display.Card.ExampleLine">
        <TextBlock
            Margin="0,0,0,7"
            FontFamily="{DynamicResource Display.Card.ExampleFamily}"
            FontSize="{DynamicResource Display.Card.ExampleSize}"
            TextWrapping="Wrap">
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource Display.Card.Frame}">
                    <Binding Path="LExampleDraftParticle" />
                    <Binding Path="LExampleDraftDependence" />
                    <Binding Path="LExampleDraftText" />
                    <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
    </DataTemplate>

    <DataTemplate x:Key="Display.Card.TranslationChip">
        <Border Margin="0,0,7,7" Padding="10,5" Background="{DynamicResource Theme.AccentSoft}" CornerRadius="13">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Image Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Source="{Binding PLinkChipFlag}" Stretch="Uniform" />
                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Accent}" Text="{Binding PLinkChipHeadword}" />
                <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Theme.Muted}" Text="{Binding PLinkChipLanguage}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Display.Card.TagChip">
        <Border Margin="0,0,7,7" Padding="10,4" Background="Transparent" BorderBrush="{DynamicResource Theme.Line}" BorderThickness="1" CornerRadius="11">
            <TextBlock FontSize="12" Foreground="{DynamicResource Theme.Muted}" Text="{Binding}" />
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Display.Card.Body">
        <StackPanel>
            <ItemsControl ItemTemplate="{StaticResource Display.Card.SituationLine}" ItemsSource="{Binding LCardDraftSituation}" Style="{StaticResource Display.Card.Situation}" />
            <ItemsControl
                ItemTemplate="{StaticResource Display.Card.TranslationChip}"
                ItemsSource="{Binding LCardDraftTranslation, Converter={StaticResource Display.Card.Translation}}"
                Style="{StaticResource Display.Card.Chips}" />
            <Border Style="{StaticResource Display.Card.Example}">
                <ItemsControl ItemTemplate="{StaticResource Display.Card.ExampleLine}" ItemsSource="{Binding LCardDraftExample}" />
            </Border>
            <ItemsControl ItemTemplate="{StaticResource Display.Card.TagChip}" ItemsSource="{Binding LCardDraftTag}" Style="{StaticResource Display.Card.Tag}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Display.Meaning.Card">
        <Border Margin="0,0,0,15" Style="{DynamicResource Theme.Input.Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="55" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Display.Card.Header}">
                    <Grid Margin="22,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Display.Card.Position}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Theme.Accent}"
                                Text="{Binding LCardDraftPosition}" />
                        </Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource Display.Card.Title}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource Display.Card.State}">
                                    <Binding Path="LCardDraftTitle" />
                                    <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Style="{StaticResource Display.Card.Kind}" Text="{DynamicResource Display.MeaningSingle}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="30,21,30,24">
                    <TextBlock Style="{StaticResource Display.Card.Definition}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource Display.Card.State}">
                                <Binding Path="LCardDraftMeaning" />
                                <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Display.Card.Body}" Focusable="False" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Display.Collocation.Card">
        <Border Margin="0,0,0,15" Style="{DynamicResource Theme.Input.Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="55" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Display.Card.Header}">
                    <Grid Margin="22,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Display.Card.Position}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Theme.Accent}"
                                Text="{Binding LCardDraftPosition}" />
                        </Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource Display.Card.Title}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource Display.Card.State}">
                                    <Binding Path="LCardDraftTitle" />
                                    <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Style="{StaticResource Display.Card.Kind}" Text="{DynamicResource Display.CollocationSingle}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="30,21,30,24">
                    <TextBlock Style="{StaticResource Display.Card.Expression}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource Display.Card.State}">
                                <Binding Path="LCardDraftExpression" />
                                <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Display.Card.Definition}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource Display.Card.State}">
                                <Binding Path="LCardDraftMeaning" />
                                <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Display.Card.Body}" Focusable="False" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
