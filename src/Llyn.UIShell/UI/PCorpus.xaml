<UserControl
    x:Class="Llyn.UIShell.PCorpus"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    >

    <UserControl.Resources>
        <Style x:Key="Theme.Anthology.Meta" TargetType="TextBlock" BasedOn="{StaticResource Theme.Catalog.Meta}" />

        <Style x:Key="Theme.Anthology.Row" TargetType="Button" BasedOn="{StaticResource Theme.Catalog.Row}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding PAnthologyItemChosen}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                    <Setter Property="Tag" Value="Chosen" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Theme.Display.Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        </Style>

        <Style x:Key="Theme.Display.Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Theme.Quotation.Row" TargetType="Button" BasedOn="{StaticResource Theme.Choice.Row}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <DataTemplate x:Key="Theme.Citation.Row">
            <TextBlock Margin="4,0" VerticalAlignment="Center" Text="{Binding PCitationItemName}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <Style x:Key="Theme.Citation.Item" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <DataTemplate x:Key="Theme.Language.Choice">
            <Button Height="31" Padding="12,0" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="PSpeakerHandle" Foreground="{DynamicResource Theme.Ink}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image Width="19" Height="14" VerticalAlignment="Center" Source="{Binding PLanguageItemFlag}" Stretch="Uniform" />
                    <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontSize="13" Text="{Binding PLanguageItemName}" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="-34,0,-34,0" Style="{StaticResource Theme.Panel.SeamRow}" />
        <local:PSeam Grid.Row="1" Grid.Column="1" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />

        <Border
            x:Name="PRank"
            Grid.Row="0"
            Grid.Column="0"
            Margin="{StaticResource Theme.Catalog.HeaderMargin}"
            Style="{StaticResource Theme.Search.Bar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton
                    x:Name="PRankDropper"
                    Grid.Column="0"
                    Style="{StaticResource Theme.Search.Dropper}"
                    ToolTip="{DynamicResource Rank.Title}">
                    <Canvas Width="16" Height="14">
                        <Rectangle Canvas.Top="1" Width="16" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        <Rectangle Canvas.Top="6.2" Width="11" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        <Rectangle Canvas.Top="11.4" Width="6" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    </Canvas>
                </ToggleButton>
                <Rectangle Grid.Column="1" Style="{StaticResource Theme.Search.Divider}" />
                <TextBox
                    x:Name="PQuery"
                    Grid.Column="2"
                    Style="{StaticResource Theme.Search.Field}"
                    Tag="{DynamicResource Example.Search}"
                    TextChanged="PQueryHandle" />
                <Popup
                    x:Name="PRankDropdown"
                    Width="238"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsChecked, ElementName=PRankDropper, Mode=TwoWay}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=PRank}"
                    StaysOpen="False"
                    VerticalOffset="6">
                    <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                        <StackPanel>
                            <TextBlock Margin="10,7,10,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Rank.Title}" />
                            <RadioButton GroupName="PRankChoice" IsChecked="True" Click="PRankHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Text" Content="{DynamicResource Rank.Text}" />
                            <RadioButton GroupName="PRankChoice" Click="PRankHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Language" Content="{DynamicResource Rank.Language}" />
                            <RadioButton GroupName="PRankChoice" Click="PRankHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Source" Content="{DynamicResource Rank.Source}" />
                            <RadioButton GroupName="PRankChoice" Click="PRankHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Usage" Content="{DynamicResource Rank.Usage}" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <local:PRail Grid.Row="0" Grid.Column="1" Margin="0,0,0,18">
            <Border Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="PCorpusFresh"
                        Click="PCorpusFreshHandle"
                        Content="{DynamicResource Scribe.New}"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="pack://application:,,,/Llyn;component/icons/plus.svg" />
                    <Rectangle Style="{StaticResource Theme.Command.Divider}" />
                    <Button
                        Content="{DynamicResource Scribe.Export}"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="pack://application:,,,/Llyn;component/icons/upload-simple.svg" />
                    <Button
                        Content="{DynamicResource Scribe.Print}"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="pack://application:,,,/Llyn;component/icons/printer.svg" />
                </StackPanel>
            </Border>
            <Border
                x:Name="PCorpusMode"
                IsEnabled="False"
                Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        x:Name="PCorpusViewer"
                        Click="PCorpusScribeHandle"
                        Content="{DynamicResource Scribe.View}"
                        GroupName="PCorpusMode"
                        IsChecked="True"
                        Style="{StaticResource Theme.Command.Mode}"
                        Tag="pack://application:,,,/Llyn;component/icons/eye.svg" />
                    <RadioButton
                        x:Name="PCorpusScribe"
                        Click="PCorpusScribeHandle"
                        Content="{DynamicResource Scribe.Edit}"
                        GroupName="PCorpusMode"
                        Style="{StaticResource Theme.Command.Mode}"
                        Tag="pack://application:,,,/Llyn;component/icons/pencil-simple.svg" />
                </StackPanel>
            </Border>
        </local:PRail>

        <Grid Grid.Row="1" Grid.Column="0" Style="{StaticResource Theme.Catalog.Frame}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl x:Name="PAnthology">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="PAnthologyHandle" Style="{StaticResource Theme.Anthology.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Source="{Binding PAnthologyItemFlag}" Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Theme.Catalog.Title}" Text="{Binding PAnthologyItemName}" />
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Theme.Anthology.Meta}" Text="{Binding PAnthologyItemLanguage}" />
                                        <TextBlock Style="{StaticResource Theme.Catalog.Dot}" />
                                        <TextBlock MaxWidth="150" Style="{StaticResource Theme.Anthology.Meta}" Text="{Binding PAnthologyItemSource}" />
                                    </StackPanel>
                                    <Border Grid.Column="3" Style="{StaticResource Theme.Catalog.Pellet}">
                                        <TextBlock Style="{StaticResource Theme.Catalog.Tally}" Text="{Binding PAnthologyItemCount}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="PAnthologyEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Example.Empty}" />
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" ClipToBounds="True" Style="{StaticResource Theme.Panel.Surface}">
            <Grid>
                <Grid x:Name="PExcerpt">
                    <ScrollViewer Padding="24,22,0,20" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource Theme.Scroll.Gutter}" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PExcerptBody" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Theme.Display.Label}" Text="{DynamicResource Example.Language}" />
                            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                <Image x:Name="PExcerptFlag" Width="19" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" Stretch="Uniform" />
                                <TextBlock x:Name="PExcerptLanguage" Style="{StaticResource Theme.Display.Value}" />
                            </StackPanel>

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Display.Label}" Text="{DynamicResource Example.Text}" />
                            <TextBlock x:Name="PExcerptText" Margin="0,5,0,0" FontSize="20" TextWrapping="Wrap" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Display.Label}" Text="{DynamicResource Example.Translation}" />
                            <TextBlock x:Name="PExcerptTranslation" Margin="0,5,0,0" Style="{StaticResource Theme.Display.Value}" TextWrapping="Wrap" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Display.Label}" Text="{DynamicResource Reference.Title}" />
                            <TextBlock x:Name="PExcerptCitation" Margin="0,5,0,0" Style="{StaticResource Theme.Display.Value}" />

                            <TextBlock Margin="0,26,0,10" Style="{StaticResource Theme.Display.Label}" Text="{DynamicResource Example.Usage}" />
                            <ItemsControl x:Name="PQuotation">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="PQuotationHandle" Style="{StaticResource Theme.Quotation.Row}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding PUsageItemName}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Theme.Accent}" Text="{Binding PUsageItemOwner}" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource Theme.Muted}" Text="{Binding PUsageItemTitle}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                                    <Image Width="19" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" Source="{Binding PUsageItemFlag}" Stretch="Uniform" />
                                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Theme.Muted}" Text="{Binding PUsageItemLanguage}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock
                                x:Name="PQuotationEmpty"
                                Margin="0,2,0,0"
                                Foreground="{StaticResource Theme.Muted}"
                                Text="{DynamicResource Example.UsageEmpty}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock
                        x:Name="PExcerptUnselected"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Theme.Muted}"
                        IsHitTestVisible="False"
                        Text="{DynamicResource Example.Unselected}"
                        TextWrapping="Wrap" />
                </Grid>

                <Grid x:Name="PTranscript" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Padding="24,22,0,10" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource Theme.Scroll.Gutter}" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Example.Language}" />
                            <Grid Margin="0,7,0,0" HorizontalAlignment="Left">
                                <ToggleButton
                                    x:Name="PSpeaker"
                                    MinWidth="220"
                                    Height="44"
                                    Padding="12,0"
                                    HorizontalContentAlignment="Stretch"
                                    Style="{StaticResource Theme.Input.ToggleAction}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image x:Name="PSpeakerFlag" Width="19" Height="14" VerticalAlignment="Center" Stretch="Uniform" />
                                        <TextBlock x:Name="PSpeakerName" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </ToggleButton>
                                <Popup
                                    x:Name="PLanguage"
                                    Width="238"
                                    AllowsTransparency="True"
                                    IsOpen="{Binding IsChecked, ElementName=PSpeaker, Mode=TwoWay}"
                                    Placement="Bottom"
                                    PlacementTarget="{Binding ElementName=PSpeaker}"
                                    StaysOpen="False">
                                    <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                                        <ItemsControl x:Name="PLanguageList" ItemTemplate="{StaticResource Theme.Language.Choice}" />
                                    </Border>
                                </Popup>
                            </Grid>

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Example.Text}" />
                            <TextBox
                                x:Name="PTranscriptText"
                                MinHeight="88"
                                Margin="0,7,0,0"
                                Padding="12,9"
                                AcceptsReturn="True"
                                Style="{StaticResource Theme.Input.Field}"
                                TextChanged="PTranscriptTextHandle"
                                TextWrapping="Wrap"
                                VerticalContentAlignment="Top" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Example.Translation}" />
                            <TextBox
                                x:Name="PTranscriptTranslation"
                                MinHeight="88"
                                Margin="0,7,0,0"
                                Padding="12,9"
                                AcceptsReturn="True"
                                Style="{StaticResource Theme.Input.Field}"
                                TextChanged="PTranscriptTranslationHandle"
                                TextWrapping="Wrap"
                                VerticalContentAlignment="Top" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Reference.Title}" />
                            <Grid Margin="0,7,0,0" HorizontalAlignment="Left">
                                <ToggleButton
                                    x:Name="PCitation"
                                    MinWidth="220"
                                    Height="44"
                                    Padding="12,0"
                                    Foreground="{StaticResource Theme.Accent}"
                                    Style="{StaticResource Theme.Input.ToggleAction}">
                                    <TextBlock x:Name="PCitationName" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" />
                                </ToggleButton>
                                <Popup
                                    x:Name="PCitationDrawer"
                                    Width="264"
                                    AllowsTransparency="True"
                                    IsOpen="{Binding IsChecked, ElementName=PCitation, Mode=TwoWay}"
                                    Placement="Bottom"
                                    PlacementTarget="{Binding ElementName=PCitation}"
                                    StaysOpen="False">
                                    <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Theme.Popup.Title}" Text="{DynamicResource Reference.Title}" />
                                            <TextBlock
                                                x:Name="PCitationEmpty"
                                                Margin="10,5,10,9"
                                                FontSize="12"
                                                Foreground="{StaticResource Theme.Muted}"
                                                Text="{DynamicResource Reference.Empty}"
                                                Visibility="Collapsed" />
                                            <ListBox
                                                x:Name="PCitationList"
                                                MaxHeight="220"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                IsSynchronizedWithCurrentItem="False"
                                                ItemContainerStyle="{StaticResource Theme.Citation.Item}"
                                                ItemTemplate="{StaticResource Theme.Citation.Row}"
                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                SelectedValuePath="PCitationItemId"
                                                SelectionChanged="PCitationHandle" />
                                            <Button
                                                x:Name="PCitationNone"
                                                Height="31"
                                                Padding="12,0"
                                                HorizontalContentAlignment="Left"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="PCitationClearHandle"
                                                Foreground="{StaticResource Theme.Muted}">
                                                <TextBlock VerticalAlignment="Center" FontSize="13" Text="{DynamicResource Reference.None}" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="24,10,24,20" HorizontalAlignment="Right" Orientation="Horizontal">
                        <TextBlock x:Name="PTranscriptCount" Margin="0,0,14,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Theme.Muted}" />
                        <Button
                            x:Name="PTranscriptRemoval"
                            Height="44"
                            Margin="0,0,8,0"
                            Click="PTranscriptRemovalHandle"
                            Content="{DynamicResource Example.Delete}"
                            IsEnabled="False"
                            Style="{StaticResource Theme.Input.Pill}" />
                        <Button
                            x:Name="PTranscriptDiscard"
                            Height="44"
                            Margin="0,0,8,0"
                            Click="PTranscriptDiscardHandle"
                            Content="{DynamicResource Example.Discard}"
                            Style="{StaticResource Theme.Input.Pill}" />
                        <Button
                            x:Name="PTranscriptStore"
                            Height="44"
                            Click="PTranscriptStoreHandle"
                            Content="{DynamicResource Example.Store}"
                            Style="{StaticResource Theme.Input.Primary}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
