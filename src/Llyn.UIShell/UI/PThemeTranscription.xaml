<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn;component/UI/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PThemeIcon.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PThemePronunciation.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PThemeAccent.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PThemePopup.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Transcription.Phonetician" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Tool}">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Tag" Value="pack://application:,,,/Llyn;component/icons/lookup.svg" />
        <Setter Property="ToolTip" Value="{DynamicResource Transcription.Title}" />
        <Setter Property="Command" Value="{x:Static local:PTranscriptionCommand.PTranscriptionCommandNotation}" />
    </Style>

    <Style x:Key="Theme.Transcription.Label" TargetType="TextBlock" BasedOn="{StaticResource Theme.Pronunciation.Label}">
        <Setter Property="Text" Value="{Binding PTranscriptionItemLabel}" />
    </Style>

    <Style x:Key="Theme.Transcription.Option" TargetType="ComboBoxItem">
        <Setter Property="Height" Value="31" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="PSchemeSurface" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="7">
                        <TextBlock VerticalAlignment="Center" Text="{Binding PTranscriptionChoiceLabel}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="PSchemeSurface" Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Theme.DisabledInk}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding PTranscriptionChoiceTaken}" Value="True">
                <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Transcription.Scheme" TargetType="ComboBox">
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemsSource" Value="{Binding PTranscriptionItemChoice}" />
        <Setter Property="SelectedValuePath" Value="PTranscriptionChoiceScheme" />
        <Setter Property="SelectedValue" Value="{Binding PTranscriptionItemScheme, Mode=TwoWay}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Theme.Transcription.Option}" />
        <Setter Property="ToolTip" Value="{DynamicResource Transcription.Title}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="PSchemeField">
                        <ToggleButton x:Name="PSchemeHead" Padding="0" Background="Transparent" BorderThickness="0" ClickMode="Press" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PSchemeName" VerticalAlignment="Center" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" Text="{Binding PTranscriptionItemLabel}" />
                                <Path x:Name="PSchemeChevron" Width="6" Height="3" Margin="4,1,0,0" VerticalAlignment="Center" Data="{StaticResource Theme.Icon.Expand}" Fill="{StaticResource Theme.Muted}" Stretch="Uniform" />
                            </StackPanel>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" MinWidth="124" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PlacementTarget="{Binding ElementName=PSchemeField}" PopupAnimation="Fade" StaysOpen="False">
                            <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                                <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSchemeName" Property="Foreground" Value="{StaticResource Theme.Accent}" />
                            <Setter TargetName="PSchemeChevron" Property="Fill" Value="{StaticResource Theme.Accent}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="PSchemeName" Property="Foreground" Value="{StaticResource Theme.Accent}" />
                            <Setter TargetName="PSchemeChevron" Property="Fill" Value="{StaticResource Theme.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Transcription.Measure" TargetType="TextBlock" BasedOn="{StaticResource Theme.Pronunciation.Measure}">
        <Setter Property="Text" Value="{Binding PTranscriptionItemText}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PTranscriptionItemText}" Value="">
                <Setter Property="Text" Value="{DynamicResource Input.Transcription}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Transcription.Addition" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Addition}">
        <Setter Property="Command" Value="{x:Static local:PTranscriptionCommand.PTranscriptionCommandAddition}" />
    </Style>

    <Style x:Key="Theme.Transcription.Remove" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Remove}">
        <Setter Property="Command" Value="{x:Static local:PTranscriptionCommand.PTranscriptionCommandRemoval}" />
    </Style>

    <DataTemplate x:Key="Theme.Transcription.Row">
        <Border Style="{StaticResource Theme.Pronunciation.Surface}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReadingLabel" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource Theme.Pronunciation.Lead}">
                    <ComboBox Style="{StaticResource Theme.Transcription.Scheme}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <Grid Margin="3,0">
                        <TextBlock Style="{StaticResource Theme.Transcription.Measure}" />
                        <TextBox Style="{StaticResource Theme.Pronunciation.Field}" Tag="{DynamicResource Input.Transcription}" Text="{Binding PTranscriptionItemText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Button Style="{StaticResource Theme.Transcription.Phonetician}" />
                    <StackPanel Style="{StaticResource Theme.Accent.Control}">
                        <Button Style="{StaticResource Theme.Transcription.Addition}" />
                        <Button Style="{StaticResource Theme.Transcription.Remove}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Transcription.Display">
        <Border Style="{StaticResource Theme.Pronunciation.Surface}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReadingLabel" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource Theme.Pronunciation.Lead}">
                    <TextBlock Style="{StaticResource Theme.Transcription.Label}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Style="{StaticResource Theme.Pronunciation.Text}" Text="{Binding PTranscriptionItemText}" />
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
