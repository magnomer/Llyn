<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn;component/UI/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PThemeInput.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Pronunciation.Surface" TargetType="Border">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Height" Value="37" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Theme.Pronunciation.Bracket" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Theme.Pronunciation.Flag" TargetType="Image">
        <Setter Property="Width" Value="19" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stretch" Value="Uniform" />
        <Style.Triggers>
            <Trigger Property="Source" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Pronunciation.Label" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Theme.Pronunciation.Text" TargetType="TextBlock">
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="MaxWidth" Value="292" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Theme.Pronunciation.Field" TargetType="TextBox" BasedOn="{StaticResource Theme.Input.Field}">
        <Setter Property="Margin" Value="-2,0,-2,0" />
        <Setter Property="MaxWidth" Value="296" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="Theme.Pronunciation.Measure" TargetType="TextBlock">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MaxWidth" Value="292" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Visibility" Value="Hidden" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
