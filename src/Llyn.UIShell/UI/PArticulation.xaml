<UserControl
    x:Class="Llyn.UIShell.PArticulation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell">

    <UserControl.Resources>
        <Style x:Key="Articulation.Glyph" TargetType="Button" BasedOn="{StaticResource Theme.Input.Action}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style x:Key="Articulation.Header" TargetType="TextBlock">
            <Setter Property="Margin" Value="7,0,7,6" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Articulation.Side" TargetType="TextBlock" BasedOn="{StaticResource Articulation.Header}">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <Style x:Key="Articulation.Heading" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,0,2,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Border Padding="18,14" Style="{StaticResource Theme.Panel.Surface}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" Style="{StaticResource Theme.Scroll.Gutter}" VerticalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Style="{StaticResource Articulation.Heading}" Text="{DynamicResource Articulation.Vowel}" />
                <Grid x:Name="PVowel" HorizontalAlignment="Left" />

                <TextBlock Margin="2,18,2,8" Style="{StaticResource Articulation.Heading}" Text="{DynamicResource Articulation.Consonant}" />
                <Grid x:Name="PConsonant" HorizontalAlignment="Left" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
