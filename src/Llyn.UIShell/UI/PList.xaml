<UserControl
    x:Class="Llyn.UIShell.PList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    IsVisibleChanged="PListHandle">

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="POrder" Grid.Row="0" Grid.Column="0" Margin="0,0,20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ToggleButton
                x:Name="POrderBase"
                Grid.Column="0"
                Width="44"
                Height="44"
                Padding="0"
                ToolTip="{DynamicResource Order.Title}">
                <ToggleButton.Style>
                    <Style BasedOn="{StaticResource Theme.Input.ToggleAction}" TargetType="ToggleButton">
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
                <Grid Width="16" Height="14">

                    <Canvas Width="16" Height="14">
                        <Rectangle Canvas.Top="1" Width="16" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        <Rectangle Canvas.Top="6.2" Width="11" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        <Rectangle Canvas.Top="11.4" Width="6" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    </Canvas>
                </Grid>
            </ToggleButton>
            <Popup
                x:Name="POrderMenu"
                Width="252"
                AllowsTransparency="True"
                IsOpen="{Binding IsChecked, ElementName=POrderBase}"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=POrderBase}"
                StaysOpen="False"
                VerticalOffset="6">
                <Border Margin="10" Padding="8" Style="{StaticResource Theme.Popup.Surface}">
                    <StackPanel>
                        <TextBlock Margin="10,7,10,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Order.Title}" />

                        <RadioButton GroupName="POrderChoice" IsChecked="True" Click="POrderHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Headword" Content="{DynamicResource Order.Headword}" />
                        <RadioButton GroupName="POrderChoice" Click="POrderHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Reverse" Content="{DynamicResource Order.Reverse}" />
                        <RadioButton GroupName="POrderChoice" Click="POrderHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Recent" Content="{DynamicResource Order.Recent}" />
                        <RadioButton GroupName="POrderChoice" Click="POrderHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Earliest" Content="{DynamicResource Order.Earliest}" />
                    </StackPanel>
                </Border>
            </Popup>
            <TextBox
                x:Name="PInquiry"
                Grid.Column="2"
                Height="44"
                Style="{StaticResource Theme.Input.Field}"
                Tag="{DynamicResource List.Search}"
                TextChanged="PInquiryHandle" />
            <Button
                Grid.Column="4"
                Height="44"
                Click="PMarkupImportHandle"
                Content="{DynamicResource List.Import}"
                Style="{StaticResource Theme.Input.Pill}" />
        </Grid>

        <Border Grid.Row="1" Grid.Column="0" Margin="0,0,20,0" Style="{StaticResource Theme.Input.Card}">
            <Grid>
                <ScrollViewer Margin="10" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PIndex">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,6" Click="PIndexHandle" Style="{StaticResource Theme.Choice.Row}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{Binding PIndexItemHeadword}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Image Width="19" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" Source="{Binding PIndexItemFlag}" Stretch="Uniform" />
                                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Theme.Muted}" Text="{Binding PIndexItemLanguage}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock
                    x:Name="PIndexEmpty"
                    Margin="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Foreground="{StaticResource Theme.Muted}"
                    IsHitTestVisible="False"
                    Text="{DynamicResource List.Empty}"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,18" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button
                x:Name="PFresh"
                Height="44"
                Margin="0,0,8,0"
                Click="PFreshHandle"
                Content="{DynamicResource Scribe.New}"
                Style="{StaticResource Theme.Input.Pill}" />
            <Button
                x:Name="PScribe"
                Width="96"
                Height="44"
                Margin="0,0,8,0"
                Click="PScribeHandle"
                Content="{DynamicResource Scribe.Edit}"
                IsEnabled="False"
                Style="{StaticResource Theme.Input.Pill}" />
            <Button Height="44" Margin="0,0,8,0" Content="{DynamicResource Scribe.Export}" Style="{StaticResource Theme.Input.Pill}" />
            <Button Height="44" Content="{DynamicResource Scribe.Print}" Style="{StaticResource Theme.Input.Pill}" />
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="1" ClipToBounds="True" Style="{StaticResource Theme.Input.Card}">
            <Grid>
                <local:PDisplay x:Name="PDisplay" />

                <local:PEditor x:Name="PEditor" Grid.Row="1" Padding="20,22,20,20" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

