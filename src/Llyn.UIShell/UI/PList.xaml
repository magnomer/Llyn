<UserControl
    x:Class="Llyn.UIShell.PList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
    xmlns:local="clr-namespace:Llyn.UIShell"
    IsVisibleChanged="PListHandle">

    <UserControl.Resources>
        <local:PCardOrderConverter x:Key="Display.Card.Order" />

        <Style x:Key="Display.Card.Title" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LCardDraftTitle}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Display.Card.Expression" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,18" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LCardDraftExpression}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Display.Card.Meaning" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,18" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LCardDraftMeaning}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Display.Card.Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="21" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Display.Card.Example" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,18" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LCardDraftExample.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Display.Card.Situation" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,18" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LCardDraftSituation.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Display.Card.Tag" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding LCardDraftTag.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="Display.Card.Line">
            <TextBlock Margin="0,3,0,0" FontSize="14" LineHeight="20" Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>

        <DataTemplate x:Key="Display.Card.TagPill">
            <Border Margin="0,4,7,0" Padding="9,4" Background="{StaticResource Theme.AccentSoft}" CornerRadius="10">
                <TextBlock FontSize="12" Foreground="{StaticResource Theme.Accent}" Text="{Binding}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Display.Sense.Card">
            <Border Margin="0,0,0,15" Style="{StaticResource Theme.Input.Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                        <Grid Margin="22,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" Margin="0,0,12,0" Background="{StaticResource Theme.AccentSoft}" CornerRadius="14">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource Theme.Accent}"
                                    Text="{Binding (ItemsControl.AlternationIndex), Converter={StaticResource Display.Card.Order}, RelativeSource={RelativeSource AncestorType={x:Type ContentPresenter}}}" />
                            </Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Display.Card.Title}" Text="{Binding LCardDraftTitle}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Display.SenseSingle}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LCardDraftTitle}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="30,23,30,26">
                        <StackPanel Style="{StaticResource Display.Card.Meaning}">
                            <TextBlock Margin="0,0,0,7" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Display.Definition}" />
                            <TextBlock Style="{StaticResource Display.Card.Value}" Text="{Binding LCardDraftMeaning}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Display.Card.Example}">
                            <TextBlock Margin="0,0,0,4" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Display.Example}" />
                            <ItemsControl ItemTemplate="{StaticResource Display.Card.Line}" ItemsSource="{Binding LCardDraftExample}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Display.Card.Situation}">
                            <TextBlock Margin="0,0,0,4" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Display.Situation}" />
                            <ItemsControl ItemTemplate="{StaticResource Display.Card.Line}" ItemsSource="{Binding LCardDraftSituation}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Display.Card.Tag}">
                            <TextBlock Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Display.Tags}" />
                            <ItemsControl ItemTemplate="{StaticResource Display.Card.TagPill}" ItemsSource="{Binding LCardDraftTag}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Display.Collocation.Card">
            <Border Margin="0,0,0,15" Style="{StaticResource Theme.Input.Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                        <Grid Margin="22,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" Margin="0,0,12,0" Background="{StaticResource Theme.AccentSoft}" CornerRadius="14">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource Theme.Accent}"
                                    Text="{Binding (ItemsControl.AlternationIndex), Converter={StaticResource Display.Card.Order}, RelativeSource={RelativeSource AncestorType={x:Type ContentPresenter}}}" />
                            </Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Display.Card.Title}" Text="{Binding LCardDraftTitle}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Display.CollocationSingle}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LCardDraftTitle}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="30,23,30,26">
                        <StackPanel Style="{StaticResource Display.Card.Expression}">
                            <TextBlock Margin="0,0,0,7" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Display.Expression}" />
                            <TextBlock Style="{StaticResource Display.Card.Value}" Text="{Binding LCardDraftExpression}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Display.Card.Meaning}">
                            <TextBlock Margin="0,0,0,7" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Display.Meaning}" />
                            <TextBlock Style="{StaticResource Display.Card.Value}" Text="{Binding LCardDraftMeaning}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Display.Card.Example}">
                            <TextBlock Margin="0,0,0,4" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Display.Example}" />
                            <ItemsControl ItemTemplate="{StaticResource Display.Card.Line}" ItemsSource="{Binding LCardDraftExample}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Display.Card.Situation}">
                            <TextBlock Margin="0,0,0,4" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Display.Situation}" />
                            <ItemsControl ItemTemplate="{StaticResource Display.Card.Line}" ItemsSource="{Binding LCardDraftSituation}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Display.Card.Tag}">
                            <TextBlock Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Display.Tags}" />
                            <ItemsControl ItemTemplate="{StaticResource Display.Card.TagPill}" ItemsSource="{Binding LCardDraftTag}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="Display.Order.Row" TargetType="RadioButton">
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="PSurface"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" />
                                <Path
                                    x:Name="POrderIndicator"
                                    Grid.Column="1"
                                    Width="11"
                                    Height="8"
                                    Margin="12,0,2,0"
                                    Data="M 0,4 L 3.5,7.5 L 11,0"
                                    Stroke="{StaticResource Theme.Accent}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.8"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.SurfaceRaised}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                                <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
                                <Setter TargetName="POrderIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="POrder" Grid.Row="0" Grid.Column="0" Margin="0,0,20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ToggleButton
                x:Name="POrderBase"
                Grid.Column="0"
                Width="44"
                Height="44"
                Padding="0"
                ToolTip="{DynamicResource Order.Title}">
                <ToggleButton.Style>
                    <Style BasedOn="{StaticResource Theme.Input.ToggleAction}" TargetType="ToggleButton">
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
                <Grid Width="16" Height="14">

                    <Canvas Width="16" Height="14">
                        <Rectangle Canvas.Top="1" Width="16" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        <Rectangle Canvas.Top="6.2" Width="11" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        <Rectangle Canvas.Top="11.4" Width="6" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    </Canvas>
                </Grid>
            </ToggleButton>
            <Popup
                x:Name="POrderMenu"
                Width="252"
                AllowsTransparency="True"
                IsOpen="{Binding IsChecked, ElementName=POrderBase}"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=POrderBase}"
                StaysOpen="False"
                VerticalOffset="6">
                <Border Margin="10" Padding="8" Style="{StaticResource Theme.Popup.Surface}">
                    <StackPanel>
                        <TextBlock Margin="10,7,10,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Order.Title}" />

                        <RadioButton GroupName="POrderChoice" IsChecked="True" Click="POrderHandle" Style="{StaticResource Display.Order.Row}" Tag="Headword" Content="{DynamicResource Order.Headword}" />
                        <RadioButton GroupName="POrderChoice" Click="POrderHandle" Style="{StaticResource Display.Order.Row}" Tag="Reverse" Content="{DynamicResource Order.Reverse}" />
                        <RadioButton GroupName="POrderChoice" Click="POrderHandle" Style="{StaticResource Display.Order.Row}" Tag="Recent" Content="{DynamicResource Order.Recent}" />
                        <RadioButton GroupName="POrderChoice" Click="POrderHandle" Style="{StaticResource Display.Order.Row}" Tag="Earliest" Content="{DynamicResource Order.Earliest}" />
                    </StackPanel>
                </Border>
            </Popup>
            <TextBox
                x:Name="PInquiry"
                Grid.Column="2"
                Height="44"
                Style="{StaticResource Theme.Input.Field}"
                Tag="{DynamicResource List.Search}"
                TextChanged="PInquiryHandle" />
        </Grid>

        <Border Grid.Row="1" Grid.Column="0" Margin="0,0,20,0" Style="{StaticResource Theme.Input.Card}">
            <Grid>
                <ScrollViewer Margin="10" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PIndex">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,6" Click="PIndexHandle" Style="{StaticResource Theme.Choice.Row}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{Binding PIndexItemHeadword}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Theme.Muted}" Text="{Binding PIndexItemLanguage}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock
                    x:Name="PIndexEmpty"
                    Margin="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Foreground="{StaticResource Theme.Muted}"
                    IsHitTestVisible="False"
                    Text="{DynamicResource List.Empty}"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" ClipToBounds="True" Style="{StaticResource Theme.Input.Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,16,20,10" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Height="40" Margin="0,0,8,0" Content="{DynamicResource Scribe.New}" Style="{StaticResource Theme.Input.Pill}" />
                    <Button
                        x:Name="PScribe"
                        Width="96"
                        Height="40"
                        Margin="0,0,8,0"
                        Click="PScribeHandle"
                        Content="{DynamicResource Scribe.Edit}"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Input.Pill}" />
                    <Button Height="40" Margin="0,0,8,0" Content="{DynamicResource Scribe.Export}" Style="{StaticResource Theme.Input.Pill}" />
                    <Button Height="40" Content="{DynamicResource Scribe.Print}" Style="{StaticResource Theme.Input.Pill}" />
                </StackPanel>

                <Grid x:Name="PDisplay" Grid.Row="1">
                <TextBlock
                    x:Name="PDisplayEmpty"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource Theme.Muted}"
                    Text="{DynamicResource List.Unselected}" />
                <ScrollViewer x:Name="PDisplayContents" Margin="30,18,30,30" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PDisplayHeadword" VerticalAlignment="Center" FontSize="40" FontWeight="Bold" TextWrapping="Wrap" />
                            <Border Grid.Column="1" Margin="14,0,0,0" Padding="10,5" VerticalAlignment="Center" Background="{StaticResource Theme.AccentSoft}" CornerRadius="12">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Grid Width="19" Height="14" VerticalAlignment="Center">
                                        <Image x:Name="PDisplayLanguageFlag" Stretch="Uniform">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <Trigger Property="Source" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <Ellipse Width="12" Height="12" Stroke="{StaticResource Theme.Accent}" StrokeThickness="1.2" Visibility="Collapsed">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Source, ElementName=PDisplayLanguageFlag}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                    <TextBlock x:Name="PDisplayLanguage" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Theme.Accent}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <Border x:Name="PDisplayPronunciationSurface" Padding="13,7" VerticalAlignment="Center" Background="{StaticResource Theme.AccentSoft}" CornerRadius="10" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="15" Text="[" />
                                    <TextBlock x:Name="PDisplayPronunciation" Margin="4,0" VerticalAlignment="Center" FontSize="15" />
                                    <TextBlock FontSize="15" Text="]" />
                                </StackPanel>
                            </Border>

                            <Button x:Name="PDisplayPlayback" Width="42" Height="42" Margin="10,0,0,0" Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Line}" Foreground="{StaticResource Theme.Accent}" Click="PDisplayPlaybackHandle" Style="{StaticResource Theme.Input.Action}" Visibility="Collapsed">

                                <Rectangle Width="11" Height="13" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                    <Rectangle.OpacityMask>
                                        <VisualBrush Stretch="Uniform">
                                            <VisualBrush.Visual>
                                                <svgc:SvgViewbox Width="11" Height="13" Source="icons/play.svg" />
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Button>

                            <ItemsControl x:Name="PDisplaySpeech" Margin="10,0,0,0" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,8,0" Padding="13,7" VerticalAlignment="Center" Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="1" CornerRadius="10">
                                            <TextBlock VerticalAlignment="Center" FontSize="15" Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel x:Name="PDisplaySenseSection" Margin="0,34,0,0">
                            <TextBlock Margin="2,0,2,12" FontSize="19" FontWeight="SemiBold" Text="{DynamicResource Display.Sense}" />
                            <ItemsControl x:Name="PDisplaySense" AlternationCount="2147483647" ItemTemplate="{StaticResource Display.Sense.Card}" />
                        </StackPanel>

                        <StackPanel x:Name="PDisplayCollocationSection" Margin="0,28,0,0">
                            <TextBlock Margin="2,0,2,12" FontSize="19" FontWeight="SemiBold" Text="{DynamicResource Display.Collocation}" />
                            <ItemsControl x:Name="PDisplayCollocation" AlternationCount="2147483647" ItemTemplate="{StaticResource Display.Collocation.Card}" />
                        </StackPanel>

                        <StackPanel x:Name="PDisplayNoteSection" Margin="0,28,0,0">
                            <TextBlock Margin="2,0,2,12" FontSize="19" FontWeight="SemiBold" Text="{DynamicResource Display.Note}" />
                            <Border Padding="26,22" Style="{StaticResource Theme.Input.Card}">
                                <TextBlock x:Name="PDisplayNote" FontSize="14" LineHeight="21" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                </Grid>

                <local:PEditor x:Name="PEditor" Grid.Row="1" Padding="20,4,20,20" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
