<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Editor.Field.Hint" TargetType="TextBlock" BasedOn="{StaticResource Theme.Text.Headword}">
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text, ElementName=PHeadword}" Value="">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Editor.Field.Ghost" TargetType="TextBlock" BasedOn="{StaticResource Theme.Text.Headword}">
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Text" Value="{Binding Text, ElementName=PHeadword}" />
    </Style>

    <Style x:Key="Editor.Field.Measure" TargetType="TextBlock" BasedOn="{StaticResource Theme.Pronunciation.Measure}">
        <Setter Property="Text" Value="{Binding Text, ElementName=PPronunciation}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text, ElementName=PPronunciation}" Value="">
                <Setter Property="Text" Value="{Binding Tag, ElementName=PPronunciation}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Editor.Field.Mark" TargetType="Path">
        <Setter Property="Width" Value="17" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{StaticResource Theme.Accent}" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Data" Value="M 8,0.7 L 10.06,5.62 15.4,6.05 11.34,9.55 12.58,14.75 8,11.95 3.42,14.75 4.66,9.55 0.6,6.05 5.94,5.62 Z" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                <Setter Property="Fill" Value="{StaticResource Theme.Accent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
