<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Editor.Field.Hint" TargetType="TextBlock" BasedOn="{StaticResource Theme.Text.Headword}">
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text, ElementName=PHeadword}" Value="">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Editor.Field.Ghost" TargetType="TextBlock" BasedOn="{StaticResource Theme.Text.Headword}">
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Text" Value="{Binding Text, ElementName=PHeadword}" />
    </Style>

    <Style x:Key="Editor.Field.Measure" TargetType="TextBlock" BasedOn="{StaticResource Theme.Pronunciation.Measure}">
        <Setter Property="Text" Value="{Binding Text, ElementName=PPronunciationField}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text, ElementName=PPronunciationField}" Value="">
                <Setter Property="Text" Value="{Binding Tag, ElementName=PPronunciationField}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Editor.Field.Mark" TargetType="Path">
        <Setter Property="Width" Value="17" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{StaticResource Theme.Favorite}" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Data" Value="M 8,14.2 C 8,14.2 1,9.6 1,5.2 C 1,3 2.7,1.4 4.7,1.4 C 6.1,1.4 7.3,2.2 8,3.4 C 8.7,2.2 9.9,1.4 11.3,1.4 C 13.3,1.4 15,3 15,5.2 C 15,9.6 8,14.2 8,14.2 Z" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                <Setter Property="Fill" Value="{StaticResource Theme.Favorite}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
