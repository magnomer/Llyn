<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    x:Class="Llyn.UIShell.PTranslationTemplate">

    <DataTemplate x:Key="Theme.Translation.Chip">
        <Border Height="28" Margin="0,3,6,3" Padding="10,0,4,0" Background="{DynamicResource Theme.AccentSoft}" BorderBrush="{DynamicResource Theme.Line}" BorderThickness="1" CornerRadius="7">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Image Width="19" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" Source="{Binding PTranslationChipFlag}" Stretch="Uniform" />
                <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Theme.Ink}" Text="{Binding PTranslationChipHeadword}" />
                <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Theme.Muted}" Text="{Binding PTranslationChipLanguage}" />
                <Button Width="18" Height="18" Margin="7,0,0,0" Padding="0" Click="PTranslationChipHandle">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Path Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="{DynamicResource Theme.Muted}" StrokeEndLineCap="Round" StrokeThickness="1.4" />
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Translation.Entry">
        <TextBox
            MinWidth="96"
            Height="28"
            MinHeight="28"
            Margin="0,3,0,3"
            Padding="2,0"
            Background="Transparent"
            BorderThickness="0"
            FontSize="13"
            Foreground="{DynamicResource Theme.Ink}"
            KeyDown="PTranslationEntryHandle"
            LostKeyboardFocus="PTranslationCloseHandle"
            Style="{DynamicResource Theme.Input.Field}"
            Tag="{Binding PTranslationEntryHint}"
            Text="{Binding PTranslationEntryText, UpdateSourceTrigger=PropertyChanged}"
            VerticalContentAlignment="Center" />
    </DataTemplate>

    <local:PTranslationSelector
        x:Key="Theme.Translation.Item"
        PTranslationSelectorChip="{StaticResource Theme.Translation.Chip}"
        PTranslationSelectorEntry="{StaticResource Theme.Translation.Entry}" />

    <DataTemplate x:Key="Theme.Translation.Candidate">
        <Grid Background="Transparent" MouseLeftButtonUp="PTranslationMenuHandle">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PTranslationMark" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Accent}" Text="+" Visibility="Collapsed" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Ink}" Text="{Binding PTranslationItemHeadword}" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                <Image Width="19" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" Source="{Binding PTranslationItemFlag}" Stretch="Uniform" />
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Theme.Muted}" Text="{Binding PTranslationItemLanguage}" />
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding PTranslationItemFresh}" Value="True">
                <Setter TargetName="PTranslationMark" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="Theme.Translation.Field" TargetType="ItemsControl">
        <Setter Property="ItemTemplateSelector" Value="{StaticResource Theme.Translation.Item}" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <Border
                        x:Name="PSurface"
                        MinHeight="{TemplateBinding MinHeight}"
                        Padding="{TemplateBinding Padding}"
                        Background="{DynamicResource Theme.Surface}"
                        BorderBrush="{DynamicResource Theme.Line}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Cursor="IBeam"
                        MouseLeftButtonDown="PTranslationFocusHandle">
                        <ItemsPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="PSurface" Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
