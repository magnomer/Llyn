<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell">

    <local:PStateConverter x:Key="Display.Card.State" />

    <Style x:Key="Display.Card.Video" TargetType="ItemsControl">
        <Setter Property="Margin" Value="{DynamicResource Theme.Card.MediaMargin}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding LCardDraftVideo.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="Display.Card.VideoLine">
        <Border HorizontalAlignment="Stretch" Style="{DynamicResource Theme.Card.Preview}">
            <local:PScreen
                PScreenFrom="{Binding PVideoFrom}"
                PScreenLocation="{Binding PVideoLocation, Converter={StaticResource Display.Card.State}}"
                PScreenPlaying="{Binding PVideoPlaying, Mode=TwoWay}"
                PScreenUntil="{Binding PVideoUntil}"
                PScreenVolume="{Binding PVolumeCatalogLevel, Source={x:Static local:PVolumeCatalog.PVolumeCatalogCurrent}}" />
        </Border>
    </DataTemplate>
</ResourceDictionary>
