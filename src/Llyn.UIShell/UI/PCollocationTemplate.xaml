<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Llyn.UIShell.PCollocationTemplate">

    <!-- One collocation card in the collocation tab: the same card shape as a sense, over the expression a collocation adds. -->
    <DataTemplate x:Key="Theme.Collocation.Card">
        <Border Margin="0,0,0,15" Style="{DynamicResource Theme.Input.Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="55" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Background="{DynamicResource Theme.Surface}"
                    BorderBrush="{DynamicResource Theme.Line}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="PCardDragHandle">
                    <Grid Margin="14,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="38" />
                        </Grid.ColumnDefinitions>
                        <UniformGrid Width="13" Height="19" HorizontalAlignment="Left" VerticalAlignment="Center" Columns="2" Rows="3">
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource Theme.Muted}" />
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource Theme.Muted}" />
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource Theme.Muted}" />
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource Theme.Muted}" />
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource Theme.Muted}" />
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource Theme.Muted}" />
                        </UniformGrid>
                        <Border Grid.Column="1" Width="28" Height="28" Background="{DynamicResource Theme.AccentSoft}" CornerRadius="14">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Accent}" FontWeight="SemiBold" Text="{Binding PCardOrder}" />
                        </Border>
                        <TextBox
                            Grid.Column="2"
                            Margin="23,0,8,0"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Style="{DynamicResource Theme.Input.Field}"
                            Tag="{Binding PCardTitle}"
                            Text="{Binding PTitle, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Right" Click="PCardHandle" Style="{DynamicResource Theme.Input.Action}" BorderThickness="0" Background="Transparent">
                            <Path Width="12" Height="12" Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{DynamicResource Theme.Muted}" StrokeEndLineCap="Round" StrokeThickness="1.5" />
                        </Button>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="40,25,40,25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="142" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,10,0,19" VerticalAlignment="Top" Style="{DynamicResource Theme.Input.Label}" Text="Expression" />
                    <TextBox Grid.Column="1" MinHeight="42" Margin="0,0,0,19" VerticalAlignment="Top" Style="{DynamicResource Theme.Input.Field}" Tag="Add a word combination" Text="{Binding PCardExpression, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Margin="0,10,0,19" VerticalAlignment="Top" Style="{DynamicResource Theme.Input.Label}" Text="Meaning" />
                    <TextBox Grid.Row="1" Grid.Column="1" MinHeight="42" Margin="0,0,0,19" VerticalAlignment="Top" Style="{DynamicResource Theme.Input.Field}" Tag="Explain what it means" Text="{Binding PCardDefinition, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2" Margin="0,10,0,19" VerticalAlignment="Top" Style="{DynamicResource Theme.Input.Label}" Text="Example" />
                    <TextBox Grid.Row="2" Grid.Column="1" MinHeight="42" Margin="0,0,0,19" VerticalAlignment="Top" Style="{DynamicResource Theme.Input.Field}" Tag="Add an example sentence" Text="{Binding PCardExample, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="3" Margin="0,10,0,19" VerticalAlignment="Top" Style="{DynamicResource Theme.Input.Label}" Text="Situation" />
                    <TextBox Grid.Row="3" Grid.Column="1" MinHeight="42" Margin="0,0,0,19" VerticalAlignment="Top" Style="{DynamicResource Theme.Input.Field}" Tag="Where or when is it used?" Text="{Binding PCardSituation, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="4" Margin="0,10,0,0" VerticalAlignment="Top" Style="{DynamicResource Theme.Input.Label}" Text="Tags" />
                    <TextBox Grid.Row="4" Grid.Column="1" MinHeight="42" VerticalAlignment="Top" Style="{DynamicResource Theme.Input.Field}" Tag="Add tags" Text="{Binding PCardTag, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
