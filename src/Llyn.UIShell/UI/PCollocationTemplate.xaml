<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    x:Class="Llyn.UIShell.PCollocationTemplate">

    <local:PStateConverter x:Key="Theme.State.Show" />

    <DataTemplate x:Key="Theme.Collocation.Card">
        <Border Margin="0,0,0,15" Style="{DynamicResource Theme.Input.Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="55" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Background="{DynamicResource Theme.Surface}"
                    BorderBrush="{DynamicResource Theme.Line}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="PCardDragHandle">
                    <Grid Margin="14,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="38" />
                        </Grid.ColumnDefinitions>
                        <UniformGrid Width="13" Height="19" HorizontalAlignment="Left" VerticalAlignment="Center" Columns="2" Rows="3">
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource Theme.Muted}" />
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource Theme.Muted}" />
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource Theme.Muted}" />
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource Theme.Muted}" />
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource Theme.Muted}" />
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource Theme.Muted}" />
                        </UniformGrid>
                        <Border Grid.Column="1" Width="28" Height="28" Background="{DynamicResource Theme.AccentSoft}" CornerRadius="14">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Accent}" FontWeight="SemiBold" Text="{Binding PCardOrder}" />
                        </Border>
                        <TextBox
                            Grid.Column="2"
                            Margin="23,0,8,0"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Style="{DynamicResource Theme.Input.Field}"
                            Text="{Binding PTitle, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Tag>
                                <MultiBinding Converter="{StaticResource Theme.State.Show}">
                                    <Binding Path="PTitleUnreadable" />
                                    <Binding Path="PCardTitle" />
                                </MultiBinding>
                            </TextBox.Tag>
                        </TextBox>
                        <Button Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Right" Click="PCardHandle" Style="{DynamicResource Theme.Input.Action}" BorderThickness="0" Background="Transparent">
                            <Path Width="12" Height="12" Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{DynamicResource Theme.Muted}" StrokeEndLineCap="Round" StrokeThickness="1.5" />
                        </Button>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="40,25,40,25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="142" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,10,0,19" VerticalAlignment="Top" Style="{DynamicResource Theme.Input.Label}" Text="Expression" />
                    <TextBox Grid.Column="1" MinHeight="42" Margin="0,0,0,19" VerticalAlignment="Top" Style="{DynamicResource Theme.Input.Field}" Text="{Binding PCardExpression, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Tag>
                            <MultiBinding Converter="{StaticResource Theme.State.Show}">
                                <Binding Path="PCardExpressionUnreadable" />
                                <Binding Source="Add a word combination" />
                            </MultiBinding>
                        </TextBox.Tag>
                    </TextBox>
                    <TextBlock Grid.Row="1" Margin="0,10,0,19" VerticalAlignment="Top" Style="{DynamicResource Theme.Input.Label}" Text="Meaning" />
                    <TextBox Grid.Row="1" Grid.Column="1" MinHeight="42" Margin="0,0,0,19" VerticalAlignment="Top" Style="{DynamicResource Theme.Input.Field}" Text="{Binding PCardDefinition, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Tag>
                            <MultiBinding Converter="{StaticResource Theme.State.Show}">
                                <Binding Path="PCardDefinitionUnreadable" />
                                <Binding Source="Explain what it means" />
                            </MultiBinding>
                        </TextBox.Tag>
                    </TextBox>
                    <TextBlock Grid.Row="2" Margin="0,10,0,19" VerticalAlignment="Top" Style="{DynamicResource Theme.Input.Label}" Text="Example" />
                    <ItemsControl Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" VerticalAlignment="Top" ItemTemplate="{DynamicResource Theme.Sentence.Row}" ItemsSource="{Binding PCardSentence}" />
                    <TextBlock Grid.Row="3" Margin="0,10,0,19" VerticalAlignment="Top" Style="{DynamicResource Theme.Input.Label}" Text="Situation" />
                    <ItemsControl Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" VerticalAlignment="Top" ItemTemplate="{DynamicResource Theme.Context.Row}" ItemsSource="{Binding PCardSituation}" />
                    <TextBlock Grid.Row="4" Margin="0,10,0,19" VerticalAlignment="Top" Style="{DynamicResource Theme.Input.Label}" Text="Tags" />
                    <ItemsControl Grid.Row="4" Grid.Column="1" Margin="0,0,0,19" VerticalAlignment="Top" ItemsSource="{Binding PCardTag}" Style="{DynamicResource Theme.Tag.Field}" />
                    <Grid Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,19" Style="{DynamicResource Theme.Image.Section}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="142" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="0,10,0,0" VerticalAlignment="Top" Style="{DynamicResource Theme.Input.Label}" Text="Image" />
                        <ItemsControl Grid.Column="1" VerticalAlignment="Top" ItemTemplate="{DynamicResource Theme.Image.Row}" ItemsSource="{Binding PCardImage}" />
                    </Grid>
                    <Grid Grid.Row="6" Grid.ColumnSpan="2" Margin="0,0,0,19" Style="{DynamicResource Theme.Video.Section}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="142" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="0,10,0,0" VerticalAlignment="Top" Style="{DynamicResource Theme.Input.Label}" Text="Video" />
                        <ItemsControl Grid.Column="1" VerticalAlignment="Top" ItemTemplate="{DynamicResource Theme.Video.Row}" ItemsSource="{Binding PCardVideo}" />
                    </Grid>
                    <TextBlock Grid.Row="7" Margin="0,10,0,0" VerticalAlignment="Top" Style="{DynamicResource Theme.Input.Label}" Text="Extra" />
                    <StackPanel Grid.Row="7" Grid.Column="1" VerticalAlignment="Top" Orientation="Horizontal">
                        <Button Height="42" Padding="14,0" Click="PImageAddHandle" Style="{DynamicResource Theme.Input.Pill}">
                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="+ Image" />
                        </Button>
                        <Button Height="42" Margin="8,0,0,0" Padding="14,0" Click="PVideoAddHandle" Style="{DynamicResource Theme.Input.Pill}">
                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="+ Video" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
