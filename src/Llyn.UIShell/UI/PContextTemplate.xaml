<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    x:Class="Llyn.UIShell.PContextTemplate">

    <local:PStateConverter x:Key="Theme.State.Show" />

    <Style x:Key="Theme.Context.Identity" TargetType="Border">
        <Setter Property="Margin" Value="0,0,11,0" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Theme.AccentSoft}" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PContextId}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Context.Order" TargetType="TextBlock">
        <Setter Property="Margin" Value="-34,0,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <DataTemplate x:Key="Theme.Context.Row">
        <Grid Margin="0,0,0,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid>
                <TextBox MinHeight="42" Padding="12,7,124,7" Style="{DynamicResource Theme.Input.Field}" Text="{Binding PContextText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Tag>
                        <MultiBinding Converter="{StaticResource Theme.State.Show}">
                            <Binding Path="PContextUnreadable" />
                            <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                            <local:PLocalizationBinder PLocalizationBinderKey="Card.SituationHint" />
                        </MultiBinding>
                    </TextBox.Tag>
                </TextBox>
                <Border Style="{StaticResource Theme.Context.Identity}">
                    <TextBlock FontFamily="Consolas, Cascadia Mono, Courier New" FontSize="11" Foreground="{DynamicResource Theme.Accent}" Text="{Binding PContextId}" />
                </Border>
                <TextBlock Style="{StaticResource Theme.Context.Order}" Text="{Binding PContextOrderText}" />
            </Grid>

            <Button Grid.Column="1" Width="42" Height="42" Margin="8,0,0,0" Click="PContextAddHandle" Style="{DynamicResource Theme.Input.Action}">
                <Path Width="12" Height="12" Data="M 6,1 L 6,11 M 1,6 L 11,6" Stroke="{DynamicResource Theme.Accent}" StrokeEndLineCap="Round" StrokeThickness="1.5" />
            </Button>
            <Button Grid.Column="2" Width="42" Height="42" Margin="7,0,0,0" Click="PContextRemoveHandle" Style="{DynamicResource Theme.Input.Action}">
                <Path Width="12" Height="12" Data="M 1,6 L 11,6" Stroke="{DynamicResource Theme.Muted}" StrokeEndLineCap="Round" StrokeThickness="1.5" />
            </Button>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
