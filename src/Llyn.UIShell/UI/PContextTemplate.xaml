<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    x:Class="Llyn.UIShell.PContextTemplate">

    <local:PStateConverter x:Key="Theme.State.Show" />

    <DataTemplate x:Key="Theme.Context.Chip">
        <Border Margin="0,0,9,7" Padding="10,4,5,4" Cursor="Arrow" Style="{DynamicResource Theme.Card.Situation}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource Theme.Card.SituationSize}" Foreground="{DynamicResource Theme.Situation}">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource Theme.State.Show}">
                            <Binding Path="PContextUnknown" />
                            <local:PLocalizationBinder PLocalizationBinderKey="Display.Unknown" />
                            <Binding Path="PContextText" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <Button Width="16" Height="16" Margin="7,0,0,0" Padding="0" Cursor="Hand" Click="PContextChipHandle">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Path Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0,0 L 7,7 M 7,0 L 0,7" Stroke="{DynamicResource Theme.Situation}" StrokeEndLineCap="Round" StrokeThickness="1.4" />
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Context.Entry">
        <TextBox
            MinWidth="128"
            Margin="9,0,9,7"
            Padding="0,5"
            VerticalContentAlignment="Center"
            FontSize="{DynamicResource Theme.Card.SituationSize}"
            Foreground="{DynamicResource Theme.Ink}"
            LostKeyboardFocus="PContextCloseHandle"
            PreviewKeyDown="PContextCaretHandle"
            Style="{DynamicResource Theme.Input.Bare}"
            Tag="{Binding PContextCaretHint}"
            Text="{Binding PContextCaretText, UpdateSourceTrigger=PropertyChanged}" />
    </DataTemplate>

    <local:PContextSelector
        x:Key="Theme.Context.Item"
        PContextSelectorChip="{StaticResource Theme.Context.Chip}"
        PContextSelectorCaret="{StaticResource Theme.Context.Entry}" />

    <Style x:Key="Theme.Context.Field" TargetType="ItemsControl">
        <Setter Property="ItemTemplateSelector" Value="{StaticResource Theme.Context.Item}" />
        <Setter Property="Margin" Value="{DynamicResource Theme.Card.SituationMargin}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <Border Background="Transparent" Cursor="IBeam" MouseLeftButtonDown="PContextFocusHandle">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
