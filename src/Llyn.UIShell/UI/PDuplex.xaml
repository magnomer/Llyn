<UserControl
    x:Class="Llyn.UIShell.PDuplex"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    >

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="-34,0,-34,0" Style="{StaticResource Theme.Panel.SeamRow}" />
        <local:PSeam Grid.Row="1" Grid.Column="1" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />

        <TextBox
            x:Name="PLeftQuery"
            Grid.Row="0"
            Grid.Column="0"
            Height="44"
            Margin="0,0,10,18"
            Style="{StaticResource Theme.Input.Field}"
            Tag="{DynamicResource Duplex.Search}"
            TextChanged="PLeftQueryHandle" />

        <TextBox
            x:Name="PRightQuery"
            Grid.Row="0"
            Grid.Column="1"
            Height="44"
            Margin="10,0,0,18"
            Style="{StaticResource Theme.Input.Field}"
            Tag="{DynamicResource Duplex.Search}"
            TextChanged="PRightQueryHandle" />

        <Grid x:Name="PLeft" Grid.Row="1" Grid.Column="0" Margin="0,14,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Rectangle
                Grid.Row="0"
                Style="{StaticResource Theme.Panel.SeamRow}"
                Visibility="{Binding Visibility, ElementName=PLeftIndex}" />

            <Border
                Grid.Row="0"
                Margin="0,0,0,12"
                Style="{StaticResource Theme.Panel.Surface}"
                Visibility="{Binding Visibility, ElementName=PLeftIndex}">
                <ScrollViewer Margin="10" MaxHeight="220" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource Theme.Scroll.Gutter}" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PLeftIndex" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,6" Click="PLeftIndexHandle" Style="{StaticResource Theme.Choice.Row}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{Binding PIndexItemName}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Image Width="19" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" Source="{Binding PIndexItemFlag}" Stretch="Uniform" />
                                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Theme.Muted}" Text="{Binding PIndexItemLanguage}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="1" ClipToBounds="True" Style="{StaticResource Theme.Panel.Surface}">
                <local:PDisplay x:Name="PLeftDisplay" />
            </Border>
        </Grid>

        <Grid x:Name="PRight" Grid.Row="1" Grid.Column="1" Margin="10,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Rectangle
                Grid.Row="0"
                Style="{StaticResource Theme.Panel.SeamRow}"
                Visibility="{Binding Visibility, ElementName=PRightIndex}" />

            <Border
                Grid.Row="0"
                Margin="0,0,0,12"
                Style="{StaticResource Theme.Panel.Surface}"
                Visibility="{Binding Visibility, ElementName=PRightIndex}">
                <ScrollViewer Margin="10" MaxHeight="220" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource Theme.Scroll.Gutter}" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PRightIndex" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,6" Click="PRightIndexHandle" Style="{StaticResource Theme.Choice.Row}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{Binding PIndexItemName}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Image Width="19" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" Source="{Binding PIndexItemFlag}" Stretch="Uniform" />
                                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Theme.Muted}" Text="{Binding PIndexItemLanguage}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="1" ClipToBounds="True" Style="{StaticResource Theme.Panel.Surface}">
                <local:PDisplay x:Name="PRightDisplay" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
