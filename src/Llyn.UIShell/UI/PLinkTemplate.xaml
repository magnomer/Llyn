<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    x:Class="Llyn.UIShell.PLinkTemplate">

    <DataTemplate x:Key="Theme.Link.Chip">
        <Border Padding="10,5,5,5" Cursor="Arrow" Style="{DynamicResource Theme.Card.Pellet}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Image Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Source="{Binding PLinkChipFlag}" Stretch="Uniform" />
                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Accent}" Text="{Binding PLinkChipHeadword}" />
                <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Theme.Muted}" Text="{Binding PLinkChipLanguage}" />
                <Button Width="16" Height="16" Margin="7,0,0,0" Padding="0" Cursor="Hand" Click="PLinkChipHandle">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Path Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{local:PIcon unlink, 12}" Fill="{DynamicResource Theme.Accent}" Stretch="None" />
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Link.Entry">
        <TextBox
            MinWidth="96"
            Margin="9,0,9,7"
            Padding="0,5"
            VerticalContentAlignment="Center"
            FontSize="13"
            Foreground="{DynamicResource Theme.Ink}"
            PreviewKeyDown="PLinkCaretHandle"
            LostKeyboardFocus="PLinkCloseHandle"
            Style="{DynamicResource Theme.Input.Bare}"
            Tag="{Binding PLinkCaretHint}"
            Text="{Binding PLinkCaretText, UpdateSourceTrigger=PropertyChanged}" />
    </DataTemplate>

    <local:PLinkSelector
        x:Key="Theme.Link.Item"
        PLinkSelectorChip="{StaticResource Theme.Link.Chip}"
        PLinkSelectorCaret="{StaticResource Theme.Link.Entry}" />

    <Style x:Key="Theme.Link.Field" TargetType="ItemsControl">
        <Setter Property="ItemTemplateSelector" Value="{StaticResource Theme.Link.Item}" />
        <Setter Property="Margin" Value="{DynamicResource Theme.Card.ChipTightMargin}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <Border Background="Transparent" Cursor="IBeam" MouseLeftButtonDown="PLinkFocusHandle">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
