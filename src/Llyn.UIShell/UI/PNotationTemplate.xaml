<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Llyn.UIShell.PNotationTemplate">

    <DataTemplate x:Key="Theme.Notation.Reading">
        <Grid Margin="0,3,6,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, StringFormat=PNotationColumn{0}}" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PNotationSelector" HorizontalAlignment="Stretch" VerticalAlignment="Center" Click="PNotationSelectorHandle" Style="{DynamicResource Theme.Popup.RowReading}" ToolTip="{Binding PNotationReadingLabel}">
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="PNotationReadingFlag" Width="19" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Source="{Binding PNotationReadingFlag}" Stretch="Uniform" />
                    <TextBlock x:Name="PNotationReadingLabel" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="11" Text="{Binding PNotationReadingLabel}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PNotationReadingFlag}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PNotationReadingLabel}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock x:Name="PNotationReadingPhonetic" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"><Run Text="[" /><Run Text="{Binding PNotationReadingPhonetic, Mode=OneWay}" /><Run Text="]" /></TextBlock>
                </StackPanel>
            </Button>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding PNotationReadingFlag}" Value="{x:Null}">
                <Setter TargetName="PNotationReadingFlag" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PNotationSelector" Property="ToolTip" Value="{x:Null}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Notation.Row">
        <Border x:Name="PNotationRow" Style="{DynamicResource Theme.Popup.RowSurface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Theme.Muted}" Text="{Binding PNotationItemSource}" TextTrimming="CharacterEllipsis" />
                <ItemsControl x:Name="PNotationReadingList" Grid.Column="1" AlternationCount="8" Margin="4,0,10,0" VerticalAlignment="Center" ItemTemplate="{DynamicResource Theme.Notation.Reading}" ItemsSource="{Binding PNotationItemReading}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="PNotationNote" Grid.Column="1" Margin="4,0,10,0" VerticalAlignment="Center" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource Theme.Muted}" Text="{Binding PNotationItemNotice}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding PNotationItemReady}" Value="False">
                <Setter TargetName="PNotationReadingList" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PNotationNote" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
