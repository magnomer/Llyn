<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn;component/UI/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PThemePronunciation.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PThemeAccent.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PThemeTranscription.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="Theme.Glyph.Sourced" />

    <Style x:Key="Theme.Glyph.Phonetician" TargetType="Button" BasedOn="{StaticResource Theme.Transcription.Phonetician}">
        <Setter Property="ToolTip" Value="{DynamicResource Glyph.Title}" />
        <Setter Property="Command" Value="{x:Static local:PGlyphCommand.PGlyphCommandNotation}" />
        <Setter Property="Visibility" Value="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Theme.Glyph.Sourced}}" />
    </Style>

    <Style x:Key="Theme.Glyph.Field" TargetType="TextBox" BasedOn="{StaticResource Theme.Pronunciation.Field}">
        <Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
    </Style>

    <Style x:Key="Theme.Glyph.Measure" TargetType="TextBlock" BasedOn="{StaticResource Theme.Pronunciation.Measure}">
        <Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
        <Setter Property="Text" Value="{Binding PTranscriptionItemText}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PTranscriptionItemText}" Value="">
                <Setter Property="Text" Value="{DynamicResource Input.Glyph}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Glyph.Chip" TargetType="Button">
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Command" Value="{x:Static local:PGlyphCommand.PGlyphCommandEntry}" />
        <Setter Property="CommandParameter" Value="{Binding}" />
        <Setter Property="ToolTip" Value="{DynamicResource Glyph.Entry}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" SnapsToDevicePixels="True">
                        <TextBlock x:Name="PGlyphCharacter" VerticalAlignment="Center" Text="{Binding PGlyphItemText}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PGlyphCharacter" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Theme.Glyph.Row">
        <Border Style="{StaticResource Theme.Pronunciation.Surface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReadingLabel" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource Theme.Pronunciation.Lead}">
                    <TextBlock Style="{StaticResource Theme.Transcription.Label}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Style="{StaticResource Theme.Pronunciation.Body}">
                    <Grid Style="{StaticResource Theme.Pronunciation.Cell}">
                        <TextBlock Style="{StaticResource Theme.Glyph.Measure}" />
                        <TextBox Style="{StaticResource Theme.Glyph.Field}" Tag="{DynamicResource Input.Glyph}" Text="{Binding PTranscriptionItemText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Button Style="{StaticResource Theme.Glyph.Phonetician}" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Glyph.Display">
        <Button Style="{StaticResource Theme.Glyph.Chip}" />
    </DataTemplate>

</ResourceDictionary>
