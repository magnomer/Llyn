<UserControl
    x:Class="Llyn.UIShell.PReference"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    >

    <UserControl.Resources>
        <Style x:Key="Theme.Shelf.Meta" TargetType="TextBlock" BasedOn="{StaticResource Theme.Catalog.Meta}" />

        <Style x:Key="Theme.Shelf.Row" TargetType="Button" BasedOn="{StaticResource Theme.Catalog.Row}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding PShelfItemChosen}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Theme.Accent}" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                    <Setter Property="Padding" Value="9,9,12,9" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Theme.Colophon.Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        </Style>

        <Style x:Key="Theme.Colophon.Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Theme.Footnote.Row" TargetType="Button" BasedOn="{StaticResource Theme.Choice.Row}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="Theme.Imprint.Unknown" TargetType="ToggleButton" BasedOn="{StaticResource Theme.Input.ToggleAction}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Content" Value="?" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="Theme.Author.Row">
            <TextBlock Margin="4,0" VerticalAlignment="Center" Text="{Binding PAuthorItemName}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <Style x:Key="Theme.Author.Item" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            x:Name="PGrade"
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,20,18"
            Style="{StaticResource Theme.Search.Bar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton
                    x:Name="PGradeDropper"
                    Grid.Column="0"
                    Style="{StaticResource Theme.Search.Dropper}"
                    ToolTip="{DynamicResource Grade.Title}">
                    <Canvas Width="16" Height="13">
                        <Rectangle Canvas.Top="1" Width="16" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        <Rectangle Canvas.Top="6.2" Width="11" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        <Rectangle Canvas.Top="11.4" Width="6" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    </Canvas>
                </ToggleButton>
                <Rectangle Grid.Column="1" Style="{StaticResource Theme.Search.Divider}" />
                <TextBox
                    x:Name="PSurvey"
                    Grid.Column="2"
                    Style="{StaticResource Theme.Search.Field}"
                    Tag="{DynamicResource Source.Search}"
                    TextChanged="PSurveyHandle" />
                <Popup
                    x:Name="PGradeDropdown"
                    Width="238"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsChecked, ElementName=PGradeDropper, Mode=TwoWay}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=PGrade}"
                    StaysOpen="False"
                    VerticalOffset="6">
                    <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                        <StackPanel>
                            <TextBlock Margin="10,7,10,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Grade.Title}" />
                            <RadioButton GroupName="PGradeChoice" IsChecked="True" Click="PGradeHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Name" Content="{DynamicResource Grade.Name}" />
                            <RadioButton GroupName="PGradeChoice" Click="PGradeHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Year" Content="{DynamicResource Grade.Year}" />
                            <RadioButton GroupName="PGradeChoice" Click="PGradeHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Author" Content="{DynamicResource Grade.Author}" />
                            <RadioButton GroupName="PGradeChoice" Click="PGradeHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Usage" Content="{DynamicResource Grade.Usage}" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,18">
            <Border HorizontalAlignment="Left" Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="PReferenceFresh"
                        Click="PReferenceFreshHandle"
                        Content="{DynamicResource Scribe.New}"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="pack://application:,,,/Llyn;component/icons/plus.svg" />
                    <Rectangle Style="{StaticResource Theme.Command.Divider}" />
                    <Button
                        Content="{DynamicResource Scribe.Export}"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="pack://application:,,,/Llyn;component/icons/upload-simple.svg" />
                    <Button
                        Content="{DynamicResource Scribe.Print}"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="pack://application:,,,/Llyn;component/icons/printer.svg" />
                </StackPanel>
            </Border>
            <Border
                x:Name="PReferenceMode"
                HorizontalAlignment="Right"
                IsEnabled="False"
                Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        x:Name="PReferenceViewer"
                        Click="PReferenceScribeHandle"
                        Content="{DynamicResource Scribe.View}"
                        GroupName="PReferenceMode"
                        IsChecked="True"
                        Style="{StaticResource Theme.Command.Mode}"
                        Tag="pack://application:,,,/Llyn;component/icons/eye.svg" />
                    <RadioButton
                        x:Name="PReferenceScribe"
                        Click="PReferenceScribeHandle"
                        Content="{DynamicResource Scribe.Edit}"
                        GroupName="PReferenceMode"
                        Style="{StaticResource Theme.Command.Mode}"
                        Tag="pack://application:,,,/Llyn;component/icons/pencil-simple.svg" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PShelf" Margin="0,0,4,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="PShelfHandle" Style="{StaticResource Theme.Shelf.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource Theme.Catalog.Title}" Text="{Binding PShelfItemName}" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock MaxWidth="220" Style="{StaticResource Theme.Shelf.Meta}" Text="{Binding PShelfItemAuthor}" />
                                        <TextBlock Style="{StaticResource Theme.Catalog.Dot}" />
                                        <TextBlock Style="{StaticResource Theme.Shelf.Meta}" Text="{Binding PShelfItemYear}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource Theme.Catalog.Pellet}">
                                        <TextBlock Style="{StaticResource Theme.Catalog.Tally}" Text="{Binding PShelfItemCount}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="PShelfEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Source.Empty}" />
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" ClipToBounds="True" Style="{StaticResource Theme.Input.Card}">
            <Grid>
                <Grid x:Name="PColophon">
                    <ScrollViewer Padding="24,22,24,20" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PColophonBody" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Theme.Colophon.Label}" Text="{DynamicResource Source.TitleField}" />
                            <TextBlock x:Name="PColophonTitle" Margin="0,5,0,0" FontSize="20" TextWrapping="Wrap" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Colophon.Label}" Text="{DynamicResource Source.Author}" />
                            <TextBlock x:Name="PColophonAuthor" Margin="0,5,0,0" Style="{StaticResource Theme.Colophon.Value}" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Colophon.Label}" Text="{DynamicResource Source.Program}" />
                            <TextBlock x:Name="PColophonProgram" Margin="0,5,0,0" Style="{StaticResource Theme.Colophon.Value}" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Colophon.Label}" Text="{DynamicResource Source.Channel}" />
                            <TextBlock x:Name="PColophonChannel" Margin="0,5,0,0" Style="{StaticResource Theme.Colophon.Value}" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Colophon.Label}" Text="{DynamicResource Source.Year}" />
                            <TextBlock x:Name="PColophonYear" Margin="0,5,0,0" Style="{StaticResource Theme.Colophon.Value}" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Colophon.Label}" Text="{DynamicResource Source.Url}" />
                            <TextBlock x:Name="PColophonUrl" Margin="0,5,0,0" Style="{StaticResource Theme.Colophon.Value}" />

                            <TextBlock Margin="0,26,0,10" Style="{StaticResource Theme.Colophon.Label}" Text="{DynamicResource Source.Footnote}" />
                            <ItemsControl x:Name="PFootnote">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="PFootnoteHandle" Style="{StaticResource Theme.Footnote.Row}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding PFootnoteItemName}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Theme.Accent}" Text="{Binding PFootnoteItemKind}" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource Theme.Muted}" Text="{Binding PFootnoteItemTitle}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                                    <Image Width="19" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" Source="{Binding PFootnoteItemFlag}" Stretch="Uniform" />
                                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Theme.Muted}" Text="{Binding PFootnoteItemLanguage}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock
                                x:Name="PFootnoteEmpty"
                                Margin="0,2,0,0"
                                Foreground="{StaticResource Theme.Muted}"
                                Text="{DynamicResource Source.FootnoteEmpty}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock
                        x:Name="PColophonUnselected"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Theme.Muted}"
                        IsHitTestVisible="False"
                        Text="{DynamicResource Source.Unselected}"
                        TextWrapping="Wrap" />
                </Grid>

                <Grid x:Name="PImprint" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Padding="24,22,24,10" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Source.TitleField}" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="PImprintTitle"
                                    Height="44"
                                    Style="{StaticResource Theme.Input.Field}"
                                    TextChanged="PImprintTitleHandle" />
                                <ToggleButton
                                    x:Name="PImprintTitleUnknown"
                                    Grid.Column="1"
                                    Click="PImprintUnknownHandle"
                                    Style="{StaticResource Theme.Imprint.Unknown}"
                                    Tag="Title"
                                    ToolTip="{DynamicResource Source.Unknown}" />
                            </Grid>

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Source.Author}" />
                            <Grid x:Name="PAuthor" Margin="0,7,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ItemsControl x:Name="PAuthorCredit">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Padding="12,6" Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="1" CornerRadius="9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" FontSize="13" Text="{Binding PAuthorItemName}" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Click="PAuthorEarlierHandle" Content="↑" IsEnabled="{Binding PAuthorItemEarlier}" Style="{StaticResource Theme.Popup.IconAction}" ToolTip="{DynamicResource Source.AuthorEarlier}" />
                                                        <Button Click="PAuthorLaterHandle" Content="↓" IsEnabled="{Binding PAuthorItemLater}" Style="{StaticResource Theme.Popup.IconAction}" ToolTip="{DynamicResource Source.AuthorLater}" />
                                                        <Button Click="PAuthorRenameHandle" Content="✎" Style="{StaticResource Theme.Popup.IconAction}" ToolTip="{DynamicResource Source.AuthorRename}" />
                                                        <Button Click="PAuthorRemoveHandle" Content="✕" Style="{StaticResource Theme.Popup.IconAction}" ToolTip="{DynamicResource Source.AuthorRemove}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    x:Name="PAuthorNotice"
                                    Margin="0,0,0,6"
                                    VerticalAlignment="Top"
                                    Foreground="{StaticResource Theme.Muted}"
                                    IsHitTestVisible="False"
                                    Text="{DynamicResource Source.AuthorNone}"
                                    TextWrapping="Wrap" />
                                <StackPanel Grid.Row="1" HorizontalAlignment="Left" Orientation="Horizontal">
                                    <Grid>
                                        <ToggleButton
                                            x:Name="PAuthorSwitch"
                                            MinWidth="180"
                                            Height="44"
                                            Padding="12,0"
                                            Content="{DynamicResource Source.AuthorAdd}"
                                            Foreground="{StaticResource Theme.Accent}"
                                            Style="{StaticResource Theme.Input.ToggleAction}" />
                                        <Popup
                                            x:Name="PAuthorMenu"
                                            Width="264"
                                            AllowsTransparency="True"
                                            IsOpen="{Binding IsChecked, ElementName=PAuthorSwitch, Mode=TwoWay}"
                                            Placement="Bottom"
                                            PlacementTarget="{Binding ElementName=PAuthorSwitch}"
                                            StaysOpen="False">
                                            <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource Theme.Popup.Title}" Text="{DynamicResource Source.Author}" />
                                                    <TextBlock
                                                        x:Name="PAuthorEmpty"
                                                        Margin="10,5,10,9"
                                                        FontSize="12"
                                                        Foreground="{StaticResource Theme.Muted}"
                                                        Text="{DynamicResource Source.AuthorEmpty}"
                                                        Visibility="Collapsed" />
                                                    <ListBox
                                                        x:Name="PAuthorList"
                                                        MaxHeight="220"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        IsSynchronizedWithCurrentItem="False"
                                                        ItemContainerStyle="{StaticResource Theme.Author.Item}"
                                                        ItemTemplate="{StaticResource Theme.Author.Row}"
                                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                        SelectedValuePath="PAuthorItemId"
                                                        SelectionChanged="PAuthorHandle" />
                                                    <Grid Margin="10,8,10,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox
                                                            x:Name="PAuthorName"
                                                            Height="36"
                                                            Style="{StaticResource Theme.Input.Field}"
                                                            Tag="{DynamicResource Source.AuthorName}" />
                                                        <Button
                                                            x:Name="PAuthorFresh"
                                                            Grid.Column="1"
                                                            Height="36"
                                                            Margin="8,0,0,0"
                                                            Click="PAuthorFreshHandle"
                                                            Content="{DynamicResource Source.AuthorAdd}"
                                                            Style="{StaticResource Theme.Input.Pill}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <ToggleButton
                                        x:Name="PAuthorUnknown"
                                        Height="44"
                                        Margin="8,0,0,0"
                                        Padding="12,0"
                                        Click="PAuthorUnknownHandle"
                                        Content="{DynamicResource Source.AuthorUnknown}"
                                        Style="{StaticResource Theme.Input.ToggleAction}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Source.Program}" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="PImprintProgram"
                                    Height="44"
                                    Style="{StaticResource Theme.Input.Field}"
                                    TextChanged="PImprintProgramHandle" />
                                <ToggleButton
                                    x:Name="PImprintProgramUnknown"
                                    Grid.Column="1"
                                    Click="PImprintUnknownHandle"
                                    Style="{StaticResource Theme.Imprint.Unknown}"
                                    Tag="Program"
                                    ToolTip="{DynamicResource Source.Unknown}" />
                            </Grid>

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Source.Channel}" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="PImprintChannel"
                                    Height="44"
                                    Style="{StaticResource Theme.Input.Field}"
                                    TextChanged="PImprintChannelHandle" />
                                <ToggleButton
                                    x:Name="PImprintChannelUnknown"
                                    Grid.Column="1"
                                    Click="PImprintUnknownHandle"
                                    Style="{StaticResource Theme.Imprint.Unknown}"
                                    Tag="Channel"
                                    ToolTip="{DynamicResource Source.Unknown}" />
                            </Grid>

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Source.Year}" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="PImprintYear"
                                    Height="44"
                                    Style="{StaticResource Theme.Input.Field}"
                                    TextChanged="PImprintYearHandle" />
                                <ToggleButton
                                    x:Name="PImprintYearUnknown"
                                    Grid.Column="1"
                                    Click="PImprintUnknownHandle"
                                    Style="{StaticResource Theme.Imprint.Unknown}"
                                    Tag="Year"
                                    ToolTip="{DynamicResource Source.Unknown}" />
                            </Grid>

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Source.Url}" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="PImprintUrl"
                                    Height="44"
                                    Style="{StaticResource Theme.Input.Field}"
                                    TextChanged="PImprintUrlHandle" />
                                <ToggleButton
                                    x:Name="PImprintUrlUnknown"
                                    Grid.Column="1"
                                    Click="PImprintUnknownHandle"
                                    Style="{StaticResource Theme.Imprint.Unknown}"
                                    Tag="Url"
                                    ToolTip="{DynamicResource Source.Unknown}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="24,10,24,20" HorizontalAlignment="Right" Orientation="Horizontal">
                        <TextBlock x:Name="PImprintCount" Margin="0,0,14,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Theme.Muted}" />
                        <Button
                            x:Name="PImprintRemoval"
                            Height="44"
                            Margin="0,0,8,0"
                            Click="PImprintRemovalHandle"
                            Content="{DynamicResource Source.Delete}"
                            IsEnabled="False"
                            Style="{StaticResource Theme.Input.Pill}" />
                        <Button
                            x:Name="PImprintDiscard"
                            Height="44"
                            Margin="0,0,8,0"
                            Click="PImprintDiscardHandle"
                            Content="{DynamicResource Source.Discard}"
                            Style="{StaticResource Theme.Input.Pill}" />
                        <Button
                            x:Name="PImprintStore"
                            Height="44"
                            Click="PImprintStoreHandle"
                            Content="{DynamicResource Source.Store}"
                            Style="{StaticResource Theme.Input.Primary}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
