<UserControl
    x:Class="Llyn.UIShell.PReference"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Llyn;component/UI/PReferenceShelf.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Llyn;component/UI/PReferenceColophon.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Theme.Shelf.Meta" TargetType="TextBlock" BasedOn="{StaticResource Theme.Catalog.Meta}" />

            <Style x:Key="Theme.Shelf.Row" TargetType="Button" BasedOn="{StaticResource Theme.Catalog.Row}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PShelfItemChosen}" Value="True">
                        <Setter Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                        <Setter Property="Tag" Value="Chosen" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="Theme.Footnote.Row" TargetType="Button" BasedOn="{StaticResource Theme.Choice.Row}">
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="-34,0,-34,0" Style="{StaticResource Theme.Panel.SeamRow}" />
        <local:PSeam Grid.Row="1" Grid.Column="1" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />

        <Border
            x:Name="PGrade"
            Grid.Row="0"
            Grid.Column="0"
            Margin="{StaticResource Theme.Catalog.HeaderMargin}"
            Style="{StaticResource Theme.Search.Bar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton
                    x:Name="PGradeDropper"
                    Grid.Column="0"
                    Style="{StaticResource Theme.Search.Dropper}"
                    ToolTip="{DynamicResource Grade.Title}">
                    <Path Width="24" Height="24" Data="{local:PIcon sort, 24}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Stretch="None" />
                </ToggleButton>
                <Rectangle Grid.Column="1" Style="{StaticResource Theme.Search.Divider}" />
                <TextBox
                    x:Name="PSurvey"
                    Grid.Column="2"
                    Style="{StaticResource Theme.Search.Field}"
                    Tag="{DynamicResource Source.Search}"
                    TextChanged="PSurveyHandle" />
                <Popup
                    x:Name="PGradeDropdown"
                    Width="238"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsChecked, ElementName=PGradeDropper, Mode=TwoWay}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=PGrade}"
                    StaysOpen="False"
                    VerticalOffset="6">
                    <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                        <StackPanel>
                            <TextBlock Margin="10,7,10,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Grade.Title}" />
                            <RadioButton GroupName="PGradeChoice" IsChecked="True" Click="PGradeHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Name" Content="{DynamicResource Grade.Name}" />
                            <RadioButton GroupName="PGradeChoice" Click="PGradeHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Year" Content="{DynamicResource Grade.Year}" />
                            <RadioButton GroupName="PGradeChoice" Click="PGradeHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Author" Content="{DynamicResource Grade.Author}" />
                            <RadioButton GroupName="PGradeChoice" Click="PGradeHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Usage" Content="{DynamicResource Grade.Usage}" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <local:PRail Grid.Row="0" Grid.Column="1" Margin="0,0,0,18">
            <Border Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="PReferenceFresh"
                        Click="PReferenceFreshHandle"
                        Content="{DynamicResource Scribe.New}"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="{local:PIcon new, 24}" />
                    <Rectangle Style="{StaticResource Theme.Command.Divider}" />
                    <Button
                        Content="{DynamicResource Scribe.Export}"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="{local:PIcon export, 24}" />
                    <Button
                        Content="{DynamicResource Scribe.Print}"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="{local:PIcon print, 24}" />
                </StackPanel>
            </Border>
            <Border
                x:Name="PReferenceMode"
                IsEnabled="False"
                Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        x:Name="PReferenceViewer"
                        Click="PReferenceScribeHandle"
                        Content="{DynamicResource Scribe.View}"
                        GroupName="PReferenceMode"
                        IsChecked="True"
                        Style="{StaticResource Theme.Command.Mode}"
                        Tag="{local:PIcon view, 24}" />
                    <RadioButton
                        x:Name="PReferenceScribe"
                        Click="PReferenceScribeHandle"
                        Content="{DynamicResource Scribe.Edit}"
                        GroupName="PReferenceMode"
                        Style="{StaticResource Theme.Command.Mode}"
                        Tag="{local:PIcon edit, 24}" />
                </StackPanel>
            </Border>
        </local:PRail>

        <Grid Grid.Row="1" Grid.Column="0" Style="{StaticResource Theme.Catalog.Frame}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl
                    x:Name="PShelf"
                    Button.Click="PShelfHandle"
                    ItemTemplate="{StaticResource Reference.Shelf.Card}" />
            </ScrollViewer>
            <TextBlock
                x:Name="PShelfEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Source.Empty}" />
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" ClipToBounds="True" Style="{StaticResource Theme.Panel.Surface}">
            <Grid>
                <Grid x:Name="PColophon">
                    <ScrollViewer Padding="24,22,0,20" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource Theme.Scroll.Gutter}" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PColophonBody" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Reference.Colophon.Label}" Text="{DynamicResource Source.TitleField}" />
                            <TextBlock x:Name="PColophonTitle" Margin="0,5,0,0" FontSize="20" TextWrapping="Wrap" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Reference.Colophon.Label}" Text="{DynamicResource Source.Author}" />
                            <TextBlock x:Name="PColophonAuthor" Margin="0,5,0,0" Style="{StaticResource Reference.Colophon.Value}" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Reference.Colophon.Label}" Text="{DynamicResource Source.Year}" />
                            <TextBlock x:Name="PColophonYear" Margin="0,5,0,0" Style="{StaticResource Reference.Colophon.Value}" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Reference.Colophon.Label}" Text="{DynamicResource Source.Kind}" />
                            <TextBlock x:Name="PColophonKind" Margin="0,5,0,0" Style="{StaticResource Reference.Colophon.Value}" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Reference.Colophon.Label}" Text="{DynamicResource Source.Note}" />
                            <TextBlock x:Name="PColophonNote" Margin="0,5,0,0" Style="{StaticResource Reference.Colophon.Value}" TextWrapping="Wrap" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Reference.Colophon.Label}" Text="{DynamicResource Source.Url}" />
                            <TextBlock x:Name="PColophonUrl" Margin="0,5,0,0" Style="{StaticResource Reference.Colophon.Value}" />

                            <TextBlock Margin="0,26,0,10" Style="{StaticResource Reference.Colophon.Label}" Text="{DynamicResource Source.Footnote}" />
                            <ItemsControl
                                x:Name="PFootnote"
                                Button.Click="PFootnoteHandle"
                                ItemTemplate="{StaticResource Reference.Footnote.Card}" />
                            <TextBlock
                                x:Name="PFootnoteEmpty"
                                Margin="0,2,0,0"
                                Foreground="{StaticResource Theme.Muted}"
                                Text="{DynamicResource Source.FootnoteEmpty}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock
                        x:Name="PColophonUnselected"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Theme.Muted}"
                        IsHitTestVisible="False"
                        Text="{DynamicResource Source.Unselected}"
                        TextWrapping="Wrap" />
                </Grid>

                <local:PImprint x:Name="PImprint" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
