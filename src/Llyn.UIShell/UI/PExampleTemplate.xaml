<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    x:Class="Llyn.UIShell.PExampleTemplate">

    <local:PStateConverter x:Key="Theme.State.Show" />

    <DataTemplate x:Key="Theme.Reference.Row">
        <TextBlock Margin="12,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Theme.Ink}" Text="{Binding PReferenceName}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <Style x:Key="Theme.Reference.Item" TargetType="ListBoxItem">
        <Setter Property="Height" Value="31" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="PReferenceSurface" Background="Transparent" CornerRadius="7">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PReferenceSurface" Property="Background" Value="{DynamicResource Theme.AccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="PReferenceSurface" Property="Background" Value="{DynamicResource Theme.AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Example.Identity" TargetType="Border">
        <Setter Property="Margin" Value="0,0,11,0" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Theme.AccentSoft}" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PExampleId}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Example.Order" TargetType="TextBlock">
        <Setter Property="Margin" Value="-34,0,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="Theme.Example.Citation" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Text" Value="{Binding PExampleReferenceName}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PExampleReferenceName}" Value="">
                <Setter Property="Text" Value="{DynamicResource Reference.Assign}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding PExampleReferenceUnreadable}" Value="True">
                <Setter Property="Text" Value="{DynamicResource Display.Unreadable}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Example.Notice" TargetType="TextBlock">
        <Setter Property="Margin" Value="10,5,10,9" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PExampleReferenceCatalog.Count}" Value="0">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="Theme.Example.Row">
        <Grid Margin="0,0,0,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid>
                <TextBox MinHeight="42" Padding="12,7,124,7" Style="{DynamicResource Theme.Input.Field}" Text="{Binding PExampleText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Tag>
                        <MultiBinding Converter="{StaticResource Theme.State.Show}">
                            <Binding Path="PExampleUnreadable" />
                            <Binding Source="Add an example sentence" />
                        </MultiBinding>
                    </TextBox.Tag>
                </TextBox>
                <Border Style="{StaticResource Theme.Example.Identity}">
                    <TextBlock FontFamily="Consolas, Cascadia Mono, Courier New" FontSize="11" Foreground="{DynamicResource Theme.Accent}" Text="{Binding PExampleId}" />
                </Border>
                <TextBlock Style="{StaticResource Theme.Example.Order}" Text="{Binding PExampleOrderText}" />
            </Grid>

            <Grid Grid.Column="1" Margin="8,0,0,0">
                <ToggleButton
                    x:Name="PExampleReference"
                    Width="104"
                    Height="42"
                    Padding="10,0"
                    Foreground="{DynamicResource Theme.Accent}"
                    IsChecked="{Binding PExampleReferenceVisible, Mode=TwoWay}"
                    Style="{DynamicResource Theme.Input.ToggleAction}">
                    <TextBlock Style="{StaticResource Theme.Example.Citation}" />
                </ToggleButton>
                <Popup
                    Width="264"
                    Margin="0,6,0,0"
                    AllowsTransparency="True"
                    IsOpen="{Binding PExampleReferenceVisible, Mode=TwoWay}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=PExampleReference}"
                    StaysOpen="False">
                    <Border Margin="10" Style="{DynamicResource Theme.Popup.Surface}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Theme.Popup.Title}" Text="{DynamicResource Reference.Title}" />
                            <TextBlock Style="{StaticResource Theme.Example.Notice}" Text="{DynamicResource Reference.Empty}" />
                            <ListBox
                                MaxHeight="220"
                                Background="Transparent"
                                BorderThickness="0"
                                IsSynchronizedWithCurrentItem="False"
                                ItemContainerStyle="{StaticResource Theme.Reference.Item}"
                                ItemTemplate="{StaticResource Theme.Reference.Row}"
                                ItemsSource="{Binding PExampleReferenceCatalog}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectedValue="{Binding PExampleReference, Mode=TwoWay}"
                                SelectedValuePath="PReferenceId" />
                            <Button Height="31" Padding="12,0" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="PExampleReferenceClear" Foreground="{DynamicResource Theme.Muted}">
                                <TextBlock VerticalAlignment="Center" FontSize="13" Text="{DynamicResource Reference.None}" />
                            </Button>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox MinHeight="35" Padding="10,0" VerticalContentAlignment="Center" Style="{DynamicResource Theme.Input.Field}" Tag="{DynamicResource Reference.Name}" Text="{Binding PExampleReferenceDraft, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Height="35" Margin="7,0,0,0" Padding="14,0" Click="PExampleReferenceCreate" Style="{DynamicResource Theme.Input.Pill}">
                                    <TextBlock VerticalAlignment="Center" FontSize="13" Text="{DynamicResource Reference.Add}" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <Button Grid.Column="2" Width="42" Height="42" Margin="8,0,0,0" Click="PExampleAddHandle" Style="{DynamicResource Theme.Input.Action}">
                <Path Width="12" Height="12" Data="M 6,1 L 6,11 M 1,6 L 11,6" Stroke="{DynamicResource Theme.Accent}" StrokeEndLineCap="Round" StrokeThickness="1.5" />
            </Button>
            <Button Grid.Column="3" Width="42" Height="42" Margin="7,0,0,0" Click="PExampleRemoveHandle" Style="{DynamicResource Theme.Input.Action}">
                <Path Width="12" Height="12" Data="M 1,6 L 11,6" Stroke="{DynamicResource Theme.Muted}" StrokeEndLineCap="Round" StrokeThickness="1.5" />
            </Button>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
