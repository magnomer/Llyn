<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Llyn.UIShell.PVideoTemplate">

    <Style x:Key="Theme.Video.Section" TargetType="Grid">
        <Style.Triggers>
            <DataTrigger Binding="{Binding PCardVideo.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Video.Preview" TargetType="Border">
        <Setter Property="Margin" Value="0,7,0,0" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PVideoPreview}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="Theme.Video.Row">
        <Grid Margin="0,0,0,7">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox MinHeight="42" Padding="12,7" Style="{DynamicResource Theme.Input.Field}" Tag="{DynamicResource Card.LocationHint}" Text="{Binding PVideoLocation, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Column="1" Width="124" MinHeight="42" Margin="8,0,0,0" Padding="12,7" Style="{DynamicResource Theme.Input.Field}" Tag="{DynamicResource Card.TimestampHint}" Text="{Binding PVideoTimestamp, UpdateSourceTrigger=PropertyChanged}" />

                <Button Grid.Column="2" Height="42" Margin="8,0,0,0" Padding="14,0" Click="PVideoOpenHandle" Style="{DynamicResource Theme.Input.Pill}">
                    <TextBlock VerticalAlignment="Center" FontSize="13" Text="{DynamicResource Card.Browse}" />
                </Button>
                <Button Grid.Column="3" Width="42" Height="42" Margin="7,0,0,0" Click="PVideoRemoveHandle" Style="{DynamicResource Theme.Input.Action}">
                    <Path Width="12" Height="12" Data="M 1,6 L 11,6" Stroke="{DynamicResource Theme.Muted}" StrokeEndLineCap="Round" StrokeThickness="1.5" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Theme.Video.Preview}">
                <StackPanel>
                    <MediaElement
                        Width="320"
                        Height="200"
                        LoadedBehavior="Manual"
                        Loaded="PVideoLoadHandle"
                        MediaEnded="PVideoFinishHandle"
                        MediaOpened="PVideoReadyHandle"
                        ScrubbingEnabled="True"
                        Source="{Binding PVideoPreview}"
                        Stretch="Uniform"
                        Unloaded="PVideoDropHandle" />
                    <ToggleButton
                        Width="88"
                        Height="31"
                        Margin="0,7,0,0"
                        HorizontalAlignment="Left"
                        Click="PVideoPlayHandle"
                        Foreground="{DynamicResource Theme.Accent}"
                        IsChecked="{Binding PVideoPlaying, Mode=TwoWay}"
                        Style="{DynamicResource Theme.Input.ToggleAction}">
                        <TextBlock VerticalAlignment="Center" FontSize="13" Text="{DynamicResource Card.Play}" />
                    </ToggleButton>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
