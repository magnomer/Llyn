<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Llyn.UIShell.PVideoTemplate">

    <Style x:Key="Theme.Video.Preview" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PVideoPreview}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="Theme.Video.Row">
        <Grid Style="{DynamicResource Theme.Card.Reach}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Style="{DynamicResource Theme.Card.Gutter}" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border Style="{StaticResource Theme.Video.Preview}">
                    <StackPanel>
                        <MediaElement
                            Width="320"
                            Height="200"
                            LoadedBehavior="Manual"
                            Loaded="PVideoLoadHandle"
                            MediaEnded="PVideoFinishHandle"
                            MediaOpened="PVideoReadyHandle"
                            ScrubbingEnabled="True"
                            Source="{Binding PVideoPreview}"
                            Stretch="Uniform"
                            Unloaded="PVideoDropHandle" />
                        <ToggleButton
                            Width="88"
                            Height="31"
                            Margin="0,7,0,0"
                            HorizontalAlignment="Left"
                            Click="PVideoPlayHandle"
                            Foreground="{DynamicResource Theme.Accent}"
                            IsChecked="{Binding PVideoPlaying, Mode=TwoWay}"
                            Style="{DynamicResource Theme.Input.ToggleAction}">
                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="{DynamicResource Card.Play}" />
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Margin="0,6,16,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource Theme.Muted}"
                        Style="{DynamicResource Theme.Input.Bare}"
                        Tag="{DynamicResource Card.LocationHint}"
                        Text="{Binding PVideoLocation, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        Grid.Column="1"
                        Width="96"
                        Margin="0,6,16,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource Theme.Muted}"
                        Style="{DynamicResource Theme.Input.Bare}"
                        Tag="{DynamicResource Card.TimestampHint}"
                        Text="{Binding PVideoTimestamp, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Column="2" Height="20" Padding="8,0" Click="PVideoOpenHandle" Foreground="{DynamicResource Theme.Accent}" Style="{DynamicResource Theme.Input.Pill}">
                        <TextBlock VerticalAlignment="Center" FontSize="11" Text="{DynamicResource Card.Browse}" />
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="30,1,0,0" VerticalAlignment="Top" Orientation="Horizontal" Style="{DynamicResource Theme.Card.Control}">
                <Button Click="PVideoRemoveHandle" Style="{DynamicResource Theme.Card.Handle}">
                    <Path Width="9" Height="9" Data="M 0,4.5 L 9,4.5" Stroke="{DynamicResource Theme.Muted}" StrokeEndLineCap="Round" StrokeThickness="1.5" />
                </Button>
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
