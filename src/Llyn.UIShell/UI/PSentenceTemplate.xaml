<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    x:Class="Llyn.UIShell.PSentenceTemplate">

    <local:PStateConverter x:Key="Theme.State.Show" />

    <Style x:Key="Theme.Sentence.Control" TargetType="FrameworkElement">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="IsHitTestVisible" Value="True" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="IsHitTestVisible" Value="True" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Sentence.Frame" TargetType="StackPanel">
        <Style.Triggers>
            <DataTrigger Binding="{Binding PSentenceFrameVisible}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Sentence.Hint" TargetType="TextBlock" BasedOn="{StaticResource Theme.Card.Ghost}">
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <DataTemplate x:Key="Theme.Reference.Row">
        <TextBlock Margin="12,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Theme.Ink}" Text="{Binding PCitationItemName}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <Style x:Key="Theme.Reference.Item" TargetType="ListBoxItem">
        <Setter Property="Height" Value="31" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="PCitationSurface" Background="Transparent" CornerRadius="7">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PCitationSurface" Property="Background" Value="{DynamicResource Theme.AccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="PCitationSurface" Property="Background" Value="{DynamicResource Theme.AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Sentence.Identity" TargetType="Border">
        <Setter Property="Margin" Value="7,0,0,0" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Theme.AccentSoft}" />
        <Setter Property="CornerRadius" Value="6" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PSentenceId}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Sentence.Citation" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Text" Value="{Binding PSentenceCitationName}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PSentenceCitationName}" Value="">
                <Setter Property="Text" Value="{DynamicResource Reference.Assign}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding PSentenceCitationUnreadable}" Value="True">
                <Setter Property="Text" Value="{DynamicResource Display.Unreadable}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Sentence.Notice" TargetType="TextBlock">
        <Setter Property="Margin" Value="10,5,10,9" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PSentenceCitationCatalog.Count}" Value="0">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="Theme.Sentence.Row">
        <Grid Style="{DynamicResource Theme.Card.Reach}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Style="{DynamicResource Theme.Card.Gutter}" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Style="{StaticResource Theme.Sentence.Frame}">
                    <TextBlock Style="{DynamicResource Theme.Card.Frame}" Text="(+" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="1" Style="{DynamicResource Theme.Card.Frame}" Text="{Binding PSentenceFrameGap}" />

                        <Grid Grid.Column="{Binding PSentenceParticleColumn}">
                            <TextBlock Style="{DynamicResource Theme.Card.Ghost}" Text="{Binding PSentenceParticle}" />
                            <TextBlock Text="{Binding Tag, ElementName=PSentenceParticle}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Theme.Sentence.Hint}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PSentenceParticle}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ComboBox
                                x:Name="PSentenceParticle"
                                Style="{DynamicResource Theme.Choice.Bare}"
                                ItemsSource="{Binding PSentenceParticleCatalog}"
                                Text="{Binding PSentenceParticle, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBox.Tag>
                                    <MultiBinding Converter="{StaticResource Theme.State.Show}">
                                        <Binding Path="PSentenceParticleUnreadable" />
                                        <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                                        <local:PLocalizationBinder PLocalizationBinderKey="Card.ParticleHint" />
                                    </MultiBinding>
                                </ComboBox.Tag>
                            </ComboBox>
                        </Grid>

                        <Grid Grid.Column="{Binding PSentenceDependenceColumn}">
                            <TextBlock Style="{DynamicResource Theme.Card.Ghost}" Text="{Binding PSentenceDependence}" />
                            <TextBlock Text="{Binding Tag, ElementName=PSentenceDependence}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Theme.Sentence.Hint}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PSentenceDependence}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ComboBox
                                x:Name="PSentenceDependence"
                                Style="{DynamicResource Theme.Choice.Bare}"
                                ItemsSource="{Binding PSentenceDependenceCatalog}"
                                Text="{Binding PSentenceDependence, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBox.Tag>
                                    <MultiBinding Converter="{StaticResource Theme.State.Show}">
                                        <Binding Path="PSentenceDependenceUnreadable" />
                                        <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                                        <local:PLocalizationBinder PLocalizationBinderKey="Card.DependenceHint" />
                                    </MultiBinding>
                                </ComboBox.Tag>
                            </ComboBox>
                        </Grid>
                    </Grid>
                    <TextBlock Style="{DynamicResource Theme.Card.Frame}" Text=") " />
                </StackPanel>

                <Grid Grid.Column="1">
                    <TextBox Style="{DynamicResource Theme.Card.Instance}" Text="{Binding PSentenceText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Tag>
                            <MultiBinding Converter="{StaticResource Theme.State.Show}">
                                <Binding Path="PSentenceUnreadable" />
                                <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                                <local:PLocalizationBinder PLocalizationBinderKey="Card.ExampleHint" />
                            </MultiBinding>
                        </TextBox.Tag>
                    </TextBox>

                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel" BasedOn="{StaticResource Theme.Sentence.Control}" />
                        </StackPanel.Style>
                        <ToggleButton
                            x:Name="PSentenceCitation"
                            MaxWidth="124"
                            Height="20"
                            Padding="8,0"
                            Foreground="{DynamicResource Theme.Accent}"
                            IsChecked="{Binding PSentenceCitationVisible, Mode=TwoWay}"
                            Style="{DynamicResource Theme.Input.ToggleAction}">
                            <TextBlock Style="{StaticResource Theme.Sentence.Citation}" />
                        </ToggleButton>
                        <Popup
                            x:Name="PCitationDrawer"
                            Width="264"
                            Margin="0,6,0,0"
                            AllowsTransparency="True"
                            IsOpen="{Binding PSentenceCitationVisible, Mode=TwoWay}"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=PSentenceCitation}"
                            StaysOpen="False">
                            <Border Margin="10" Style="{DynamicResource Theme.Popup.Surface}">
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource Theme.Popup.Title}" Text="{DynamicResource Reference.Title}" />
                                    <TextBlock Style="{StaticResource Theme.Sentence.Notice}" Text="{DynamicResource Reference.Empty}" />
                                    <ListBox
                                        MaxHeight="220"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        IsSynchronizedWithCurrentItem="False"
                                        ItemContainerStyle="{StaticResource Theme.Reference.Item}"
                                        ItemTemplate="{StaticResource Theme.Reference.Row}"
                                        ItemsSource="{Binding PSentenceCitationCatalog}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        SelectedValue="{Binding PSentenceCitation, Mode=TwoWay}"
                                        SelectedValuePath="PCitationItemId" />
                                    <Button Height="31" Padding="12,0" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="PSentenceCitationClear" Foreground="{DynamicResource Theme.Muted}">
                                        <TextBlock VerticalAlignment="Center" FontSize="13" Text="{DynamicResource Reference.None}" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Border Style="{StaticResource Theme.Sentence.Identity}">
                            <TextBlock FontFamily="Consolas, Cascadia Mono, Courier New" FontSize="10" Foreground="{DynamicResource Theme.Accent}" Text="{Binding PSentenceId}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <StackPanel Grid.Column="1" Margin="8,1,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel" BasedOn="{StaticResource Theme.Sentence.Control}" />
                </StackPanel.Style>
                <ToggleButton IsChecked="{Binding PSentenceFrameVisible, Mode=TwoWay}" Style="{DynamicResource Theme.Card.Switch}">
                    <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource Theme.Muted}" Text="(+" />
                </ToggleButton>
                <Button Margin="4,0,0,0" Click="PSentenceAddHandle" Style="{DynamicResource Theme.Card.Handle}">
                    <Path Width="9" Height="9" Data="M 4.5,0 L 4.5,9 M 0,4.5 L 9,4.5" Stroke="{DynamicResource Theme.Accent}" StrokeEndLineCap="Round" StrokeThickness="1.5" />
                </Button>
                <Button Margin="4,0,0,0" Click="PSentenceRemoveHandle" Style="{DynamicResource Theme.Card.Handle}">
                    <Path Width="9" Height="9" Data="M 0,4.5 L 9,4.5" Stroke="{DynamicResource Theme.Muted}" StrokeEndLineCap="Round" StrokeThickness="1.5" />
                </Button>
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
