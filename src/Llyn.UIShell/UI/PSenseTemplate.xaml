<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Llyn.UIShell.PSenseTemplate">

    <!-- One sense card in the meaning tab: its draggable header, title box, and the fields a sense carries. -->
    <DataTemplate x:Key="Theme.Sense.Card">
        <Border Margin="0,0,0,15" Style="{DynamicResource Theme.Input.Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="55" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Background="{DynamicResource Theme.Surface}"
                    BorderBrush="{DynamicResource Theme.Line}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0">
                    <Grid Margin="14,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="38" />
                        </Grid.ColumnDefinitions>
                        <UniformGrid Width="13" Height="19" HorizontalAlignment="Left" VerticalAlignment="Center" Columns="2" Rows="3">
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource Theme.Muted}" />
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource Theme.Muted}" />
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource Theme.Muted}" />
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource Theme.Muted}" />
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource Theme.Muted}" />
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource Theme.Muted}" />
                        </UniformGrid>
                        <Border Grid.Column="1" Width="28" Height="28" Background="{DynamicResource Theme.AccentSoft}" CornerRadius="14">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Accent}" FontWeight="SemiBold" Text="{Binding PInputCardOrder}" />
                        </Border>
                        <TextBox
                            Grid.Column="2"
                            Margin="23,0,8,0"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Style="{DynamicResource Theme.Input.Field}"
                            Tag="{Binding PInputCardTitle}"
                            Text="{Binding PTitle, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Right" Click="PCardHandle" Style="{DynamicResource Theme.Input.Action}" BorderThickness="0" Background="Transparent">
                            <Path Width="12" Height="12" Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{DynamicResource Theme.Muted}" StrokeEndLineCap="Round" StrokeThickness="1.5" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="40,25,40,25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="142" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.ColumnSpan="2" Margin="0,0,0,19">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Top" Style="{DynamicResource Theme.Input.Label}" Text="Definition" />
                        <TextBox Grid.Row="1" MinHeight="89" AcceptsReturn="True" Style="{DynamicResource Theme.Input.Field}" Tag="Write a clear definition" Text="{Binding PInputCardDefinition, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                    </Grid>

                    <TextBlock Grid.Row="1" Margin="0,10,0,19" VerticalAlignment="Top" Style="{DynamicResource Theme.Input.Label}" Text="Example" />
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,19" VerticalAlignment="Top">
                        <TextBox MinHeight="42" Padding="12,7,72,7" Style="{DynamicResource Theme.Input.Field}" Tag="Add an example sentence" Text="{Binding PInputCardExample, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Margin="0,0,13,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" IsHitTestVisible="False">
                            <Path Width="13" Height="13" Margin="0,0,14,0" Data="M 5,2 L 2,2 L 2,11 L 11,11 L 11,8 M 7,1 L 12,1 L 12,6 M 6,7 L 12,1" Stroke="{DynamicResource Theme.Accent}" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeLineJoin="Round" StrokeThickness="1.3" />
                            <Path Width="5" Height="9" Data="M 0,0 L 4,4.5 L 0,9" Stroke="{DynamicResource Theme.Muted}" StrokeThickness="1.2" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="2" Margin="0,10,0,19" VerticalAlignment="Top" Style="{DynamicResource Theme.Input.Label}" Text="Situation" />
                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,19" VerticalAlignment="Top">
                        <TextBox MinHeight="42" Padding="12,7,72,7" Style="{DynamicResource Theme.Input.Field}" Tag="Where or when is it used?" Text="{Binding PInputCardSituation, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Margin="0,0,13,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" IsHitTestVisible="False">
                            <Path Width="13" Height="16" Margin="0,0,14,0" Data="M 6.5,15 C 5,12 2,9 2,6.5 A 4.5,4.5 0 1 1 11,6.5 C 11,9 8,12 6.5,15 M 6.5,4.5 A 2,2 0 1 0 6.5,8.5 A 2,2 0 1 0 6.5,4.5" Stroke="{DynamicResource Theme.Accent}" StrokeThickness="1.2" />
                            <Path Width="5" Height="9" Data="M 0,0 L 4,4.5 L 0,9" Stroke="{DynamicResource Theme.Muted}" StrokeThickness="1.2" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="3" Margin="0,10,0,0" VerticalAlignment="Top" Style="{DynamicResource Theme.Input.Label}" Text="Tags" />
                    <Grid Grid.Row="3" Grid.Column="1" VerticalAlignment="Top">
                        <TextBox MinHeight="42" Padding="12,7,72,7" Style="{DynamicResource Theme.Input.Field}" Tag="Add tags" Text="{Binding PInputCardTag, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Margin="0,0,13,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" IsHitTestVisible="False">
                            <Path Width="15" Height="14" Margin="0,0,14,0" Data="M 1,2 L 8,2 L 14,8 L 8,14 L 1,14 Z M 5,6 A 1.2,1.2 0 1 0 5,8.4 A 1.2,1.2 0 1 0 5,6" Stretch="Fill" Stroke="{DynamicResource Theme.Accent}" StrokeLineJoin="Round" StrokeThickness="1.2" />
                            <Path Width="5" Height="9" Data="M 0,0 L 4,4.5 L 0,9" Stroke="{DynamicResource Theme.Muted}" StrokeThickness="1.2" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
