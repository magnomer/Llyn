<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn;component/UI/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn;component/UI/PThemePopup.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <sys:Boolean x:Key="Theme.Diwei.Spoken">False</sys:Boolean>
    <sys:Boolean x:Key="Theme.Diwei.Spelled">True</sys:Boolean>

    <Style x:Key="Theme.Diwei.Empty" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Margin" Value="2,25,0,0" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="Theme.Diwei.Switch" TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="14,0,2,12" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="Background" Value="{StaticResource Theme.Surface}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PDiweiItemSwitched}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Diwei.Choice" TargetType="Button">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Command" Value="{x:Static local:PDiweiCommand.PDiweiCommandSwitch}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="PSurface"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.SurfaceRaised}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Diwei.Ipa" TargetType="Button" BasedOn="{StaticResource Theme.Diwei.Choice}">
        <Setter Property="Content" Value="{DynamicResource Tally.Ipa}" />
        <Setter Property="CommandParameter" Value="{StaticResource Theme.Diwei.Spoken}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PDiweiItemRespelled}" Value="False">
                <Setter Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Diwei.Respelling" TargetType="Button" BasedOn="{StaticResource Theme.Diwei.Choice}">
        <Setter Property="Content" Value="{DynamicResource Tally.Respelling}" />
        <Setter Property="CommandParameter" Value="{StaticResource Theme.Diwei.Spelled}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PDiweiItemRespelled}" Value="True">
                <Setter Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Diwei.Language" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Text" Value="{Binding PTallyLanguage}" />
    </Style>

    <Style x:Key="Theme.Diwei.Kind" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Text" Value="{Binding PTallyKind}" />
    </Style>

    <Style x:Key="Theme.Diwei.MarkText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Text" Value="{Binding LTallyMarkText}" />
    </Style>

    <Style x:Key="Theme.Diwei.MarkNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Text" Value="{Binding LTallyMarkCount}" />
    </Style>

    <Style x:Key="Theme.Diwei.Mark" TargetType="ToggleButton">
        <Setter Property="Margin" Value="0,0,16,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ToolTip" Value="{DynamicResource Tally.Characters}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PTallyPart" Style="{StaticResource Theme.Diwei.MarkText}" />
                            <TextBlock Style="{StaticResource Theme.Diwei.MarkNumber}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PTallyPart" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PTallyPart" Property="Foreground" Value="{StaticResource Theme.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Diwei.MarkPopup" TargetType="Popup">
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="Placement" Value="Bottom" />
        <Setter Property="StaysOpen" Value="False" />
        <Setter Property="VerticalOffset" Value="4" />
        <Setter Property="MaxWidth" Value="360" />
    </Style>

    <Style x:Key="Theme.Diwei.MarkList" TargetType="ItemsControl">
        <Setter Property="Margin" Value="8,6,2,6" />
        <Setter Property="ItemsSource" Value="{Binding LTallyMarkCharacters}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Diwei.Head" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="2,0,2,12" />
        <Setter Property="Padding" Value="0,5,0,0" />
        <Setter Property="Text" Value="{Binding PDiweiItemLabel}" />
    </Style>

    <Style x:Key="Theme.Diwei.Plate" TargetType="Border">
        <Setter Property="Padding" Value="14,8,18,8" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="Background" Value="{StaticResource Theme.Surface}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Theme.Diwei.Reading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Text" Value="{Binding PDiweiLineReading}" />
    </Style>

    <Style x:Key="Theme.Diwei.Rime" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Text" Value="{Binding PDiweiLineRime}" />
    </Style>

    <Style x:Key="Theme.Diwei.Rounded" TargetType="Border">
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PDiweiLineRounded}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Diwei.RoundedText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Warning}" />
        <Setter Property="Text" Value="合" />
    </Style>

    <Style x:Key="Theme.Diwei.Chip" TargetType="Button">
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Command" Value="{x:Static local:PDiweiCommand.PDiweiCommandEntry}" />
        <Setter Property="CommandParameter" Value="{Binding}" />
        <Setter Property="ToolTip" Value="{DynamicResource Glyph.Entry}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" SnapsToDevicePixels="True">
                        <TextBlock x:Name="PDiweiCharacter" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Text="{Binding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PDiweiCharacter" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Theme.Diwei.MarkChip">
        <Grid>
            <ToggleButton x:Name="PTallyDropper" Style="{StaticResource Theme.Diwei.Mark}" />
            <Popup IsOpen="{Binding IsChecked, ElementName=PTallyDropper}" PlacementTarget="{Binding ElementName=PTallyDropper}" Style="{StaticResource Theme.Diwei.MarkPopup}">
                <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                    <ItemsControl Style="{StaticResource Theme.Diwei.MarkList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Theme.Diwei.Chip}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Diwei.TallyLine">
        <Grid MinHeight="26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="PTallyLanguage" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PTallyKind" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Theme.Diwei.Language}" />
            <TextBlock Grid.Column="1" Style="{StaticResource Theme.Diwei.Kind}" />
            <ItemsControl Grid.Column="2" VerticalAlignment="Center" ItemTemplate="{StaticResource Theme.Diwei.MarkChip}" ItemsSource="{Binding PTallyMarks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>
    </DataTemplate>

    <Style x:Key="Theme.Diwei.Tally" TargetType="ItemsControl">
        <Setter Property="Margin" Value="2,0,2,12" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="ItemTemplate" Value="{StaticResource Theme.Diwei.TallyLine}" />
        <Setter Property="ItemsSource" Value="{Binding PDiweiItemTallies}" />
        <Style.Triggers>
            <Trigger Property="HasItems" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="Theme.Diwei.Line">
        <Grid MinHeight="26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="PDiweiReading" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PDiweiRime" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PDiweiRounded" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Theme.Diwei.Reading}" />
            <TextBlock Grid.Column="1" Style="{StaticResource Theme.Diwei.Rime}" />
            <Border Grid.Column="2" Style="{StaticResource Theme.Diwei.Rounded}">
                <TextBlock Style="{StaticResource Theme.Diwei.RoundedText}" />
            </Border>
            <ItemsControl Grid.Column="3" VerticalAlignment="Center" ItemsSource="{Binding PDiweiLineCharacters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Theme.Diwei.Chip}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Diwei.Section">
        <StackPanel Margin="0,0,0,28">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Theme.Diwei.Head}" />
                <Border Grid.Column="1" Style="{StaticResource Theme.Diwei.Switch}">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Theme.Diwei.Ipa}" />
                        <Button Style="{StaticResource Theme.Diwei.Respelling}" />
                    </StackPanel>
                </Border>
            </Grid>
            <ItemsControl Style="{StaticResource Theme.Diwei.Tally}" />
            <Border Style="{StaticResource Theme.Diwei.Plate}">
                <ItemsControl Grid.IsSharedSizeScope="True" ItemTemplate="{StaticResource Theme.Diwei.Line}" ItemsSource="{Binding PDiweiItemLines}" />
            </Border>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
