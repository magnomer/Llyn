<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn;component/UI/PThemePalette.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Diwei.Empty" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Margin" Value="2,25,0,0" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="Theme.Diwei.Head" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="2,0,2,12" />
        <Setter Property="Padding" Value="0,5,0,0" />
        <Setter Property="Text" Value="{Binding PDiweiItemLabel}" />
    </Style>

    <Style x:Key="Theme.Diwei.Plate" TargetType="Border">
        <Setter Property="Padding" Value="14,8,18,8" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="Background" Value="{StaticResource Theme.Surface}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Theme.Diwei.Reading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Text" Value="{Binding PDiweiLineReading}" />
    </Style>

    <Style x:Key="Theme.Diwei.Rime" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Text" Value="{Binding PDiweiLineRime}" />
    </Style>

    <Style x:Key="Theme.Diwei.Rounded" TargetType="Border">
        <Setter Property="Margin" Value="-6,0,14,0" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{StaticResource Theme.AccentSoft}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PDiweiLineRounded}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Diwei.RoundedText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
        <Setter Property="Text" Value="合" />
    </Style>

    <Style x:Key="Theme.Diwei.Chip" TargetType="Button">
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Command" Value="{x:Static local:PDiweiCommand.PDiweiCommandEntry}" />
        <Setter Property="CommandParameter" Value="{Binding}" />
        <Setter Property="ToolTip" Value="{DynamicResource Glyph.Entry}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" SnapsToDevicePixels="True">
                        <TextBlock x:Name="PDiweiCharacter" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Text="{Binding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PDiweiCharacter" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Theme.Diwei.Line">
        <Grid MinHeight="26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="PDiweiReading" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PDiweiRime" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PDiweiRounded" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Theme.Diwei.Reading}" />
            <TextBlock Grid.Column="1" Style="{StaticResource Theme.Diwei.Rime}" />
            <Border Grid.Column="2" Style="{StaticResource Theme.Diwei.Rounded}">
                <TextBlock Style="{StaticResource Theme.Diwei.RoundedText}" />
            </Border>
            <ItemsControl Grid.Column="3" VerticalAlignment="Center" ItemsSource="{Binding PDiweiLineCharacters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Theme.Diwei.Chip}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Diwei.Section">
        <StackPanel Margin="0,0,0,28">
            <TextBlock Style="{StaticResource Theme.Diwei.Head}" />
            <Border Style="{StaticResource Theme.Diwei.Plate}">
                <ItemsControl Grid.IsSharedSizeScope="True" ItemTemplate="{StaticResource Theme.Diwei.Line}" ItemsSource="{Binding PDiweiItemLines}" />
            </Border>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
