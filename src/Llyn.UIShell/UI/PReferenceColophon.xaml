<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn;component/UI/PThemeSpeech.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Reference.Colophon.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Reference.Colophon.Heading" TargetType="TextBlock">
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="2,0,2,12" />
        <Setter Property="Padding" Value="0,5,0,0" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Reference.Colophon.Value" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Reference.Colophon.Chip" TargetType="Border" BasedOn="{StaticResource Theme.Speech.Chip}">
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.AccentEdge}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="Reference.Colophon.Tally" TargetType="Border" BasedOn="{StaticResource Theme.Speech.Chip}">
        <Setter Property="Background" Value="{DynamicResource Theme.SurfaceRaised}" />
    </Style>

    <Style x:Key="Reference.Colophon.Figure" TargetType="TextBlock" BasedOn="{StaticResource Theme.Speech.Name}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}" />
    </Style>

    <DataTemplate x:Key="Reference.Footnote.Card">
        <Button Style="{DynamicResource Theme.Footnote.Row}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Source="{Binding PFootnoteItemFlag}" Stretch="Uniform" />
                <TextBlock Grid.Column="1" Style="{DynamicResource Theme.Catalog.Title}" Text="{Binding PFootnoteItemName}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" Style="{DynamicResource Theme.Catalog.Meta}" Text="{Binding PFootnoteItemLanguage}" />
            </Grid>
        </Button>
    </DataTemplate>

</ResourceDictionary>
