<UserControl
    x:Class="Llyn.UIShell.PSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    >

    <UserControl.Resources>
        <Style x:Key="Theme.Ledger.Row" TargetType="Button" BasedOn="{StaticResource Theme.Catalog.Row}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding PLedgerItemChosen}" Value="True">
                    <Setter Property="Tag" Value="Chosen" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="-34,0,-34,0" Style="{StaticResource Theme.Panel.SeamRow}" />
        <local:PSeam Grid.Row="1" Grid.Column="1" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />

        <Border
            Grid.Row="0"
            Grid.Column="0"
            Margin="{StaticResource Theme.Catalog.HeaderMargin}"
            Style="{StaticResource Theme.Search.Bar}">
            <TextBox
                x:Name="PWinnow"
                Style="{StaticResource Theme.Search.Field}"
                Tag="{DynamicResource Settings.Search}"
                TextChanged="PWinnowHandle" />
        </Border>

        <local:PRail Grid.Row="0" Grid.Column="1" Margin="0,0,0,18">
            <Border Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="PDialFolder"
                        Click="PDialFolderHandle"
                        Content="{DynamicResource Settings.Folder}"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="{local:PIcon folder, 24}" />
                    <Rectangle Style="{StaticResource Theme.Command.Divider}" />
                    <Button
                        x:Name="PDialWidth"
                        Click="PDialWidthHandle"
                        Content="{DynamicResource Settings.Reset}"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="{local:PIcon sort, 24}" />
                </StackPanel>
            </Border>
        </local:PRail>

        <Grid Grid.Row="1" Grid.Column="0" Style="{StaticResource Theme.Catalog.Frame}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl x:Name="PLedger">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="PLedgerHandle" Style="{StaticResource Theme.Ledger.Row}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Theme.Catalog.Title}" Text="{Binding PLedgerItemTitle}" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Theme.Catalog.Meta}" Text="{Binding PLedgerItemMeta}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="PLedgerEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Settings.Empty}"
                Visibility="Collapsed" />
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" Style="{StaticResource Theme.Panel.Surface}">
            <ScrollViewer Margin="30,18,0,0" Padding="0,0,30,30" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource Theme.Scroll.Gutter}" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <Border x:Name="PDialWorkspace" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Card}">
                            <StackPanel>
                                <StackPanel Margin="20,16">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{DynamicResource Settings.Workspace}" />
                                    <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Settings.WorkspaceHelper}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Rectangle Height="1" Fill="{StaticResource Theme.Line}" />
                                <Grid Margin="20,14,20,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="PWorkspacePath"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Height="44"
                                        VerticalAlignment="Center"
                                        LostKeyboardFocus="PWorkspacePathHandle"
                                        Style="{StaticResource Theme.Input.Field}" />
                                    <Button
                                        x:Name="PWorkspaceDialog"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Click="PWorkspaceDialogHandle"
                                        Style="{StaticResource Theme.Input.Action}"
                                        ToolTip="{DynamicResource Workspace.Browse}">
                                        <Path Width="24" Height="24" Data="{local:PIcon folder, 24}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="None" />
                                    </Button>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Workspace.Helper}" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="PDialLanguage" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Card}" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Margin="20,16">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{DynamicResource Settings.Language}" />
                                    <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Settings.LanguageHelper}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Rectangle Height="1" Fill="{StaticResource Theme.Line}" />
                                <Grid Margin="20,14,20,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Settings.Language}" />
                                    <ComboBox
                                        x:Name="PLocalization"
                                        Grid.Column="1"
                                        Width="200"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        SelectedValuePath="Tag"
                                        SelectionChanged="PLocalizationHandle"
                                        Style="{StaticResource Theme.Input.Choice}">
                                        <ComboBoxItem Content="English" Tag="en" />
                                        <ComboBoxItem Content="한국어" Tag="ko" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="PDialTranscription" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Card}" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Margin="20,16">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{DynamicResource Settings.Transcription}" />
                                    <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Settings.TranscriptionHelper}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Rectangle Height="1" Fill="{StaticResource Theme.Line}" />
                                <Grid Margin="20,14,20,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Respelling.Switch}" />
                                        <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Respelling.Helper}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleButton x:Name="PRespelling" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Click="PRespellingHandle" Style="{StaticResource Theme.Choice.Switch}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="PDialWeb" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Card}" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Margin="20,16">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{DynamicResource Settings.Web}" />
                                    <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Settings.WebHelper}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Rectangle Height="1" Fill="{StaticResource Theme.Line}" />
                                <Grid Margin="20,14,20,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Frequency.Switch}" />
                                        <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Frequency.Helper}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleButton x:Name="PFrequency" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Click="PFrequencyHandle" Style="{StaticResource Theme.Choice.Switch}" />
                                </Grid>
                                <Rectangle Height="1" Fill="{StaticResource Theme.Line}" />
                                <Grid Margin="20,14,20,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Morphology.Switch}" />
                                        <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Morphology.Helper}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleButton x:Name="PMorphology" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Click="PMorphologyHandle" Style="{StaticResource Theme.Choice.Switch}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="PDialLayout" VerticalAlignment="Top" Style="{StaticResource Theme.Input.Card}" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Margin="20,16">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{DynamicResource Settings.Layout}" />
                                    <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Settings.LayoutHelper}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Rectangle Height="1" Fill="{StaticResource Theme.Line}" />
                                <Grid Margin="20,14,20,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Layout.Linked}" />
                                        <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Layout.LinkedHelper}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleButton x:Name="PLayoutLinked" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Click="PLayoutLinkedHandle" Style="{StaticResource Theme.Choice.Switch}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="PDialFooter" Margin="0,24,0,0" FontSize="12" Foreground="{StaticResource Theme.Muted}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
