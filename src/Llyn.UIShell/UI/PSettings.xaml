<UserControl
    x:Class="Llyn.UIShell.PSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell"
    >

    <UserControl.Resources>
        <Style x:Key="Theme.Ledger.Row" TargetType="Button" BasedOn="{StaticResource Theme.Catalog.Row}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding PLedgerItemChosen}" Value="True">
                    <Setter Property="Tag" Value="Chosen" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="-34,0,-34,0" Style="{StaticResource Theme.Panel.SeamRow}" />
        <local:PSeam Grid.Row="1" Grid.Column="1" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />

        <Border
            Grid.Row="0"
            Grid.Column="0"
            Margin="{StaticResource Theme.Catalog.HeaderMargin}"
            Style="{StaticResource Theme.Search.Bar}">
            <TextBox
                x:Name="PWinnow"
                Style="{StaticResource Theme.Search.Field}"
                Tag="{DynamicResource Settings.Search}"
                TextChanged="PWinnowHandle" />
        </Border>

        <Grid Grid.Row="1" Grid.Column="0" Style="{StaticResource Theme.Catalog.Frame}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl x:Name="PLedger">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="PLedgerHandle" Style="{StaticResource Theme.Ledger.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource Theme.Catalog.Title}" Text="{Binding PLedgerItemTitle}" />
                                    <TextBlock Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource Theme.Catalog.Meta}" Text="{Binding PLedgerItemMeta}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="PLedgerEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Settings.Empty}"
                Visibility="Collapsed" />
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" Style="{StaticResource Theme.Panel.Surface}">
            <ScrollViewer
                Margin="30,18,0,0"
                Padding="0,0,30,30"
                Focusable="False"
                HorizontalScrollBarVisibility="Disabled"
                Style="{StaticResource Theme.Scroll.Gutter}"
                VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel x:Name="PDialWorkspace">
                        <TextBlock Style="{StaticResource Theme.Page.Title}" Text="{DynamicResource Settings.Workspace}" />
                        <TextBlock MaxWidth="560" HorizontalAlignment="Left" Style="{StaticResource Theme.Page.Helper}" Text="{DynamicResource Settings.WorkspaceHelper}" />
                        <Rectangle Style="{StaticResource Theme.Page.Rule}" />
                        <Grid Margin="0,22,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="560" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="PWorkspacePath"
                                Grid.Row="0"
                                Grid.Column="0"
                                Height="44"
                                VerticalAlignment="Center"
                                KeyDown="PWorkspacePathHandle"
                                LostKeyboardFocus="PWorkspaceFocusHandle"
                                Style="{StaticResource Theme.Input.Field}" />
                            <Button
                                x:Name="PWorkspaceDialog"
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Click="PWorkspaceDialogHandle"
                                Style="{StaticResource Theme.Input.Action}"
                                ToolTip="{DynamicResource Workspace.Browse}">
                                <Path Width="24" Height="24" Data="{local:PIcon folder, 24}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="None" />
                            </Button>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" Style="{StaticResource Theme.Page.Note}" Text="{DynamicResource Workspace.Helper}" />
                        </Grid>
                        <Rectangle Style="{StaticResource Theme.Page.Rule}" />
                        <Button
                            x:Name="PDialFolder"
                            Margin="-13,16,0,0"
                            HorizontalAlignment="Left"
                            Click="PDialFolderHandle"
                            Content="{DynamicResource Settings.Folder}"
                            Style="{StaticResource Theme.Command.Segment}"
                            Tag="{local:PIcon folder, 24}" />
                    </StackPanel>

                    <StackPanel x:Name="PDialLanguage" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Theme.Page.Title}" Text="{DynamicResource Settings.Language}" />
                        <TextBlock MaxWidth="560" HorizontalAlignment="Left" Style="{StaticResource Theme.Page.Helper}" Text="{DynamicResource Settings.LanguageHelper}" />
                        <Rectangle Style="{StaticResource Theme.Page.Rule}" />
                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="560" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Settings.Language}" />
                            <ComboBox
                                x:Name="PLocalization"
                                Grid.Column="1"
                                Width="200"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                SelectedValuePath="Tag"
                                SelectionChanged="PLocalizationHandle"
                                Style="{StaticResource Theme.Input.Choice}">
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="한국어" Tag="ko" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="PDialTranscription" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Theme.Page.Title}" Text="{DynamicResource Settings.Transcription}" />
                        <TextBlock MaxWidth="560" HorizontalAlignment="Left" Style="{StaticResource Theme.Page.Helper}" Text="{DynamicResource Settings.TranscriptionHelper}" />
                        <Rectangle Style="{StaticResource Theme.Page.Rule}" />
                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="560" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Respelling.Switch}" />
                                <TextBlock Style="{StaticResource Theme.Page.Note}" Text="{DynamicResource Respelling.Helper}" />
                            </StackPanel>
                            <ToggleButton
                                x:Name="PRespelling"
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Click="PRespellingHandle"
                                Style="{StaticResource Theme.Choice.Switch}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="PDialWeb" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Theme.Page.Title}" Text="{DynamicResource Settings.Web}" />
                        <TextBlock MaxWidth="560" HorizontalAlignment="Left" Style="{StaticResource Theme.Page.Helper}" Text="{DynamicResource Settings.WebHelper}" />
                        <Rectangle Style="{StaticResource Theme.Page.Rule}" />
                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="560" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Frequency.Switch}" />
                                <TextBlock Style="{StaticResource Theme.Page.Note}" Text="{DynamicResource Frequency.Helper}" />
                            </StackPanel>
                            <ToggleButton
                                x:Name="PFrequency"
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Click="PFrequencyHandle"
                                Style="{StaticResource Theme.Choice.Switch}" />
                        </Grid>
                        <Rectangle Style="{StaticResource Theme.Page.Rule}" />
                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="560" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Morphology.Switch}" />
                                <TextBlock Style="{StaticResource Theme.Page.Note}" Text="{DynamicResource Morphology.Helper}" />
                            </StackPanel>
                            <ToggleButton
                                x:Name="PMorphology"
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Click="PMorphologyHandle"
                                Style="{StaticResource Theme.Choice.Switch}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="PDialLayout" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Theme.Page.Title}" Text="{DynamicResource Settings.Layout}" />
                        <TextBlock MaxWidth="560" HorizontalAlignment="Left" Style="{StaticResource Theme.Page.Helper}" Text="{DynamicResource Settings.LayoutHelper}" />
                        <Rectangle Style="{StaticResource Theme.Page.Rule}" />
                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="560" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Layout.Linked}" />
                                <TextBlock Style="{StaticResource Theme.Page.Note}" Text="{DynamicResource Layout.LinkedHelper}" />
                            </StackPanel>
                            <ToggleButton
                                x:Name="PLayoutLinked"
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Click="PLayoutLinkedHandle"
                                Style="{StaticResource Theme.Choice.Switch}" />
                        </Grid>
                        <Rectangle Style="{StaticResource Theme.Page.Rule}" />
                        <Button
                            x:Name="PDialWidth"
                            Margin="-13,16,0,0"
                            HorizontalAlignment="Left"
                            Click="PDialWidthHandle"
                            Content="{DynamicResource Settings.Reset}"
                            Style="{StaticResource Theme.Command.Segment}"
                            Tag="{local:PIcon sort, 24}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
