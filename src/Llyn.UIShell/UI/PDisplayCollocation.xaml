<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell">

    <DataTemplate x:Key="Display.Collocation.Card">
        <Border Style="{DynamicResource Theme.Card.Shell}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="55" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{DynamicResource Theme.Card.Header}">
                    <Grid Style="{DynamicResource Theme.Card.Crown}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{DynamicResource Theme.Card.Position}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Theme.Accent}"
                                Text="{Binding LCardDraftPosition}" />
                        </Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource Display.Card.Title}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource Display.Card.State}">
                                    <Binding Path="LCardDraftTitle" />
                                    <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Style="{StaticResource Display.Card.Kind}" Text="{DynamicResource Display.CollocationSingle}" />
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Style="{DynamicResource Theme.Card.Body}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Style="{DynamicResource Theme.Card.Gutter}" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Display.Card.Expression}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource Display.Card.State}">
                                    <Binding Path="LCardDraftExpression" />
                                    <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Display.Card.Definition}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource Display.Card.State}">
                                    <Binding Path="LCardDraftMeaning" />
                                    <local:PLocalizationBinder PLocalizationBinderKey="Display.Unreadable" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Display.Card.Body}" Focusable="False" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
