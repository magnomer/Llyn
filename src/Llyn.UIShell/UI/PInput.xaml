<UserControl
    x:Class="Llyn.UIShell.PInput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf">

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Height="51" Margin="9,0,-8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Margin="0,0,16,0">
                <TextBlock Margin="0,0,4,0" FontSize="40" FontWeight="Bold" Opacity="0" IsHitTestVisible="False" Text="Headword">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=PHeadword}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Margin="0,0,4,0" FontSize="40" FontWeight="Bold" Opacity="0" IsHitTestVisible="False" Text="{Binding Text, ElementName=PHeadword}" />
                <TextBox x:Name="PHeadword" HorizontalAlignment="Stretch" Style="{StaticResource Theme.Input.Headword}" Tag="Headword" />
            </Grid>

            <Grid x:Name="PLangcode" Grid.Column="1">
                <ToggleButton
                    x:Name="PLangcodeBase"
                    Width="170"
                    Height="41"
                    Padding="17,0"
                    HorizontalContentAlignment="Stretch"
                    Background="{StaticResource Theme.Surface}"
                    BorderBrush="{StaticResource Theme.Line}"
                    BorderThickness="1"
                    Style="{StaticResource Theme.Input.TogglePill}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="19" Height="14" VerticalAlignment="Center">
                            <Image x:Name="PLangcodeBaseFlag" Stretch="Uniform" />
                            <Ellipse x:Name="PLangcodeBaseGlobe" Width="12" Height="12" Stroke="{StaticResource Theme.Muted}" StrokeThickness="1.2" />
                        </Grid>
                        <TextBlock x:Name="PLangcodeBaseName" Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontSize="13" Text="English" />
                        <Path Grid.Column="2" Width="8" Height="4" Data="M 0,0 L 4,3 L 8,0" Stroke="{StaticResource Theme.Muted}" StrokeThickness="1.5" />
                    </Grid>
                </ToggleButton>
                <Popup
                    x:Name="PLangcodeList"
                    Width="170"
                    Margin="0,5,0,0"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsChecked, ElementName=PLangcodeBase}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=PLangcodeBase}"
                    StaysOpen="False">
                    <Border Padding="5" Background="White" BorderBrush="{StaticResource Theme.Line}" BorderThickness="1" CornerRadius="8">
                        <ItemsControl x:Name="PLangcodeListMenu" ItemTemplate="{DynamicResource Theme.Langcode.Row}" />
                    </Border>
                </Popup>
            </Grid>

            <Button x:Name="PDiscard" Grid.Column="3" Width="144" Height="51" Margin="0,0,14,0" Click="PDiscardHandle" Style="{StaticResource Theme.Input.Pill}">
                <StackPanel Orientation="Horizontal">
                    <!-- Phosphor trash.svg. SvgViewbox has no foreground of its own, so the
                         glyph is used as an opacity mask over the button's foreground. -->
                    <Rectangle Width="14" Height="16" Margin="0,0,9,0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform">
                                <VisualBrush.Visual>
                                    <svgc:SvgViewbox Width="14" Height="16" Source="icons/trash.svg" />
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock VerticalAlignment="Center" Text="Discard" />
                </StackPanel>
            </Button>
            <Button x:Name="PStore" Grid.Column="4" Width="162" Height="51" Click="PStoreHandle" Style="{StaticResource Theme.Input.Primary}">
                <StackPanel Orientation="Horizontal">
                    <!-- Phosphor floppy-disk.svg, tinted through an opacity mask (see PDiscard). -->
                    <Rectangle Width="15" Height="15" Margin="0,0,9,0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform">
                                <VisualBrush.Visual>
                                    <svgc:SvgViewbox Width="15" Height="15" Source="icons/floppy-disk.svg" />
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock VerticalAlignment="Center" Text="Save entry" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Height="49" Margin="9,20,0,0" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Height="49" MaxWidth="360" HorizontalAlignment="Left" Background="{StaticResource Theme.AccentSoft}" BorderBrush="{StaticResource Theme.AccentSoft}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Text="[" />
                    <TextBox x:Name="PPronunciation" Grid.Column="1" MaxWidth="292" MinHeight="40" Padding="4,0" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" FontSize="15" Foreground="{StaticResource Theme.Ink}" Style="{StaticResource Theme.Input.Field}" Tag="Pronunciation" VerticalContentAlignment="Center" />
                    <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Text="]" />
                </Grid>
            </Border>

            <Button x:Name="PPlayback" Grid.Column="1" Width="50" Height="49" Margin="14,0,0,0" Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Line}" Foreground="{StaticResource Theme.Accent}" Click="PPlaybackHandle" Style="{StaticResource Theme.Input.Action}" Visibility="Collapsed">
                <!-- Phosphor play.svg, tinted through an opacity mask (see PDiscard). -->
                <Rectangle Width="13" Height="15" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform">
                            <VisualBrush.Visual>
                                <svgc:SvgViewbox Width="13" Height="15" Source="icons/play.svg" />
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
            </Button>

            <Grid Grid.Column="2" Margin="14,0,0,0">
                <ToggleButton x:Name="PLookup" Width="50" Height="49" Padding="0" Foreground="{StaticResource Theme.Accent}" Checked="PLookupCheckedHandle" Unchecked="PLookupUncheckedHandle" Style="{StaticResource Theme.Input.ToggleAction}">
                    <!-- Phosphor magnifying-glass.svg, tinted through an opacity mask (see PDiscard). -->
                    <Rectangle Width="15" Height="15" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform">
                                <VisualBrush.Visual>
                                    <svgc:SvgViewbox Width="15" Height="15" Source="icons/magnifying-glass.svg" />
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </ToggleButton>
                <Popup
                    x:Name="PLookupMenu"
                    Width="328"
                    Margin="0,6,0,0"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsChecked, ElementName=PLookup}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=PLookup}"
                    StaysOpen="False">
                    <Border Margin="8" Padding="8" Background="{StaticResource Theme.SurfaceRaised}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="1" CornerRadius="13">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22" Direction="270" Opacity="0.18" ShadowDepth="7" />
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="8,6,8,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" Background="{StaticResource Theme.AccentSoft}" CornerRadius="8">
                                    <Path Width="13" Height="13" Data="M 5.5,1 A 4.5,4.5 0 1 0 5.5,10 A 4.5,4.5 0 1 0 5.5,1 M 9,9 L 13,13" Stretch="Fill" Stroke="{StaticResource Theme.Accent}" StrokeEndLineCap="Round" StrokeThickness="1.5" />
                                </Border>
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Theme.Ink}" Text="{DynamicResource Lookup.Title}" />
                            </Grid>
                            <Border x:Name="PLookupStatusCard" Margin="4,5" Padding="12,11" Background="{StaticResource Theme.Surface}" CornerRadius="9" Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="PLookupMenuStatus" VerticalAlignment="Center" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Lookup.Searching}" />
                                    <Border x:Name="PLookupProgress" Grid.Row="1" Height="3" Margin="0,10,0,0" Background="{StaticResource Theme.AccentSoft}" ClipToBounds="True" CornerRadius="2">
                                        <Border Width="86" HorizontalAlignment="Left" Background="{StaticResource Theme.Accent}" CornerRadius="2">
                                            <Border.RenderTransform>
                                                <TranslateTransform X="-86" />
                                            </Border.RenderTransform>
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="-86" To="276" Duration="0:0:1.15" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                        </Border>
                                    </Border>
                                </Grid>
                            </Border>
                            <ScrollViewer MaxHeight="286" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="PLookupMenuList" ItemTemplate="{DynamicResource Theme.Lookup.Row}" Visibility="Collapsed">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <Grid Grid.Column="3" Margin="14,0,0,0">
                <ToggleButton x:Name="PDownloader" Width="50" Height="49" Foreground="{StaticResource Theme.Accent}" Checked="PDownloaderCheckedHandle" Unchecked="PDownloaderUncheckedHandle" Style="{StaticResource Theme.Input.ToggleAction}">
                    <!-- Phosphor box-arrow-down.svg, tinted through an opacity mask (see PDiscard). -->
                    <Rectangle Width="15" Height="15" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform">
                                <VisualBrush.Visual>
                                    <svgc:SvgViewbox Width="15" Height="15" Source="icons/box-arrow-down.svg" />
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </ToggleButton>
                <Popup
                    x:Name="PDownloaderMenu"
                    Width="352"
                    Margin="0,6,0,0"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsChecked, ElementName=PDownloader}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=PDownloader}"
                    StaysOpen="False">
                    <Border Margin="8" Padding="8" Background="{StaticResource Theme.SurfaceRaised}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="1" CornerRadius="13">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22" Direction="270" Opacity="0.18" ShadowDepth="7" />
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="8,6,8,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" Background="{StaticResource Theme.AccentSoft}" CornerRadius="8">
                                    <Path Width="13" Height="13" Data="M 6.5,0 L 6.5,8 M 3,5 L 6.5,8.5 L 10,5 M 1,11.5 L 12,11.5" Stretch="Fill" Stroke="{StaticResource Theme.Accent}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeThickness="1.5" />
                                </Border>
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Theme.Ink}" Text="{DynamicResource Downloader.Title}" />
                            </Grid>
                            <Border x:Name="PDownloaderStatusCard" Margin="4,5" Padding="12,11" Background="{StaticResource Theme.Surface}" CornerRadius="9" Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="PDownloaderMenuStatus" VerticalAlignment="Center" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Downloader.Searching}" />
                                    <Border x:Name="PDownloaderProgress" Grid.Row="1" Height="3" Margin="0,10,0,0" Background="{StaticResource Theme.AccentSoft}" ClipToBounds="True" CornerRadius="2">
                                        <Border Width="92" HorizontalAlignment="Left" Background="{StaticResource Theme.Accent}" CornerRadius="2">
                                            <Border.RenderTransform>
                                                <TranslateTransform X="-92" />
                                            </Border.RenderTransform>
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="-92" To="300" Duration="0:0:1.15" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                        </Border>
                                    </Border>
                                </Grid>
                            </Border>
                            <ScrollViewer MaxHeight="286" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="PDownloaderMenuList" ItemTemplate="{DynamicResource Theme.Downloader.Row}" Visibility="Collapsed">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Margin="-34,20,-34,0" BorderBrush="{StaticResource Theme.Line}" BorderThickness="0,0,0,1">
            <StackPanel x:Name="PStack" Margin="29,0,0,0" Orientation="Horizontal">
                <Button x:Name="PStackMeaning" Content="Meaning" Click="PStackHandle" Style="{StaticResource Theme.Input.Tab.Selected}" />
                <Button x:Name="PStackCollocation" Content="Collocation" Click="PStackHandle" Style="{StaticResource Theme.Input.Tab}" />
                <Button x:Name="PStackNote" Content="Note" Click="PStackHandle" Style="{StaticResource Theme.Input.Tab}" />
            </StackPanel>
        </Border>

        <Border x:Name="PContents" Grid.Row="3" Padding="0,22,0,0" Background="Transparent">
            <Grid>
                <ScrollViewer x:Name="PMeaning" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl x:Name="PSenseList" ItemTemplate="{DynamicResource Theme.Sense.Card}" />

                        <Button Height="56" Margin="0,20,0,0" Foreground="{StaticResource Theme.Accent}" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" Click="PSenseHandle">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" Margin="0,0,9,0" Background="{StaticResource Theme.Accent}" CornerRadius="10">
                                    <Grid>
                                        <Rectangle Width="10" Height="1.5" Fill="White" />
                                        <Rectangle Width="1.5" Height="10" Fill="White" />
                                    </Grid>
                                </Border>
                                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Theme.Accent}" Text="Add another sense" />
                            </StackPanel>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <Rectangle RadiusX="10" RadiusY="10" Stroke="{StaticResource Theme.Accent}" StrokeDashArray="5,3" StrokeThickness="1" Opacity="0.52" />
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="PCollocation" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <ItemsControl x:Name="PCollocationList" ItemTemplate="{DynamicResource Theme.Collocation.Card}" />

                        <Button Height="56" Margin="0,20,0,0" Foreground="{StaticResource Theme.Accent}" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" Click="PCollocationHandle">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" Margin="0,0,9,0" Background="{StaticResource Theme.Accent}" CornerRadius="10">
                                    <Grid>
                                        <Rectangle Width="10" Height="1.5" Fill="White" />
                                        <Rectangle Width="1.5" Height="10" Fill="White" />
                                    </Grid>
                                </Border>
                                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Theme.Accent}" Text="Add another collocation" />
                            </StackPanel>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <Rectangle RadiusX="10" RadiusY="10" Stroke="{StaticResource Theme.Accent}" StrokeDashArray="5,3" StrokeThickness="1" Opacity="0.52" />
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <Border x:Name="PNote" VerticalAlignment="Stretch" Style="{StaticResource Theme.Input.Card}" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="55" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                            <TextBlock Margin="22,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Note" />
                        </Border>
                        <Border Grid.Row="1" Margin="22,18,22,22" Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="1" CornerRadius="7">
                            <Grid>
                                <TextBlock x:Name="PNotePlaceholder" Margin="14,12" Foreground="{StaticResource Theme.Muted}" IsHitTestVisible="False" Opacity="0.56" Text="Write a note about this entry" />
                                <TextBox x:Name="PNoteContents" Padding="10,6" VerticalAlignment="Stretch" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Theme.Ink}" CaretBrush="{StaticResource Theme.Ink}" TextChanged="PNoteContentsHandle" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
