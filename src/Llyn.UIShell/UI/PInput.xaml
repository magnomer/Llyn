<UserControl
    x:Class="Llyn.UIShell.PInput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIShell">

    <!--
        The lexical editing structure is the shared editor, so this panel is that editor standing on no
        entry: a form that creates one. The browse-style panels mount the same control over an entry
        they loaded. The padding is this panel's own — the editor fills the whole tab here.
    -->
    <local:PEditor x:Name="PEditor" Padding="34,20,34,38" />
</UserControl>
