<UserControl
    x:Class="Llyn.UIShell.PEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf">

    <Grid Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Height="51" Margin="9,0,-8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Margin="0,0,16,0">
                <TextBlock x:Name="PHeadwordHint" Margin="0,0,4,0" Opacity="0" IsHitTestVisible="False" Text="{DynamicResource Input.Headword}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Theme.Text.Headword}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=PHeadword}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock x:Name="PHeadwordGhost" Margin="0,0,4,0" Opacity="0" IsHitTestVisible="False" Style="{StaticResource Theme.Text.Headword}" Text="{Binding Text, ElementName=PHeadword}" />
                <TextBox x:Name="PHeadword" HorizontalAlignment="Stretch" Style="{StaticResource Theme.Input.Headword}" Tag="{DynamicResource Input.Headword}" />
            </Grid>

            <Grid Grid.Column="1">
                <ToggleButton x:Name="PSpeaker" Style="{StaticResource Theme.Language.Toggle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="19" Height="14" VerticalAlignment="Center">
                            <Image x:Name="PSpeakerFlag" Stretch="Uniform" />
                            <Ellipse x:Name="PSpeakerGlobe" Width="12" Height="12" Stroke="{StaticResource Theme.Accent}" StrokeThickness="1.2" />
                        </Grid>
                        <TextBlock x:Name="PSpeakerName" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Theme.Language.Name}" Text="English" />
                        <Path Grid.Column="2" Width="8" Height="4" Margin="8,0,0,0" VerticalAlignment="Center" Data="M 0,0 L 4,3 L 8,0" Stroke="{StaticResource Theme.Accent}" StrokeThickness="1.5" />
                    </Grid>
                </ToggleButton>
                <Popup
                    x:Name="PLanguage"
                    Width="190"
                    Margin="0,6,0,0"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsChecked, ElementName=PSpeaker}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=PSpeaker}"
                    StaysOpen="False">

                    <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                        <ItemsControl x:Name="PLanguageList" ItemTemplate="{DynamicResource Theme.Language.Row}" />
                    </Border>
                </Popup>
            </Grid>

            <Button x:Name="PEditorDiscard" Grid.Column="3" Width="144" Height="51" Margin="0,0,14,0" Click="PEditorDiscardHandle" IsEnabled="False" Style="{StaticResource Theme.Input.Pill}">
                <StackPanel Orientation="Horizontal">

                    <Rectangle Width="14" Height="16" Margin="0,0,9,0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform">
                                <VisualBrush.Visual>
                                    <svgc:SvgViewbox Width="14" Height="16" Source="icons/trash.svg" />
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource Input.Discard}" />
                </StackPanel>
            </Button>
            <Button x:Name="PEditorStore" Grid.Column="4" Width="162" Height="51" Click="PEditorStoreHandle" IsEnabled="False" Style="{StaticResource Theme.Input.Primary}">
                <StackPanel Orientation="Horizontal">

                    <Rectangle Width="15" Height="15" Margin="0,0,9,0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform">
                                <VisualBrush.Visual>
                                    <svgc:SvgViewbox Width="15" Height="15" Source="icons/floppy-disk.svg" />
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource Input.Store}" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Height="49" Margin="9,20,0,0" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Height="49" MaxWidth="360" HorizontalAlignment="Left" Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Text="[" />
                    <TextBox x:Name="PPronunciation" Grid.Column="1" MaxWidth="292" MinHeight="40" Padding="4,0" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" FontSize="15" Foreground="{StaticResource Theme.Ink}" Style="{StaticResource Theme.Input.Field}" Tag="{DynamicResource Input.Pronunciation}" VerticalContentAlignment="Center" />
                    <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Text="]" />
                </Grid>
            </Border>

            <Button x:Name="PPlayback" Grid.Column="1" Width="50" Height="49" Margin="14,0,0,0" Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Line}" Foreground="{StaticResource Theme.Accent}" Click="PPlaybackHandle" Style="{StaticResource Theme.Input.Action}" Visibility="Collapsed">

                <Rectangle Width="13" Height="15" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform">
                            <VisualBrush.Visual>
                                <svgc:SvgViewbox Width="13" Height="15" Source="icons/play.svg" />
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
            </Button>

            <Grid Grid.Column="2" Margin="14,0,0,0">
                <ToggleButton x:Name="PTranscriber" Width="50" Height="49" Padding="0" Foreground="{StaticResource Theme.Accent}" Checked="PTranscriberCheckedHandle" Unchecked="PTranscriberUncheckedHandle" Style="{StaticResource Theme.Input.ToggleAction}">

                    <Rectangle Width="15" Height="15" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform">
                                <VisualBrush.Visual>
                                    <svgc:SvgViewbox Width="15" Height="15" Source="icons/magnifying-glass.svg" />
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </ToggleButton>
                <Popup
                    x:Name="PNotation"
                    Width="320"
                    Margin="0,6,0,0"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsChecked, ElementName=PTranscriber}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=PTranscriber}"
                    StaysOpen="False">
                    <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Theme.Popup.Title}" Text="{DynamicResource Transcriber.Title}" />
                            <Border x:Name="PNotationProgress" Style="{StaticResource Theme.Popup.Progress}" Visibility="Collapsed">
                                <Border Width="84" HorizontalAlignment="Left" Background="{StaticResource Theme.Accent}" CornerRadius="1">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="-84" />
                                    </Border.RenderTransform>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="-84" To="268" Duration="0:0:1.15" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                            </Border>
                            <TextBlock x:Name="PNotationNotice" Style="{StaticResource Theme.Popup.Notice}" Text="{DynamicResource Transcriber.Searching}" Visibility="Collapsed" />
                            <ScrollViewer MaxHeight="264" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="PNotationList" ItemTemplate="{DynamicResource Theme.Notation.Row}" Visibility="Collapsed">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <Grid Grid.Column="3" Margin="14,0,0,0">
                <ToggleButton x:Name="PDownloader" Width="50" Height="49" Foreground="{StaticResource Theme.Accent}" Checked="PDownloaderCheckedHandle" Unchecked="PDownloaderUncheckedHandle" Style="{StaticResource Theme.Input.ToggleAction}">

                    <Rectangle Width="15" Height="15" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform">
                                <VisualBrush.Visual>
                                    <svgc:SvgViewbox Width="15" Height="15" Source="icons/box-arrow-down.svg" />
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </ToggleButton>
                <Popup
                    x:Name="PClip"
                    Width="320"
                    Margin="0,6,0,0"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsChecked, ElementName=PDownloader}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=PDownloader}"
                    StaysOpen="False">
                    <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Theme.Popup.Title}" Text="{DynamicResource Downloader.Title}" />
                            <Border x:Name="PClipProgress" Style="{StaticResource Theme.Popup.Progress}" Visibility="Collapsed">
                                <Border Width="84" HorizontalAlignment="Left" Background="{StaticResource Theme.Accent}" CornerRadius="1">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="-84" />
                                    </Border.RenderTransform>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="-84" To="268" Duration="0:0:1.15" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                            </Border>
                            <TextBlock x:Name="PClipNotice" Style="{StaticResource Theme.Popup.Notice}" Text="{DynamicResource Downloader.Searching}" Visibility="Collapsed" />
                            <ScrollViewer MaxHeight="264" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="PClipList" ItemTemplate="{DynamicResource Theme.Clip.Row}" Visibility="Collapsed">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

        </Grid>

        <WrapPanel x:Name="PMarker" Grid.Row="2" Margin="9,14,0,0" Orientation="Horizontal">

            <ItemsControl x:Name="PMarkerList" MaxWidth="{Binding ActualWidth, ElementName=PMarker}" VerticalAlignment="Top" ItemTemplate="{DynamicResource Theme.Marker.Chip}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Grid Margin="0,0,0,6" VerticalAlignment="Top">
                <Border Height="41" VerticalAlignment="Top" Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="PMarkerField" Width="212" MinHeight="33" Padding="12,0" Background="Transparent" BorderThickness="0" FontSize="15" Foreground="{StaticResource Theme.Ink}" Style="{StaticResource Theme.Input.Field}" Tag="{DynamicResource Speech.Title}" VerticalContentAlignment="Center" />
                        <ToggleButton x:Name="PMarkerSwitch" Grid.Column="1" Width="38" Height="39" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Theme.Muted}" Style="{StaticResource Theme.Input.ToggleAction}">
                            <Path Width="8" Height="4" Data="M 0,0 L 4,3 L 8,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" />
                        </ToggleButton>
                    </Grid>
                </Border>
                <Popup
                    x:Name="PCategory"
                    Width="260"
                    Margin="0,6,0,0"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsChecked, ElementName=PMarkerSwitch}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=PMarkerSwitch}"
                    StaysOpen="False">
                    <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Theme.Popup.Title}" Text="{DynamicResource Speech.Title}" />
                            <TextBlock x:Name="PCategoryNotice" Style="{StaticResource Theme.Popup.Notice}" Text="{DynamicResource Speech.Empty}" Visibility="Collapsed" />
                            <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="PCategoryList" ItemTemplate="{DynamicResource Theme.Category.Row}">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </WrapPanel>

        <Border Grid.Row="3" Margin="-34,20,-34,0" BorderBrush="{StaticResource Theme.Line}" BorderThickness="0,0,0,1">
            <StackPanel x:Name="PStack" Margin="29,0,0,0" Orientation="Horizontal">
                <Button x:Name="PStackMeaning" Content="{DynamicResource Display.Meaning}" Click="PStackHandle" Style="{StaticResource Theme.Input.Tab.Selected}" />
                <Button x:Name="PStackCollocation" Content="{DynamicResource Display.CollocationSingle}" Click="PStackHandle" Style="{StaticResource Theme.Input.Tab}" />
                <Button x:Name="PStackNote" Content="{DynamicResource Display.Note}" Click="PStackHandle" Style="{StaticResource Theme.Input.Tab}" />
            </StackPanel>
        </Border>

        <Border x:Name="PContents" Grid.Row="4" Padding="0,22,0,0" Background="Transparent">
            <Grid>
                <ScrollViewer x:Name="PMeaning" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl x:Name="PMeaningList" LostMouseCapture="PCardDragCancel" MouseLeftButtonUp="PCardDragFinish" MouseMove="PCardDragUpdate" ItemTemplate="{DynamicResource Theme.Meaning.Card}" />

                        <Button Height="56" Margin="0,20,0,0" Foreground="{StaticResource Theme.Accent}" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" Click="PMeaningHandle">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" Margin="0,0,9,0" Background="{StaticResource Theme.Accent}" CornerRadius="10">
                                    <Grid>
                                        <Rectangle Width="10" Height="1.5" Fill="White" />
                                        <Rectangle Width="1.5" Height="10" Fill="White" />
                                    </Grid>
                                </Border>
                                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Theme.Accent}" Text="{DynamicResource Input.MeaningAdd}" />
                            </StackPanel>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <Rectangle RadiusX="10" RadiusY="10" Stroke="{StaticResource Theme.Accent}" StrokeDashArray="5,3" StrokeThickness="1" Opacity="0.52" />
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="PCollocation" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <ItemsControl x:Name="PCollocationList" LostMouseCapture="PCardDragCancel" MouseLeftButtonUp="PCardDragFinish" MouseMove="PCardDragUpdate" ItemTemplate="{DynamicResource Theme.Collocation.Card}" />

                        <Button Height="56" Margin="0,20,0,0" Foreground="{StaticResource Theme.Accent}" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" Click="PCollocationHandle">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" Margin="0,0,9,0" Background="{StaticResource Theme.Accent}" CornerRadius="10">
                                    <Grid>
                                        <Rectangle Width="10" Height="1.5" Fill="White" />
                                        <Rectangle Width="1.5" Height="10" Fill="White" />
                                    </Grid>
                                </Border>
                                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Theme.Accent}" Text="{DynamicResource Input.CollocationAdd}" />
                            </StackPanel>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <Rectangle RadiusX="10" RadiusY="10" Stroke="{StaticResource Theme.Accent}" StrokeDashArray="5,3" StrokeThickness="1" Opacity="0.52" />
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <Border x:Name="PNote" VerticalAlignment="Stretch" Style="{StaticResource Theme.Input.Card}" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="55" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                            <TextBlock Margin="22,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{DynamicResource Display.Note}" />
                        </Border>
                        <TextBox x:Name="PNoteContents" Grid.Row="1" Margin="22,18,22,22" Padding="14,12" VerticalAlignment="Stretch" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource Theme.Input.Field}" Tag="{DynamicResource Input.NoteHint}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Popup
            x:Name="PProspect"
            Grid.Row="4"
            Width="320"
            Margin="0,4,0,0"
            AllowsTransparency="True"
            Placement="Bottom"
            StaysOpen="False">
            <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                <ListBox
                    x:Name="PProspectList"
                    MaxHeight="264"
                    Background="Transparent"
                    BorderThickness="0"
                    Focusable="False"
                    ItemTemplate="{DynamicResource Theme.Prospect.Row}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionMode="Single">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="PSurface" MinHeight="38" Padding="10,0" Background="Transparent" CornerRadius="9">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.SurfaceRaised}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
