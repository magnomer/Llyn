<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Llyn</AssemblyName>
    <RootNamespace>Llyn.UIShell</RootNamespace>
    <ApplicationIcon>..\..\assets\brand\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Llyn.Core\Llyn.Core.csproj" />
    <ProjectReference Include="..\Llyn.Media\Llyn.Media.csproj" />
    <ProjectReference Include="..\Llyn.ShellEngine\Llyn.ShellEngine.csproj" />
  </ItemGroup>

  <ItemGroup>

    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />

    <PackageReference Include="SharpVectors.Wpf" Version="1.8.4.2" />
  </ItemGroup>

  <ItemGroup>

    <Resource Include="..\..\assets\icons\**\*.svg" Link="icons\%(RecursiveDir)%(Filename)%(Extension)" />
    <Resource Include="..\..\assets\brand\icon.png" Link="brand\icon.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\localization\en.json" LogicalName="Llyn.UIShell.Localization.en.json" />
    <EmbeddedResource Include="..\..\localization\ko.json" LogicalName="Llyn.UIShell.Localization.ko.json" />
    <EmbeddedResource Include="..\..\themes\default.json" LogicalName="Llyn.UIShell.Themes.default.json" />
  </ItemGroup>
</Project>
