<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Llyn.UIShell</AssemblyName>
    <RootNamespace>Llyn.UIShell</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\localization\en.json" LogicalName="Llyn.UIShell.Localization.en.json" />
    <EmbeddedResource Include="..\..\localization\ko.json" LogicalName="Llyn.UIShell.Localization.ko.json" />
    <EmbeddedResource Include="..\..\themes\default.json" LogicalName="Llyn.UIShell.Themes.default.json" />
  </ItemGroup>
</Project>
