<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="14" />
        <Setter Property="MinWidth" Value="14" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template" Value="{DynamicResource Theme.ScrollBar.Vertical.Template}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Template" Value="{DynamicResource Theme.Scroll.Gutter.Template}" />
    </Style>

    <Style x:Key="Theme.Scroll.Gutter" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}" />

    <Style x:Key="Theme.Scroll.Lane" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

</ResourceDictionary>
