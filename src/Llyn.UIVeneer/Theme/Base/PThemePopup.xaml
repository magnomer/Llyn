<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn;component/Theme/Base/PThemePalette.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Popup.Surface" TargetType="Border">
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="{StaticResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="10" Direction="270" Opacity="0.18" ShadowDepth="4" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Popup.Title" TargetType="TextBlock">
        <Setter Property="Margin" Value="10,7,10,5" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
    </Style>

    <Style x:Key="Theme.Popup.Notice" TargetType="TextBlock">
        <Setter Property="Margin" Value="10,5,10,9" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
    </Style>

    <Style x:Key="Theme.Popup.Progress" TargetType="Border">
        <Setter Property="Height" Value="2" />
        <Setter Property="Margin" Value="10,1,10,3" />
        <Setter Property="Background" Value="{StaticResource Theme.AccentSoft}" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style x:Key="Theme.Popup.ProgressBar" TargetType="Border">
        <Setter Property="Width" Value="84" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{StaticResource Theme.Accent}" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform X="-84" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="-84" To="268" Duration="0:0:1.15" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Popup.RowSurface" TargetType="Border">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="9" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Theme.SurfaceRaised}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Popup.RowChoice" TargetType="Button">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="PSurface"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="12">
                        <TextBlock
                            x:Name="PLabel"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            Foreground="{TemplateBinding Foreground}"
                            Text="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.Accent}" />
                            <Setter TargetName="PSurface" Property="BorderBrush" Value="{StaticResource Theme.Accent}" />
                            <Setter TargetName="PLabel" Property="Foreground" Value="{StaticResource Theme.Roof}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.AccentPress}" />
                            <Setter TargetName="PSurface" Property="BorderBrush" Value="{StaticResource Theme.AccentPress}" />
                            <Setter TargetName="PLabel" Property="Foreground" Value="{StaticResource Theme.Roof}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PSurface" Property="Background" Value="Transparent" />
                            <Setter TargetName="PSurface" Property="BorderBrush" Value="{StaticResource Theme.DisabledLine}" />
                            <Setter TargetName="PLabel" Property="Foreground" Value="{StaticResource Theme.DisabledInk}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Popup.RowReading" TargetType="Button">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="PSurface"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="13">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.Accent}" />
                            <Setter TargetName="PSurface" Property="BorderBrush" Value="{StaticResource Theme.Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Theme.Roof}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.AccentPress}" />
                            <Setter TargetName="PSurface" Property="BorderBrush" Value="{StaticResource Theme.AccentPress}" />
                            <Setter Property="Foreground" Value="{StaticResource Theme.Roof}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Popup.IconAction" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PSurface" Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PSurface" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
