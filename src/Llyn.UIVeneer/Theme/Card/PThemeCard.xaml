<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemeInput.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <sys:Double x:Key="Theme.Card.TitleSize">16</sys:Double>

    <sys:Double x:Key="Theme.Card.DefinitionSize">16</sys:Double>

    <sys:Double x:Key="Theme.Card.SituationSize">13</sys:Double>

    <sys:Double x:Key="Theme.Card.RegisterSize">13</sys:Double>

    <sys:Double x:Key="Theme.Card.ExampleSize">15</sys:Double>

    <sys:Double x:Key="Theme.Card.GlossSize">15</sys:Double>

    <FontStyle x:Key="Theme.Card.GlossStyle">Normal</FontStyle>

    <sys:Double x:Key="Theme.Card.FrameSize">15</sys:Double>

    <Thickness x:Key="Theme.Card.FrameMargin">0,0,16,0</Thickness>

    <FontFamily x:Key="Theme.Card.ExampleFamily">Georgia, Segoe UI</FontFamily>

    <FontFamily x:Key="Theme.Card.GlossFamily">Georgia, Segoe UI</FontFamily>

    <Thickness x:Key="Theme.Card.ExpressionMargin">0,0,0,7</Thickness>

    <Thickness x:Key="Theme.Card.SituationMargin">0,18,0,0</Thickness>

    <Thickness x:Key="Theme.Card.RegisterMargin">0,10,0,0</Thickness>

    <Thickness x:Key="Theme.Card.ChipMargin">0,15,0,0</Thickness>

    <Thickness x:Key="Theme.Card.ChipTightMargin">0,10,0,0</Thickness>

    <Thickness x:Key="Theme.Card.TagMargin">0,24,0,0</Thickness>

    <Thickness x:Key="Theme.Card.ExampleMargin">0,16,0,0</Thickness>

    <Thickness x:Key="Theme.Card.ExamplePadding">14,1,0,0</Thickness>

    <Thickness x:Key="Theme.Card.ExampleLineMargin">0,0,0,7</Thickness>

    <Thickness x:Key="Theme.Card.MediaMargin">14,16,0,0</Thickness>

    <Style x:Key="Theme.Card.Shell" TargetType="Border" BasedOn="{StaticResource Theme.Input.Card}">
        <Setter Property="Margin" Value="0,0,0,15" />
    </Style>

    <Style x:Key="Theme.Card.Header" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="12,12,0,0" />
    </Style>

    <Style x:Key="Theme.Card.Crown" TargetType="Grid">
        <Setter Property="Margin" Value="22,0" />
    </Style>

    <Style x:Key="Theme.Card.Position" TargetType="Border">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource Theme.AccentSoft}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PCardPositionActive}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Theme.Accent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Card.Ordinal" TargetType="TextBox" BasedOn="{StaticResource Theme.Input.Bare}">
        <Setter Property="Template" Value="{DynamicResource Theme.Input.Field.Plain}" />
        <Setter Property="Padding" Value="2,0,0,0" />
        <Setter Property="MaxLength" Value="3" />
        <Setter Property="AcceptsReturn" Value="False" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
        <Setter Property="CaretBrush" Value="{StaticResource Theme.Accent}" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PCardPositionActive}" Value="True">
                <Setter Property="IsReadOnly" Value="False" />
                <Setter Property="IsHitTestVisible" Value="True" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Card.Body" TargetType="Grid">
        <Setter Property="Margin" Value="30,21,30,24" />
    </Style>

    <Style x:Key="Theme.Card.Gutter" TargetType="ColumnDefinition">
        <Setter Property="Width" Value="76" />
    </Style>

    <Style x:Key="Theme.Card.Reach" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,-76,0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="Theme.Card.Example" TargetType="Border">
        <Setter Property="Margin" Value="{StaticResource Theme.Card.ExampleMargin}" />
        <Setter Property="Padding" Value="{StaticResource Theme.Card.ExamplePadding}" />
    </Style>

    <Style x:Key="Theme.Card.Media" TargetType="ItemsControl">
        <Setter Property="Margin" Value="{StaticResource Theme.Card.MediaMargin}" />
    </Style>

    <Style x:Key="Theme.Card.Control" TargetType="FrameworkElement">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="IsHitTestVisible" Value="True" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="IsHitTestVisible" Value="True" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Card.Preview" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{StaticResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
    </Style>

    <Style x:Key="Theme.Card.Pellet" TargetType="Border">
        <Setter Property="Margin" Value="0,0,9,7" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Background" Value="{StaticResource Theme.AccentSoft}" />
        <Setter Property="CornerRadius" Value="13" />
    </Style>

    <Style x:Key="Theme.Card.Badge" TargetType="Border">
        <Setter Property="Margin" Value="0,0,7,7" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
    </Style>

    <Style x:Key="Theme.Card.Situation" TargetType="Border">
        <Setter Property="Margin" Value="0,0,9,7" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="{StaticResource Theme.SituationSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.SituationEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
    </Style>

    <Style x:Key="Theme.Card.Register" TargetType="Border">
        <Setter Property="Margin" Value="0,0,9,7" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="{StaticResource Theme.HelperSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.HelperEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
    </Style>

    <Style x:Key="Theme.Card.Title" TargetType="TextBox" BasedOn="{StaticResource Theme.Input.Bare}">
        <Setter Property="AcceptsReturn" Value="False" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Card.TitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Theme.Card.Meaning" TargetType="TextBox" BasedOn="{StaticResource Theme.Input.Bare}">
        <Setter Property="FontSize" Value="{StaticResource Theme.Card.DefinitionSize}" />
    </Style>

    <Style x:Key="Theme.Card.Expression" TargetType="TextBox" BasedOn="{StaticResource Theme.Card.Meaning}">
        <Setter Property="Margin" Value="{StaticResource Theme.Card.ExpressionMargin}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Theme.Card.Instance" TargetType="TextBox" BasedOn="{StaticResource Theme.Input.Bare}">
        <Setter Property="Margin" Value="{StaticResource Theme.Card.ExampleLineMargin}" />
        <Setter Property="FontFamily" Value="{StaticResource Theme.Card.ExampleFamily}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Card.ExampleSize}" />
    </Style>

    <Style x:Key="Theme.Card.Handle" TargetType="Button" BasedOn="{StaticResource Theme.Input.Action}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="Theme.Card.Switch" TargetType="ToggleButton">
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="PCardSurface" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PCardSurface" Property="Background" Value="{StaticResource Theme.SurfaceRaised}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PCardSurface" Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Card.Ghost" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Card.FrameSize}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="Theme.Card.Dot" TargetType="TextBlock">
        <Setter Property="Text" Value="•" />
        <Setter Property="Margin" Value="0,0,9,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Card.FrameSize}" />
    </Style>

    <Style x:Key="Theme.Card.Frame" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="{StaticResource Theme.Card.FrameSize}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Storyboard x:Key="Theme.Card.Spotlight">
        <DoubleAnimation
            AutoReverse="True"
            Storyboard.TargetProperty="Opacity"
            To="0.35"
            Duration="0:0:0.3" />
    </Storyboard>

</ResourceDictionary>
