<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemeInput.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Gloss.Line" TargetType="ItemsControl">
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style x:Key="Theme.Gloss.Choice" TargetType="ListBoxItem">
        <Setter Property="Height" Value="31" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="PGlossSurface" Background="Transparent" CornerRadius="7">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Theme.Gloss.Option">
        <StackPanel Margin="12,0" Orientation="Horizontal">
            <Image x:Name="PGlossOptionFlag" Width="19" Height="14" VerticalAlignment="Center" Stretch="Uniform" />
            <TextBlock x:Name="PGlossOptionName" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource Theme.Ink}" />
        </StackPanel>
    </DataTemplate>

    <Style x:Key="Theme.Gloss.Globe" TargetType="Ellipse">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stroke" Value="{StaticResource Theme.Accent}" />
        <Setter Property="StrokeThickness" Value="1.2" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="Theme.Gloss.Flag" TargetType="Image">
        <Setter Property="Width" Value="19" />
        <Setter Property="Height" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stretch" Value="Uniform" />
    </Style>

    <Style x:Key="Theme.Gloss.Name" TargetType="TextBlock">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Theme.Gloss.Remove" TargetType="Button" BasedOn="{StaticResource Theme.Input.Action}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Content">
            <Setter.Value>
                <local:PIconImage Width="12" Height="12" />
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Theme.Gloss.Row">
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ToggleButton
                x:Name="PGlossSpeaker"
                Margin="-6,0,8,0"
                Padding="6,2"
                VerticalAlignment="Top"
                Style="{DynamicResource Theme.Card.Switch}">
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="PGlossFlag" Style="{StaticResource Theme.Gloss.Flag}" />
                    <Ellipse x:Name="PGlossGlobe" Style="{StaticResource Theme.Gloss.Globe}" />
                </StackPanel>
            </ToggleButton>
            <Popup
                x:Name="PGlossPopup"
                Width="238"
                AllowsTransparency="True"
                Placement="Bottom"
                StaysOpen="False">
                <Border Margin="10" Style="{DynamicResource Theme.Popup.Surface}">
                    <ListBox
                        x:Name="PGlossList"
                        MaxHeight="220"
                        Background="Transparent"
                        BorderThickness="0"
                        IsSynchronizedWithCurrentItem="False"
                        ItemContainerStyle="{StaticResource Theme.Gloss.Choice}"
                        ItemTemplate="{StaticResource Theme.Gloss.Option}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Border>
            </Popup>

            <TextBox
                x:Name="PGlossText"
                Grid.Column="1"
                FontFamily="{DynamicResource Theme.Card.GlossFamily}"
                FontSize="{DynamicResource Theme.Card.GlossSize}"
                FontStyle="{DynamicResource Theme.Card.GlossStyle}"
                Foreground="{DynamicResource Theme.Muted}"
                Style="{DynamicResource Theme.Input.Bare}" />

            <Button x:Name="PGlossBin" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Top" Style="{StaticResource Theme.Gloss.Remove}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Gloss.Field">
        <Grid Margin="0,7,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ToggleButton
                x:Name="PGlossSpeaker"
                MinWidth="160"
                Height="44"
                Margin="0,0,8,0"
                Padding="12,0"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Stretch"
                Style="{DynamicResource Theme.Input.ToggleAction}">
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="PGlossFlag" Style="{StaticResource Theme.Gloss.Flag}" />
                    <Ellipse x:Name="PGlossGlobe" Style="{StaticResource Theme.Gloss.Globe}" />
                    <TextBlock x:Name="PGlossName" Style="{StaticResource Theme.Gloss.Name}" />
                </StackPanel>
            </ToggleButton>
            <Popup
                x:Name="PGlossPopup"
                Width="238"
                AllowsTransparency="True"
                Placement="Bottom"
                StaysOpen="False">
                <Border Margin="10" Style="{DynamicResource Theme.Popup.Surface}">
                    <ListBox
                        x:Name="PGlossList"
                        MaxHeight="220"
                        Background="Transparent"
                        BorderThickness="0"
                        IsSynchronizedWithCurrentItem="False"
                        ItemContainerStyle="{StaticResource Theme.Gloss.Choice}"
                        ItemTemplate="{StaticResource Theme.Gloss.Option}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Border>
            </Popup>

            <TextBox
                x:Name="PGlossText"
                Grid.Column="1"
                MinHeight="44"
                Padding="12,9"
                AcceptsReturn="True"
                Style="{DynamicResource Theme.Input.Field}"
                TextWrapping="Wrap"
                VerticalContentAlignment="Top" />

            <Button x:Name="PGlossBin" Grid.Column="2" Margin="8,13,0,0" VerticalAlignment="Top" Style="{StaticResource Theme.Gloss.Remove}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Gloss.Display">
        <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
            <Image x:Name="PGlossFlag" Margin="0,2,0,0" Style="{StaticResource Theme.Gloss.Flag}" />
            <Ellipse x:Name="PGlossGlobe" Margin="0,2,0,0" Style="{StaticResource Theme.Gloss.Globe}" />
            <TextBlock x:Name="PGlossText" Margin="8,0,0,0" Style="{DynamicResource Theme.Display.Value}" TextWrapping="Wrap" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
