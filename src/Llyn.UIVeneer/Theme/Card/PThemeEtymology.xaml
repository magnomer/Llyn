<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIVeneer">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemeInput.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="Theme.Etymology.Item">
        <Grid>
            <Border x:Name="PEtymonChip" Padding="10,5,5,5" Margin="0,0,7,7" Cursor="Arrow" Style="{DynamicResource Theme.Card.Pellet}">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Image
                        Width="18"
                        Height="13"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Source="{Binding PEtymonFlag}"
                        Stretch="Uniform" />
                    <Button
                        Command="{x:Static local:PEtymologyCommand.PEtymologyCommandEntry}"
                        CommandParameter="{Binding PEtymonId}"
                        Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <StackPanel Background="Transparent" Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Accent}" Text="{Binding PEtymonHeadword}" />
                                    <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Theme.Muted}" Text="{Binding PEtymonLanguage}" />
                                </StackPanel>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button
                        Width="16"
                        Height="16"
                        Margin="7,0,0,0"
                        Padding="0"
                        Command="{x:Static local:PEtymologyCommand.PEtymologyCommandRemoval}"
                        CommandParameter="{Binding}"
                        Cursor="Hand"
                        Visibility="Collapsed">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PEtymologyEditable, RelativeSource={RelativeSource AncestorType=local:PEtymology}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Background="Transparent">
                                    <local:PIconImage
                                        Width="12"
                                        Height="12"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        PIconSource="{local:PIcon unlink, 12}" />
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
            <TextBox
                x:Name="PEtymonBox"
                Visibility="Collapsed"
                MinWidth="96"
                Margin="2,0,9,7"
                Padding="0,5"
                VerticalContentAlignment="Center"
                AcceptsReturn="False"
                FontSize="13"
                Foreground="{DynamicResource Theme.Ink}"
                Style="{DynamicResource Theme.Input.Bare}"
                Tag="{DynamicResource Input.EtymonHint}"
                Text="{Binding PEtymonText, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="NoWrap">
                <TextBox.InputBindings>
                    <KeyBinding
                        Key="Return"
                        Command="{x:Static local:PEtymologyCommand.PEtymologyCommandAddition}"
                        CommandParameter="{Binding}" />
                </TextBox.InputBindings>
            </TextBox>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding PEtymonCaret}" Value="True">
                <Setter TargetName="PEtymonChip" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding PEtymonShown}" Value="True">
                <Setter TargetName="PEtymonBox" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="Theme.Etymology.Field" TargetType="ItemsControl">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Etymology.Text" TargetType="local:PMention">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Ink}" />
    </Style>

    <Style x:Key="Theme.Etymology.Prose" TargetType="TextBox" BasedOn="{StaticResource Theme.Input.Bare}">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="MinHeight" Value="72" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <ContextMenu x:Key="Theme.Etymology.Menu">
        <MenuItem
            Command="{x:Static local:PEtymologyCommand.PEtymologyCommandLink}"
            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
            Header="{DynamicResource Mention.Link}" />
        <MenuItem
            Command="{x:Static local:PEtymologyCommand.PEtymologyCommandUnlink}"
            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
            Header="{DynamicResource Mention.Unlink}" />
        <Separator />
        <MenuItem Command="ApplicationCommands.Cut" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <MenuItem Command="ApplicationCommands.Copy" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <MenuItem Command="ApplicationCommands.Paste" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
    </ContextMenu>

    <Style x:Key="Theme.Etymology.Read" TargetType="local:PEtymology">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PEtymology">
                    <Border Padding="26,22" Style="{DynamicResource Theme.Input.Card}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Etymology.Card" TargetType="local:PEtymology">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PEtymology">
                    <Border Style="{DynamicResource Theme.Input.Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="55" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Line}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                                <TextBlock Margin="22,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{DynamicResource Display.Etymology}" />
                            </Border>
                            <ContentPresenter Grid.Row="1" Margin="22,18,22,22" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
