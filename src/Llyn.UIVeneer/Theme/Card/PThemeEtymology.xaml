<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemeInput.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Etymology.Sources" TargetType="ItemsControl">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Etymology.Tool" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PEtymologyKnob" Background="Transparent" BorderBrush="{DynamicResource Theme.Line}" BorderThickness="1" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontSize="14" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Etymology.Note" TargetType="Button">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter TextElement.FontSize="11" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Etymology.Root" TargetType="Border">
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style x:Key="Theme.Etymology.Headword" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}" />
    </Style>

    <Style x:Key="Theme.Etymology.Frame" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style x:Key="Theme.Etymology.Trace" TargetType="Rectangle">
        <Setter Property="RadiusX" Value="6" />
        <Setter Property="RadiusY" Value="6" />
        <Setter Property="Stroke" Value="{DynamicResource Theme.Muted}" />
        <Setter Property="StrokeDashArray" Value="4 3" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="Theme.Etymology.Bar" TargetType="Rectangle">
        <Setter Property="Fill" Value="{DynamicResource Theme.Line}" />
    </Style>

    <Style x:Key="Theme.Etymology.Stem" TargetType="Rectangle">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource Theme.Line}" />
    </Style>

    <DataTemplate x:Key="Theme.Etymology.Item">
        <Grid VerticalAlignment="Bottom">
            <StackPanel Margin="12,0">
                <ItemsControl x:Name="PEtymologySources" ItemTemplate="{DynamicResource Theme.Etymology.Item}" Style="{DynamicResource Theme.Etymology.Sources}" />
                <Rectangle x:Name="PEtymologyTrunk" Style="{DynamicResource Theme.Etymology.Stem}" />
                <StackPanel MinWidth="160" HorizontalAlignment="Center">
                    <Grid>
                        <ComboBox x:Name="PEtymologyLanguage" Height="30" Style="{DynamicResource Theme.Input.Choice}" ToolTip="{DynamicResource Input.AncestorLanguageHint}" />
                        <TextBlock
                            x:Name="PEtymologyTongue"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource Theme.Muted}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="Collapsed" />
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Border x:Name="PEtymologyFrame" Style="{DynamicResource Theme.Etymology.Frame}" />
                        <Rectangle x:Name="PEtymologyTrace" Style="{DynamicResource Theme.Etymology.Trace}" />
                        <TextBox
                            x:Name="PEtymologyText"
                            Margin="1"
                            Padding="8,5,22,5"
                            Background="Transparent"
                            BorderThickness="0"
                            Style="{DynamicResource Theme.Input.Field}"
                            ToolTip="{DynamicResource Input.AncestorHint}" />
                        <TextBlock
                            x:Name="PEtymologyMark"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Theme.Accent}"
                            Text="↗"
                            Visibility="Collapsed" />
                    </Grid>
                    <TextBox
                        x:Name="PEtymologyGloss"
                        Margin="0,4,0,0"
                        Padding="8,5"
                        Style="{DynamicResource Theme.Input.Field}"
                        ToolTip="{DynamicResource Input.AncestorGlossHint}" />
                    <StackPanel x:Name="PEtymologyTools" Margin="0,4,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button x:Name="PEtymologyInsertion" Content="+" Style="{DynamicResource Theme.Etymology.Tool}" ToolTip="{DynamicResource Input.AncestorInsert}" />
                        <Button x:Name="PEtymologyAddition" Content="⊕" Style="{DynamicResource Theme.Etymology.Tool}" ToolTip="{DynamicResource Input.AncestorAdd}" />
                        <Button x:Name="PEtymologyRemoval" Content="−" Style="{DynamicResource Theme.Etymology.Tool}" ToolTip="{DynamicResource Input.AncestorRemove}" />
                    </StackPanel>
                    <Button x:Name="PEtymologyRestoration" Content="{DynamicResource Input.AncestorRestore}" Style="{DynamicResource Theme.Etymology.Note}" Visibility="Collapsed" />
                </StackPanel>
                <Rectangle Style="{DynamicResource Theme.Etymology.Stem}" />
                <ComboBox
                    x:Name="PEtymologyRelation"
                    Width="120"
                    Height="24"
                    HorizontalAlignment="Center"
                    FontSize="11"
                    Style="{DynamicResource Theme.Input.Choice}"
                    ToolTip="{DynamicResource Input.AncestorRelationHint}" />
                <Rectangle Style="{DynamicResource Theme.Etymology.Stem}" />
            </StackPanel>
            <Grid Height="1" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle x:Name="PEtymologyPrior" Style="{DynamicResource Theme.Etymology.Bar}" />
                <Rectangle x:Name="PEtymologyNext" Grid.Column="1" Style="{DynamicResource Theme.Etymology.Bar}" />
            </Grid>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Etymology.Reading">
        <Grid VerticalAlignment="Bottom">
            <StackPanel Margin="12,0">
                <ItemsControl x:Name="PEtymologySources" ItemTemplate="{DynamicResource Theme.Etymology.Reading}" Style="{DynamicResource Theme.Etymology.Sources}" />
                <Rectangle x:Name="PEtymologyTrunk" Style="{DynamicResource Theme.Etymology.Stem}" />
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock
                        x:Name="PEtymologyTongue"
                        Margin="0,0,0,3"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource Theme.Muted}" />
                    <Grid MinWidth="80" HorizontalAlignment="Center">
                        <Border x:Name="PEtymologyFrame" Style="{DynamicResource Theme.Etymology.Frame}" />
                        <Rectangle x:Name="PEtymologyTrace" Style="{DynamicResource Theme.Etymology.Trace}" />
                        <StackPanel Margin="1" HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock x:Name="PEtymologyText" Padding="10,4" Foreground="{DynamicResource Theme.Ink}" />
                            <TextBlock
                                x:Name="PEtymologyMark"
                                Margin="-4,0,8,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource Theme.Accent}"
                                Text="↗"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                    <TextBlock
                        x:Name="PEtymologyGloss"
                        MaxWidth="200"
                        Margin="0,3,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource Theme.Muted}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Rectangle Style="{DynamicResource Theme.Etymology.Stem}" />
                <TextBlock
                    x:Name="PEtymologyRelation"
                    HorizontalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource Theme.Muted}" />
                <Rectangle Style="{DynamicResource Theme.Etymology.Stem}" />
            </StackPanel>
            <Grid Height="1" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle x:Name="PEtymologyPrior" Style="{DynamicResource Theme.Etymology.Bar}" />
                <Rectangle x:Name="PEtymologyNext" Grid.Column="1" Style="{DynamicResource Theme.Etymology.Bar}" />
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
