<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemeInput.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="Theme.Etymology.Item">
        <Grid>
            <Border x:Name="PEtymonChip" Padding="10,5,5,5" Margin="0,0,7,7" Cursor="Arrow" Style="{DynamicResource Theme.Card.Pellet}">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Image
                        x:Name="PEtymonFlag"
                        Width="18"
                        Height="13"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Stretch="Uniform" />
                    <Button x:Name="PEtymonEntry" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <StackPanel Background="Transparent" Orientation="Horizontal">
                                    <TextBlock x:Name="PEtymonHeadword" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Accent}" />
                                    <TextBlock x:Name="PEtymonLanguage" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Theme.Muted}" />
                                </StackPanel>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button
                        x:Name="PEtymonRemoval"
                        Width="16"
                        Height="16"
                        Margin="7,0,0,0"
                        Padding="0"
                        Cursor="Hand"
                        Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Background="Transparent">
                                    <local:PIconImage
                                        x:Name="PEtymonMark"
                                        Width="12"
                                        Height="12"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
            <TextBox
                x:Name="PEtymonBox"
                Visibility="Collapsed"
                MinWidth="96"
                Margin="2,0,9,7"
                Padding="0,5"
                VerticalContentAlignment="Center"
                AcceptsReturn="False"
                FontSize="13"
                Foreground="{DynamicResource Theme.Ink}"
                Style="{DynamicResource Theme.Input.Bare}"
                Tag="{DynamicResource Input.EtymonHint}"
                TextWrapping="NoWrap" />
        </Grid>
    </DataTemplate>

    <Style x:Key="Theme.Etymology.Field" TargetType="ItemsControl">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Etymology.Text" TargetType="local:PMention">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Ink}" />
    </Style>

    <Style x:Key="Theme.Etymology.Prose" TargetType="TextBox" BasedOn="{StaticResource Theme.Input.Bare}">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="MinHeight" Value="72" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <ContextMenu x:Key="Theme.Etymology.Menu">
        <MenuItem
            x:Name="PEtymologyLink"
            Header="{DynamicResource Mention.Link}" />
        <MenuItem
            x:Name="PEtymologyUnlink"
            Header="{DynamicResource Mention.Unlink}" />
        <Separator />
        <MenuItem x:Name="PMentionCut" />
        <MenuItem x:Name="PMentionClip" />
        <MenuItem x:Name="PMentionPaste" />
    </ContextMenu>

    <Style x:Key="Theme.Etymology.Read" TargetType="local:PEtymology">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PEtymology">
                    <Border Padding="26,22" Style="{DynamicResource Theme.Input.Card}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Etymology.Card" TargetType="local:PEtymology">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PEtymology">
                    <Border Style="{DynamicResource Theme.Input.Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="55" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Line}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                                <TextBlock Margin="22,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{DynamicResource Display.Etymology}" />
                            </Border>
                            <ContentPresenter Grid.Row="1" Margin="22,18,22,22" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
