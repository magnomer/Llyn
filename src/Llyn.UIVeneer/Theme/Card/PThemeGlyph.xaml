<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Sound/PThemePronunciation.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Sound/PThemeAccent.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Sound/PThemeTranscription.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <FontFamily x:Key="Theme.Glyph.Family">Segoe UI, Arial</FontFamily>
    <sys:Double x:Key="Theme.Glyph.Size">19</sys:Double>

    <Style x:Key="Theme.Glyph.Phonetician" TargetType="Button" BasedOn="{StaticResource Theme.Transcription.Phonetician}">
        <Setter Property="ToolTip" Value="{DynamicResource Glyph.Title}" />
    </Style>

    <Style x:Key="Theme.Glyph.Field" TargetType="TextBox" BasedOn="{StaticResource Theme.Pronunciation.Field}">
        <Setter Property="FontFamily" Value="{DynamicResource Theme.Glyph.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Glyph.Size}" />
    </Style>

    <Style x:Key="Theme.Glyph.Measure" TargetType="TextBlock" BasedOn="{StaticResource Theme.Pronunciation.Measure}">
        <Setter Property="FontFamily" Value="{DynamicResource Theme.Glyph.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Glyph.Size}" />
    </Style>

    <Style x:Key="Theme.Glyph.Chip" TargetType="Button">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource Theme.Glyph.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Glyph.Size}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ToolTip" Value="{DynamicResource Glyph.Entry}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" SnapsToDevicePixels="True">
                        <TextBlock x:Name="PGlyphCharacter" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Theme.Glyph.Display">
        <Button x:Name="PGlyphChip" Style="{StaticResource Theme.Glyph.Chip}" />
    </DataTemplate>

    <Style x:Key="Theme.Glyph.Line" TargetType="ItemsControl">
        <Setter Property="Margin" Value="0,-3,0,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ItemTemplate" Value="{StaticResource Theme.Glyph.Display}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Theme.Glyph.Row">
        <Border Style="{StaticResource Theme.Pronunciation.Surface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReadingLabel" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource Theme.Pronunciation.Lead}">
                    <TextBlock x:Name="PGlyphLabel" Style="{StaticResource Theme.Pronunciation.Label}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Style="{StaticResource Theme.Pronunciation.Body}">
                    <Grid Style="{StaticResource Theme.Pronunciation.Cell}">
                        <TextBlock x:Name="PGlyphMeasure" Style="{StaticResource Theme.Glyph.Measure}" />
                        <TextBox x:Name="PGlyphField" Style="{StaticResource Theme.Glyph.Field}" Tag="{DynamicResource Input.Glyph}" />
                    </Grid>
                    <Button x:Name="PGlyphPhonetician" Style="{StaticResource Theme.Glyph.Phonetician}" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
