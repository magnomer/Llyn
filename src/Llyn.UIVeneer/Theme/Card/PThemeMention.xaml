<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemePalette.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Mention.Linked" TargetType="Run">
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
        <Setter Property="TextDecorations" Value="Underline" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="Theme.Mention.Silent" TargetType="Run" />

    <ContextMenu x:Key="Theme.Mention.Menu">
        <MenuItem
            x:Name="PMentionLink"
            Header="{DynamicResource Mention.Link}" />
        <MenuItem
            x:Name="PMentionChoose"
            Header="{DynamicResource Mention.Choose}" />
        <MenuItem
            x:Name="PMentionSilence"
            Header="{DynamicResource Mention.Silence}" />
        <MenuItem
            x:Name="PMentionUnlink"
            Header="{DynamicResource Mention.Unlink}" />
        <Separator />
        <MenuItem x:Name="PMentionCut" />
        <MenuItem x:Name="PMentionClip" />
        <MenuItem x:Name="PMentionPaste" />
    </ContextMenu>

    <Style x:Key="Theme.Mention.Line" TargetType="ItemsControl">
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Mention.Sense" TargetType="TextBlock">
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
    </Style>

    <DataTemplate x:Key="Theme.Mention.Chip">
        <Border Padding="10,4,5,4" Cursor="Arrow" Style="{DynamicResource Theme.Card.Badge}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock x:Name="PMentionWord" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Theme.Ink}" />
                <TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Theme.Muted}" Text="&#8594;" />
                <TextBlock x:Name="PMentionName" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Accent}" />
                <TextBlock x:Name="PMentionSense" Style="{StaticResource Theme.Mention.Sense}" />
                <Button x:Name="PMentionUnlink" Width="16" Height="16" Margin="7,0,0,0" Padding="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <local:PIconImage
                                    x:Name="PMentionMark"
                                    Width="12"
                                    Height="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
