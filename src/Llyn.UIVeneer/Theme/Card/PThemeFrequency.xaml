<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn;component/Theme/Base/PThemePalette.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Frequency.Chip" TargetType="Border">
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,0,7,7" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{StaticResource Theme.SurfaceRaised}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Theme.Frequency.Name" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Theme.Frequency.Band" TargetType="TextBlock">
        <Setter Property="Margin" Value="7,0,0,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <SolidColorBrush x:Key="Theme.Frequency.Core" Color="{DynamicResource Theme.FrequencyCore.Color}" />

    <SolidColorBrush x:Key="Theme.Frequency.Everyday" Color="{DynamicResource Theme.FrequencyEveryday.Color}" />

    <SolidColorBrush x:Key="Theme.Frequency.Advanced" Color="{DynamicResource Theme.FrequencyAdvanced.Color}" />

    <SolidColorBrush x:Key="Theme.Frequency.Rare" Color="{DynamicResource Theme.FrequencyRare.Color}" />

    <SolidColorBrush x:Key="Theme.Frequency.Unknown" Color="{DynamicResource Theme.Muted.Color}" />

    <SolidColorBrush x:Key="Theme.Frequency.Empty" Opacity="0.22" Color="{DynamicResource Theme.Muted.Color}" />

</ResourceDictionary>
