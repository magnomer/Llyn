<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Sound/PThemePronunciation.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Volume.Tray" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource Theme.Pronunciation.Height}" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="Theme.Volume.Rail" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border
                        x:Name="PSurface"
                        Height="4"
                        VerticalAlignment="Center"
                        CornerRadius="2"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Volume.Thumb" TargetType="Thumb">
        <Setter Property="Width" Value="13" />
        <Setter Property="Height" Value="13" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border
                        x:Name="PSurface"
                        Background="{StaticResource Theme.Surface}"
                        BorderBrush="{StaticResource Theme.Accent}"
                        BorderThickness="2"
                        CornerRadius="7"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Volume.Slider" TargetType="Slider">
        <Setter Property="Width" Value="138" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="SmallChange" Value="0.05" />
        <Setter Property="LargeChange" Value="0.1" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="PSurface" VerticalAlignment="Center" Background="Transparent">
                        <Border Height="4" VerticalAlignment="Center" Background="{StaticResource Theme.Line}" CornerRadius="2" SnapsToDevicePixels="True" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="PSurfaceLower" Background="{StaticResource Theme.Accent}" Style="{StaticResource Theme.Volume.Rail}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="PSurfaceUpper" Background="Transparent" Style="{StaticResource Theme.Volume.Rail}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Theme.Volume.Thumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
