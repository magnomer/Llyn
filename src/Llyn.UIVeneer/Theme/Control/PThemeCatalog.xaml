<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn;component/Theme/Base/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn;component/Theme/Base/PThemeScroll.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Thickness x:Key="Theme.Catalog.HeaderMargin">-28,0,16,18</Thickness>

    <Style x:Key="Theme.Catalog.Frame" TargetType="Grid">
        <Setter Property="Margin" Value="-28,14,16,0" />
    </Style>

    <Style x:Key="Theme.Catalog.Middle" TargetType="Grid" BasedOn="{StaticResource Theme.Catalog.Frame}">
        <Setter Property="Margin" Value="-4,14,16,0" />
    </Style>

    <Style x:Key="Theme.Catalog.Scroll" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="Theme.Catalog.Row" TargetType="Button">
        <Setter Property="Margin" Value="0,0,0,3" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="PSurface"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="11">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.SurfaceRaised}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PSurface" Property="Opacity" Value="0.78" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tag" Value="Chosen">
                <Setter Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Catalog.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Theme.Catalog.Meta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Theme.Catalog.Epithet" TargetType="Run">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="BaselineAlignment" Value="Baseline" />
    </Style>

    <Style x:Key="Theme.Catalog.Dot" TargetType="TextBlock" BasedOn="{StaticResource Theme.Catalog.Meta}">
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="Text" Value="&#183;" />
    </Style>

    <Style x:Key="Theme.Catalog.Pellet" TargetType="Border">
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource Theme.SurfaceRaised}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="Theme.Catalog.Tally" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
    </Style>

    <Style x:Key="Theme.Catalog.Empty" TargetType="TextBlock">
        <Setter Property="Margin" Value="14,30,14,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
