<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemePopup.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Diwei.Empty" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Margin" Value="2,25,0,0" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="Theme.Diwei.Switch" TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="14,0,2,12" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="Background" Value="{StaticResource Theme.Surface}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="Theme.Diwei.Choice" TargetType="Button">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PSurface" CornerRadius="8" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Diwei.Ipa" TargetType="Button" BasedOn="{StaticResource Theme.Diwei.Choice}">
        <Setter Property="Content" Value="{DynamicResource Tally.Ipa}" />
    </Style>

    <Style x:Key="Theme.Diwei.Respelling" TargetType="Button" BasedOn="{StaticResource Theme.Diwei.Choice}">
        <Setter Property="Content" Value="{DynamicResource Tally.Respelling}" />
    </Style>

    <Style x:Key="Theme.Diwei.Language" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Theme.Diwei.Kind" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Theme.Diwei.MarkText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style x:Key="Theme.Diwei.MarkNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="Theme.Diwei.Mark" TargetType="ToggleButton">
        <Setter Property="Margin" Value="0,0,16,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ToolTip" Value="{DynamicResource Tally.Characters}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PTallyPart" Style="{StaticResource Theme.Diwei.MarkText}" />
                            <TextBlock x:Name="PTallyCount" Style="{StaticResource Theme.Diwei.MarkNumber}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Diwei.MarkPopup" TargetType="Popup">
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="Placement" Value="Bottom" />
        <Setter Property="StaysOpen" Value="False" />
        <Setter Property="VerticalOffset" Value="4" />
        <Setter Property="MaxWidth" Value="360" />
    </Style>

    <Style x:Key="Theme.Diwei.MarkList" TargetType="ItemsControl">
        <Setter Property="Margin" Value="8,6,2,6" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Diwei.Head" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="2,0,2,12" />
        <Setter Property="Padding" Value="0,5,0,0" />
    </Style>

    <Style x:Key="Theme.Diwei.Plate" TargetType="Border">
        <Setter Property="Padding" Value="14,8,18,8" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="Background" Value="{StaticResource Theme.Surface}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Theme.Diwei.Reading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Theme.Diwei.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Theme.Diwei.Rounded" TargetType="Border">
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="Theme.Diwei.RoundedText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Warning}" />
        <Setter Property="Text" Value="合" />
    </Style>

    <Style x:Key="Theme.Diwei.Chip" TargetType="Button">
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ToolTip" Value="{DynamicResource Glyph.Entry}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" SnapsToDevicePixels="True">
                        <TextBlock x:Name="PDiweiCharacter" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Theme.Diwei.CharacterChip">
        <Button Style="{StaticResource Theme.Diwei.Chip}" />
    </DataTemplate>

    <DataTemplate x:Key="Theme.Diwei.MarkChip">
        <Grid>
            <ToggleButton x:Name="PTallyDropper" Style="{StaticResource Theme.Diwei.Mark}" />
            <Popup x:Name="PTallyPopup" Style="{StaticResource Theme.Diwei.MarkPopup}">
                <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                    <ItemsControl x:Name="PTallyCharacters" ItemTemplate="{StaticResource Theme.Diwei.CharacterChip}" Style="{StaticResource Theme.Diwei.MarkList}" />
                </Border>
            </Popup>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Diwei.TallyLine">
        <Grid MinHeight="26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="PTallyLanguage" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PTallyKind" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PTallyLanguage" Style="{StaticResource Theme.Diwei.Language}" />
            <TextBlock x:Name="PTallyKind" Grid.Column="1" Style="{StaticResource Theme.Diwei.Kind}" />
            <ItemsControl x:Name="PTallyMarks" Grid.Column="2" VerticalAlignment="Center" ItemTemplate="{StaticResource Theme.Diwei.MarkChip}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>
    </DataTemplate>

    <Style x:Key="Theme.Diwei.Tally" TargetType="ItemsControl">
        <Setter Property="Margin" Value="2,0,2,12" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="ItemTemplate" Value="{StaticResource Theme.Diwei.TallyLine}" />
    </Style>

    <DataTemplate x:Key="Theme.Diwei.Line">
        <Grid MinHeight="26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="PDiweiReading" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PDiweiLabel" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PDiweiRounded" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PDiweiReading" Style="{StaticResource Theme.Diwei.Reading}" />
            <TextBlock x:Name="PDiweiLabel" Grid.Column="1" Style="{StaticResource Theme.Diwei.Label}" />
            <Border x:Name="PDiweiRounded" Grid.Column="2" Style="{StaticResource Theme.Diwei.Rounded}">
                <TextBlock Style="{StaticResource Theme.Diwei.RoundedText}" />
            </Border>
            <ItemsControl x:Name="PDiweiCharacters" Grid.Column="3" VerticalAlignment="Center" ItemTemplate="{StaticResource Theme.Diwei.CharacterChip}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Diwei.Section">
        <StackPanel Margin="0,0,0,28">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PDiweiHead" Style="{StaticResource Theme.Diwei.Head}" />
                <Border x:Name="PDiweiSwitch" Grid.Column="1" Style="{StaticResource Theme.Diwei.Switch}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PDiweiSpoken" Style="{StaticResource Theme.Diwei.Ipa}" />
                        <Button x:Name="PDiweiSpelled" Style="{StaticResource Theme.Diwei.Respelling}" />
                    </StackPanel>
                </Border>
            </Grid>
            <ItemsControl x:Name="PDiweiTally" Style="{StaticResource Theme.Diwei.Tally}" />
            <Border Style="{StaticResource Theme.Diwei.Plate}">
                <ItemsControl x:Name="PDiweiLines" Grid.IsSharedSizeScope="True" ItemTemplate="{StaticResource Theme.Diwei.Line}" />
            </Border>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
