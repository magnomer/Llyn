<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIVeneer">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Control/PThemeCommand.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Sound.Rebuild" TargetType="Button" BasedOn="{StaticResource Theme.Command.Icon}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="26" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ToolTip" Value="{DynamicResource Display.Rebuild}" />
        <Setter Property="Content" Value="" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <local:PIconImage
                        x:Name="PSurfaceMark"
                        Width="18"
                        Height="18"
                        PIconSource="{local:PIcon rebuild, 18}"
                        RenderTransformOrigin="0.5,0.5">
                        <local:PIconImage.RenderTransform>
                            <RotateTransform Angle="0" />
                        </local:PIconImage.RenderTransform>
                    </local:PIconImage>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="PSurfaceSpin">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="PSurfaceMark"
                                            Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                            From="0"
                                            To="360"
                                            Duration="0:0:1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="PSurfaceSpin" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
