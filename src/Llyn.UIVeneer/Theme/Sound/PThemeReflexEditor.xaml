<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Sound/PThemePronunciation.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Sound/PThemeAccent.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Control/PThemeCommand.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Sound/PThemeRebuild.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Sound/PThemeReflex.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Reflex.Anchoring" TargetType="Button">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PSurface">
                        <Grid>
                            <TextBlock x:Name="PSurfaceText" Style="{StaticResource Theme.Reflex.Anchor}" />
                            <TextBlock
                                x:Name="PSurfacePrompt"
                                Margin="12,0,3,2"
                                Style="{StaticResource Theme.Reflex.Minor}"
                                Text="{DynamicResource Input.Anchor}"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Reflex.Field" TargetType="TextBox" BasedOn="{StaticResource Theme.Pronunciation.Field}">
        <Setter Property="MaxWidth" Value="424" />
    </Style>

    <Style x:Key="Theme.Reflex.Lead" TargetType="TextBox" BasedOn="{StaticResource Theme.Reflex.Field}">
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
    </Style>

    <Style x:Key="Theme.Reflex.Name" TargetType="TextBox" BasedOn="{StaticResource Theme.Pronunciation.Field}">
        <Setter Property="Margin" Value="-2,0" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="MaxWidth" Value="160" />
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
    </Style>

    <Style x:Key="Theme.Reflex.Aside" TargetType="TextBox" BasedOn="{StaticResource Theme.Pronunciation.Field}">
        <Setter Property="Margin" Value="-2,0" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="MaxWidth" Value="424" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
    </Style>

    <Style x:Key="Theme.Reflex.Star" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Handle}">
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="ToolTip" Value="{DynamicResource Reflex.Main}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <local:PIconImage x:Name="PSurfaceMark" Width="12" Height="12" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Reflex.Addition" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Addition}" />

    <Style x:Key="Theme.Reflex.Remove" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Remove}" />

    <Style x:Key="Theme.Reflex.Rebuild" TargetType="Button" BasedOn="{StaticResource Theme.Sound.Rebuild}">
        <Setter Property="Margin" Value="0,12,-5,0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <DataTemplate x:Key="Theme.Reflex.Control">
        <StackPanel IsHitTestVisible="True" Opacity="1" Style="{StaticResource Theme.Accent.Control}">
            <Button Style="{StaticResource Theme.Reflex.Star}" />
            <Button Style="{StaticResource Theme.Reflex.Addition}" />
            <Button Style="{StaticResource Theme.Reflex.Remove}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Reflex.Row">
        <Border x:Name="PReflexSurface" Style="{StaticResource Theme.Reflex.Surface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReadingLabel" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReflexKind" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReflexText" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReflexRomanization" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReflexMeaning" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReflexNote" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource Theme.Pronunciation.Lead}">
                    <Grid Margin="0,0,8,0" MinWidth="12" Background="Transparent">
                        <TextBlock x:Name="PReflexLabel" Margin="0" Style="{StaticResource Theme.Reflex.Label}" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1" Style="{StaticResource Theme.Pronunciation.Lead}">
                    <Grid Margin="0,0,6,0" MinWidth="12" Background="Transparent">
                        <TextBlock x:Name="PReflexTag" Margin="0" Style="{StaticResource Theme.Reflex.Tag}" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="3,0" Orientation="Horizontal">
                    <TextBlock x:Name="PReflexOpener" Style="{StaticResource Theme.Reflex.Edge}" />
                    <Grid x:Name="PReflexCell" HorizontalAlignment="Left" Background="Transparent">
                        <TextBlock x:Name="PReflexText" Style="{StaticResource Theme.Reflex.Text}" />
                    </Grid>
                    <TextBlock x:Name="PReflexCloser" Style="{StaticResource Theme.Reflex.Edge}" />
                </StackPanel>
                <Grid
                    Grid.Column="3"
                    Margin="12,0,3,2"
                    MinWidth="12"
                    Background="Transparent">
                    <TextBlock x:Name="PReflexRomanization" Margin="0" Style="{StaticResource Theme.Reflex.Romanization}" />
                </Grid>
                <Grid
                    Grid.Column="4"
                    Margin="6,0,3,2"
                    MinWidth="12"
                    Background="Transparent">
                    <TextBlock x:Name="PReflexMeaning" Margin="0" Style="{StaticResource Theme.Reflex.Minor}" />
                </Grid>
                <Grid
                    Grid.Column="5"
                    Margin="6,0,3,2"
                    MinWidth="12"
                    Background="Transparent">
                    <TextBlock x:Name="PReflexNote" Margin="0" Style="{StaticResource Theme.Reflex.Minor}" />
                </Grid>
                <StackPanel Grid.Column="6" Style="{StaticResource Theme.Pronunciation.Body}">
                    <Button x:Name="PReflexAnchoring" Style="{StaticResource Theme.Reflex.Anchoring}" />
                    <ContentControl
                        x:Name="PAccentShelf"
                        Focusable="False"
                        IsHitTestVisible="False"
                        Opacity="0" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
