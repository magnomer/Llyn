<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIVeneer">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn;component/Theme/Base/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn;component/Theme/Sound/PThemePronunciation.xaml" />
        <ResourceDictionary Source="/Llyn;component/Theme/Sound/PThemeAccent.xaml" />
        <ResourceDictionary Source="/Llyn;component/Theme/Control/PThemeCommand.xaml" />
        <ResourceDictionary Source="/Llyn;component/Theme/Sound/PThemeRebuild.xaml" />
        <ResourceDictionary Source="/Llyn;component/Theme/Sound/PThemeReflex.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Reflex.Anchoring" TargetType="Button">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Command" Value="{x:Static local:PReflexCommand.PReflexCommandAnchor}" />
        <Setter Property="CommandParameter" Value="{Binding}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <Grid>
                            <TextBlock x:Name="PSurfaceText" Style="{StaticResource Theme.Reflex.Anchor}" />
                            <TextBlock
                                x:Name="PSurfacePrompt"
                                Margin="12,0,3,2"
                                Style="{StaticResource Theme.Reflex.Minor}"
                                Text="{DynamicResource Input.Anchor}"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding LReflexItemAnchor}" Value="">
                            <Setter TargetName="PSurfacePrompt" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurfaceText" Property="Foreground" Value="{StaticResource Theme.Accent}" />
                            <Setter TargetName="PSurfacePrompt" Property="Foreground" Value="{StaticResource Theme.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding LReflexItemAnchorable}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Reflex.Field" TargetType="TextBox" BasedOn="{StaticResource Theme.Pronunciation.Field}">
        <Setter Property="MaxWidth" Value="424" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding LReflexItemMain}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Reflex.Prompt" TargetType="TextBlock" BasedOn="{StaticResource Theme.Reflex.Text}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding LReflexItemText}" Value="">
                <Setter Property="Text" Value="{DynamicResource Input.Reflex}" />
                <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Reflex.Name" TargetType="TextBox" BasedOn="{StaticResource Theme.Pronunciation.Field}">
        <Setter Property="Margin" Value="-2,0" />
        <Setter Property="ToolTip" Value="{Binding LReflexItemArea}" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="MaxWidth" Value="160" />
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding LReflexItemArea}" Value="">
                <Setter Property="ToolTip" Value="{x:Null}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Reflex.Aside" TargetType="TextBox" BasedOn="{StaticResource Theme.Pronunciation.Field}">
        <Setter Property="Margin" Value="-2,0" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="MaxWidth" Value="424" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
    </Style>

    <Style x:Key="Theme.Reflex.Star" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Handle}">
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Command" Value="{x:Static local:PReflexCommand.PReflexCommandMain}" />
        <Setter Property="ToolTip" Value="{DynamicResource Reflex.Main}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <local:PIconImage Width="12" Height="12" PIconSource="{local:PIcon star, 12}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Reflex.Addition" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Addition}">
        <Setter Property="Command" Value="{x:Static local:PReflexCommand.PReflexCommandAddition}" />
    </Style>

    <Style x:Key="Theme.Reflex.Remove" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Remove}">
        <Setter Property="Command" Value="{x:Static local:PReflexCommand.PReflexCommandRemoval}" />
    </Style>

    <Style x:Key="Theme.Reflex.Rebuild" TargetType="Button" BasedOn="{StaticResource Theme.Sound.Rebuild}">
        <Setter Property="Margin" Value="0,12,-5,0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Command" Value="{x:Static local:PReflexCommand.PReflexCommandRenewal}" />
    </Style>

    <DataTemplate x:Key="Theme.Reflex.Control">
        <StackPanel Style="{StaticResource Theme.Accent.Control}">
            <Button Style="{StaticResource Theme.Reflex.Star}" />
            <Button Style="{StaticResource Theme.Reflex.Addition}" />
            <Button Style="{StaticResource Theme.Reflex.Remove}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Reflex.Row">
        <Border Style="{StaticResource Theme.Reflex.Surface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReadingLabel" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReflexKind" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReflexText" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReflexRomanization" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReflexMeaning" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReflexNote" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource Theme.Pronunciation.Lead}">
                    <Grid Margin="0,0,8,0" MinWidth="12" Background="Transparent" Tag="Theme.Reflex.Name LReflexItemHead">
                        <TextBlock Margin="0" Style="{StaticResource Theme.Reflex.Label}" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1" Style="{StaticResource Theme.Pronunciation.Lead}">
                    <Grid Margin="0,0,6,0" MinWidth="12" Background="Transparent" Tag="Theme.Reflex.Name LReflexItemKind">
                        <TextBlock Margin="0" Style="{StaticResource Theme.Reflex.Tag}" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="3,0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Theme.Reflex.Edge}" Text="{Binding LReflexItemOpener}" />
                    <Grid HorizontalAlignment="Left" Background="Transparent" Tag="Theme.Reflex.Field LReflexItemText Input.Reflex">
                        <TextBlock Style="{StaticResource Theme.Reflex.Prompt}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Theme.Reflex.Edge}" Text="{Binding LReflexItemCloser}" />
                </StackPanel>
                <Grid
                    Grid.Column="3"
                    Margin="12,0,3,2"
                    MinWidth="12"
                    Background="Transparent" Tag="Theme.Reflex.Aside LReflexItemRomanization">
                    <TextBlock Margin="0" Style="{StaticResource Theme.Reflex.Romanization}" />
                </Grid>
                <Grid
                    Grid.Column="4"
                    Margin="6,0,3,2"
                    MinWidth="12"
                    Background="Transparent" Tag="Theme.Reflex.Aside LReflexItemMeaning Input.Meaning">
                    <TextBlock Margin="0" Style="{StaticResource Theme.Reflex.Meaning}" />
                </Grid>
                <Grid
                    Grid.Column="5"
                    Margin="6,0,3,2"
                    MinWidth="12"
                    Background="Transparent" Tag="Theme.Reflex.Aside LReflexItemNote">
                    <TextBlock Margin="0" Style="{StaticResource Theme.Reflex.Note}" />
                </Grid>
                <StackPanel Grid.Column="6" Style="{StaticResource Theme.Pronunciation.Body}">
                    <Button Style="{StaticResource Theme.Reflex.Anchoring}" />
                    <ContentControl Focusable="False" Tag="Theme.Reflex.Control" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
