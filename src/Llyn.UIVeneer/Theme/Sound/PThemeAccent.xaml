<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemeInput.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Sound/PThemePronunciation.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Control/PThemePlayback.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Accent.Tool" TargetType="Button" BasedOn="{StaticResource Theme.Playback.Action}">
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Content" Value="" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <local:PIconImage x:Name="PSurfaceMark" Width="24" Height="24" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Accent.Playback" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Tool}">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="ToolTip" Value="{DynamicResource Downloader.Play}" />
    </Style>

    <Style x:Key="Theme.Accent.Phonetician" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Tool}">
        <Setter Property="ToolTip" Value="{DynamicResource Phonetician.Title}" />
    </Style>

    <Style x:Key="Theme.Accent.Downloader" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Tool}">
        <Setter Property="ToolTip" Value="{DynamicResource Downloader.Title}" />
    </Style>

    <Style x:Key="Theme.Accent.Prompt" TargetType="TextBlock" BasedOn="{StaticResource Theme.Pronunciation.Text}">
        <Setter Property="Margin" Value="0,-3,0,3" />
    </Style>

    <Style x:Key="Theme.Accent.Blank" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Visibility" Value="Hidden" />
    </Style>

    <Style x:Key="Theme.Accent.Control" TargetType="StackPanel">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="Theme.Accent.Handle" TargetType="Button" BasedOn="{StaticResource Theme.Input.Action}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Content" Value="" />
    </Style>

    <Style x:Key="Theme.Accent.Addition" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Handle}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <local:PIconImage x:Name="PSurfaceMark" Width="12" Height="12" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Accent.Remove" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Handle}">
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <local:PIconImage x:Name="PSurfaceMark" Width="12" Height="12" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Theme.Accent.Slot">
        <StackPanel IsHitTestVisible="True" Opacity="1" Style="{StaticResource Theme.Accent.Control}">
            <Button Style="{StaticResource Theme.Accent.Addition}" />
            <Button Style="{StaticResource Theme.Accent.Remove}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Accent.Row">
        <Border Style="{StaticResource Theme.Pronunciation.Surface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReadingLabel" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource Theme.Pronunciation.Lead}">
                    <Image x:Name="PAccentFlag" Style="{StaticResource Theme.Pronunciation.Flag}" />
                    <TextBlock x:Name="PAccentLabel" Style="{StaticResource Theme.Pronunciation.Label}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Style="{StaticResource Theme.Pronunciation.Body}">
                    <TextBlock x:Name="PAccentOpener" Style="{StaticResource Theme.Pronunciation.Bracket}" />
                    <Grid Background="Transparent" Style="{StaticResource Theme.Pronunciation.Cell}">
                        <TextBlock x:Name="PAccentPrompt" Style="{StaticResource Theme.Accent.Prompt}" />
                    </Grid>
                    <TextBlock x:Name="PAccentCloser" Style="{StaticResource Theme.Pronunciation.Bracket}" />
                    <Button x:Name="PAccentPlayback" Style="{StaticResource Theme.Accent.Playback}" />
                    <Button Style="{StaticResource Theme.Accent.Phonetician}" />
                    <Button Style="{StaticResource Theme.Accent.Downloader}" />
                    <ContentControl
                        x:Name="PAccentShelf"
                        Focusable="False"
                        IsHitTestVisible="False"
                        Opacity="0" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Accent.Display">
        <Border Style="{StaticResource Theme.Pronunciation.Surface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReadingLabel" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource Theme.Pronunciation.Lead}">
                    <Image x:Name="PAccentFlag" Style="{StaticResource Theme.Pronunciation.Flag}" />
                    <TextBlock x:Name="PAccentLabel" Style="{StaticResource Theme.Pronunciation.Label}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Style="{StaticResource Theme.Pronunciation.Body}">
                    <TextBlock x:Name="PAccentOpener" Style="{StaticResource Theme.Pronunciation.Bracket}" />
                    <TextBlock x:Name="PAccentText" Style="{StaticResource Theme.Pronunciation.Text}" />
                    <TextBlock x:Name="PAccentCloser" Style="{StaticResource Theme.Pronunciation.Bracket}" />
                    <Button x:Name="PAccentPlayback" Style="{StaticResource Theme.Accent.Playback}" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
