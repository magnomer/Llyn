<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIVeneer">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn;component/Theme/Base/PThemePalette.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Script.Box" TargetType="Border">
        <Setter Property="Padding" Value="14,12,18,6" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="Background" Value="{StaticResource Theme.Surface}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Theme.Script.Character" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Text" Value="{Binding PScriptItemCharacter}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PScriptItemCharacter}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Script.Chip" TargetType="Border">
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="0,2,14,0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{StaticResource Theme.AccentSoft}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Theme.Script.Style" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Text" Value="{Binding PScriptItemStyle}" />
    </Style>

    <Style x:Key="Theme.Script.Shape" TargetType="Rectangle">
        <Setter Property="Fill" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Width" Value="{Binding PScriptImageWidth}" />
        <Setter Property="Height" Value="{Binding PScriptImageHeight}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="OpacityMask">
            <Setter.Value>
                <ImageBrush ImageSource="{Binding PScriptImageSource}" Stretch="Uniform" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Script.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="120" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,1,0,0" />
        <Setter Property="Text" Value="{Binding PScriptImageCaption}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PScriptImageCaption}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Script.Epoch" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="120" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Text" Value="{Binding PScriptImageEpoch}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PScriptImageEpoch}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Script.Gloss" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,6" />
        <Setter Property="Text" Value="{Binding PScriptItemGloss}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PScriptItemGloss}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Script.Head" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="Theme.Script.Loading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Margin" Value="0,2,0,6" />
    </Style>

    <DataTemplate x:Key="Theme.Script.Picture">
        <StackPanel Margin="0,0,14,8" VerticalAlignment="Top">
            <local:PImageLazy PImageLazyRow="{Binding}">
                <Rectangle Style="{StaticResource Theme.Script.Shape}" />
            </local:PImageLazy>
            <StackPanel Margin="0,4,0,0">
                <TextBlock Style="{StaticResource Theme.Script.Epoch}" />
                <TextBlock Style="{StaticResource Theme.Script.Caption}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Script.Row">
        <Grid Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="PScriptCharacter" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PScriptStyle" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Theme.Script.Character}" />
            <Border Grid.Column="1" Style="{StaticResource Theme.Script.Chip}">
                <TextBlock Style="{StaticResource Theme.Script.Style}" />
            </Border>
            <StackPanel Grid.Column="2">
                <ItemsControl ItemTemplate="{StaticResource Theme.Script.Picture}" ItemsSource="{Binding PScriptItemImages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Style="{StaticResource Theme.Script.Gloss}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
