<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Sound/PThemePronunciation.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Sound/PThemeAccent.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemePopup.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Transcription.Phonetician" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Tool}">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="ToolTip" Value="{DynamicResource Transcription.Title}" />
    </Style>

    <Style x:Key="Theme.Transcription.Option" TargetType="ComboBoxItem">
        <Setter Property="Height" Value="31" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="PSchemeSurface" Background="Transparent" CornerRadius="7">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Transcription.Scheme" TargetType="ComboBox">
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Theme.Transcription.Option}" />
        <Setter Property="ToolTip" Value="{DynamicResource Transcription.Title}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton
                            x:Name="PSchemeHead"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            ClickMode="Press"
                            Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PSchemeName" VerticalAlignment="Center" />
                                <local:PIconImage
                                    x:Name="PSchemeChevron"
                                    Width="12"
                                    Height="12"
                                    Margin="-1,1,-11,0"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <Popup
                            x:Name="PART_Popup"
                            MinWidth="124"
                            AllowsTransparency="True"
                            Placement="Bottom"
                            PopupAnimation="Fade"
                            StaysOpen="False">
                            <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                                <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Transcription.Addition" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Addition}" />

    <Style x:Key="Theme.Transcription.Remove" TargetType="Button" BasedOn="{StaticResource Theme.Accent.Remove}" />

    <DataTemplate x:Key="Theme.Transcription.Row">
        <Border Style="{StaticResource Theme.Pronunciation.Surface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReadingLabel" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource Theme.Pronunciation.Lead}">
                    <ComboBox x:Name="PTranscriptionScheme" Style="{StaticResource Theme.Transcription.Scheme}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Style="{StaticResource Theme.Pronunciation.Body}">
                    <Grid Style="{StaticResource Theme.Pronunciation.Cell}">
                        <TextBlock x:Name="PTranscriptionMeasure" Style="{StaticResource Theme.Pronunciation.Measure}" />
                        <TextBox x:Name="PTranscriptionField" Style="{StaticResource Theme.Pronunciation.Field}" Tag="{DynamicResource Input.Transcription}" />
                    </Grid>
                    <Button Style="{StaticResource Theme.Transcription.Phonetician}" />
                    <StackPanel x:Name="PAccentShelf" Style="{StaticResource Theme.Accent.Control}">
                        <Button Style="{StaticResource Theme.Transcription.Addition}" />
                        <Button Style="{StaticResource Theme.Transcription.Remove}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Transcription.Display">
        <Border Style="{StaticResource Theme.Pronunciation.Surface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReadingLabel" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource Theme.Pronunciation.Lead}">
                    <TextBlock x:Name="PTranscriptionLabel" Style="{StaticResource Theme.Pronunciation.Label}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Style="{StaticResource Theme.Pronunciation.Body}">
                    <TextBlock x:Name="PTranscriptionText" Style="{StaticResource Theme.Pronunciation.Text}" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
