<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIVeneer">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Sound/PThemePronunciation.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Sound/PThemeAccent.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Control/PThemeCommand.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Reflex.Surface" TargetType="Border" BasedOn="{StaticResource Theme.Pronunciation.Surface}">
        <Setter Property="Height" Value="31" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding LReflexItemHidden}" Value="True">
                <Setter Property="Visibility" Value="Hidden" />
                <Setter Property="Height" Value="0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Reflex.Label" TargetType="TextBlock" BasedOn="{StaticResource Theme.Pronunciation.Label}">
        <Setter Property="Text" Value="{Binding LReflexItemLabel}" />
        <Setter Property="ToolTip" Value="{Binding LReflexItemArea}" />
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Hidden" />
            </Trigger>
            <DataTrigger Binding="{Binding LReflexItemArea}" Value="">
                <Setter Property="ToolTip" Value="{x:Null}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Reflex.Text" TargetType="TextBlock" BasedOn="{StaticResource Theme.Pronunciation.Text}">
        <Setter Property="Margin" Value="0,-3,0,3" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="Text" Value="{Binding LReflexItemText}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding LReflexItemMain}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Reflex.Edge" TargetType="TextBlock" BasedOn="{StaticResource Theme.Pronunciation.Text}">
        <Setter Property="Margin" Value="0,-3,0,3" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
            <DataTrigger Binding="{Binding LReflexItemMain}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Reflex.Fold" TargetType="ToggleButton">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Content" Value="{DynamicResource Reflex.More}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <local:PIconImage
                                x:Name="PSurfaceMark"
                                Width="12"
                                Height="12"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                PIconSource="{local:PIcon expand, 12}"
                                RenderTransformOrigin="0.5,0.5" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PSurfaceMark" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Content" Value="{DynamicResource Reflex.Less}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Reflex.Tag" TargetType="TextBlock" BasedOn="{StaticResource Theme.Reflex.Label}">
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="MaxWidth" Value="160" />
        <Setter Property="ToolTip" Value="{x:Null}" />
        <Setter Property="Text" Value="{Binding LReflexItemTag}" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Hidden" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Reflex.Minor" TargetType="TextBlock" BasedOn="{StaticResource Theme.Pronunciation.Text}">
        <Setter Property="Margin" Value="6,0,3,2" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Hidden" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Reflex.Romanization" TargetType="TextBlock" BasedOn="{StaticResource Theme.Reflex.Minor}">
        <Setter Property="Margin" Value="12,0,3,2" />
        <Setter Property="Text" Value="{Binding LReflexItemRomanization}" />
    </Style>

    <Style x:Key="Theme.Reflex.Meaning" TargetType="TextBlock" BasedOn="{StaticResource Theme.Reflex.Minor}">
        <Setter Property="Text" Value="{Binding LReflexItemMeaning}" />
    </Style>

    <Style x:Key="Theme.Reflex.Note" TargetType="TextBlock" BasedOn="{StaticResource Theme.Reflex.Minor}">
        <Setter Property="Text" Value="{Binding LReflexItemNote}" />
    </Style>

    <Style x:Key="Theme.Reflex.Anchor" TargetType="TextBlock" BasedOn="{StaticResource Theme.Reflex.Minor}">
        <Setter Property="Margin" Value="12,0,3,2" />
        <Setter Property="MaxWidth" Value="520" />
        <Setter Property="Text" Value="{Binding LReflexItemAnchor}" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Reflex.Loading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Margin" Value="0,6,0,6" />
        <Setter Property="Text" Value="{DynamicResource Reflex.Loading}" />
    </Style>

    <DataTemplate x:Key="Theme.Reflex.Display">
        <Border Style="{StaticResource Theme.Reflex.Surface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReadingLabel" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReflexKind" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReflexText" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReflexRomanization" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReflexMeaning" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PReflexNote" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource Theme.Pronunciation.Lead}">
                    <TextBlock Style="{StaticResource Theme.Reflex.Label}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Style="{StaticResource Theme.Pronunciation.Lead}">
                    <TextBlock Style="{StaticResource Theme.Reflex.Tag}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="3,0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Theme.Reflex.Edge}" Text="{Binding LReflexItemOpener}" />
                    <TextBlock Style="{StaticResource Theme.Reflex.Text}" />
                    <TextBlock Style="{StaticResource Theme.Reflex.Edge}" Text="{Binding LReflexItemCloser}" />
                </StackPanel>
                <Grid Grid.Column="3" Margin="12,0,3,2" MinWidth="12">
                    <TextBlock Margin="0" Style="{StaticResource Theme.Reflex.Romanization}" />
                </Grid>
                <Grid Grid.Column="4" Margin="6,0,3,2" MinWidth="12">
                    <TextBlock Margin="0" Style="{StaticResource Theme.Reflex.Meaning}" />
                </Grid>
                <Grid Grid.Column="5" Margin="6,0,3,2" MinWidth="12">
                    <TextBlock Margin="0" Style="{StaticResource Theme.Reflex.Note}" />
                </Grid>
                <TextBlock Grid.Column="6" Style="{StaticResource Theme.Reflex.Anchor}" />
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
