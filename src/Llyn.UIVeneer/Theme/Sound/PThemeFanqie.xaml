<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemeInput.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Fanqie.Box" TargetType="Border">
        <Setter Property="Padding" Value="14,12,18,10" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="Background" Value="{StaticResource Theme.Surface}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Theme.Fanqie.Character" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="Theme.Fanqie.Chip" TargetType="Border">
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="0,2,14,0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{StaticResource Theme.AccentSoft}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Theme.Fanqie.Book" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Han}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Theme.Fanqie.Origin" TargetType="Border">
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="14,4,0,0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Theme.Fanqie.Source" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Theme.Fanqie.Part" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Theme.Fanqie.Link" TargetType="Button">
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ToolTip" Value="{DynamicResource Display.FanqieDiwei}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="PFanqieSurface"
                        Background="{StaticResource Theme.AccentSoft}"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="11"
                        SnapsToDevicePixels="True">
                        <TextBlock x:Name="PFanqieWord" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Fanqie.Initial" TargetType="Button" BasedOn="{StaticResource Theme.Fanqie.Link}" />

    <Style x:Key="Theme.Fanqie.Rime" TargetType="Button" BasedOn="{StaticResource Theme.Fanqie.Link}" />

    <Style x:Key="Theme.Fanqie.Knot" TargetType="TextBlock" BasedOn="{StaticResource Theme.Fanqie.Part}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
    </Style>

    <Style x:Key="Theme.Fanqie.Reading" TargetType="TextBlock" BasedOn="{StaticResource Theme.Fanqie.Part}">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Theme.Fanqie.Label" TargetType="TextBlock" BasedOn="{StaticResource Theme.Fanqie.Part}">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
    </Style>

    <Style x:Key="Theme.Fanqie.Medial" TargetType="Border">
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Visible" />
    </Style>

    <Style x:Key="Theme.Fanqie.MedialText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
    </Style>

    <Style x:Key="Theme.Fanqie.Spelling" TargetType="TextBlock" BasedOn="{StaticResource Theme.Fanqie.Part}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
    </Style>

    <Style x:Key="Theme.Fanqie.Text" TargetType="TextBlock" BasedOn="{StaticResource Theme.Fanqie.Part}" />

    <Style x:Key="Theme.Fanqie.RepresentativeIcon" TargetType="local:PIconImage">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Theme.Fanqie.RepresentativeOrder" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Representative}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="1,0,0,0" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="Theme.Fanqie.Representative" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ToolTip" Value="{DynamicResource Display.FanqieRepresentative}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PSurface" Background="Transparent">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <local:PIconImage x:Name="PFanqieStar" Style="{StaticResource Theme.Fanqie.RepresentativeIcon}" />
                            <TextBlock x:Name="PFanqieOrder" Style="{StaticResource Theme.Fanqie.RepresentativeOrder}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Theme.Fanqie.Line">
        <Grid Height="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieRepresentative" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieReading" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieLabel" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieInitial" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieRime" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieHeading" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieKnot" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieMedial" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieDivision" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieTone" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieSpelling" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PFanqieRepresentative" Style="{StaticResource Theme.Fanqie.Representative}" />
            <TextBlock x:Name="PFanqieReading" Grid.Column="1" Style="{StaticResource Theme.Fanqie.Reading}" />
            <TextBlock x:Name="PFanqieLabel" Grid.Column="2" Style="{StaticResource Theme.Fanqie.Label}" />
            <Button x:Name="PFanqieInitial" Grid.Column="3" Style="{StaticResource Theme.Fanqie.Initial}" />
            <Button x:Name="PFanqieRime" Grid.Column="4" Style="{StaticResource Theme.Fanqie.Rime}" />
            <TextBlock x:Name="PFanqieHeading" Grid.Column="5" Style="{StaticResource Theme.Fanqie.Part}" />
            <TextBlock x:Name="PFanqieKnot" Grid.Column="6" Style="{StaticResource Theme.Fanqie.Knot}" />
            <Border x:Name="PFanqieMedial" Grid.Column="7" Style="{StaticResource Theme.Fanqie.Medial}">
                <TextBlock x:Name="PFanqieMedialText" Style="{StaticResource Theme.Fanqie.MedialText}" />
            </Border>
            <TextBlock x:Name="PFanqieDivision" Grid.Column="8" Style="{StaticResource Theme.Fanqie.Part}" />
            <TextBlock x:Name="PFanqieTone" Grid.Column="9" Style="{StaticResource Theme.Fanqie.Part}" />
            <TextBlock x:Name="PFanqieSpelling" Grid.Column="10" Style="{StaticResource Theme.Fanqie.Spelling}" />
            <TextBlock x:Name="PFanqieText" Grid.Column="11" Style="{StaticResource Theme.Fanqie.Text}" />
        </Grid>
    </DataTemplate>

    <Style x:Key="Theme.Fanqie.Head" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="Theme.Fanqie.Loading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Margin" Value="0,2,0,6" />
    </Style>

    <Style x:Key="Theme.Fanqie.Stem" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="Theme.Fanqie.StemChip" TargetType="Border">
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{StaticResource Theme.AccentSoft}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Theme.Fanqie.StemLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Text" Value="{DynamicResource Display.FanqieShengfu}" />
    </Style>

    <Style x:Key="Theme.Fanqie.StemKey" TargetType="Button" BasedOn="{StaticResource Theme.Fanqie.Link}">
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="ToolTip" Value="{DynamicResource Display.FanqieStem}" />
    </Style>

    <DataTemplate x:Key="Theme.Fanqie.StemChipItem">
        <Button Style="{StaticResource Theme.Fanqie.StemKey}" />
    </DataTemplate>

    <DataTemplate x:Key="Theme.Fanqie.Row">
        <StackPanel Margin="0,0,0,2">
            <Grid x:Name="PFanqieStem" Style="{StaticResource Theme.Fanqie.Stem}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieCharacter" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieBook" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieRepresentative" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Theme.Fanqie.Character}" Text="" Visibility="Collapsed" />
                <Border Grid.Column="1" Style="{StaticResource Theme.Fanqie.StemChip}">
                    <TextBlock Style="{StaticResource Theme.Fanqie.StemLabel}" />
                </Border>
                <ItemsControl x:Name="PFanqieStems" Grid.Column="3" Margin="-9,0,0,0" VerticalAlignment="Center" ItemTemplate="{StaticResource Theme.Fanqie.StemChipItem}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieCharacter" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieBook" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieSource" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PFanqieCharacter" Style="{StaticResource Theme.Fanqie.Character}" />
                <Border x:Name="PFanqieChip" Grid.Column="1" Style="{StaticResource Theme.Fanqie.Chip}">
                    <TextBlock x:Name="PFanqieBook" Style="{StaticResource Theme.Fanqie.Book}" />
                </Border>
                <ItemsControl x:Name="PFanqieLines" Grid.Column="2" Margin="0,2,0,6" ItemTemplate="{StaticResource Theme.Fanqie.Line}" />
                <Border Grid.Column="3" Style="{StaticResource Theme.Fanqie.Origin}">
                    <TextBlock x:Name="PFanqieSource" Style="{StaticResource Theme.Fanqie.Source}" />
                </Border>
            </Grid>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
