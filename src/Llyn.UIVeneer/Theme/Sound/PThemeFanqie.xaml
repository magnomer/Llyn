<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIVeneer">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn;component/Theme/Base/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn;component/Theme/Base/PThemeInput.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Fanqie.Box" TargetType="Border">
        <Setter Property="Padding" Value="14,12,18,10" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="Background" Value="{StaticResource Theme.Surface}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Theme.Fanqie.Character" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Text" Value="{Binding PFanqieItemCharacter}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PFanqieItemCharacter}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Fanqie.Chip" TargetType="Border">
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="0,2,14,0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{StaticResource Theme.AccentSoft}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PFanqieItemBook}" Value="">
                <Setter Property="Visibility" Value="Hidden" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Fanqie.Book" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Han}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Text" Value="{Binding PFanqieItemBook}" />
    </Style>

    <Style x:Key="Theme.Fanqie.Origin" TargetType="Border">
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="14,4,0,0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Line}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Theme.Fanqie.Source" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Text" Value="{Binding PFanqieItemSource}" />
    </Style>

    <Style x:Key="Theme.Fanqie.Part" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Theme.Fanqie.Link" TargetType="Button">
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CommandParameter" Value="{Binding}" />
        <Setter Property="ToolTip" Value="{DynamicResource Display.FanqieDiwei}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="PFanqieSurface"
                        Padding="{TemplateBinding Padding}"
                        Background="{StaticResource Theme.AccentSoft}"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="11"
                        SnapsToDevicePixels="True">
                        <TextBlock VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PFanqieSurface" Property="BorderBrush" Value="{StaticResource Theme.Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PFanqieSurface" Property="Opacity" Value="0.72" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Content" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Fanqie.Heading" TargetType="TextBlock" BasedOn="{StaticResource Theme.Fanqie.Part}">
        <Setter Property="Text" Value="{Binding PFanqieLineHeading}" />
    </Style>

    <Style x:Key="Theme.Fanqie.Knot" TargetType="TextBlock" BasedOn="{StaticResource Theme.Fanqie.Part}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Text" Value="{Binding PFanqieLineKnot}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PFanqieLineKnot}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Fanqie.Reading" TargetType="TextBlock" BasedOn="{StaticResource Theme.Fanqie.Part}">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Text" Value="{Binding PFanqieLineReading}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PFanqieLineReading}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Fanqie.Label" TargetType="TextBlock" BasedOn="{StaticResource Theme.Fanqie.Part}">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
        <Setter Property="Text" Value="{Binding PFanqieLineLabel}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PFanqieLineLabel}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Fanqie.Medial" TargetType="Border">
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PFanqieLineMedial}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Fanqie.MedialText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Text" Value="{Binding PFanqieLineMedial}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PFanqieLineRounded}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Theme.Warning}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Fanqie.Spelling" TargetType="TextBlock" BasedOn="{StaticResource Theme.Fanqie.Part}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Text" Value="{Binding PFanqieLineSpelling}" />
    </Style>

    <Style x:Key="Theme.Fanqie.Text" TargetType="TextBlock" BasedOn="{StaticResource Theme.Fanqie.Part}">
        <Setter Property="Text" Value="{Binding PFanqieLineText}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PFanqieLineText}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Fanqie.RepresentativeIcon" TargetType="Path">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Data" Value="{local:PIcon star, 14}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <Setter Property="Fill" Value="{StaticResource Theme.Muted}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding PFanqieLineMarked}" Value="True">
                <Setter Property="Fill" Value="{StaticResource Theme.Representative}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Fanqie.RepresentativeOrder" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Representative}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="1,0,0,0" />
        <Setter Property="Text" Value="{Binding PFanqieLineOrder}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PFanqieLineMarked}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Fanqie.Representative" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Command" Value="{x:Static local:PFanqieCommand.PFanqieCommandRepresentative}" />
        <Setter Property="CommandParameter" Value="{Binding}" />
        <Setter Property="ToolTip" Value="{DynamicResource Display.FanqieRepresentative}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PSurface" Background="Transparent">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Style="{StaticResource Theme.Fanqie.RepresentativeIcon}" />
                            <TextBlock Style="{StaticResource Theme.Fanqie.RepresentativeOrder}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PSurface" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding PFanqieLineMarked}" Value="True" />
                    <Condition Binding="{Binding PFanqieLinePrimary}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Opacity" Value="0.62" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding PFanqieLineMarked}" Value="True">
                <Setter Property="ToolTip" Value="{DynamicResource Display.FanqieRepresentativeMarked}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="Theme.Fanqie.Line">
        <Grid Height="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieRepresentative" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieReading" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieLabel" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieInitial" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieRime" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieMedial" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieDivision" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieTone" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieSpelling" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource Theme.Fanqie.Representative}" />
            <TextBlock Grid.Column="1" Style="{StaticResource Theme.Fanqie.Reading}" />
            <TextBlock Grid.Column="2" Style="{StaticResource Theme.Fanqie.Label}" />
            <Button Grid.Column="3" Style="{StaticResource Theme.Fanqie.Link}" Command="{x:Static local:PFanqieCommand.PFanqieCommandInitial}" Content="{Binding PFanqieLineInitial}" />
            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button Style="{StaticResource Theme.Fanqie.Link}" Command="{x:Static local:PFanqieCommand.PFanqieCommandRime}" Content="{Binding PFanqieLineYunmu}" />
                <TextBlock Style="{StaticResource Theme.Fanqie.Heading}" />
                <TextBlock Style="{StaticResource Theme.Fanqie.Knot}" />
            </StackPanel>
            <Border Grid.Column="5" Style="{StaticResource Theme.Fanqie.Medial}">
                <TextBlock Style="{StaticResource Theme.Fanqie.MedialText}" />
            </Border>
            <TextBlock Grid.Column="6" Style="{StaticResource Theme.Fanqie.Part}" Text="{Binding PFanqieLineDivision}" />
            <TextBlock Grid.Column="7" Style="{StaticResource Theme.Fanqie.Part}" Text="{Binding PFanqieLineTone}" />
            <TextBlock Grid.Column="8" Style="{StaticResource Theme.Fanqie.Spelling}" />
            <TextBlock Grid.Column="9" Style="{StaticResource Theme.Fanqie.Text}" />
        </Grid>
    </DataTemplate>

    <Style x:Key="Theme.Fanqie.Head" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="Theme.Fanqie.Rebuild" TargetType="Button" BasedOn="{StaticResource Theme.Input.Pill}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="0,4,0,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
    </Style>

    <Style x:Key="Theme.Fanqie.Loading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Margin" Value="0,2,0,6" />
    </Style>

    <Style x:Key="Theme.Fanqie.Stem" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PFanqieItemStems.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Fanqie.StemChip" TargetType="Border">
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{StaticResource Theme.AccentSoft}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Theme.Fanqie.StemLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Text" Value="{DynamicResource Display.FanqieShengfu}" />
    </Style>

    <Style x:Key="Theme.Fanqie.StemKey" TargetType="Button" BasedOn="{StaticResource Theme.Fanqie.Link}">
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="Content" Value="{Binding}" />
        <Setter Property="Command" Value="{x:Static local:PFanqieCommand.PFanqieCommandStem}" />
        <Setter Property="ToolTip" Value="{DynamicResource Display.FanqieStem}" />
    </Style>

    <DataTemplate x:Key="Theme.Fanqie.StemChipItem">
        <Button Style="{StaticResource Theme.Fanqie.StemKey}" />
    </DataTemplate>

    <DataTemplate x:Key="Theme.Fanqie.Row">
        <StackPanel Margin="0,0,0,2">
            <Grid Style="{StaticResource Theme.Fanqie.Stem}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieCharacter" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieBook" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieRepresentative" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Theme.Fanqie.Character}" Text="" Visibility="Collapsed" />
                <Border Grid.Column="1" Style="{StaticResource Theme.Fanqie.StemChip}">
                    <TextBlock Style="{StaticResource Theme.Fanqie.StemLabel}" />
                </Border>
                <ItemsControl Grid.Column="3" Margin="-9,0,0,0" VerticalAlignment="Center" ItemTemplate="{StaticResource Theme.Fanqie.StemChipItem}" ItemsSource="{Binding PFanqieItemStems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieCharacter" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieBook" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PFanqieSource" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Theme.Fanqie.Character}" />
                <Border Grid.Column="1" Style="{StaticResource Theme.Fanqie.Chip}">
                    <TextBlock Style="{StaticResource Theme.Fanqie.Book}" />
                </Border>
                <ItemsControl Grid.Column="2" Margin="0,2,0,6" ItemTemplate="{StaticResource Theme.Fanqie.Line}" ItemsSource="{Binding PFanqieItemLines}" />
                <Border Grid.Column="3" Style="{StaticResource Theme.Fanqie.Origin}">
                    <TextBlock Style="{StaticResource Theme.Fanqie.Source}" />
                </Border>
            </Grid>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
