<UserControl
    x:Class="Llyn.UIVeneer.PReference"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment"
    xmlns:veneer="clr-namespace:Llyn.UIVeneer"
    >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Llyn.UIVeneer;component/Panel/Source/PReferenceShelf.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Llyn.UIVeneer;component/Panel/Source/PReferenceFootnote.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Theme.Shelf.Meta" TargetType="TextBlock" BasedOn="{StaticResource Theme.Catalog.Meta}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="-34,0,-34,0" Style="{StaticResource Theme.Panel.SeamRow}" />
        <local:QSeam Grid.Row="1" Grid.Column="1" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />
        <local:QSeam Grid.Row="1" Grid.Column="2" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />

        <Border
            x:Name="PGrade"
            Grid.Row="0"
            Grid.Column="0"
            Margin="{StaticResource Theme.Catalog.HeaderMargin}"
            Style="{StaticResource Theme.Search.Bar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <veneer:PChoiceOrder x:Name="PReferenceOrder" Grid.Column="0" />
                <Rectangle Grid.Column="1" Style="{StaticResource Theme.Search.Divider}" />
                <TextBox
                    x:Name="PSurvey"
                    Grid.Column="2"
                    Style="{StaticResource Theme.Search.Field}" />
            </Grid>
        </Border>

        <Border
            x:Name="PTrellis"
            Grid.Row="0"
            Grid.Column="1"
            Margin="-4,0,16,18"
            Style="{StaticResource Theme.Search.Bar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="PRummage"
                    Grid.Column="0"
                    Style="{StaticResource Theme.Search.Field}" />
                <Rectangle Grid.Column="1" Margin="2,0,5,0" Style="{StaticResource Theme.Search.Divider}" />
                <veneer:PChoiceFilter x:Name="PReferenceFilter" Grid.Column="2" />
            </Grid>
        </Border>

        <veneer:PPanelRail x:Name="PReferenceRail" Grid.Row="0" Grid.Column="2" Margin="0,0,0,18" />

        <Grid Grid.Row="1" Grid.Column="0" Style="{StaticResource Theme.Catalog.Frame}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl
                    x:Name="PShelf"
                    ItemTemplate="{StaticResource Reference.Shelf.Card}" />
            </ScrollViewer>
            <TextBlock
                x:Name="PShelfEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Source.Empty}" />
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" Style="{StaticResource Theme.Catalog.Middle}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl
                    x:Name="PFootnote"
                    ItemTemplate="{StaticResource Reference.Footnote.Card}" />
            </ScrollViewer>
            <TextBlock
                x:Name="PFootnoteEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Source.Vacant}" />
        </Grid>

        <Border Grid.Row="1" Grid.Column="2" Margin="0,14,0,0" ClipToBounds="True" Style="{StaticResource Theme.Panel.Surface}">
            <Grid>
                <veneer:PDisplay x:Name="PDisplay" Visibility="Collapsed" />

                <veneer:PEditor x:Name="PEditor" Padding="30,18,30,30" Visibility="Collapsed" />

                <veneer:PColophon x:Name="PColophon" />

                <veneer:PImprint x:Name="PImprint" Margin="21,18,0,0" Visibility="Collapsed" />

                <Button
                    x:Name="PReferenceBin"
                    Margin="0,17,26,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    IsEnabled="False"
                    Style="{StaticResource Theme.Input.Bin}"
                    ToolTip="{DynamicResource Scribe.Delete}">
                    <local:QIconImage x:Name="PReferenceBinIcon" Width="24" Height="24" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
