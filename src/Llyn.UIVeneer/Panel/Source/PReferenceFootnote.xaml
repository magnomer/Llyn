<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="Reference.Footnote.Card">
        <Button x:Name="PFootnoteRow" Style="{DynamicResource Theme.Catalog.Row}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="PFootnoteFlag" Grid.Column="0" Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform" />
                <TextBlock Grid.Column="1" Style="{DynamicResource Theme.Catalog.Title}"><Run x:Name="PFootnoteName" /><Run
                    x:Name="PFootnoteEpithet"
                    Style="{DynamicResource Theme.Catalog.Epithet}" /></TextBlock>
                <TextBlock x:Name="PFootnoteLanguage" Grid.Column="2" Margin="10,0,0,0" Style="{DynamicResource Theme.Catalog.Meta}" />
            </Grid>
        </Button>
    </DataTemplate>

</ResourceDictionary>
