<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment">

    <DataTemplate x:Key="Reference.Shelf.Card">
        <Button x:Name="PShelfRow" Style="{DynamicResource Theme.Catalog.Row}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:PIconImage
                    x:Name="PShelfIcon"
                    Grid.Column="0"
                    Width="16"
                    Height="16"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center" />
                <TextBlock x:Name="PShelfName" Grid.Column="1" Style="{DynamicResource Theme.Catalog.Title}" />
                <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock x:Name="PShelfAuthor" MaxWidth="220" Style="{DynamicResource Theme.Shelf.Meta}" />
                    <TextBlock Style="{DynamicResource Theme.Catalog.Dot}" />
                    <TextBlock x:Name="PShelfYear" Style="{DynamicResource Theme.Shelf.Meta}" />
                </StackPanel>
                <Border Grid.Column="3" Style="{DynamicResource Theme.Catalog.Pellet}" ToolTip="{DynamicResource Source.Tally}">
                    <TextBlock x:Name="PShelfCount" Style="{DynamicResource Theme.Catalog.Tally}" />
                </Border>
            </Grid>
        </Button>
    </DataTemplate>

</ResourceDictionary>
