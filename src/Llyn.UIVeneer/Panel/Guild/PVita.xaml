<UserControl
    x:Class="Llyn.UIVeneer.PVita"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Llyn.UIVeneer;component/Panel/Guild/PGuildTemplate.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Llyn.UIVeneer;component/Theme/Sound/PThemeSpeech.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Theme.Vita.Title" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer Margin="30,18,0,0" Focusable="False" Padding="0,0,10,0" HorizontalScrollBarVisibility="Disabled"
            Style="{StaticResource Theme.Scroll.Gutter}" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PVitaBody" Margin="0,0,60,30" Visibility="Collapsed">
                <TextBlock x:Name="PVitaName" Style="{StaticResource Theme.Vita.Title}" />

                <WrapPanel Margin="12,14,0,7" Orientation="Horizontal">
                    <Border Style="{StaticResource Theme.Page.Tally}">
                        <TextBlock x:Name="PVitaWork" Style="{StaticResource Theme.Page.Figure}" />
                    </Border>
                    <Border Style="{StaticResource Theme.Page.Tally}">
                        <TextBlock x:Name="PVitaTally" Style="{StaticResource Theme.Page.Figure}" />
                    </Border>
                </WrapPanel>

                <StackPanel x:Name="PVitaFellowSection" Margin="0,28,0,0">
                    <TextBlock Style="{StaticResource Theme.Page.Heading}" Text="{DynamicResource Vita.Fellow}" />
                    <ItemsControl
                        x:Name="PFellow"
                        Margin="-10,0,0,0"
                        ItemTemplate="{StaticResource Guild.Fellow.Card}" />
                </StackPanel>

                <StackPanel x:Name="PVitaCitationSection" Margin="0,28,0,0">
                    <TextBlock Style="{StaticResource Theme.Page.Heading}" Text="{DynamicResource Vita.Citation}" />
                    <ItemsControl
                        x:Name="PVitaCitation"
                        Margin="-10,0,0,0"
                        ItemTemplate="{StaticResource Guild.Citation.Card}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <TextBlock
            x:Name="PVitaUnselected"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{StaticResource Theme.Muted}"
            IsHitTestVisible="False"
            Text="{DynamicResource Guild.Unselected}"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
