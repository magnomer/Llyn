<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Llyn.UIVeneer;component/Panel/Guild/PGuildTemplate.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Llyn.UIVeneer;component/Theme/Sound/PThemeSpeech.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Theme.Autograph.Title" TargetType="TextBox" BasedOn="{StaticResource Theme.Input.Bare}">
                <Setter Property="MinHeight" Value="37" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="Theme.Autograph.Heading" TargetType="TextBlock">
                <Setter Property="Height" Value="34" />
                <Setter Property="Margin" Value="2,0,2,12" />
                <Setter Property="Padding" Value="0,5,0,0" />
                <Setter Property="FontSize" Value="19" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="Theme.Autograph.Field" TargetType="TextBox" BasedOn="{StaticResource Theme.Input.Bare}">
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="AcceptsReturn" Value="False" />
            </Style>

            <Style x:Key="Theme.Autograph.Tally" TargetType="Border" BasedOn="{StaticResource Theme.Speech.Chip}">
                <Setter Property="Background" Value="{StaticResource Theme.SurfaceRaised}" />
            </Style>

            <Style x:Key="Theme.Autograph.Figure" TargetType="TextBlock" BasedOn="{StaticResource Theme.Speech.Name}">
                <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Padding="0,0,10,0" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource Theme.Scroll.Gutter}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="9,0,20,30">
            <TextBox
                x:Name="PAutographName"
                Margin="0,0,60,0"
                Style="{StaticResource Theme.Autograph.Title}"
                Tag="{DynamicResource Autograph.Name}" />

            <WrapPanel Margin="12,14,0,7" Orientation="Horizontal">
                <Border Style="{StaticResource Theme.Autograph.Tally}">
                    <TextBlock x:Name="PAutographWork" Style="{StaticResource Theme.Autograph.Figure}" />
                </Border>
                <Border Style="{StaticResource Theme.Autograph.Tally}">
                    <TextBlock x:Name="PAutographTally" Style="{StaticResource Theme.Autograph.Figure}" />
                </Border>
            </WrapPanel>

            <StackPanel Margin="0,28,0,0">
                <TextBlock Style="{StaticResource Theme.Autograph.Heading}" Text="{DynamicResource Autograph.Union}" />
                <Grid Margin="2,0">
                    <StackPanel x:Name="PAutographUnionBody">
                        <TextBox
                            x:Name="PAutographUnion"
                            Style="{StaticResource Theme.Autograph.Field}"
                            Tag="{DynamicResource Autograph.UnionSearch}" />
                        <ItemsControl
                            x:Name="PAutographUnionList"
                            Margin="-12,10,0,0"
                            ItemTemplate="{StaticResource Guild.Union.Card}" />
                    </StackPanel>
                    <TextBlock
                        x:Name="PAutographUnionNotice"
                        VerticalAlignment="Top"
                        Foreground="{StaticResource Theme.Muted}"
                        IsHitTestVisible="False"
                        Text="{DynamicResource Autograph.UnionUnsaved}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
