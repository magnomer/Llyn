<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIVeneer">

    <DataTemplate x:Key="Guild.Roll.Card">
        <Button Style="{DynamicResource Theme.Roll.Row}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:PIconImage Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" PIconSource="{Binding PRollItemMark}" />
                <TextBlock Grid.Column="1" Style="{DynamicResource Theme.Catalog.Title}" Text="{Binding PRollItemName}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" Style="{DynamicResource Theme.Catalog.Meta}" Text="{Binding PRollItemWork}" />
                <Border Grid.Column="3" Style="{DynamicResource Theme.Catalog.Pellet}" ToolTip="{DynamicResource Guild.Tally}">
                    <TextBlock Style="{DynamicResource Theme.Catalog.Tally}" Text="{Binding PRollItemCount}" />
                </Border>
            </Grid>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="Guild.Fellow.Card">
        <Button Style="{DynamicResource Theme.Vita.Row}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:PIconImage Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" PIconSource="{local:PIcon guild, 16}" />
                <TextBlock Grid.Column="1" Style="{DynamicResource Theme.Catalog.Title}" Text="{Binding PFellowItemName}" />
                <Border Grid.Column="2" Style="{DynamicResource Theme.Catalog.Pellet}" ToolTip="{DynamicResource Vita.Shared}">
                    <TextBlock Style="{DynamicResource Theme.Catalog.Tally}" Text="{Binding PFellowItemCount}" />
                </Border>
            </Grid>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="Guild.Citation.Card">
        <Button Style="{DynamicResource Theme.Vita.Row}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Source="{Binding LUsageItemFlag}" Stretch="Uniform" />
                <TextBlock Grid.Column="1" Style="{DynamicResource Theme.Catalog.Title}"><Run Text="{Binding LUsageItemName, Mode=OneWay}" /><Run
                    Style="{DynamicResource Theme.Catalog.Epithet}"
                    Text="{Binding LUsageItemEpithet, Mode=OneWay, StringFormat='&#x2002;{0}'}" /></TextBlock>
                <TextBlock Grid.Column="2" MaxWidth="220" Margin="10,0,0,0" Style="{DynamicResource Theme.Catalog.Meta}" Text="{Binding LUsageItemTitle}" />
                <Border Grid.Column="3" Style="{DynamicResource Theme.Catalog.Pellet}">
                    <TextBlock Style="{DynamicResource Theme.Catalog.Tally}" Text="{Binding LUsageItemOwner}" />
                </Border>
            </Grid>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="Guild.Union.Card">
        <Button Style="{DynamicResource Theme.Vita.Row}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:PIconImage Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" PIconSource="{local:PIcon guild, 16}" />
                <TextBlock Grid.Column="1" Style="{DynamicResource Theme.Catalog.Title}" Text="{Binding PRollItemName}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" Style="{DynamicResource Theme.Catalog.Meta}" Text="{Binding PRollItemWork}" />
            </Grid>
        </Button>
    </DataTemplate>

</ResourceDictionary>
