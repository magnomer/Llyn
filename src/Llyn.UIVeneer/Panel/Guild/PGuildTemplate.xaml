<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment">

    <DataTemplate x:Key="Guild.Roll.Card">
        <Button x:Name="PRollRow" Style="{DynamicResource Theme.Catalog.Row}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:PIconImage x:Name="PRollMark" Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="PRollName" Grid.Column="1" Style="{DynamicResource Theme.Catalog.Title}" />
                <TextBlock x:Name="PRollWork" Grid.Column="2" Margin="10,0,0,0" Style="{DynamicResource Theme.Catalog.Meta}" />
                <Border Grid.Column="3" Style="{DynamicResource Theme.Catalog.Pellet}" ToolTip="{DynamicResource Guild.Tally}">
                    <TextBlock x:Name="PRollCount" Style="{DynamicResource Theme.Catalog.Tally}" />
                </Border>
            </Grid>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="Guild.Fellow.Card">
        <Button Style="{DynamicResource Theme.Catalog.Row}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:PIconImage x:Name="PFellowIcon" Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="PFellowName" Grid.Column="1" Style="{DynamicResource Theme.Catalog.Title}" />
                <Border Grid.Column="2" Style="{DynamicResource Theme.Catalog.Pellet}" ToolTip="{DynamicResource Vita.Shared}">
                    <TextBlock x:Name="PFellowCount" Style="{DynamicResource Theme.Catalog.Tally}" />
                </Border>
            </Grid>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="Guild.Citation.Card">
        <Button Style="{DynamicResource Theme.Catalog.Row}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="PUsageFlag" Grid.Column="0" Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform" />
                <TextBlock Grid.Column="1" Style="{DynamicResource Theme.Catalog.Title}"><Run x:Name="PUsageName" /><Run
                    x:Name="PUsageEpithet"
                    Style="{DynamicResource Theme.Catalog.Epithet}" /></TextBlock>
                <TextBlock x:Name="PUsageTitle" Grid.Column="2" MaxWidth="220" Margin="10,0,0,0" Style="{DynamicResource Theme.Catalog.Meta}" />
                <Border Grid.Column="3" Style="{DynamicResource Theme.Catalog.Pellet}">
                    <TextBlock x:Name="PUsageOwner" Style="{DynamicResource Theme.Catalog.Tally}" />
                </Border>
            </Grid>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="Guild.Union.Card">
        <Button x:Name="PRollRow" Style="{DynamicResource Theme.Catalog.Row}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:PIconImage x:Name="PRollMark" Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="PRollName" Grid.Column="1" Style="{DynamicResource Theme.Catalog.Title}" />
                <TextBlock x:Name="PRollWork" Grid.Column="2" Margin="10,0,0,0" Style="{DynamicResource Theme.Catalog.Meta}" />
            </Grid>
        </Button>
    </DataTemplate>

</ResourceDictionary>
