<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment"
    >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Llyn.UIVeneer;component/Editor/Core/PEditorPopup.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Llyn.UIVeneer;component/Panel/Corpus/PCorpusExcerpt.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="-34,0,-34,0" Style="{StaticResource Theme.Panel.SeamRow}" />
        <local:PSeam Grid.Row="1" Grid.Column="1" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />
        <local:PSeam Grid.Row="1" Grid.Column="2" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />

        <Border
            x:Name="PRank"
            Grid.Row="0"
            Grid.Column="0"
            Margin="{StaticResource Theme.Catalog.HeaderMargin}"
            Style="{StaticResource Theme.Search.Bar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton
                    x:Name="PRankDropper"
                    Grid.Column="0"
                    Style="{StaticResource Theme.Search.Dropper}"
                    ToolTip="{DynamicResource Rank.Title}">
                    <local:PIconImage x:Name="PRankIcon" Width="24" Height="24" />
                </ToggleButton>
                <Rectangle Grid.Column="1" Style="{StaticResource Theme.Search.Divider}" />
                <TextBox
                    x:Name="PQuery"
                    Grid.Column="2"
                    Style="{StaticResource Theme.Search.Field}"
                    Tag="{DynamicResource Example.Search}" />
                <Popup
                    x:Name="PRankDropdown"
                    Width="238"
                    AllowsTransparency="True"
                    Placement="Bottom"
                    StaysOpen="False"
                    VerticalOffset="6">
                    <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                        <StackPanel x:Name="PRankList">
                            <TextBlock Margin="10,7,10,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Rank.Title}" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <Border
            x:Name="PGauze"
            Grid.Row="0"
            Grid.Column="1"
            Margin="-4,0,16,18"
            Style="{StaticResource Theme.Search.Bar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="PDredge"
                    Grid.Column="0"
                    Style="{StaticResource Theme.Search.Field}"
                    Tag="{DynamicResource Dredge.Search}" />
                <Rectangle Grid.Column="1" Margin="2,0,5,0" Style="{StaticResource Theme.Search.Divider}" />
                <ToggleButton
                    x:Name="PGauzeDropper"
                    Grid.Column="2"
                    Style="{StaticResource Theme.Search.Dropper}"
                    ToolTip="{DynamicResource Gauze.Title}">
                    <Grid Width="24" Height="24">
                        <local:PIconImage x:Name="PGauzeIcon" Width="24" Height="24" />
                        <Ellipse
                            x:Name="PGauzeMark"
                            Width="6"
                            Height="6"
                            Margin="0,2,1,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Fill="{StaticResource Theme.Accent}"
                            Visibility="Collapsed" />
                    </Grid>
                </ToggleButton>
                <Popup
                    x:Name="PGauzeDropdown"
                    Width="190"
                    AllowsTransparency="True"
                    HorizontalOffset="-151"
                    Placement="Bottom"
                    StaysOpen="False"
                    VerticalOffset="6">
                    <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                        <StackPanel x:Name="PGauzeList" />
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <local:PRail Grid.Row="0" Grid.Column="2" Margin="0,0,0,18">
            <Border Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="PCorpusFresh"
                        Content="{DynamicResource Scribe.New}"
                        Style="{StaticResource Theme.Command.Segment}" />
                    <Button
                        x:Name="PCorpusStore"
                        Content="{DynamicResource Scribe.Save}"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Primary}" />
                    <Rectangle Style="{StaticResource Theme.Command.Divider}" />
                    <StackPanel x:Name="PCorpusVoyage" Orientation="Horizontal">
                        <Button
                            x:Name="PCorpusEarlier"
                            IsEnabled="False"
                            Style="{StaticResource Theme.Command.Segment}"
                            ToolTip="{DynamicResource Voyage.Retreat}" />
                        <Button
                            x:Name="PCorpusLater"
                            IsEnabled="False"
                            Style="{StaticResource Theme.Command.Segment}"
                            ToolTip="{DynamicResource Voyage.Advance}" />
                    </StackPanel>
                    <StackPanel x:Name="PCorpusChronicle" Orientation="Horizontal" Visibility="Collapsed">
                        <Button
                            x:Name="PCorpusBackward"
                            IsEnabled="False"
                            Style="{StaticResource Theme.Command.Segment}"
                            ToolTip="{DynamicResource Chronicle.Undo}" />
                        <Button
                            x:Name="PCorpusForward"
                            IsEnabled="False"
                            Style="{StaticResource Theme.Command.Segment}"
                            ToolTip="{DynamicResource Chronicle.Redo}" />
                    </StackPanel>
                    <Rectangle Style="{StaticResource Theme.Command.Divider}" />
                    <Button
                        x:Name="PCorpusPortrait"
                        Content="{DynamicResource Scribe.Export}"
                        Style="{StaticResource Theme.Command.Segment}" />
                    <Button
                        x:Name="PCorpusPress"
                        Content="{DynamicResource Scribe.Print}"
                        Style="{StaticResource Theme.Command.Segment}" />
                </StackPanel>
            </Border>
            <Border
                x:Name="PCorpusMode"
                IsEnabled="False"
                Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        x:Name="PCorpusViewer"
                        Content="{DynamicResource Scribe.View}"
                        GroupName="PCorpusMode"
                        IsChecked="True"
                        Style="{StaticResource Theme.Command.Mode}" />
                    <RadioButton
                        x:Name="PCorpusScribe"
                        Content="{DynamicResource Scribe.Edit}"
                        GroupName="PCorpusMode"
                        Style="{StaticResource Theme.Command.Mode}" />
                </StackPanel>
            </Border>
        </local:PRail>

        <Grid Grid.Row="1" Grid.Column="0" Style="{StaticResource Theme.Catalog.Frame}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl x:Name="PAnthology">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="PAnthologyRow" Style="{StaticResource Theme.Catalog.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="PAnthologyFlag" Grid.Column="0" Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform" />
                                    <TextBlock x:Name="PAnthologyName" Grid.Column="1" Style="{StaticResource Theme.Catalog.Title}" />
                                    <TextBlock x:Name="PAnthologyLanguage" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Theme.Anthology.Meta}" />
                                    <Border Grid.Column="3" Style="{StaticResource Theme.Catalog.Pellet}">
                                        <TextBlock x:Name="PAnthologyCount" Style="{StaticResource Theme.Catalog.Tally}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="PAnthologyEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Example.Empty}" />
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" Style="{StaticResource Theme.Catalog.Middle}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl x:Name="PQuotation">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="PQuotationRow" Style="{StaticResource Theme.Catalog.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="PQuotationFlag" Grid.Column="0" Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Theme.Catalog.Title}"><Run x:Name="PQuotationName" /><Run
                                        x:Name="PQuotationEpithet"
                                        Style="{StaticResource Theme.Catalog.Epithet}" /></TextBlock>
                                    <TextBlock x:Name="PQuotationLanguage" Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource Theme.Catalog.Meta}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="PQuotationEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Example.Vacant}" />
        </Grid>

        <Border Grid.Row="1" Grid.Column="2" Margin="0,14,0,0" ClipToBounds="True" Style="{StaticResource Theme.Panel.Surface}">
            <Grid>
                <local:PDisplay x:Name="PDisplay" Visibility="Collapsed" />

                <local:PEditor x:Name="PEditor" Padding="30,18,30,30" Visibility="Collapsed" />

                <Grid x:Name="PExcerpt">
                    <ScrollViewer
                        Margin="30,18,0,0"
                        Focusable="False"
                        Padding="0,0,10,0"
                        HorizontalScrollBarVisibility="Disabled"
                        Style="{StaticResource Theme.Scroll.Gutter}"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PExcerptBody" Margin="0,0,60,30" Visibility="Collapsed">
                            <local:PMention
                                x:Name="PExcerptText"
                                FontFamily="{DynamicResource Theme.Font}"
                                FontSize="28"
                                FontWeight="SemiBold"
                                Style="{StaticResource Theme.Excerpt.Sentence}" />

                            <WrapPanel Margin="12,14,0,7" Orientation="Horizontal">
                                <Border Style="{StaticResource Theme.Excerpt.Chip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image x:Name="PExcerptFlag" Style="{StaticResource Theme.Excerpt.Flag}" />
                                        <TextBlock x:Name="PExcerptLanguage" Style="{StaticResource Theme.Speech.Name}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Theme.Excerpt.Tally}">
                                    <TextBlock x:Name="PExcerptTally" Style="{StaticResource Theme.Excerpt.Figure}" />
                                </Border>
                            </WrapPanel>

                            <StackPanel x:Name="PExcerptGlossSection" Margin="0,28,0,0">
                                <TextBlock Style="{StaticResource Theme.Excerpt.Heading}" Text="{DynamicResource Example.Translation}" />
                                <ItemsControl x:Name="PExcerptGloss" Margin="2,0" ItemTemplate="{DynamicResource Theme.Gloss.Display}" />
                            </StackPanel>

                            <StackPanel x:Name="PExcerptCitationSection" Margin="0,28,0,0">
                                <TextBlock Style="{StaticResource Theme.Excerpt.Heading}" Text="{DynamicResource Reference.Title}" />
                                <TextBlock x:Name="PExcerptCitation" Margin="2,0" Style="{StaticResource Theme.Display.Value}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock
                        x:Name="PExcerptUnselected"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Theme.Muted}"
                        IsHitTestVisible="False"
                        Text="{DynamicResource Example.Unselected}"
                        TextWrapping="Wrap" />
                </Grid>

                <Grid x:Name="PTranscript" Margin="21,18,0,0" Visibility="Collapsed">
                    <ScrollViewer Padding="0,0,10,0" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource Theme.Scroll.Gutter}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="9,0,20,30">
                            <TextBox
                                x:Name="PTranscriptText"
                                Margin="0,0,60,0"
                                ContextMenu="{DynamicResource Theme.Mention.Menu}"
                                Style="{DynamicResource Theme.Transcript.Sentence}" />
                            <ItemsControl x:Name="PTranscriptMentionLine" ItemTemplate="{DynamicResource Theme.Mention.Chip}" Style="{DynamicResource Theme.Mention.Line}" />

                            <WrapPanel Margin="12,14,0,7" Orientation="Horizontal">
                                <Grid>
                                    <ToggleButton x:Name="PSpeaker" Style="{DynamicResource Theme.Transcript.Speaker}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image x:Name="PSpeakerFlag" Style="{StaticResource Theme.Excerpt.Flag}" />
                                            <TextBlock x:Name="PSpeakerName" Style="{StaticResource Theme.Speech.Name}" />
                                            <local:PIconImage
                                                x:Name="PSpeakerIcon"
                                                Width="12"
                                                Height="12"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <Popup
                                        x:Name="PLanguage"
                                        Width="238"
                                        AllowsTransparency="True"
                                        Placement="Bottom"
                                        StaysOpen="False">
                                        <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                                            <ItemsControl x:Name="PLanguageList" ItemTemplate="{DynamicResource Theme.Language.Choice}" />
                                        </Border>
                                    </Popup>
                                </Grid>
                                <Border Style="{StaticResource Theme.Excerpt.Tally}">
                                    <TextBlock x:Name="PTranscriptTally" Style="{StaticResource Theme.Excerpt.Figure}" />
                                </Border>
                            </WrapPanel>

                            <StackPanel Margin="0,28,0,0">
                                <TextBlock Style="{StaticResource Theme.Excerpt.Heading}" Text="{DynamicResource Example.Translation}" />
                                <ItemsControl x:Name="PTranscriptGlossLine" Margin="2,0,0,0" ItemTemplate="{DynamicResource Theme.Transcript.Line}" />
                                <Border x:Name="PTranscriptSeed" Margin="2,5,0,0" Style="{DynamicResource Theme.Transcript.Row}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="PTranscriptSeedField"
                                            Grid.Column="1"
                                            Margin="0"
                                            Style="{DynamicResource Theme.Transcript.Gloss}"
                                            Tag="{DynamicResource Example.Translation}" />
                                        <StackPanel x:Name="PTranscriptShelf" Grid.Column="2" Style="{DynamicResource Theme.Transcript.Control}">
                                            <Button x:Name="PTranscriptAddition" Style="{DynamicResource Theme.Transcript.Addition}">
                                                <local:PIconImage Width="12" Height="12" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Margin="0,28,0,0">
                                <TextBlock Style="{StaticResource Theme.Excerpt.Heading}" Text="{DynamicResource Reference.Title}" />
                                <Grid HorizontalAlignment="Left">
                                    <TextBox
                                        x:Name="PCitationField"
                                        Style="{DynamicResource Theme.Transcript.Citation}" />
                                    <Popup
                                        x:Name="PCitationDrawer"
                                        MaxWidth="320"
                                        AllowsTransparency="True"
                                        Placement="Custom"
                                        StaysOpen="False">
                                        <Border x:Name="PCitationSheet" Style="{StaticResource Editor.Popup.Frame}">
                                            <ListBox
                                                x:Name="PCitationList"
                                                MaxHeight="232"
                                                ItemContainerStyle="{StaticResource Editor.Popup.Caret}"
                                                ItemTemplate="{DynamicResource Theme.Citation.Row}"
                                                Style="{StaticResource Editor.Popup.List}" />
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Button
                    x:Name="PCorpusBin"
                    Margin="0,17,26,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    IsEnabled="False"
                    Style="{StaticResource Theme.Input.Bin}"
                    ToolTip="{DynamicResource Scribe.Delete}">
                    <local:PIconImage x:Name="PCorpusBinIcon" Width="24" Height="24" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
