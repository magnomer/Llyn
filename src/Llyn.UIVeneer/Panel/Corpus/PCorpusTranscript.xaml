<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment">

    <Style x:Key="Theme.Transcript.Sentence" TargetType="TextBox" BasedOn="{StaticResource Theme.Input.Bare}">
        <Setter Property="MinHeight" Value="37" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Theme.Transcript.Speaker" TargetType="ToggleButton" BasedOn="{StaticResource Theme.Language.Toggle}">
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,0,7,7" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.AccentEdge}" />
    </Style>

    <Style x:Key="Theme.Transcript.Citation" TargetType="TextBox" BasedOn="{StaticResource Theme.Input.Bare}">
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="AcceptsReturn" Value="False" />
        <Setter Property="Tag" Value="{DynamicResource Reference.Assign}" />
    </Style>

    <Style x:Key="Theme.Transcript.Gloss" TargetType="TextBox" BasedOn="{StaticResource Theme.Input.Bare}">
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="Theme.Transcript.Row" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="Theme.Transcript.Control" TargetType="StackPanel">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="Theme.Transcript.Addition" TargetType="Button" BasedOn="{StaticResource Theme.Card.Handle}">
        <Setter Property="ToolTip" Value="{DynamicResource Gloss.Add}" />
    </Style>

    <Style x:Key="Theme.Transcript.Remove" TargetType="Button" BasedOn="{StaticResource Theme.Card.Handle}">
        <Setter Property="Margin" Value="4,0,0,0" />
    </Style>

    <DataTemplate x:Key="Theme.Transcript.Line">
        <Border Margin="0,5,0,0" Style="{StaticResource Theme.Transcript.Row}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ToggleButton
                x:Name="PGlossSpeaker"
                Margin="-4,2,0,-1"
                Padding="4,2"
                VerticalAlignment="Top"
                Style="{DynamicResource Theme.Card.Switch}">
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="PGlossFlag" Style="{DynamicResource Theme.Gloss.Flag}" />
                    <Ellipse x:Name="PGlossGlobe" Style="{DynamicResource Theme.Gloss.Globe}" />
                </StackPanel>
            </ToggleButton>
            <Popup
                x:Name="PGlossPopup"
                Width="238"
                AllowsTransparency="True"
                Placement="Bottom"
                StaysOpen="False">
                <Border Margin="10" Style="{DynamicResource Theme.Popup.Surface}">
                    <ListBox
                        x:Name="PGlossList"
                        MaxHeight="220"
                        Background="Transparent"
                        BorderThickness="0"
                        IsSynchronizedWithCurrentItem="False"
                        ItemContainerStyle="{DynamicResource Theme.Gloss.Choice}"
                        ItemTemplate="{DynamicResource Theme.Gloss.Option}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Border>
            </Popup>

            <TextBox
                x:Name="PGlossText"
                Grid.Column="1"
                Style="{StaticResource Theme.Transcript.Gloss}" />

            <StackPanel x:Name="PTranscriptShelf" Grid.Column="2" Style="{StaticResource Theme.Transcript.Control}">
                <Button x:Name="PGlossAddition" Style="{StaticResource Theme.Transcript.Addition}">
                    <local:PIconImage Width="12" Height="12" />
                </Button>
                <Button x:Name="PGlossRemoval" Style="{StaticResource Theme.Transcript.Remove}">
                    <local:PIconImage Width="12" Height="12" />
                </Button>
            </StackPanel>
        </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Citation.Row">
        <Grid x:Name="PCitationRow" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Theme.Ink}" TextTrimming="CharacterEllipsis">
                <Run x:Name="PCitationLead" /><Run
                    x:Name="PCitationMark"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Theme.Accent}" /><Run x:Name="PCitationTail" />
            </TextBlock>
            <TextBlock x:Name="PCitationCount" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource Theme.Muted}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Language.Choice">
        <Button x:Name="PSpeakerChoice" Height="31" Padding="12,0" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Theme.Ink}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image x:Name="PGlossOptionFlag" Width="19" Height="14" VerticalAlignment="Center" Stretch="Uniform" />
                <TextBlock x:Name="PGlossOptionName" Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontSize="13" />
            </Grid>
        </Button>
    </DataTemplate>
</ResourceDictionary>
