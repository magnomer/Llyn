<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment">

    <Style x:Key="Imprint.Credit.Field" TargetType="TextBox" BasedOn="{StaticResource Theme.Input.Bare}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="AcceptsReturn" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Imprint.Credit.Control" TargetType="FrameworkElement">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="Imprint.Credit.Handle" TargetType="Button" BasedOn="{StaticResource Theme.Card.Handle}">
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <DataTemplate x:Key="Imprint.Credit.Card">
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PAuthorName" Style="{StaticResource Imprint.Credit.Field}" Tag="{DynamicResource Source.AuthorName}" />
            <StackPanel x:Name="PAuthorShelf" Grid.Column="1" Margin="8,0,0,0" Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel" BasedOn="{StaticResource Imprint.Credit.Control}" />
                </StackPanel.Style>
                <Button x:Name="PAuthorAddition" Style="{StaticResource Imprint.Credit.Handle}" ToolTip="{DynamicResource Source.AuthorAdd}">
                    <local:PIconImage x:Name="PAuthorAdditionIcon" Width="12" Height="12" />
                </Button>
                <Button x:Name="PAuthorRemoval" Style="{StaticResource Imprint.Credit.Handle}" ToolTip="{DynamicResource Source.AuthorRemove}">
                    <local:PIconImage x:Name="PAuthorRemovalIcon" Width="12" Height="12" />
                </Button>
                <Button x:Name="PAuthorEarlier" Style="{StaticResource Imprint.Credit.Handle}" ToolTip="{DynamicResource Source.AuthorEarlier}">
                    <local:PIconImage x:Name="PAuthorEarlierIcon" Width="12" Height="12" />
                </Button>
                <Button x:Name="PAuthorLater" Style="{StaticResource Imprint.Credit.Handle}" ToolTip="{DynamicResource Source.AuthorLater}">
                    <local:PIconImage x:Name="PAuthorLaterIcon" Width="12" Height="12" />
                </Button>
            </StackPanel>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
