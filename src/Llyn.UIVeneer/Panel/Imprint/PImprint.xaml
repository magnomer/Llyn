<UserControl
    x:Class="Llyn.UIVeneer.PImprint"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIVeneer"
    >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Llyn;component/Editor/Core/PEditorPopup.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Llyn;component/Panel/Imprint/PImprintCredit.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Imprint.Title" TargetType="TextBox" BasedOn="{StaticResource Theme.Input.Bare}">
                <Setter Property="MinHeight" Value="37" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="Imprint.Heading" TargetType="TextBlock">
                <Setter Property="Height" Value="34" />
                <Setter Property="Margin" Value="2,0,2,12" />
                <Setter Property="Padding" Value="0,5,0,0" />
                <Setter Property="FontSize" Value="19" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="Imprint.Field" TargetType="TextBox" BasedOn="{StaticResource Theme.Input.Bare}">
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="AcceptsReturn" Value="False" />
            </Style>

            <Style x:Key="Imprint.Note" TargetType="TextBox" BasedOn="{StaticResource Imprint.Field}">
                <Setter Property="MinHeight" Value="120" />
                <Setter Property="AcceptsReturn" Value="True" />
            </Style>

            <Style x:Key="Imprint.Kind" TargetType="ToggleButton" BasedOn="{StaticResource Theme.Language.Toggle}">
                <Setter Property="Height" Value="28" />
                <Setter Property="Margin" Value="0,0,7,7" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="BorderBrush" Value="{StaticResource Theme.AccentEdge}" />
            </Style>

            <Style x:Key="Imprint.Tally" TargetType="Border" BasedOn="{StaticResource Theme.Speech.Chip}">
                <Setter Property="Background" Value="{StaticResource Theme.SurfaceRaised}" />
            </Style>

            <Style x:Key="Imprint.Figure" TargetType="TextBlock" BasedOn="{StaticResource Theme.Speech.Name}">
                <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Padding="0,0,10,0" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource Theme.Scroll.Gutter}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="9,0,20,30">
            <TextBox
                x:Name="PImprintTitle"
                Margin="0,0,60,0"
                Style="{StaticResource Imprint.Title}"
                Tag="{DynamicResource Source.Untitled}"
                TextChanged="PImprintTitleHandle" />

            <WrapPanel Margin="12,14,0,7" Orientation="Horizontal">
                <Grid>
                    <ToggleButton x:Name="PImprintKind" Style="{StaticResource Imprint.Kind}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PImprintKindName" Style="{StaticResource Theme.Speech.Name}" />
                            <local:PIconImage Width="12" Height="12" Margin="8,0,0,0" VerticalAlignment="Center" PIconSource="{local:PIcon expand, 12}" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup
                        x:Name="PImprintKindMenu"
                        Width="238"
                        AllowsTransparency="True"
                        IsOpen="{Binding IsChecked, ElementName=PImprintKind, Mode=TwoWay}"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=PImprintKind}"
                        StaysOpen="False">
                        <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                            <StackPanel x:Name="PImprintKindList" />
                        </Border>
                    </Popup>
                </Grid>
                <Border Style="{StaticResource Imprint.Tally}">
                    <TextBlock x:Name="PImprintTally" Style="{StaticResource Imprint.Figure}" />
                </Border>
            </WrapPanel>

            <StackPanel Margin="0,28,0,0">
                <TextBlock Style="{StaticResource Imprint.Heading}" Text="{DynamicResource Source.Author}" />
                <Grid x:Name="PAuthor" Margin="2,0">
                    <ItemsControl
                        x:Name="PAuthorCredit"
                        Margin="0,-4,0,0"
                        Button.Click="PAuthorCreditHandle"
                        ItemTemplate="{StaticResource Imprint.Credit.Card}"
                        PreviewKeyDown="PAuthorKeyHandle"
                        TextBoxBase.TextChanged="PAuthorTextHandle"
                        LostKeyboardFocus="PAuthorLeaveHandle" />
                    <TextBlock
                        x:Name="PAuthorNotice"
                        VerticalAlignment="Top"
                        Foreground="{StaticResource Theme.Muted}"
                        IsHitTestVisible="False"
                        Text="{DynamicResource Source.AuthorUnsaved}"
                        TextWrapping="Wrap" />
                    <Popup
                        x:Name="PByline"
                        MaxWidth="320"
                        AllowsTransparency="True"
                        Placement="Custom"
                        StaysOpen="False">
                        <Border MinWidth="{Binding ElementName=PByline, Path=PlacementTarget.ActualWidth}" Style="{StaticResource Editor.Popup.Frame}">
                            <ListBox
                                x:Name="PBylineList"
                                MaxHeight="232"
                                ItemContainerStyle="{StaticResource Editor.Popup.Caret}"
                                ItemTemplate="{DynamicResource Theme.Byline.Row}"
                                Style="{StaticResource Editor.Popup.List}" />
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>

            <StackPanel Margin="0,28,0,0">
                <TextBlock Style="{StaticResource Imprint.Heading}" Text="{DynamicResource Source.Year}" />
                <TextBox
                    x:Name="PImprintYear"
                    Style="{StaticResource Imprint.Field}"
                    Tag="{DynamicResource Source.Year}"
                    TextChanged="PImprintYearHandle" />
            </StackPanel>

            <StackPanel Margin="0,28,0,0">
                <TextBlock Style="{StaticResource Imprint.Heading}" Text="{DynamicResource Source.Url}" />
                <TextBox
                    x:Name="PImprintUrl"
                    Style="{StaticResource Imprint.Field}"
                    Tag="{DynamicResource Source.Url}"
                    TextChanged="PImprintUrlHandle" />
            </StackPanel>

            <StackPanel Margin="0,28,0,0">
                <TextBlock Style="{StaticResource Imprint.Heading}" Text="{DynamicResource Source.Note}" />
                <TextBox
                    x:Name="PImprintNote"
                    Style="{StaticResource Imprint.Note}"
                    Tag="{DynamicResource Source.Note}"
                    TextChanged="PImprintNoteHandle" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
