<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="Theme.Byline.Row">
        <Grid x:Name="PBylineRow" Background="Transparent">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="{DynamicResource Theme.Ink}"
                TextTrimming="CharacterEllipsis">
                <Run x:Name="PBylineLead" /><Run
                    x:Name="PBylineMark"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Theme.Accent}" /><Run x:Name="PBylineTail" />
            </TextBlock>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
