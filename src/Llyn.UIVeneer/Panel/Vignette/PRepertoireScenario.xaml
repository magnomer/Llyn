<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn;component/Panel/Vignette/PRepertoireVignette.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Scenario.Media" TargetType="ItemsControl">
        <Setter Property="Margin" Value="2,16,0,0" />
    </Style>

    <Style x:Key="Theme.Scenario.Hint" TargetType="TextBlock" BasedOn="{StaticResource Theme.Text.Headword}">
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Text" Value="{Binding Tag, ElementName=PScenarioTitle}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text, ElementName=PScenarioTitle}" Value="">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Scenario.Ghost" TargetType="TextBlock" BasedOn="{StaticResource Theme.Text.Headword}">
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Text" Value="{Binding Text, ElementName=PScenarioTitle}" />
    </Style>

    <Style x:Key="Theme.Scenario.Measure" TargetType="TextBlock" BasedOn="{StaticResource Theme.Vignette.Kind}">
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Visibility" Value="Hidden" />
        <Setter Property="Text" Value="{Binding Text, ElementName=PScenarioKind}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text, ElementName=PScenarioKind}" Value="">
                <Setter Property="Text" Value="{Binding Tag, ElementName=PScenarioKind}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Scenario.Kind" TargetType="TextBox" BasedOn="{StaticResource Theme.Input.Bare}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="AcceptsReturn" Value="False" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Situation}" />
    </Style>

    <Style x:Key="Theme.Scenario.Description" TargetType="TextBox" BasedOn="{StaticResource Theme.Input.Bare}">
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="MinHeight" Value="120" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="FontSize" Value="14" />
    </Style>
</ResourceDictionary>
