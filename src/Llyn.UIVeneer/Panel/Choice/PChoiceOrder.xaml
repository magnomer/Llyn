<UserControl
    x:Class="Llyn.UIVeneer.PChoiceOrder"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment"
    >

    <Grid>
        <ToggleButton
            x:Name="PChoiceOrderDropper"
            Style="{StaticResource Theme.Search.Dropper}">
            <local:QIconImage x:Name="PChoiceOrderIcon" Width="24" Height="24" />
        </ToggleButton>
        <Popup
            x:Name="PChoiceOrderDropdown"
            Width="252"
            AllowsTransparency="True"
            Placement="Bottom"
            StaysOpen="False"
            VerticalOffset="6">
            <Border Margin="10" Padding="8" Style="{StaticResource Theme.Popup.Surface}">
                <StackPanel x:Name="PChoiceOrderList" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
