<UserControl
    x:Class="Llyn.UIVeneer.PFavorite"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment"
    xmlns:veneer="clr-namespace:Llyn.UIVeneer"
    >

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="-34,0,-34,0" Style="{StaticResource Theme.Panel.SeamRow}" />
        <local:QSeam Grid.Row="1" Grid.Column="1" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />

        <Border
            x:Name="PSeries"
            Grid.Row="0"
            Grid.Column="0"
            Margin="{StaticResource Theme.Catalog.HeaderMargin}"
            Style="{StaticResource Theme.Search.Bar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <veneer:PChoiceOrder x:Name="PFavoriteOrder" Grid.Column="0" />
                <Rectangle Grid.Column="1" Style="{StaticResource Theme.Search.Divider}" />
                <TextBox
                    x:Name="PRecall"
                    Grid.Column="2"
                    Style="{StaticResource Theme.Search.Field}" />
                <Rectangle Grid.Column="3" Margin="2,0,5,0" Style="{StaticResource Theme.Search.Divider}" />
                <veneer:PChoiceFilter x:Name="PFavoriteFilter" Grid.Column="4" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0" Style="{StaticResource Theme.Catalog.Frame}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl x:Name="PRoster">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="PRosterRow" Style="{StaticResource Theme.Catalog.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="PRosterFlag" Grid.Column="0" Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Theme.Catalog.Title}"><Run x:Name="PRosterName" /><Run
                                        x:Name="PRosterEpithet"
                                        Style="{StaticResource Theme.Catalog.Epithet}" /></TextBlock>
                                    <TextBlock x:Name="PRosterLanguage" Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource Theme.Catalog.Meta}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="PRosterEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Favorite.Empty}" />
        </Grid>

        <veneer:PPanelRail x:Name="PFavoriteRail" Grid.Row="0" Grid.Column="1" Margin="0,0,0,18" />

        <Border Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" ClipToBounds="True" Style="{StaticResource Theme.Panel.Surface}">
            <Grid>
                <veneer:PDisplay x:Name="PDisplay" />

                <veneer:PEditor x:Name="PEditor" Grid.Row="1" Padding="30,18,30,30" Visibility="Collapsed" />

                <Button
                    x:Name="PFavoriteBin"
                    Margin="0,17,26,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    IsEnabled="False"
                    Style="{StaticResource Theme.Input.Bin}"
                    ToolTip="{DynamicResource Scribe.Delete}">
                    <local:QIconImage x:Name="PFavoriteBinIcon" Width="24" Height="24" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
