<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment"
    >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="0,0,0,18"
            Style="{StaticResource Theme.Search.Bar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton
                    x:Name="PWingOrderDropper"
                    Grid.Column="0"
                    Style="{StaticResource Theme.Search.Dropper}"
                    ToolTip="{DynamicResource Order.Title}">
                    <local:PIconImage x:Name="PWingOrderIcon" Width="24" Height="24" />
                </ToggleButton>
                <Rectangle Grid.Column="1" Style="{StaticResource Theme.Search.Divider}" />
                <TextBox
                    x:Name="PWingQuery"
                    Grid.Column="2"
                    Style="{StaticResource Theme.Search.Field}"
                    Tag="{DynamicResource Duplex.Search}" />
                <Rectangle Grid.Column="3" Margin="2,0,5,0" Style="{StaticResource Theme.Search.Divider}" />
                <ToggleButton
                    x:Name="PWingSieveDropper"
                    Grid.Column="4"
                    Style="{StaticResource Theme.Search.Dropper}"
                    ToolTip="{DynamicResource Sieve.Title}">
                    <Grid Width="24" Height="24">
                        <local:PIconImage x:Name="PWingSieveIcon" Width="24" Height="24" />
                        <Ellipse
                            x:Name="PWingSieveMark"
                            Width="6"
                            Height="6"
                            Margin="0,2,1,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Fill="{StaticResource Theme.Accent}"
                            Visibility="Collapsed" />
                    </Grid>
                </ToggleButton>
                <Popup
                    x:Name="PWingOrderDropdown"
                    Width="252"
                    AllowsTransparency="True"
                    HorizontalOffset="-6"
                    Placement="Bottom"
                    StaysOpen="False"
                    VerticalOffset="12">
                    <Border Margin="10" Padding="8" Style="{StaticResource Theme.Popup.Surface}">
                        <StackPanel x:Name="PWingOrderList">
                            <TextBlock Margin="10,7,10,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Order.Title}" />
                        </StackPanel>
                    </Border>
                </Popup>
                <Popup
                    x:Name="PWingSieveDropdown"
                    Width="190"
                    AllowsTransparency="True"
                    HorizontalOffset="-151"
                    Placement="Bottom"
                    StaysOpen="False"
                    VerticalOffset="6">
                    <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                        <StackPanel x:Name="PWingSieveList" />
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Rectangle
                x:Name="PWingSeam"
                Grid.Row="0"
                Style="{StaticResource Theme.Panel.SeamRow}"
                Visibility="Collapsed" />

            <Border
                x:Name="PWingTray"
                Grid.Row="0"
                Margin="0,0,0,12"
                Style="{StaticResource Theme.Panel.Surface}"
                Visibility="Collapsed">
                <Grid>
                    <ScrollViewer Margin="10" MaxHeight="220" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource Theme.Scroll.Gutter}" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PWingIndex" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button x:Name="PIndexRow" Style="{StaticResource Theme.Catalog.Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image x:Name="PIndexFlag" Grid.Column="0" Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource Theme.Catalog.Title}"><Run x:Name="PIndexName" /><Run
                                                x:Name="PIndexEpithet"
                                                Style="{StaticResource Theme.Catalog.Epithet}" /></TextBlock>
                                            <TextBlock x:Name="PIndexLanguage" Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource Theme.Catalog.Meta}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock
                        x:Name="PWingEmpty"
                        Margin="14,18,14,18"
                        Style="{StaticResource Theme.Catalog.Empty}"
                        Text="{DynamicResource Duplex.Empty}"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border Grid.Row="1" ClipToBounds="True" Style="{StaticResource Theme.Panel.Surface}">
                <local:PDisplay x:Name="PWingDisplay" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
