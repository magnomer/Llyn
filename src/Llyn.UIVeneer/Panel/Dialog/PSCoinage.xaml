<Window
    x:Class="Llyn.UIVeneer.PSCoinage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{DynamicResource Terms.Product}"
    Icon="pack://application:,,,/brand/icon.ico"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    Style="{StaticResource {x:Type Window}}"
    WindowStartupLocation="CenterOwner">

    <StackPanel MinWidth="360" Margin="28,24,28,20">
        <TextBlock x:Name="PSCoinageMessage" FontSize="14" TextWrapping="Wrap" />

        <TextBox
            x:Name="PSCoinageWording"
            Margin="0,14,0,0"
            Style="{StaticResource Theme.Input.Field}"
            TextChanged="PSCoinageWordingHandle" />

        <StackPanel Margin="0,26,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button
                x:Name="PSCoinageMint"
                MinWidth="88"
                Click="PSCoinageMintHandle"
                Content="{DynamicResource Coinage.Create}"
                IsDefault="True"
                IsEnabled="False"
                Style="{StaticResource Theme.Command.Primary}" />
            <Button
                x:Name="PSCoinageDismiss"
                MinWidth="88"
                Margin="6,0,0,0"
                Content="{DynamicResource Coinage.Cancel}"
                IsCancel="True"
                Style="{StaticResource Theme.Command.Segment}" />
        </StackPanel>
    </StackPanel>
</Window>
