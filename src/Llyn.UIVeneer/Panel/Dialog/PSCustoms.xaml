<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{DynamicResource Customs.Title}"
    Width="820"
    MaxHeight="640"
    Icon="pack://application:,,,/Llyn.UIVeneer;component/brand/icon.ico"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Style="{StaticResource {x:Type Window}}"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="28,24,28,20">
        <Grid x:Name="PSCustomsDeclaration">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="170" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Customs.Headword}" />
                <TextBlock Grid.Column="3" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Customs.Mode}" />
                <TextBlock Grid.Column="4" Style="{StaticResource Theme.Input.Label}" Text="{DynamicResource Customs.Target}" />
            </Grid>

            <ScrollViewer Grid.Row="1" MaxHeight="440" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PSCustomsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PSCustomsNumber" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource Theme.Muted}" />
                                <TextBlock x:Name="PSCustomsHeadword" Grid.Column="1" VerticalAlignment="Center" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="PSCustomsLanguage"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource Theme.Muted}"
                                    TextTrimming="CharacterEllipsis" />
                                <ComboBox
                                    x:Name="PSCustomsMode"
                                    Grid.Column="3"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource Theme.Input.Choice}">
                                    <ComboBoxItem x:Name="PSCustomsFresh" Content="{DynamicResource Customs.Create}" />
                                    <ComboBoxItem x:Name="PSCustomsMerge" Content="{DynamicResource Customs.Append}" />
                                    <ComboBoxItem x:Name="PSCustomsReplace" Content="{DynamicResource Customs.Replace}" />
                                </ComboBox>
                                <ComboBox
                                    x:Name="PSCustomsTarget"
                                    Grid.Column="4"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource Theme.Input.Choice}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="PSCustomsCandidateHeadword" />
                                                <TextBlock x:Name="PSCustomsCandidateId" Margin="8,0,0,0" Foreground="{StaticResource Theme.Muted}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock x:Name="PSCustomsLoss" Grid.Column="5" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Theme.Muted}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    x:Name="PSCustomsAdmit"
                    MinWidth="88"
                    Content="{DynamicResource Customs.Accept}"
                    IsDefault="True"
                    Style="{StaticResource Theme.Command.Primary}" />
                <Button
                    x:Name="PSCustomsQuit"
                    MinWidth="88"
                    Margin="6,0,0,0"
                    Content="{DynamicResource Customs.Cancel}"
                    IsCancel="True"
                    Style="{StaticResource Theme.Command.Segment}" />
            </StackPanel>
        </Grid>

        <Grid x:Name="PSCustomsReport" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="0,0,0,10" FontSize="14" Text="{DynamicResource Customs.Omission}" TextWrapping="Wrap" />

            <ScrollViewer Grid.Row="1" MaxHeight="440" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PSCustomsOmission">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PSCustomsOmissionLine" Grid.Column="0" Foreground="{StaticResource Theme.Muted}" />
                                <TextBlock x:Name="PSCustomsOmissionText" Grid.Column="1" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    x:Name="PSCustomsDismiss"
                    MinWidth="88"
                    Content="{DynamicResource Customs.Close}"
                    IsCancel="True"
                    IsDefault="True"
                    Style="{StaticResource Theme.Command.Primary}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
