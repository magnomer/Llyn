<UserControl
    x:Class="Llyn.UIVeneer.PJotter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >

    <UserControl.Resources>
        <Style x:Key="Theme.Jotter.Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Theme.Jotter.Field" TargetType="TextBox" BasedOn="{StaticResource Theme.Input.Bare}">
            <Setter Property="Margin" Value="2,0,2,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Style="{StaticResource Theme.Catalog.Scroll}" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="PJotterSlots" Margin="0,0,10,20" Grid.IsSharedSizeScope="True">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="PJotterLabel" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="2,0,12,8" VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock x:Name="PJotterCaption" Margin="0,0,4,0" Style="{StaticResource Theme.Jotter.Caption}" />
                            <TextBlock x:Name="PJotterNumber" Style="{StaticResource Theme.Jotter.Caption}" />
                        </StackPanel>
                        <TextBox x:Name="PJotterBody" Grid.Column="1" Style="{StaticResource Theme.Jotter.Field}" ToolTip="{DynamicResource Cue.Cell}" />
                        <Button x:Name="PJotterPicker" Grid.Column="2" Margin="8,0,0,8" VerticalAlignment="Center" Content="{DynamicResource Cue.Pick}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
