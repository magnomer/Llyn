<UserControl
    x:Class="Llyn.UIVeneer.PDeck"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment"
    xmlns:veneer="clr-namespace:Llyn.UIVeneer"
    >

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="-34,0,-34,0" Style="{StaticResource Theme.Panel.SeamRow}" />
        <local:QSeam Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />

        <Grid Grid.Row="0" Grid.Column="0" Margin="{StaticResource Theme.Catalog.HeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="PDeckKind"
                Grid.Column="0"
                Margin="0,0,4,0"
                VerticalAlignment="Center"
                Style="{StaticResource Theme.Input.Choice}"
                ToolTip="{DynamicResource Deck.Grain}" />
            <Border Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PDeckFresh" Style="{StaticResource Theme.Command.Icon}" ToolTip="{DynamicResource Deck.New}">
                        <local:QIconImage x:Name="PDeckFreshIcon" Width="24" Height="24" />
                    </Button>

                    <Rectangle Style="{StaticResource Theme.Command.Divider}" />

                    <Button x:Name="PDeckFolder" Style="{StaticResource Theme.Command.Icon}" ToolTip="{DynamicResource Deck.FolderNew}">
                        <local:QIconImage x:Name="PDeckFolderIcon" Width="24" Height="24" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="0" Style="{StaticResource Theme.Catalog.Frame}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl x:Name="PDeckShelf">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PDeckRow" Grid.Column="0" Style="{StaticResource Theme.Catalog.Row}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <local:QIconImage
                                            x:Name="PDeckIcon"
                                            Grid.Column="0"
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center" />
                                        <TextBlock x:Name="PDeckText" Grid.Column="1" Style="{StaticResource Theme.Catalog.Title}" />
                                        <TextBox x:Name="PDeckName" Grid.Column="1" Style="{StaticResource Theme.Input.Field}" Visibility="Collapsed" />
                                    </Grid>
                                </Button>
                                <Button x:Name="PDeckEarlier" Grid.Column="1" Style="{StaticResource Theme.Command.Icon}" ToolTip="{DynamicResource Deck.OrderUp}">
                                    <local:QIconImage x:Name="PDeckEarlierIcon" Width="16" Height="16" />
                                </Button>
                                <Button x:Name="PDeckLater" Grid.Column="2" Style="{StaticResource Theme.Command.Icon}" ToolTip="{DynamicResource Deck.OrderDown}">
                                    <local:QIconImage x:Name="PDeckLaterIcon" Width="16" Height="16" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="PDeckEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Deck.Empty}" />
        </Grid>

        <Border Grid.Row="0" Grid.Column="1" Margin="-4,0,16,18" HorizontalAlignment="Left" Style="{StaticResource Theme.Command.Group}">
            <StackPanel Orientation="Horizontal">
                <Button
                    x:Name="PCueFresh"
                    Content="{DynamicResource Cue.Free}"
                    Style="{StaticResource Theme.Command.Segment}" />
                <Button
                    x:Name="PCueRemoval"
                    Content="{DynamicResource Cue.Remove}"
                    Style="{StaticResource Theme.Command.Segment}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Style="{StaticResource Theme.Catalog.Middle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" Style="{StaticResource Theme.Catalog.Scroll}">
                <ListBox
                    x:Name="PCue"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource Theme.Catalog.Item}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectionMode="Extended">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton
                                    x:Name="PCueMark"
                                    Grid.Column="0"
                                    Width="30"
                                    Height="26"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource Theme.Command.IconToggle}"
                                    ToolTip="{DynamicResource Cue.Flag}">
                                    <local:QIconImage x:Name="PCueMarkIcon" Width="16" Height="16" />
                                </ToggleButton>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="PCueText" Style="{StaticResource Theme.Catalog.Title}" />
                                    <TextBlock x:Name="PCueOrphan" Style="{StaticResource Theme.Catalog.Meta}" Text="{DynamicResource Cue.Orphan}" />
                                </StackPanel>
                                <ToggleButton
                                    x:Name="PCueExclusion"
                                    Grid.Column="2"
                                    Width="30"
                                    Height="26"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource Theme.Command.IconToggle}"
                                    ToolTip="{DynamicResource Cue.Exclude}">
                                    <local:QIconImage x:Name="PCueExclusionIcon" Width="16" Height="16" />
                                </ToggleButton>
                                <Button
                                    x:Name="PCueEarlier"
                                    Grid.Column="3"
                                    Width="30"
                                    Height="26"
                                    Style="{StaticResource Theme.Command.Icon}"
                                    ToolTip="{DynamicResource Deck.OrderUp}">
                                    <local:QIconImage x:Name="PCueEarlierIcon" Width="16" Height="16" />
                                </Button>
                                <Button
                                    x:Name="PCueLater"
                                    Grid.Column="4"
                                    Width="30"
                                    Height="26"
                                    Style="{StaticResource Theme.Command.Icon}"
                                    ToolTip="{DynamicResource Deck.OrderDown}">
                                    <local:QIconImage x:Name="PCueLaterIcon" Width="16" Height="16" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
            <veneer:PJotter x:Name="PJotter" Grid.Row="1" MaxHeight="360" Margin="0,16,0,0" Visibility="Collapsed" />
        </Grid>

        <local:QSeam Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />
        <StackPanel Grid.Row="0" Grid.Column="2" Margin="16,0,0,0" Orientation="Horizontal">
            <Button x:Name="PDeckAccession" Content="{DynamicResource Deck.ViewAdd}" Style="{StaticResource Theme.Input.Tab}" />
            <Button x:Name="PDeckStencil" Content="{DynamicResource Deck.ViewCard}" Style="{StaticResource Theme.Input.Tab}" />
            <Button x:Name="PDeckCharter" Content="{DynamicResource Deck.ViewDeck}" Style="{StaticResource Theme.Input.Tab}" />
        </StackPanel>

        <Grid Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Margin="16,16,0,0">
            <Grid x:Name="PDeckAccessionSheet">
                <veneer:PAccession x:Name="PAccession" />
            </Grid>
            <Grid x:Name="PDeckStencilSheet" Visibility="Collapsed">
                <veneer:PStencil x:Name="PStencil" Visibility="Collapsed" />
            </Grid>
            <Grid x:Name="PDeckCharterSheet" Visibility="Collapsed">
                <veneer:PCharter x:Name="PCharter" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <TextBlock x:Name="PDeckLine" Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource Theme.Catalog.Meta}" />
    </Grid>
</UserControl>
