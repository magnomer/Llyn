<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment"
    >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Llyn.UIVeneer;component/Media/Image/PDisplayImage.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Llyn.UIVeneer;component/Media/Video/PDisplayVideo.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Llyn.UIVeneer;component/Panel/Vignette/PRepertoireVignette.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Llyn.UIVeneer;component/Panel/Vignette/PRepertoireScenario.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="-34,0,-34,0" Style="{StaticResource Theme.Panel.SeamRow}" />
        <local:PSeam Grid.Row="1" Grid.Column="1" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />
        <local:PSeam Grid.Row="1" Grid.Column="2" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />

        <Border
            x:Name="PTier"
            Grid.Row="0"
            Grid.Column="0"
            Margin="{StaticResource Theme.Catalog.HeaderMargin}"
            Style="{StaticResource Theme.Search.Bar}">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ToggleButton
                x:Name="PTierDropper"
                Grid.Column="0"
                Style="{StaticResource Theme.Search.Dropper}"
                ToolTip="{DynamicResource Tier.Title}">
                <local:PIconImage x:Name="PTierIcon" Width="24" Height="24" />
            </ToggleButton>
            <Rectangle Grid.Column="1" Style="{StaticResource Theme.Search.Divider}" />
            <Popup
                x:Name="PTierDropdown"
                Width="238"
                AllowsTransparency="True"
                Placement="Bottom"
                StaysOpen="False"
                VerticalOffset="6">
                <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                    <StackPanel x:Name="PTierList">
                        <TextBlock Margin="10,7,10,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Tier.Title}" />
                    </StackPanel>
                </Border>
            </Popup>
            <TextBox
                x:Name="PInquest"
                Grid.Column="2"
                Style="{StaticResource Theme.Search.Field}"
                Tag="{DynamicResource Situation.Search}" />
            </Grid>
        </Border>

        <Border
            x:Name="PMesh"
            Grid.Row="0"
            Grid.Column="1"
            Margin="-4,0,16,18"
            Style="{StaticResource Theme.Search.Bar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="PSortie"
                    Grid.Column="0"
                    Style="{StaticResource Theme.Search.Field}"
                    Tag="{DynamicResource Sortie.Search}" />
                <Rectangle Grid.Column="1" Margin="2,0,5,0" Style="{StaticResource Theme.Search.Divider}" />
                <ToggleButton
                    x:Name="PMeshDropper"
                    Grid.Column="2"
                    Style="{StaticResource Theme.Search.Dropper}"
                    ToolTip="{DynamicResource Mesh.Title}">
                    <Grid Width="24" Height="24">
                        <local:PIconImage x:Name="PMeshIcon" Width="24" Height="24" />
                        <Ellipse
                            x:Name="PMeshMark"
                            Width="6"
                            Height="6"
                            Margin="0,2,1,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Fill="{StaticResource Theme.Accent}"
                            Visibility="Collapsed" />
                    </Grid>
                </ToggleButton>
                <Popup
                    x:Name="PMeshDropdown"
                    Width="190"
                    AllowsTransparency="True"
                    HorizontalOffset="-151"
                    Placement="Bottom"
                    StaysOpen="False"
                    VerticalOffset="6">
                    <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                        <StackPanel x:Name="PMeshList" />
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <local:PRail Grid.Row="0" Grid.Column="2" Margin="0,0,0,18">
            <Border Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="PRepertoireFresh"
                        Content="{DynamicResource Scribe.New}"
                        Style="{StaticResource Theme.Command.Segment}" />
                    <Button
                        x:Name="PRepertoireStore"
                        Content="{DynamicResource Scribe.Save}"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Primary}" />
                    <Rectangle Style="{StaticResource Theme.Command.Divider}" />
                    <StackPanel x:Name="PRepertoireVoyage" Orientation="Horizontal">
                        <Button
                            x:Name="PRepertoireEarlier"
                            IsEnabled="False"
                            Style="{StaticResource Theme.Command.Segment}"
                            ToolTip="{DynamicResource Voyage.Retreat}" />
                        <Button
                            x:Name="PRepertoireLater"
                            IsEnabled="False"
                            Style="{StaticResource Theme.Command.Segment}"
                            ToolTip="{DynamicResource Voyage.Advance}" />
                    </StackPanel>
                    <StackPanel x:Name="PRepertoireChronicle" Orientation="Horizontal" Visibility="Collapsed">
                        <Button
                            x:Name="PRepertoireBackward"
                            IsEnabled="False"
                            Style="{StaticResource Theme.Command.Segment}"
                            ToolTip="{DynamicResource Chronicle.Undo}" />
                        <Button
                            x:Name="PRepertoireForward"
                            IsEnabled="False"
                            Style="{StaticResource Theme.Command.Segment}"
                            ToolTip="{DynamicResource Chronicle.Redo}" />
                    </StackPanel>
                    <Rectangle Style="{StaticResource Theme.Command.Divider}" />
                    <Button
                        x:Name="PRepertoirePortrait"
                        Content="{DynamicResource Scribe.Export}"
                        Style="{StaticResource Theme.Command.Segment}" />
                    <Button
                        x:Name="PRepertoirePress"
                        Content="{DynamicResource Scribe.Print}"
                        Style="{StaticResource Theme.Command.Segment}" />
                </StackPanel>
            </Border>
            <Border
                x:Name="PRepertoireMode"
                IsEnabled="False"
                Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        x:Name="PRepertoireViewer"
                        Content="{DynamicResource Scribe.View}"
                        GroupName="PRepertoireMode"
                        IsChecked="True"
                        Style="{StaticResource Theme.Command.Mode}" />
                    <RadioButton
                        x:Name="PRepertoireScribe"
                        Content="{DynamicResource Scribe.Edit}"
                        GroupName="PRepertoireMode"
                        Style="{StaticResource Theme.Command.Mode}" />
                </StackPanel>
            </Border>
        </local:PRail>

        <Grid Grid.Row="1" Grid.Column="0" Style="{StaticResource Theme.Catalog.Frame}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl x:Name="PAtlas">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="PAtlasRow" Style="{StaticResource Theme.Catalog.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <local:PIconImage
                                        x:Name="PAtlasIcon"
                                        Grid.Column="0"
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center" />
                                    <TextBlock x:Name="PAtlasTitle" Grid.Column="1" Style="{StaticResource Theme.Catalog.Title}" />
                                    <TextBlock x:Name="PAtlasKind" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Theme.Atlas.Kind}" />
                                    <Border Grid.Column="3" Style="{StaticResource Theme.Catalog.Pellet}">
                                        <TextBlock x:Name="PAtlasTally" Style="{StaticResource Theme.Catalog.Tally}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="PAtlasEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Situation.Empty}" />
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" Style="{StaticResource Theme.Catalog.Middle}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl x:Name="POccurrence">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="POccurrenceRow" Style="{StaticResource Theme.Catalog.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="POccurrenceFlag" Grid.Column="0" Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Theme.Catalog.Title}"><Run x:Name="POccurrenceName" /><Run
                                        x:Name="POccurrenceEpithet"
                                        Style="{StaticResource Theme.Catalog.Epithet}" /></TextBlock>
                                    <TextBlock x:Name="POccurrenceLanguage" Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource Theme.Catalog.Meta}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="POccurrenceEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Situation.Vacant}" />
        </Grid>

        <Border Grid.Row="1" Grid.Column="2" Margin="0,14,0,0" ClipToBounds="True" Style="{StaticResource Theme.Panel.Surface}">
            <Grid>
                <local:PDisplay x:Name="PDisplay" Visibility="Collapsed" />

                <local:PEditor x:Name="PEditor" Padding="30,18,30,30" Visibility="Collapsed" />

                <Grid x:Name="PVignette">
                    <ScrollViewer Margin="30,18,0,0" Padding="0,0,10,0" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource Theme.Scroll.Gutter}" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PVignetteBody" Visibility="Collapsed">
                            <TextBlock x:Name="PVignetteTitle" Style="{StaticResource Theme.Text.Headword}" TextWrapping="Wrap" />

                            <WrapPanel Margin="12,14,0,-4" Orientation="Horizontal">
                                <Border x:Name="PVignetteChip" Style="{StaticResource Theme.Vignette.Chip}">
                                    <TextBlock x:Name="PVignetteKind" Style="{StaticResource Theme.Vignette.Kind}" />
                                </Border>
                                <Border Style="{StaticResource Theme.Vignette.Tally}">
                                    <TextBlock x:Name="PVignetteTally" Style="{StaticResource Theme.Vignette.Figure}" />
                                </Border>
                            </WrapPanel>

                            <StackPanel x:Name="PVignetteDescriptionSection" Margin="0,39,0,24">
                                <TextBlock Style="{StaticResource Theme.Vignette.Heading}" Text="{DynamicResource Situation.Description}" />
                                <StackPanel x:Name="PVignetteDescription" Margin="2,0" />
                            </StackPanel>

                            <ItemsControl
                                x:Name="PVignettePicture"
                                ItemTemplate="{StaticResource Display.Card.PictureLine}"
                                Style="{StaticResource Theme.Vignette.Picture}" />
                            <ItemsControl
                                x:Name="PVignetteVideo"
                                ItemTemplate="{StaticResource Display.Card.VideoLine}"
                                Style="{StaticResource Theme.Vignette.Video}" />
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock
                        x:Name="PVignetteUnselected"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Theme.Muted}"
                        IsHitTestVisible="False"
                        Text="{DynamicResource Situation.Unselected}"
                        TextWrapping="Wrap" />
                </Grid>

                <Grid x:Name="PScenario" Margin="30,18,30,30" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Grid HorizontalAlignment="Left">
                            <TextBlock x:Name="PScenarioHint" Style="{StaticResource Theme.Scenario.Hint}" />
                            <TextBlock x:Name="PScenarioGhost" Style="{StaticResource Theme.Scenario.Ghost}" />
                            <TextBox
                                x:Name="PScenarioTitle"
                                Margin="-2,0,0,0"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource Theme.Input.Headword}" />
                        </Grid>

                        <WrapPanel Margin="12,14,0,-4" Orientation="Horizontal">
                            <Border x:Name="PScenarioChip" Style="{StaticResource Theme.Vignette.Chip}">
                                <Grid>
                                    <TextBlock x:Name="PScenarioMeasure" Style="{StaticResource Theme.Scenario.Measure}" />
                                    <TextBox
                                        x:Name="PScenarioKind"
                                        Style="{StaticResource Theme.Scenario.Kind}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Theme.Vignette.Tally}">
                                <TextBlock x:Name="PScenarioTally" Style="{StaticResource Theme.Vignette.Figure}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <ScrollViewer
                        Grid.Row="1"
                        Margin="-9,0,-30,0"
                        Padding="0,0,10,0"
                        HorizontalScrollBarVisibility="Disabled"
                        Style="{StaticResource Theme.Scroll.Gutter}"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="9,39,9,24">
                            <TextBlock Style="{StaticResource Theme.Vignette.Heading}" Text="{DynamicResource Situation.Description}" />
                            <TextBox
                                x:Name="PScenarioDescription"
                                AcceptsReturn="True"
                                Style="{StaticResource Theme.Scenario.Description}"
                                TextWrapping="Wrap" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Style="{StaticResource Theme.Card.Gutter}" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <ItemsControl
                                        x:Name="PScenarioImage"
                                        ItemTemplate="{DynamicResource Theme.Image.Row}"
                                        Style="{StaticResource Theme.Scenario.Media}" />

                                    <ItemsControl
                                        x:Name="PScenarioVideo"
                                        ItemTemplate="{DynamicResource Theme.Video.Row}"
                                        Style="{StaticResource Theme.Scenario.Media}" />

                                    <Border Margin="0,16,-76,0" HorizontalAlignment="Center" Style="{StaticResource Theme.Command.Group}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="PScenarioPicture" Style="{StaticResource Theme.Command.Icon}" ToolTip="{DynamicResource Card.ImageAdd}">
                                                <local:PIconImage x:Name="PScenarioPictureIcon" Width="24" Height="24" />
                                            </Button>

                                            <Rectangle Style="{StaticResource Theme.Command.Divider}" />

                                            <Button x:Name="PScenarioFilm" Style="{StaticResource Theme.Command.Icon}" ToolTip="{DynamicResource Card.VideoAdd}">
                                                <local:PIconImage x:Name="PScenarioFilmIcon" Width="24" Height="24" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Button
                    x:Name="PRepertoireBin"
                    Margin="0,17,26,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    IsEnabled="False"
                    Style="{StaticResource Theme.Input.Bin}"
                    ToolTip="{DynamicResource Scribe.Delete}">
                    <local:PIconImage x:Name="PRepertoireBinIcon" Width="24" Height="24" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
