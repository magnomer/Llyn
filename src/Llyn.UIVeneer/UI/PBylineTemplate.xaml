<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Llyn.UIVeneer.PBylineTemplate">

    <DataTemplate x:Key="Theme.Byline.Row">
        <Grid Background="Transparent" PreviewMouseLeftButtonDown="PBylineHandle">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="{DynamicResource Theme.Ink}"
                TextTrimming="CharacterEllipsis">
                <Run Text="{Binding PBylineItemLead, Mode=OneWay}" /><Run
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Theme.Accent}"
                    Text="{Binding PBylineItemMark, Mode=OneWay}" /><Run Text="{Binding PBylineItemTail, Mode=OneWay}" />
            </TextBlock>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
