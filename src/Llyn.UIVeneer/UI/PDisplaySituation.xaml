<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIVeneer">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn;component/UI/PDisplayState.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Display.Card.Situation" TargetType="ItemsControl">
        <Setter Property="Margin" Value="{DynamicResource Theme.Card.SituationMargin}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding LCardDraftSituation.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Display.Card.SituationLink" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PSurface" Style="{DynamicResource Theme.Card.Situation}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="BorderBrush" Value="{DynamicResource Theme.Situation}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PSurface" Property="Opacity" Value="0.72" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Display.Card.SituationChip">
        <Button Style="{StaticResource Display.Card.SituationLink}">
            <TextBlock FontSize="{DynamicResource Theme.Card.SituationSize}" Foreground="{DynamicResource Theme.Situation}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource Display.Card.State}">
                        <Binding Path="LSituationDraftTitle" />
                        <local:PLocalizationBinder PLocalizationBinderKey="Display.Unknown" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Button>
    </DataTemplate>
</ResourceDictionary>
