<UserControl
    x:Class="Llyn.UIVeneer.PYunjing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIVeneer"
    >

    <UserControl.Resources>
        <Style x:Key="Theme.Yunjing.Row" TargetType="Button" BasedOn="{StaticResource Theme.Catalog.Row}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding PYunjingItemChosen}" Value="True">
                    <Setter Property="Tag" Value="Chosen" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Theme.Xiaoyun.Row" TargetType="Button" BasedOn="{StaticResource Theme.Catalog.Row}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding PXiaoyunItemChosen}" Value="True">
                    <Setter Property="Tag" Value="Chosen" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Theme.Yunjing.Key" TargetType="TextBlock" BasedOn="{StaticResource Theme.Catalog.Title}">
            <Setter Property="FontSize" Value="26" />
        </Style>

        <DataTemplate x:Key="Theme.Yunjing.Cell">
            <Button Click="PYunjingHandle" Style="{StaticResource Theme.Yunjing.Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Theme.Yunjing.Key}" Text="{Binding PYunjingItemKey}" />
                    <Border Grid.Column="1" Style="{StaticResource Theme.Catalog.Pellet}">
                        <TextBlock Style="{StaticResource Theme.Catalog.Tally}" Text="{Binding PYunjingItemCount}" />
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.CommandBindings>
        <CommandBinding CanExecute="PYunjingPressCheck" Command="ApplicationCommands.Print" Executed="PYunjingPressHandle" />
        <CommandBinding CanExecute="PYunjingPressCheck" Command="local:PDisplayCommand.PDisplayCommandPortrait" Executed="PYunjingPortraitHandle" />
    </UserControl.CommandBindings>

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Margin="-34,0,-34,0" Style="{StaticResource Theme.Panel.SeamRow}" />
        <local:PSeam Grid.Row="1" Grid.Column="1" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />
        <local:PSeam Grid.Row="1" Grid.Column="2" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />
        <local:PSeam Grid.Row="1" Grid.Column="3" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />

        <Border
            x:Name="PLadder"
            Grid.Row="0"
            Grid.Column="0"
            Margin="{StaticResource Theme.Catalog.HeaderMargin}"
            Style="{StaticResource Theme.Search.Bar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton
                    x:Name="PLadderDropper"
                    Grid.Column="0"
                    Style="{StaticResource Theme.Search.Dropper}"
                    ToolTip="{DynamicResource Ladder.Title}">
                    <Path Width="24" Height="24" Data="{local:PIcon sort, 24}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Stretch="None" />
                </ToggleButton>
                <Rectangle Grid.Column="1" Style="{StaticResource Theme.Search.Divider}" />
                <TextBox
                    x:Name="PPlumb"
                    Grid.Column="2"
                    Style="{StaticResource Theme.Search.Field}"
                    Tag="{DynamicResource Plumb.Search}"
                    TextChanged="PPlumbHandle" />
                <Popup
                    x:Name="PLadderDropdown"
                    Width="252"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsChecked, ElementName=PLadderDropper}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=PLadder}"
                    StaysOpen="False"
                    VerticalOffset="6">
                    <Border Margin="10" Padding="8" Style="{StaticResource Theme.Popup.Surface}">
                        <StackPanel>
                            <TextBlock Margin="10,7,10,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Ladder.Title}" />
                            <RadioButton
                                GroupName="PLadderChoice"
                                IsChecked="True"
                                Click="PLadderHandle"
                                Style="{StaticResource Theme.Choice.Order}"
                                Tag="Name"
                                Content="{DynamicResource Ladder.Name}" />
                            <RadioButton GroupName="PLadderChoice" Click="PLadderHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Reverse" Content="{DynamicResource Ladder.Reverse}" />
                            <RadioButton GroupName="PLadderChoice" Click="PLadderHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Usage" Content="{DynamicResource Ladder.Usage}" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0" Style="{StaticResource Theme.Catalog.Frame}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl x:Name="PShengmu" ItemTemplate="{StaticResource Theme.Yunjing.Cell}" />
            </ScrollViewer>
            <TextBlock
                x:Name="PShengmuEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Yunjing.ShengmuEmpty}" />
        </Grid>

        <Border
            x:Name="PStair"
            Grid.Row="0"
            Grid.Column="1"
            Margin="-4,0,16,18"
            Style="{StaticResource Theme.Search.Bar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton
                    x:Name="PStairDropper"
                    Grid.Column="0"
                    Style="{StaticResource Theme.Search.Dropper}"
                    ToolTip="{DynamicResource Stair.Title}">
                    <Path Width="24" Height="24" Data="{local:PIcon sort, 24}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Stretch="None" />
                </ToggleButton>
                <Rectangle Grid.Column="1" Style="{StaticResource Theme.Search.Divider}" />
                <TextBox
                    x:Name="PFathom"
                    Grid.Column="2"
                    Style="{StaticResource Theme.Search.Field}"
                    Tag="{DynamicResource Fathom.Search}"
                    TextChanged="PFathomHandle" />
                <Popup
                    x:Name="PStairDropdown"
                    Width="252"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsChecked, ElementName=PStairDropper}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=PStair}"
                    StaysOpen="False"
                    VerticalOffset="6">
                    <Border Margin="10" Padding="8" Style="{StaticResource Theme.Popup.Surface}">
                        <StackPanel>
                            <TextBlock Margin="10,7,10,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Stair.Title}" />
                            <RadioButton
                                GroupName="PStairChoice"
                                IsChecked="True"
                                Click="PStairHandle"
                                Style="{StaticResource Theme.Choice.Order}"
                                Tag="Name"
                                Content="{DynamicResource Stair.Name}" />
                            <RadioButton GroupName="PStairChoice" Click="PStairHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Reverse" Content="{DynamicResource Stair.Reverse}" />
                            <RadioButton GroupName="PStairChoice" Click="PStairHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Usage" Content="{DynamicResource Stair.Usage}" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Style="{StaticResource Theme.Catalog.Middle}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl x:Name="PYunmu" ItemTemplate="{StaticResource Theme.Yunjing.Cell}" />
            </ScrollViewer>
            <TextBlock
                x:Name="PYunmuEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Yunjing.YunmuEmpty}" />
        </Grid>

        <Border
            Grid.Row="0"
            Grid.Column="2"
            Margin="-4,0,16,18"
            Style="{StaticResource Theme.Search.Bar}">
            <TextBox
                x:Name="PBeacon"
                Style="{StaticResource Theme.Search.Field}"
                Tag="{DynamicResource Beacon.Search}"
                TextChanged="PBeaconHandle" />
        </Border>

        <Grid Grid.Row="1" Grid.Column="2" Style="{StaticResource Theme.Catalog.Middle}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl x:Name="PXiaoyun">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="PXiaoyunHandle" Style="{StaticResource Theme.Xiaoyun.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Source="{Binding PXiaoyunItemFlag}" Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Theme.Catalog.Title}"><Run Text="{Binding PXiaoyunItemName, Mode=OneWay}" /><Run
                                        Style="{StaticResource Theme.Catalog.Epithet}"
                                        Text="{Binding PXiaoyunItemEpithet, Mode=OneWay, StringFormat='&#x2002;{0}'}" /></TextBlock>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="PXiaoyunEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Yunjing.XiaoyunEmpty}" />
        </Grid>

        <local:PRail Grid.Row="0" Grid.Column="3" Margin="0,0,0,18">
            <Border Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="PYunjingFresh"
                        Click="PYunjingFreshHandle"
                        Content="{DynamicResource Scribe.New}"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="{local:PIcon new, 24}" />
                    <Button
                        x:Name="PYunjingStore"
                        Click="PYunjingStoreHandle"
                        Content="{DynamicResource Scribe.Save}"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Primary}"
                        Tag="{local:PIcon save, 24}" />
                    <Rectangle Style="{StaticResource Theme.Command.Divider}" />
                    <Button
                        Command="local:PDisplayCommand.PDisplayCommandPortrait"
                        Content="{DynamicResource Scribe.Export}"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="{local:PIcon export, 24}" />
                    <Button
                        Command="ApplicationCommands.Print"
                        Content="{DynamicResource Scribe.Print}"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="{local:PIcon print, 24}" />
                </StackPanel>
            </Border>
            <Border
                x:Name="PYunjingMode"
                IsEnabled="False"
                Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        x:Name="PYunjingViewer"
                        Click="PYunjingScribeHandle"
                        Content="{DynamicResource Scribe.View}"
                        GroupName="PYunjingMode"
                        IsChecked="True"
                        Style="{StaticResource Theme.Command.Mode}"
                        Tag="{local:PIcon view, 24}" />
                    <RadioButton
                        x:Name="PYunjingScribe"
                        Click="PYunjingScribeHandle"
                        Content="{DynamicResource Scribe.Edit}"
                        GroupName="PYunjingMode"
                        Style="{StaticResource Theme.Command.Mode}"
                        Tag="{local:PIcon edit, 24}" />
                </StackPanel>
            </Border>
        </local:PRail>

        <Border Grid.Row="1" Grid.Column="3" Margin="0,14,0,0" ClipToBounds="True" Style="{StaticResource Theme.Panel.Surface}">
            <Grid>
                <local:PDisplay x:Name="PDisplay" />

                <local:PDiwei x:Name="PYunjingDiwei" Visibility="Collapsed" />

                <local:PEditor x:Name="PEditor" Padding="30,18,30,30" Visibility="Collapsed" />

                <Button
                    x:Name="PYunjingBin"
                    Margin="0,17,26,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="PYunjingBinHandle"
                    IsEnabled="False"
                    Style="{StaticResource Theme.Input.Bin}"
                    ToolTip="{DynamicResource Scribe.Delete}">
                    <Path Width="24" Height="24" Data="{local:PIcon delete, 24}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="None" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
