<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Theme.Atlas.Kind" TargetType="TextBlock" BasedOn="{StaticResource Theme.Catalog.Meta}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding PAtlasItemKind}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Atlas.Row" TargetType="Button" BasedOn="{StaticResource Theme.Catalog.Row}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding PAtlasItemChosen}" Value="True">
                <Setter Property="Tag" Value="Chosen" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Vignette.Heading" TargetType="TextBlock">
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="2,0,2,12" />
        <Setter Property="Padding" Value="0,5,0,0" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Theme.Vignette.Chip" TargetType="Border" BasedOn="{StaticResource Theme.Speech.Chip}">
        <Setter Property="Background" Value="{StaticResource Theme.SituationSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.SituationEdge}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="Theme.Vignette.Kind" TargetType="TextBlock" BasedOn="{StaticResource Theme.Speech.Name}">
        <Setter Property="Foreground" Value="{StaticResource Theme.Situation}" />
    </Style>

    <Style x:Key="Theme.Vignette.Tally" TargetType="Border" BasedOn="{StaticResource Theme.Speech.Chip}">
        <Setter Property="Background" Value="{StaticResource Theme.SurfaceRaised}" />
    </Style>

    <Style x:Key="Theme.Vignette.Figure" TargetType="TextBlock" BasedOn="{StaticResource Theme.Speech.Name}">
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
    </Style>

    <Style x:Key="Theme.Vignette.Picture" TargetType="ItemsControl">
        <Setter Property="Margin" Value="2,0,0,24" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding LSituationImage.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Vignette.Video" TargetType="ItemsControl">
        <Setter Property="Margin" Value="2,0,0,24" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding LSituationVideo.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Occurrence.Row" TargetType="Button" BasedOn="{StaticResource Theme.Catalog.Row}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding POccurrenceItemChosen}" Value="True">
                <Setter Property="Tag" Value="Chosen" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
