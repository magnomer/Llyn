<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIVeneer">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn;component/UI/PThemePalette.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Navigation.Focus" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{StaticResource Theme.Accent}" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Navigation.Tab" TargetType="local:PTab">
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="12,2" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.Navigation.Focus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PTab">
                    <Grid>
                        <Border
                            x:Name="PSurface"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                            <StackPanel Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Orientation="Horizontal">
                                <Grid Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Path
                                        x:Name="PSurfaceOutline"
                                        Data="{TemplateBinding PTabOutline}"
                                        Fill="{TemplateBinding Foreground}"
                                        Stretch="None" />
                                    <Path
                                        x:Name="PSurfaceFilled"
                                        Data="{TemplateBinding PTabFilled}"
                                        Fill="{StaticResource Theme.Accent}"
                                        Stretch="None"
                                        Visibility="Collapsed" />
                                </Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontWeight="{TemplateBinding FontWeight}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Text="{TemplateBinding Content}" />
                            </StackPanel>
                        </Border>
                        <Rectangle
                            x:Name="PSurfaceBar"
                            Width="3"
                            Height="20"
                            Margin="-8,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Fill="{StaticResource Theme.Accent}"
                            Opacity="0"
                            RadiusX="1.5"
                            RadiusY="1.5"
                            SnapsToDevicePixels="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.Surface}" />
                            <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                        </Trigger>
                        <Trigger Property="PTabChosen" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                            <Setter TargetName="PSurfaceOutline" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PSurfaceFilled" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PSurfaceBar" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Navigation.Voyage" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.Navigation.Focus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PSurface" Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.Surface}" />
                            <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Navigation.Divider" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="24,8" />
        <Setter Property="Fill" Value="{StaticResource Theme.Line}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Theme.Navigation.Gap" TargetType="Rectangle">
        <Setter Property="Height" Value="12" />
        <Setter Property="Fill" Value="Transparent" />
    </Style>

</ResourceDictionary>
