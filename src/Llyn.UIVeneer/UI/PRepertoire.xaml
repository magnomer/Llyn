<UserControl
    x:Class="Llyn.UIVeneer.PRepertoire"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIVeneer"
    >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Llyn;component/UI/PDisplayImage.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Llyn;component/UI/PDisplayVideo.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Llyn;component/UI/PRepertoireVignette.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Llyn;component/UI/PRepertoireScenario.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:PImageConverter x:Key="Display.Card.Preview" />
            <local:PVideoConverter x:Key="Display.Card.Reel" />
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.CommandBindings>
        <CommandBinding CanExecute="PRepertoirePressCheck" Command="ApplicationCommands.Print" Executed="PRepertoirePressHandle" />
        <CommandBinding CanExecute="PRepertoirePortraitCheck" Command="local:PDisplayCommand.PDisplayCommandPortrait" Executed="PRepertoirePortraitHandle" />
    </UserControl.CommandBindings>

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="-34,0,-34,0" Style="{StaticResource Theme.Panel.SeamRow}" />
        <local:PSeam Grid.Row="1" Grid.Column="1" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />
        <local:PSeam Grid.Row="1" Grid.Column="2" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />

        <Border
            x:Name="PTier"
            Grid.Row="0"
            Grid.Column="0"
            Margin="{StaticResource Theme.Catalog.HeaderMargin}"
            Style="{StaticResource Theme.Search.Bar}">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ToggleButton
                x:Name="PTierDropper"
                Grid.Column="0"
                Style="{StaticResource Theme.Search.Dropper}"
                ToolTip="{DynamicResource Tier.Title}">
                <Path Width="24" Height="24" Data="{local:PIcon sort, 24}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Stretch="None" />
            </ToggleButton>
            <Rectangle Grid.Column="1" Style="{StaticResource Theme.Search.Divider}" />
            <Popup
                x:Name="PTierDropdown"
                Width="238"
                AllowsTransparency="True"
                IsOpen="{Binding IsChecked, ElementName=PTierDropper, Mode=TwoWay}"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=PTier}"
                StaysOpen="False"
                VerticalOffset="6">
                <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                    <StackPanel>
                        <TextBlock Margin="10,7,10,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Tier.Title}" />
                        <RadioButton GroupName="PTierChoice" IsChecked="True" Click="PTierHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Name" Content="{DynamicResource Tier.Name}" />
                        <RadioButton GroupName="PTierChoice" Click="PTierHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Kind" Content="{DynamicResource Tier.Kind}" />
                        <RadioButton GroupName="PTierChoice" Click="PTierHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Usage" Content="{DynamicResource Tier.Usage}" />
                    </StackPanel>
                </Border>
            </Popup>
            <TextBox
                x:Name="PInquest"
                Grid.Column="2"
                Style="{StaticResource Theme.Search.Field}"
                Tag="{DynamicResource Situation.Search}"
                TextChanged="PInquestHandle" />
            </Grid>
        </Border>

        <Border
            x:Name="PMesh"
            Grid.Row="0"
            Grid.Column="1"
            Margin="-4,0,16,18"
            Style="{StaticResource Theme.Search.Bar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="PSortie"
                    Grid.Column="0"
                    Style="{StaticResource Theme.Search.Field}"
                    Tag="{DynamicResource Sortie.Search}"
                    TextChanged="PSortieHandle" />
                <Rectangle Grid.Column="1" Margin="2,0,5,0" Style="{StaticResource Theme.Search.Divider}" />
                <ToggleButton
                    x:Name="PMeshDropper"
                    Grid.Column="2"
                    Style="{StaticResource Theme.Search.Dropper}"
                    ToolTip="{DynamicResource Mesh.Title}">
                    <Grid Width="24" Height="24">
                        <Path Width="24" Height="24" Data="{local:PIcon filter, 24}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Stretch="None" />
                        <Ellipse
                            x:Name="PMeshMark"
                            Width="6"
                            Height="6"
                            Margin="0,2,1,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Fill="{StaticResource Theme.Accent}"
                            Visibility="Collapsed" />
                    </Grid>
                </ToggleButton>
                <Popup
                    x:Name="PMeshDropdown"
                    Width="190"
                    AllowsTransparency="True"
                    HorizontalOffset="-151"
                    IsOpen="{Binding IsChecked, ElementName=PMeshDropper}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=PMeshDropper}"
                    StaysOpen="False"
                    VerticalOffset="6">
                    <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                        <StackPanel x:Name="PMeshList" />
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <local:PRail Grid.Row="0" Grid.Column="2" Margin="0,0,0,18">
            <Border Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="PRepertoireBackward"
                        Click="PRepertoireUndoHandle"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="{local:PIcon undo, 24}"
                        ToolTip="{DynamicResource Chronicle.Undo}" />
                    <Button
                        x:Name="PRepertoireForward"
                        Click="PRepertoireRedoHandle"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="{local:PIcon redo, 24}"
                        ToolTip="{DynamicResource Chronicle.Redo}" />
                    <Rectangle Style="{StaticResource Theme.Command.Divider}" />
                    <Button
                        x:Name="PRepertoireFresh"
                        Click="PRepertoireFreshHandle"
                        Content="{DynamicResource Scribe.New}"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="{local:PIcon new, 24}" />
                    <Button
                        x:Name="PRepertoireStore"
                        Click="PRepertoireStoreHandle"
                        Content="{DynamicResource Scribe.Save}"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Primary}"
                        Tag="{local:PIcon save, 24}" />
                    <Rectangle Style="{StaticResource Theme.Command.Divider}" />
                    <Button
                        Command="local:PDisplayCommand.PDisplayCommandPortrait"
                        Content="{DynamicResource Scribe.Export}"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="{local:PIcon export, 24}" />
                    <Button
                        Command="ApplicationCommands.Print"
                        Content="{DynamicResource Scribe.Print}"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="{local:PIcon print, 24}" />
                </StackPanel>
            </Border>
            <Border
                x:Name="PRepertoireMode"
                IsEnabled="False"
                Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        x:Name="PRepertoireViewer"
                        Click="PRepertoireScribeHandle"
                        Content="{DynamicResource Scribe.View}"
                        GroupName="PRepertoireMode"
                        IsChecked="True"
                        Style="{StaticResource Theme.Command.Mode}"
                        Tag="{local:PIcon view, 24}" />
                    <RadioButton
                        x:Name="PRepertoireScribe"
                        Click="PRepertoireScribeHandle"
                        Content="{DynamicResource Scribe.Edit}"
                        GroupName="PRepertoireMode"
                        Style="{StaticResource Theme.Command.Mode}"
                        Tag="{local:PIcon edit, 24}" />
                </StackPanel>
            </Border>
        </local:PRail>

        <Grid Grid.Row="1" Grid.Column="0" Style="{StaticResource Theme.Catalog.Frame}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl x:Name="PAtlas">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="PAtlasHandle" Style="{StaticResource Theme.Atlas.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path
                                        Grid.Column="0"
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Data="{local:PIcon situation, 16}"
                                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        Stretch="None" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Theme.Catalog.Title}" Text="{Binding PAtlasItemTitle}" />
                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Theme.Atlas.Kind}" Text="{Binding PAtlasItemKind}" />
                                    <Border Grid.Column="3" Style="{StaticResource Theme.Catalog.Pellet}">
                                        <TextBlock Style="{StaticResource Theme.Catalog.Tally}" Text="{Binding PAtlasItemCount}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="PAtlasEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Situation.Empty}" />
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" Style="{StaticResource Theme.Catalog.Middle}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl x:Name="POccurrence">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="POccurrenceHandle" Style="{StaticResource Theme.Occurrence.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Source="{Binding POccurrenceItemFlag}" Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Theme.Catalog.Title}"><Run Text="{Binding POccurrenceItemName, Mode=OneWay}" /><Run
                                        Style="{StaticResource Theme.Catalog.Epithet}"
                                        Text="{Binding POccurrenceItemEpithet, Mode=OneWay, StringFormat='&#x2002;{0}'}" /></TextBlock>
                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource Theme.Catalog.Meta}" Text="{Binding POccurrenceItemLanguage}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="POccurrenceEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Situation.Vacant}" />
        </Grid>

        <Border Grid.Row="1" Grid.Column="2" Margin="0,14,0,0" ClipToBounds="True" Style="{StaticResource Theme.Panel.Surface}">
            <Grid>
                <local:PDisplay x:Name="PDisplay" Visibility="Collapsed" />

                <local:PEditor x:Name="PEditor" Padding="30,18,30,30" Visibility="Collapsed" />

                <Grid x:Name="PVignette">
                    <ScrollViewer Margin="30,18,0,0" Padding="0,0,10,0" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource Theme.Scroll.Gutter}" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PVignetteBody" Visibility="Collapsed">
                            <TextBlock x:Name="PVignetteTitle" Style="{StaticResource Theme.Text.Headword}" TextWrapping="Wrap" />

                            <WrapPanel Margin="12,14,0,-4" Orientation="Horizontal">
                                <Border x:Name="PVignetteChip" Style="{StaticResource Theme.Vignette.Chip}">
                                    <TextBlock x:Name="PVignetteKind" Style="{StaticResource Theme.Vignette.Kind}" />
                                </Border>
                                <Border Style="{StaticResource Theme.Vignette.Tally}">
                                    <TextBlock x:Name="PVignetteTally" Style="{StaticResource Theme.Vignette.Figure}" />
                                </Border>
                            </WrapPanel>

                            <StackPanel x:Name="PVignetteDescriptionSection" Margin="0,39,0,24">
                                <TextBlock Style="{StaticResource Theme.Vignette.Heading}" Text="{DynamicResource Situation.Description}" />
                                <StackPanel x:Name="PVignetteDescription" Margin="2,0" />
                            </StackPanel>

                            <ItemsControl
                                x:Name="PVignettePicture"
                                ItemTemplate="{StaticResource Display.Card.PictureLine}"
                                ItemsSource="{Binding LSituationImage, Converter={StaticResource Display.Card.Preview}}"
                                Style="{StaticResource Theme.Vignette.Picture}" />
                            <ItemsControl
                                x:Name="PVignetteVideo"
                                ItemTemplate="{StaticResource Display.Card.VideoLine}"
                                ItemsSource="{Binding LSituationVideo, Converter={StaticResource Display.Card.Reel}}"
                                Style="{StaticResource Theme.Vignette.Video}" />
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock
                        x:Name="PVignetteUnselected"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Theme.Muted}"
                        IsHitTestVisible="False"
                        Text="{DynamicResource Situation.Unselected}"
                        TextWrapping="Wrap" />
                </Grid>

                <Grid x:Name="PScenario" Margin="30,18,30,30" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Grid HorizontalAlignment="Left">
                            <TextBlock x:Name="PScenarioHint" Style="{StaticResource Theme.Scenario.Hint}" />
                            <TextBlock x:Name="PScenarioGhost" Style="{StaticResource Theme.Scenario.Ghost}" />
                            <TextBox
                                x:Name="PScenarioTitle"
                                Margin="-2,0,0,0"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource Theme.Input.Headword}"
                                TextChanged="PScenarioTitleHandle" />
                        </Grid>

                        <WrapPanel Margin="12,14,0,-4" Orientation="Horizontal">
                            <Border x:Name="PScenarioChip" Style="{StaticResource Theme.Vignette.Chip}">
                                <Grid>
                                    <TextBlock Style="{StaticResource Theme.Scenario.Measure}" />
                                    <TextBox
                                        x:Name="PScenarioKind"
                                        Style="{StaticResource Theme.Scenario.Kind}"
                                        TextChanged="PScenarioKindHandle" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Theme.Vignette.Tally}">
                                <TextBlock x:Name="PScenarioTally" Style="{StaticResource Theme.Vignette.Figure}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <ScrollViewer
                        Grid.Row="1"
                        Margin="-9,0,-30,0"
                        Padding="0,0,10,0"
                        HorizontalScrollBarVisibility="Disabled"
                        Style="{StaticResource Theme.Scroll.Gutter}"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="9,39,9,24">
                            <TextBlock Style="{StaticResource Theme.Vignette.Heading}" Text="{DynamicResource Situation.Description}" />
                            <TextBox
                                x:Name="PScenarioDescription"
                                AcceptsReturn="True"
                                Style="{StaticResource Theme.Scenario.Description}"
                                TextChanged="PScenarioDescriptionHandle"
                                TextWrapping="Wrap" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Style="{StaticResource Theme.Card.Gutter}" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <ItemsControl
                                        x:Name="PScenarioImage"
                                        ItemTemplate="{DynamicResource Theme.Image.Row}"
                                        Style="{StaticResource Theme.Scenario.Media}"
                                        TextBoxBase.TextChanged="PScenarioImageChange" />

                                    <ItemsControl
                                        x:Name="PScenarioVideo"
                                        ItemTemplate="{DynamicResource Theme.Video.Row}"
                                        Style="{StaticResource Theme.Scenario.Media}"
                                        TextBoxBase.TextChanged="PScenarioVideoChange" />

                                    <Border Margin="0,16,-76,0" HorizontalAlignment="Center" Style="{StaticResource Theme.Command.Group}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Click="PImageAddHandle" Style="{StaticResource Theme.Command.Icon}" ToolTip="{DynamicResource Card.ImageAdd}">
                                                <Path
                                                    Width="24"
                                                    Height="24"
                                                    Data="{local:PIcon image, 24}"
                                                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                    Stretch="None" />
                                            </Button>

                                            <Rectangle Style="{StaticResource Theme.Command.Divider}" />

                                            <Button Click="PVideoAddHandle" Style="{StaticResource Theme.Command.Icon}" ToolTip="{DynamicResource Card.VideoAdd}">
                                                <Path
                                                    Width="24"
                                                    Height="24"
                                                    Data="{local:PIcon video, 24}"
                                                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                    Stretch="None" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Button
                    x:Name="PRepertoireBin"
                    Margin="0,17,26,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="PRepertoireBinHandle"
                    IsEnabled="False"
                    Style="{StaticResource Theme.Input.Bin}"
                    ToolTip="{DynamicResource Scribe.Delete}">
                    <Path Width="24" Height="24" Data="{local:PIcon delete, 24}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="None" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
