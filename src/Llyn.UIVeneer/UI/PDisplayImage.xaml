<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIVeneer">

    <Style x:Key="Display.Card.Picture" TargetType="ItemsControl">
        <Setter Property="Margin" Value="{DynamicResource Theme.Card.MediaMargin}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding LCardDraftImage.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="Display.Card.PictureLine">
        <local:PImageLazy PImageLazyRow="{Binding}">
            <Border Style="{DynamicResource Theme.Card.Preview}">
                <Image Source="{Binding PImagePreview}" Stretch="Uniform" StretchDirection="DownOnly" />
            </Border>
        </local:PImageLazy>
    </DataTemplate>
</ResourceDictionary>
