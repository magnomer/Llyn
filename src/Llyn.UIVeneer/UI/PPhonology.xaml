<UserControl
    x:Class="Llyn.UIVeneer.PPhonology"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIVeneer"
    >

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Sound.Fold" />

        <Style x:Key="Theme.Inventory.Row" TargetType="Button" BasedOn="{StaticResource Theme.Catalog.Row}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding PInventoryItemChosen}" Value="True">
                    <Setter Property="Tag" Value="Chosen" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <UserControl.CommandBindings>
        <CommandBinding CanExecute="PPhonologyPressCheck" Command="ApplicationCommands.Print" Executed="PPhonologyPressHandle" />
        <CommandBinding CanExecute="PPhonologyPressCheck" Command="local:PDisplayCommand.PDisplayCommandPortrait" Executed="PPhonologyPortraitHandle" />
    </UserControl.CommandBindings>

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="-34,0,-34,0" Style="{StaticResource Theme.Panel.SeamRow}" />
        <Rectangle
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="-34,0,-34,0"
            Style="{StaticResource Theme.Panel.SeamRow}"
            Visibility="{Binding IsChecked, ElementName=PArticulationHelper, Converter={StaticResource Sound.Fold}}" />
        <local:PSeam Grid.Row="2" Grid.Column="1" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />

        <Grid Grid.Row="0" Grid.Column="0" Margin="{StaticResource Theme.Catalog.HeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="PSequence"
                Grid.Column="0"
                Style="{StaticResource Theme.Search.Bar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton
                        x:Name="PSequenceDropper"
                        Grid.Column="0"
                        Style="{StaticResource Theme.Search.Dropper}"
                        ToolTip="{DynamicResource Sequence.Title}">
                        <Path Width="24" Height="24" Data="{local:PIcon sort, 24}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Stretch="None" />
                    </ToggleButton>
                    <Rectangle Grid.Column="1" Style="{StaticResource Theme.Search.Divider}" />
                    <TextBox
                        x:Name="PProbe"
                        Grid.Column="2"
                        Style="{StaticResource Theme.Search.Field}"
                        Tag="{DynamicResource Sound.Search}"
                        TextChanged="PProbeHandle" />
                    <Rectangle Grid.Column="3" Margin="2,0,5,0" Style="{StaticResource Theme.Search.Divider}" />
                    <ToggleButton
                        x:Name="PLensDropper"
                        Grid.Column="4"
                        Style="{StaticResource Theme.Search.Dropper}"
                        ToolTip="{DynamicResource Lens.Title}">
                        <Grid Width="24" Height="24">
                            <Path Width="24" Height="24" Data="{local:PIcon filter, 24}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Stretch="None" />
                            <Ellipse
                                x:Name="PLensMark"
                                Width="6"
                                Height="6"
                                Margin="0,2,1,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Fill="{StaticResource Theme.Accent}"
                                Visibility="Collapsed" />
                        </Grid>
                    </ToggleButton>
                    <Popup
                        x:Name="PSequenceDropdown"
                        Width="252"
                        AllowsTransparency="True"
                        IsOpen="{Binding IsChecked, ElementName=PSequenceDropper}"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=PSequence}"
                        StaysOpen="False"
                        VerticalOffset="6">
                        <Border Margin="10" Padding="8" Style="{StaticResource Theme.Popup.Surface}">
                            <StackPanel>
                                <TextBlock Margin="10,7,10,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Sequence.Title}" />

                                <RadioButton
                                    GroupName="PSequenceChoice"
                                    IsChecked="True"
                                    Click="PSequenceHandle"
                                    Style="{StaticResource Theme.Choice.Order}"
                                    Tag="Headword"
                                    Content="{DynamicResource Sequence.Headword}" />
                                <RadioButton
                                    GroupName="PSequenceChoice"
                                    Click="PSequenceHandle"
                                    Style="{StaticResource Theme.Choice.Order}"
                                    Tag="Reverse"
                                    Content="{DynamicResource Sequence.Reverse}" />
                                <RadioButton GroupName="PSequenceChoice" Click="PSequenceHandle" Style="{StaticResource Theme.Choice.Order}" Tag="Sound" Content="{DynamicResource Sequence.Sound}" />
                                <RadioButton
                                    GroupName="PSequenceChoice"
                                    Click="PSequenceHandle"
                                    Style="{StaticResource Theme.Choice.Order}"
                                    Tag="Pending"
                                    Content="{DynamicResource Sequence.Pending}" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Popup
                        x:Name="PLensDropdown"
                        Width="190"
                        AllowsTransparency="True"
                        HorizontalOffset="-151"
                        IsOpen="{Binding IsChecked, ElementName=PLensDropper}"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=PLensDropper}"
                        StaysOpen="False"
                        VerticalOffset="6">
                        <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                            <StackPanel x:Name="PLensList" />
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ToggleButton
                x:Name="PArticulationHelper"
                Grid.Column="2"
                Style="{StaticResource Theme.Search.Helper}"
                Tag="{local:PIcon articulation, 24}"
                ToolTip="{DynamicResource Articulation.Title}" />
        </Grid>

        <local:PRail Grid.Row="0" Grid.Column="1" Margin="0,0,0,18">
            <Border Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="PPhonologyFresh"
                        Click="PPhonologyFreshHandle"
                        Content="{DynamicResource Scribe.New}"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="{local:PIcon new, 24}" />
                    <Button
                        x:Name="PPhonologyStore"
                        Click="PPhonologyStoreHandle"
                        Content="{DynamicResource Scribe.Save}"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Primary}"
                        Tag="{local:PIcon save, 24}" />
                    <Rectangle Style="{StaticResource Theme.Command.Divider}" />
                    <Button
                        Command="local:PDisplayCommand.PDisplayCommandPortrait"
                        Content="{DynamicResource Scribe.Export}"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="{local:PIcon export, 24}" />
                    <Button
                        Command="ApplicationCommands.Print"
                        Content="{DynamicResource Scribe.Print}"
                        Style="{StaticResource Theme.Command.Segment}"
                        Tag="{local:PIcon print, 24}" />
                </StackPanel>
            </Border>
            <Border
                x:Name="PPhonologyMode"
                IsEnabled="False"
                Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        x:Name="PPhonologyViewer"
                        Click="PPhonologyScribeHandle"
                        Content="{DynamicResource Scribe.View}"
                        GroupName="PPhonologyMode"
                        IsChecked="True"
                        Style="{StaticResource Theme.Command.Mode}"
                        Tag="{local:PIcon view, 24}" />
                    <RadioButton
                        x:Name="PPhonologyScribe"
                        Click="PPhonologyScribeHandle"
                        Content="{DynamicResource Scribe.Edit}"
                        GroupName="PPhonologyMode"
                        Style="{StaticResource Theme.Command.Mode}"
                        Tag="{local:PIcon edit, 24}" />
                </StackPanel>
            </Border>
        </local:PRail>

        <local:PArticulation
            x:Name="PArticulation"
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="-34,0,-34,0"
            Visibility="{Binding IsChecked, ElementName=PArticulationHelper, Converter={StaticResource Sound.Fold}}" />

        <Grid Grid.Row="2" Grid.Column="0" Style="{StaticResource Theme.Catalog.Frame}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl x:Name="PInventory">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="PInventoryHandle" Style="{StaticResource Theme.Inventory.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Source="{Binding PInventoryItemFlag}" Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Theme.Catalog.Title}" Text="{Binding PInventoryItemPronunciation, Mode=OneWay}" />
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0" Orientation="Horizontal">
                                        <TextBlock MaxWidth="150" Style="{StaticResource Theme.Catalog.Meta}"><Run Text="{Binding PInventoryItemName, Mode=OneWay}" /><Run
                                            Text="{Binding PInventoryItemEpithet, Mode=OneWay, StringFormat='&#x2002;{0}'}" /></TextBlock>
                                        <TextBlock Style="{StaticResource Theme.Catalog.Dot}" />
                                        <TextBlock Style="{StaticResource Theme.Catalog.Meta}" Text="{Binding PInventoryItemLanguage}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="PInventoryEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Sound.Empty}" />
        </Grid>

        <Border Grid.Row="2" Grid.Column="1" Margin="0,14,0,0" ClipToBounds="True" Style="{StaticResource Theme.Panel.Surface}">
            <Grid>
                <local:PDisplay x:Name="PDisplay" />

                <local:PEditor x:Name="PEditor" Padding="30,18,30,30" Visibility="Collapsed" />

                <Button
                    x:Name="PPhonologyBin"
                    Margin="0,17,26,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="PPhonologyBinHandle"
                    IsEnabled="False"
                    Style="{StaticResource Theme.Input.Bin}"
                    ToolTip="{DynamicResource Scribe.Delete}">
                    <Path Width="24" Height="24" Data="{local:PIcon delete, 24}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="None" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
