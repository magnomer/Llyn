<UserControl
    x:Class="Llyn.UIVeneer.PScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <Border
            x:Name="PScreenStage"
            MinHeight="180"
            Background="Black"
            CornerRadius="6"
            HorizontalAlignment="Stretch"
            SizeChanged="PScreenSizeHandle"
            SnapsToDevicePixels="True">
            <Grid>
                <MediaElement
                    x:Name="PScreenMedia"
                    LoadedBehavior="Manual"
                    MediaEnded="PScreenFinishHandle"
                    MediaFailed="PScreenFailureHandle"
                    MediaOpened="PScreenReadyHandle"
                    ScrubbingEnabled="True"
                    Stretch="Uniform"
                    Visibility="Collapsed" />
                <Grid x:Name="PScreenPage" Visibility="Collapsed" />
                <TextBlock
                    x:Name="PScreenNotice"
                    Margin="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#FFB0B0B0"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </Grid>
        </Border>

        <ToggleButton
            x:Name="PScreenSwitch"
            Width="88"
            Height="31"
            Margin="0,7,0,0"
            HorizontalAlignment="Left"
            Click="PScreenSwitchHandle"
            Foreground="{DynamicResource Theme.Accent}"
            Style="{DynamicResource Theme.Input.ToggleAction}">
            <TextBlock VerticalAlignment="Center" FontSize="13" Text="{DynamicResource Card.Play}" />
        </ToggleButton>
    </StackPanel>
</UserControl>
