<UserControl
    x:Class="Llyn.UIVeneer.PWing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIVeneer"
    >

    <UserControl.Resources>
        <Style x:Key="Theme.Index.Row" TargetType="Button" BasedOn="{StaticResource Theme.Catalog.Row}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding PIndexItemChosen}" Value="True">
                    <Setter Property="Tag" Value="Chosen" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="0,0,0,18"
            Style="{StaticResource Theme.Search.Bar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton
                    x:Name="PWingOrderDropper"
                    Grid.Column="0"
                    Style="{StaticResource Theme.Search.Dropper}"
                    ToolTip="{DynamicResource Order.Title}">
                    <Path Width="24" Height="24" Data="{local:PIcon sort, 24}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Stretch="None" />
                </ToggleButton>
                <Rectangle Grid.Column="1" Style="{StaticResource Theme.Search.Divider}" />
                <TextBox
                    x:Name="PWingQuery"
                    Grid.Column="2"
                    Style="{StaticResource Theme.Search.Field}"
                    Tag="{DynamicResource Duplex.Search}"
                    LostKeyboardFocus="PWingLeaveHandle"
                    PreviewKeyDown="PWingKeyHandle"
                    TextChanged="PWingQueryHandle" />
                <Rectangle Grid.Column="3" Margin="2,0,5,0" Style="{StaticResource Theme.Search.Divider}" />
                <ToggleButton
                    x:Name="PWingSieveDropper"
                    Grid.Column="4"
                    Style="{StaticResource Theme.Search.Dropper}"
                    ToolTip="{DynamicResource Sieve.Title}">
                    <Grid Width="24" Height="24">
                        <Path Width="24" Height="24" Data="{local:PIcon filter, 24}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Stretch="None" />
                        <Ellipse
                            x:Name="PWingSieveMark"
                            Width="6"
                            Height="6"
                            Margin="0,2,1,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Fill="{StaticResource Theme.Accent}"
                            Visibility="Collapsed" />
                    </Grid>
                </ToggleButton>
                <Popup
                    x:Name="PWingOrderDropdown"
                    Width="252"
                    AllowsTransparency="True"
                    HorizontalOffset="-6"
                    IsOpen="{Binding IsChecked, ElementName=PWingOrderDropper}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=PWingOrderDropper}"
                    StaysOpen="False"
                    VerticalOffset="12">
                    <Border Margin="10" Padding="8" Style="{StaticResource Theme.Popup.Surface}">
                        <StackPanel x:Name="PWingOrderList">
                            <TextBlock Margin="10,7,10,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Order.Title}" />
                        </StackPanel>
                    </Border>
                </Popup>
                <Popup
                    x:Name="PWingSieveDropdown"
                    Width="190"
                    AllowsTransparency="True"
                    HorizontalOffset="-151"
                    IsOpen="{Binding IsChecked, ElementName=PWingSieveDropper}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=PWingSieveDropper}"
                    StaysOpen="False"
                    VerticalOffset="6">
                    <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                        <StackPanel x:Name="PWingSieveList" />
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Rectangle
                Grid.Row="0"
                Style="{StaticResource Theme.Panel.SeamRow}"
                Visibility="{Binding Visibility, ElementName=PWingIndex}" />

            <Border
                Grid.Row="0"
                Margin="0,0,0,12"
                Style="{StaticResource Theme.Panel.Surface}"
                Visibility="{Binding Visibility, ElementName=PWingIndex}">
                <Grid>
                    <ScrollViewer Margin="10" MaxHeight="220" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource Theme.Scroll.Gutter}" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PWingIndex" LostKeyboardFocus="PWingLeaveHandle" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="PWingIndexHandle" Style="{StaticResource Theme.Index.Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Source="{Binding PIndexItemFlag}" Stretch="Uniform" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource Theme.Catalog.Title}"><Run Text="{Binding PIndexItemName, Mode=OneWay}" /><Run
                                                Style="{StaticResource Theme.Catalog.Epithet}"
                                                Text="{Binding PIndexItemEpithet, Mode=OneWay, StringFormat='&#x2002;{0}'}" /></TextBlock>
                                            <TextBlock Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource Theme.Catalog.Meta}" Text="{Binding PIndexItemLanguage}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock
                        x:Name="PWingEmpty"
                        Margin="14,18,14,18"
                        Style="{StaticResource Theme.Catalog.Empty}"
                        Text="{DynamicResource Duplex.Empty}"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border Grid.Row="1" ClipToBounds="True" Style="{StaticResource Theme.Panel.Surface}">
                <local:PDisplay x:Name="PWingDisplay" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
