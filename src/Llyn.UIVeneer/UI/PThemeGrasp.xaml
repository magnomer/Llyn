<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIVeneer">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn;component/UI/PThemePalette.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Grasp.Mark" TargetType="local:PGrasp">
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ToolTip" Value="{DynamicResource Grasp.Mark}" />
    </Style>

    <SolidColorBrush x:Key="Theme.Grasp.Fill" Color="{DynamicResource Theme.Accent.Color}" />

    <SolidColorBrush x:Key="Theme.Grasp.Empty" Color="{DynamicResource Theme.Accent.Color}" />

    <SolidColorBrush x:Key="Theme.Grasp.Unrated" Color="{DynamicResource Theme.Muted.Color}" />

    <SolidColorBrush x:Key="Theme.Grasp.Preview" Opacity="0.5" Color="{DynamicResource Theme.Accent.Color}" />

    <Style x:Key="Theme.Grasp.Label" TargetType="TextBlock">
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
