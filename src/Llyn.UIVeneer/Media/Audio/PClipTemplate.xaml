<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemePalette.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Theme/Base/PThemePopup.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Theme.Clip.Preview" TargetType="Button" BasedOn="{StaticResource Theme.Popup.IconAction}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PSurface" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Theme.Clip.Reading">
        <Grid Margin="0,3,6,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PClipColumn" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Image
                    x:Name="PClipReadingFlag"
                    Width="19"
                    Height="14"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Stretch="Uniform" />
                <TextBlock
                    x:Name="PClipReadingLabel"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource Theme.Muted}"
                    Visibility="Collapsed" />
                <Button
                    x:Name="PClipPreview"
                    Margin="0,0,2,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Theme.Clip.Preview}"
                    ToolTip="{DynamicResource Downloader.Play}">
                    <local:PIconImage x:Name="PClipPreviewIcon" Width="24" Height="24" />
                </Button>
                <Button
                    x:Name="PClipSelector"
                    VerticalAlignment="Center"
                    Style="{DynamicResource Theme.Popup.RowChoice}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Clip.Row">
        <Border x:Name="PClipRow" Style="{DynamicResource Theme.Popup.RowSurface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PClipOption" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Theme.Muted}" TextTrimming="CharacterEllipsis" />
                <ItemsControl
                    x:Name="PClipReadingList"
                    Grid.Column="1"
                    AlternationCount="8"
                    Margin="4,0,10,0"
                    VerticalAlignment="Center"
                    ItemTemplate="{DynamicResource Theme.Clip.Reading}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock
                    x:Name="PClipNote"
                    Grid.Column="1"
                    Margin="4,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontStyle="Italic"
                    Foreground="{DynamicResource Theme.Muted}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="Collapsed" />
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
