<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment">

    <Style x:Key="Display.Card.Video" TargetType="ItemsControl">
        <Setter Property="Margin" Value="{DynamicResource Theme.Card.MediaMargin}" />
    </Style>

    <DataTemplate x:Key="Display.Card.VideoLine">
        <local:PVideoFrame>
            <Border HorizontalAlignment="Stretch" Style="{DynamicResource Theme.Card.Preview}">
                <local:PScreen x:Name="PVideoScreen" />
            </Border>
        </local:PVideoFrame>
    </DataTemplate>
</ResourceDictionary>
