<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIVeneer"
    x:Class="Llyn.UIVeneer.PVideoTemplate">

    <local:PStateConverter x:Key="Theme.State.Show" />

    <Style x:Key="Theme.Video.Preview" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PVideoPreview}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="Theme.Video.Row">
        <Grid Style="{DynamicResource Theme.Card.Reach}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Style="{DynamicResource Theme.Card.Gutter}" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border Style="{StaticResource Theme.Video.Preview}">
                    <local:PScreen
                        PScreenFrom="{Binding PVideoFrom}"
                        PScreenAddress="{Binding PVideoPreview}"
                        PScreenPlaying="{Binding PVideoPlaying, Mode=TwoWay}"
                        PScreenUntil="{Binding PVideoUntil}"
                        PScreenVolume="{Binding PVolumeCatalogLevel, Source={x:Static local:PVolumeCatalog.PVolumeCatalogCurrent}}" />
                </Border>

                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Margin="0,6,16,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource Theme.Muted}"
                        Style="{DynamicResource Theme.Input.Bare}"
                        Tag="{DynamicResource Card.LocationHint}"
                        Text="{Binding PVideoLocation, Converter={StaticResource Theme.State.Show}, Mode=OneWay}" />
                    <TextBox
                        Grid.Column="1"
                        Width="96"
                        Margin="0,6,16,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource Theme.Muted}"
                        Style="{DynamicResource Theme.Input.Bare}"
                        Tag="{DynamicResource Card.TimestampHint}"
                        Text="{Binding PVideoTimestamp, Converter={StaticResource Theme.State.Show}, Mode=OneWay}" />

                    <Button Grid.Column="2" Height="20" Padding="8,0" Click="PVideoOpenHandle" Foreground="{DynamicResource Theme.Accent}" Style="{DynamicResource Theme.Input.Pill}">
                        <TextBlock VerticalAlignment="Center" FontSize="11" Text="{DynamicResource Card.Browse}" />
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="30,1,0,0" VerticalAlignment="Top" Orientation="Horizontal" Style="{DynamicResource Theme.Card.Control}">
                <Button Click="PVideoRemoveHandle" Style="{DynamicResource Theme.Card.Handle}">
                    <local:PIconImage Width="12" Height="12" PIconSource="{local:PIcon remove, 12}" />
                </Button>
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
