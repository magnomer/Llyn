<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment">

    <Style x:Key="Theme.Video.Preview" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
    </Style>

    <DataTemplate x:Key="Theme.Video.Row">
        <Grid Style="{DynamicResource Theme.Card.Reach}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Style="{DynamicResource Theme.Card.Gutter}" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border x:Name="PVideoSurface" Style="{StaticResource Theme.Video.Preview}">
                    <local:PScreen x:Name="PVideoScreen" />
                </Border>

                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="PVideoLocation"
                        Margin="0,6,16,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource Theme.Muted}"
                        Style="{DynamicResource Theme.Input.Bare}"
                        Tag="{DynamicResource Card.LocationHint}" />
                    <TextBox
                        x:Name="PVideoTimestamp"
                        Grid.Column="1"
                        Width="96"
                        Margin="0,6,16,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource Theme.Muted}"
                        Style="{DynamicResource Theme.Input.Bare}"
                        Tag="{DynamicResource Card.TimestampHint}" />

                    <Button x:Name="PVideoChooser" Grid.Column="2" Height="20" Padding="8,0" Foreground="{DynamicResource Theme.Accent}" Style="{DynamicResource Theme.Input.Pill}">
                        <TextBlock VerticalAlignment="Center" FontSize="11" Text="{DynamicResource Card.Browse}" />
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel x:Name="PMediaControl" Grid.Column="1" Margin="30,1,0,0" VerticalAlignment="Top" Orientation="Horizontal" Style="{StaticResource Theme.Card.Control}">
                <Button x:Name="PVideoEraser" Style="{DynamicResource Theme.Card.Handle}">
                    <local:PIconImage x:Name="PVideoRemoveIcon" Width="12" Height="12" />
                </Button>
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
