<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment">

    <Style x:Key="Display.Card.Picture" TargetType="ItemsControl">
        <Setter Property="Margin" Value="{DynamicResource Theme.Card.MediaMargin}" />
    </Style>

    <DataTemplate x:Key="Display.Card.PictureLine">
        <local:PImageLazy x:Name="PImageHold">
            <Border Style="{DynamicResource Theme.Card.Preview}">
                <Image x:Name="PImagePreview" Stretch="Uniform" StretchDirection="DownOnly" />
            </Border>
        </local:PImageLazy>
    </DataTemplate>
</ResourceDictionary>
