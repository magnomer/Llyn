<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Llyn.UIVeneer.PSlateTemplate">

    <DataTemplate x:Key="Theme.Slate.Row">
        <Grid Background="Transparent" PreviewMouseLeftButtonDown="PSlateHandle">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource Theme.Ink}"
                TextTrimming="CharacterEllipsis">
                <Run Text="{Binding PSlateItemLead, Mode=OneWay}" /><Run
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Theme.Accent}"
                    Text="{Binding PSlateItemMark, Mode=OneWay}" /><Run Text="{Binding PSlateItemTail, Mode=OneWay}" />
            </TextBlock>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
