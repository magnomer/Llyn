<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="Theme.Slate.Row">
        <Grid x:Name="PSlateRow" Background="Transparent">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource Theme.Ink}"
                TextTrimming="CharacterEllipsis">
                <Run x:Name="PSlateLead" /><Run
                    x:Name="PSlateMark"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Theme.Accent}" /><Run x:Name="PSlateTail" />
            </TextBlock>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
