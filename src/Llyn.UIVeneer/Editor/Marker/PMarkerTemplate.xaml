<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment">

    <DataTemplate x:Key="Theme.Marker.Chip">
        <Border Style="{DynamicResource Theme.Marker.Surface}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock x:Name="PMarkerName" Style="{DynamicResource Theme.Marker.Name}" />
                <Button x:Name="PMarkerEraser" Style="{DynamicResource Theme.Marker.Remove}">
                    <local:QIconImage
                        x:Name="PMarkerIcon"
                        Width="12"
                        Height="12" />
                </Button>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Unit.Row">
        <Button x:Name="PUnitChoice" Style="{DynamicResource Theme.Category.Item}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="PUnitText"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{DynamicResource Theme.Ink}"
                    TextTrimming="CharacterEllipsis" />

                <local:QIconImage
                    x:Name="PUnitIcon"
                    Grid.Column="1"
                    Width="12"
                    Height="12"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center" />
            </Grid>
        </Button>
    </DataTemplate>
</ResourceDictionary>
