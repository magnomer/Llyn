<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment">

    <DataTemplate x:Key="Theme.Marker.Chip">
        <Border Style="{DynamicResource Theme.Marker.Surface}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock x:Name="PMarkerName" Style="{DynamicResource Theme.Marker.Name}" />
                <Button x:Name="PMarkerEraser" Style="{DynamicResource Theme.Marker.Remove}">
                    <local:PIconImage
                        x:Name="PMarkerIcon"
                        Width="12"
                        Height="12" />
                </Button>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
