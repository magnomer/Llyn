<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIVeneer"
    x:Class="Llyn.UIVeneer.PMarkerTemplate">

    <DataTemplate x:Key="Theme.Marker.Chip">
        <Border Style="{DynamicResource Theme.Marker.Surface}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Style="{DynamicResource Theme.Marker.Name}" Text="{Binding PMarkerChipName}" />
                <Button Click="PMarkerChipHandle" Style="{DynamicResource Theme.Marker.Remove}">
                    <local:PIconImage
                        Width="12"
                        Height="12"
                        PIconSource="{local:PIcon close, 12}" />
                </Button>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
