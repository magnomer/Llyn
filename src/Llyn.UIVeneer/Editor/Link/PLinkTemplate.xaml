<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment">

    <DataTemplate x:Key="Theme.Link.Chip">
        <Border Padding="10,5,5,5" Cursor="Arrow" Style="{DynamicResource Theme.Card.Pellet}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Image x:Name="PLinkFlag" Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform" />
                <TextBlock x:Name="PLinkHeadword" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Accent}" />
                <TextBlock x:Name="PLinkLanguage" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Theme.Muted}" />
                <Button x:Name="PLinkEraser" Width="16" Height="16" Margin="7,0,0,0" Padding="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <local:PIconImage
                                    x:Name="PLinkIcon"
                                    Width="12"
                                    Height="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Link.Entry">
        <TextBox
            x:Name="PLinkEntry"
            MinWidth="96"
            Margin="9,0,9,7"
            Padding="0,5"
            VerticalContentAlignment="Center"
            FontSize="13"
            Foreground="{DynamicResource Theme.Ink}"
            Style="{DynamicResource Theme.Input.Bare}" />
    </DataTemplate>

    <Style x:Key="Theme.Link.Field" TargetType="ItemsControl">
        <Setter Property="Margin" Value="{DynamicResource Theme.Card.ChipTightMargin}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <Border x:Name="PLinkFrame" Background="Transparent" Cursor="IBeam">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
