<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment">

    <DataTemplate x:Key="Theme.Label.Chip">
        <Border Padding="10,4,5,4" Cursor="Arrow" Style="{DynamicResource Theme.Card.Badge}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock x:Name="PLabelName" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Theme.Muted}" />
                <Button x:Name="PLabelEraser" Width="16" Height="16" Margin="7,0,0,0" Padding="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <local:PIconImage
                                    x:Name="PLabelIcon"
                                    Width="12"
                                    Height="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Label.Entry">
        <TextBox
            x:Name="PLabelEntry"
            MinWidth="96"
            Margin="9,0,9,7"
            Padding="0,4"
            VerticalContentAlignment="Center"
            FontSize="12"
            Foreground="{DynamicResource Theme.Ink}"
            Style="{DynamicResource Theme.Input.Bare}" />
    </DataTemplate>

    <Style x:Key="Theme.Label.Field" TargetType="ItemsControl">
        <Setter Property="Margin" Value="{DynamicResource Theme.Card.TagMargin}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <Border x:Name="PLabelFrame" Background="Transparent" Cursor="IBeam">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
