<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment">

    <DataTemplate x:Key="Theme.Category.Row">
        <Button x:Name="PCategoryChoice" Style="{DynamicResource Theme.Category.Item}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="PCategoryName"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{DynamicResource Theme.Ink}"
                    TextTrimming="CharacterEllipsis" />

                <local:PIconImage
                    x:Name="PCategoryIcon"
                    Grid.Column="1"
                    Width="12"
                    Height="12"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center" />
            </Grid>
        </Button>
    </DataTemplate>
</ResourceDictionary>
