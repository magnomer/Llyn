<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment">

    <Style x:Key="Theme.Sentence.Opening" TargetType="ToggleButton" BasedOn="{StaticResource Theme.Card.Switch}">
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <Style x:Key="Theme.Sentence.Hint" TargetType="TextBlock" BasedOn="{StaticResource Theme.Card.Ghost}">
        <Setter Property="Padding" Value="4,0,0,0" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="Theme.Sentence.Citation" TargetType="TextBox" BasedOn="{StaticResource Theme.Input.Bare}">
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="MaxWidth" Value="220" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="AcceptsReturn" Value="False" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="Tag" Value="{DynamicResource Reference.Assign}" />
    </Style>

    <DataTemplate x:Key="Theme.Sentence.Row">
        <Grid x:Name="PSentenceReach" Style="{DynamicResource Theme.Card.Reach}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Style="{DynamicResource Theme.Card.Gutter}" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Style="{DynamicResource Theme.Card.Dot}" />

                <StackPanel Grid.Column="1" Margin="{DynamicResource Theme.Card.FrameMargin}" Orientation="Horizontal">
                    <ToggleButton x:Name="PSentenceOpening" VerticalAlignment="Top" Style="{StaticResource Theme.Sentence.Opening}">
                        <TextBlock
                            x:Name="PSentenceSign"
                            FontFamily="{DynamicResource Theme.Font}"
                            FontSize="{DynamicResource Theme.Card.FrameSize}"
                            Foreground="{DynamicResource Theme.Muted}"
                            Text="+" />
                    </ToggleButton>

                    <StackPanel x:Name="PSentenceFrame" VerticalAlignment="Top" Orientation="Horizontal">
                        <TextBlock x:Name="PSentenceLead" Style="{DynamicResource Theme.Card.Frame}" Text="(+" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="PSentenceGap" Grid.Column="1" Style="{DynamicResource Theme.Card.Frame}" />

                            <Grid x:Name="PSentenceParticleField">
                                <TextBlock x:Name="PSentenceParticleGhost" Style="{DynamicResource Theme.Card.Ghost}" />
                                <TextBlock x:Name="PSentenceParticleHint" Style="{StaticResource Theme.Sentence.Hint}" />
                                <Canvas>
                                    <ComboBox x:Name="PSentenceParticle" Style="{DynamicResource Theme.Choice.Bare}" />
                                </Canvas>
                            </Grid>

                            <Grid x:Name="PSentenceDependenceField">
                                <TextBlock x:Name="PSentenceDependenceGhost" Style="{DynamicResource Theme.Card.Ghost}" />
                                <TextBlock x:Name="PSentenceDependenceHint" Style="{StaticResource Theme.Sentence.Hint}" />
                                <Canvas>
                                    <ComboBox x:Name="PSentenceDependence" Style="{DynamicResource Theme.Choice.Bare}" />
                                </Canvas>
                            </Grid>
                        </Grid>
                        <TextBlock Style="{DynamicResource Theme.Card.Frame}" Text=")" />
                    </StackPanel>
                </StackPanel>

                <Grid x:Name="PSentenceBody" Grid.Column="2">
                    <StackPanel>
                        <TextBox
                            x:Name="PSentenceText"
                            ContextMenu="{DynamicResource Theme.Mention.Menu}"
                            Style="{DynamicResource Theme.Card.Instance}" />
                        <ItemsControl
                            x:Name="PSentenceMentionLine"
                            ItemTemplate="{DynamicResource Theme.Mention.Chip}"
                            Style="{DynamicResource Theme.Mention.Line}" />
                        <ItemsControl
                            x:Name="PSentenceGlossLine"
                            ItemTemplate="{DynamicResource Theme.Gloss.Row}"
                            Style="{DynamicResource Theme.Gloss.Line}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                    <Border x:Name="PSentenceGlossControl" Style="{StaticResource Theme.Card.Control}">
                        <Button x:Name="PSentenceGlossChooser" Style="{DynamicResource Theme.Card.Handle}" ToolTip="{DynamicResource Gloss.Add}">
                            <local:PIconImage x:Name="PSentenceGlossIcon" Width="12" Height="12" />
                        </Button>
                    </Border>
                    <Border Margin="12,0,0,0">
                        <TextBox x:Name="PSentenceCitation" Style="{StaticResource Theme.Sentence.Citation}" />
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="PSentenceControl" Grid.Column="1" Margin="8,1,0,0" VerticalAlignment="Top" Orientation="Horizontal" Style="{StaticResource Theme.Card.Control}">
                <Button x:Name="PSentenceAdder" Style="{DynamicResource Theme.Card.Handle}">
                    <local:PIconImage x:Name="PSentenceAddIcon" Width="12" Height="12" />
                </Button>
                <Button x:Name="PSentenceEraser" Margin="4,0,0,0" Style="{DynamicResource Theme.Card.Handle}">
                    <local:PIconImage x:Name="PSentenceRemoveIcon" Width="12" Height="12" />
                </Button>
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
