<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment">

    <DataTemplate x:Key="Theme.Collocation.Card">
        <Border Style="{DynamicResource Theme.Card.Shell}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="55" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="PCardHeader" Style="{DynamicResource Theme.Card.Header}" Cursor="SizeAll">
                    <Grid Style="{DynamicResource Theme.Card.Crown}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="PCardPosition" Style="{StaticResource Theme.Card.Position}" ToolTip="{DynamicResource Card.PositionHint}">
                            <TextBox x:Name="PCardPositionText" Style="{StaticResource Theme.Card.Ordinal}" />
                        </Border>
                        <TextBlock x:Name="PCardPeek" Grid.Column="1" Style="{DynamicResource Theme.Card.Peek}" />
                        <TextBox x:Name="PTitle" Grid.Column="1" Margin="{DynamicResource Theme.Card.TitleMargin}" Style="{DynamicResource Theme.Card.Title}" />
                        <Button
                            x:Name="PCardEraser"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="{DynamicResource Theme.Card.EraserMargin}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{DynamicResource Theme.Card.Handle}">
                            <local:QIconImage x:Name="PCardIcon" Width="12" Height="12" />
                        </Button>
                        <ToggleButton x:Name="PCardHinge" Grid.Column="0" Grid.ColumnSpan="2" Style="{DynamicResource Theme.Card.Hinge}" />
                    </Grid>
                </Border>

                <Grid x:Name="PCardBody" Grid.Row="1" Style="{DynamicResource Theme.Card.Body}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Style="{DynamicResource Theme.Card.Gutter}" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBox x:Name="PCardExpression" Style="{DynamicResource Theme.Card.Expression}" />

                        <TextBox x:Name="PCardDefinition" Style="{DynamicResource Theme.Card.Meaning}" />

                        <ItemsControl x:Name="PCardBond" Margin="{DynamicResource Theme.Card.ChipTightMargin}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Margin="0,0,10,7"
                                            Padding="0,5"
                                            VerticalAlignment="Top"
                                            FontSize="{DynamicResource Theme.Card.SituationSize}"
                                            Foreground="{DynamicResource Theme.Muted}"
                                            Text="{DynamicResource Card.SenseCaption}" />
                                        <WrapPanel Grid.Column="1">
                                            <ItemsPresenter />
                                            <Button x:Name="PBondChooser" Margin="0,0,0,7" VerticalAlignment="Top" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Padding="6,5" Background="Transparent">
                                                            <TextBlock
                                                                FontSize="{DynamicResource Theme.Card.SituationSize}"
                                                                Foreground="{DynamicResource Theme.Accent}"
                                                                Text="{DynamicResource Card.SenseAdd}" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </WrapPanel>
                                        <Popup
                                            x:Name="PBondMenu"
                                            Grid.Column="1"
                                            Width="320"
                                            AllowsTransparency="True"
                                            Placement="Bottom"
                                            StaysOpen="False">
                                            <Border Margin="10" Style="{DynamicResource Theme.Popup.Surface}">
                                                <ScrollViewer MaxHeight="264" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl x:Name="PBondList">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Cursor="Hand" Style="{DynamicResource Theme.Popup.RowSurface}">
                                                                    <Grid VerticalAlignment="Center">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock x:Name="PBondNumber" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Theme.Muted}" />
                                                                        <TextBlock
                                                                            x:Name="PBondText"
                                                                            Grid.Column="1"
                                                                            Margin="8,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="14"
                                                                            FontWeight="SemiBold"
                                                                            Foreground="{DynamicResource Theme.Ink}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,5,5,5" Cursor="Arrow" Style="{DynamicResource Theme.Card.Pellet}">
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock x:Name="PBondNumber" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Theme.Muted}" />
                                            <TextBlock Margin="5,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Theme.Muted}" Text="·" />
                                            <TextBlock x:Name="PBondText" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Accent}" />
                                            <Button x:Name="PBondEraser" Width="16" Height="16" Margin="7,0,0,0" Padding="0" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid Background="Transparent">
                                                            <local:QIconImage
                                                                x:Name="PBondIcon"
                                                                Width="12"
                                                                Height="12"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl x:Name="PCardContext" Style="{DynamicResource Theme.Context.Field}" />

                        <ItemsControl x:Name="PCardRegister" Style="{DynamicResource Theme.Register.Field}" />

                        <ItemsControl x:Name="PCardLink" Style="{DynamicResource Theme.Link.Field}" />

                        <Border Style="{DynamicResource Theme.Card.Example}">
                            <ItemsControl x:Name="PCardSentence" ItemTemplate="{DynamicResource Theme.Sentence.Row}" />
                        </Border>

                        <ItemsControl x:Name="PCardLabel" Style="{DynamicResource Theme.Label.Field}" />

                        <ItemsControl x:Name="PCardImage" ItemTemplate="{DynamicResource Theme.Image.Row}" Style="{DynamicResource Theme.Card.Media}" />

                        <ItemsControl x:Name="PCardVideo" ItemTemplate="{DynamicResource Theme.Video.Row}" Style="{DynamicResource Theme.Card.Media}" />

                        <Border Margin="0,16,-76,0" HorizontalAlignment="Center" Style="{DynamicResource Theme.Command.Group}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="PCardImageChooser" Style="{DynamicResource Theme.Command.Icon}" ToolTip="{DynamicResource Card.ImageAdd}">
                                    <local:QIconImage x:Name="PCardImageIcon" Width="24" Height="24" />
                                </Button>

                                <Rectangle Style="{DynamicResource Theme.Command.Divider}" />

                                <Button x:Name="PCardVideoChooser" Style="{DynamicResource Theme.Command.Icon}" ToolTip="{DynamicResource Card.VideoAdd}">
                                    <local:QIconImage x:Name="PCardVideoIcon" Width="24" Height="24" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
