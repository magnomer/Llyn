<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="Theme.Language.Row">
        <Button x:Name="PSpeakerChoice" Height="31" Padding="12,0" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Theme.Ink}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="19" Height="14" VerticalAlignment="Center">
                    <Image x:Name="PGlossOptionFlag" Stretch="Uniform" />
                    <Ellipse x:Name="PSpeakerGlobe" Width="12" Height="12" Stroke="{DynamicResource Theme.Muted}" StrokeThickness="1.2" Visibility="Collapsed" />
                </Grid>
                <TextBlock x:Name="PGlossOptionName" Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontSize="13" />
            </Grid>
        </Button>
    </DataTemplate>
</ResourceDictionary>
