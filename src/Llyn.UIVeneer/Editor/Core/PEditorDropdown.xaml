<UserControl
    x:Class="Llyn.UIVeneer.PEditorDropdown"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Llyn.UIVeneer;component/Editor/Core/PEditorPopup.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Popup
            x:Name="PNotation"
            Margin="0,6,0,0"
            AllowsTransparency="True"
            Placement="Bottom"
            StaysOpen="False">
            <Border Margin="10" MinWidth="300" MaxWidth="640" Style="{StaticResource Theme.Popup.Surface}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Theme.Popup.Title}" Text="{DynamicResource Phonetician.Title}" />
                    <Border x:Name="PNotationProgress" Style="{StaticResource Theme.Popup.Progress}" Visibility="Collapsed">
                        <Border Style="{StaticResource Theme.Popup.ProgressBar}" />
                    </Border>
                    <TextBlock x:Name="PNotationNotice" Style="{StaticResource Theme.Popup.Notice}" Text="{DynamicResource Phonetician.Searching}" Visibility="Collapsed" />
                    <ScrollViewer MaxHeight="264" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl
                            x:Name="PNotationList"
                            Grid.IsSharedSizeScope="True"
                            ItemContainerStyle="{StaticResource Editor.Popup.Stretch}"
                            ItemTemplate="{DynamicResource Theme.Notation.Row}"
                            Visibility="Collapsed" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>

        <Popup
            x:Name="PClip"
            Margin="0,6,0,0"
            AllowsTransparency="True"
            Placement="Bottom"
            StaysOpen="False">
            <Border Margin="10" MinWidth="300" MaxWidth="640" Style="{StaticResource Theme.Popup.Surface}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Theme.Popup.Title}" Text="{DynamicResource Downloader.Title}" />
                    <Border x:Name="PClipProgress" Style="{StaticResource Theme.Popup.Progress}" Visibility="Collapsed">
                        <Border Style="{StaticResource Theme.Popup.ProgressBar}" />
                    </Border>
                    <TextBlock x:Name="PClipNotice" Style="{StaticResource Theme.Popup.Notice}" Text="{DynamicResource Downloader.Searching}" Visibility="Collapsed" />
                    <ScrollViewer MaxHeight="264" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl
                            x:Name="PClipList"
                            Grid.IsSharedSizeScope="True"
                            ItemContainerStyle="{StaticResource Editor.Popup.Stretch}"
                            ItemTemplate="{DynamicResource Theme.Clip.Row}"
                            Visibility="Collapsed" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>

        <Popup
            x:Name="PProspect"
            Width="320"
            Margin="0,4,0,0"
            AllowsTransparency="True"
            Placement="Bottom"
            StaysOpen="False">
            <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                <ListBox
                    x:Name="PProspectList"
                    MaxHeight="264"
                    ItemContainerStyle="{StaticResource Editor.Popup.Row}"
                    ItemTemplate="{DynamicResource Theme.Prospect.Row}"
                    Style="{StaticResource Editor.Popup.List}" />
            </Border>
        </Popup>

        <Popup
            x:Name="PProffer"
            MaxWidth="320"
            AllowsTransparency="True"
            Placement="Custom"
            StaysOpen="False">
            <Border x:Name="PProfferSheet" Style="{StaticResource Editor.Popup.Frame}">
                <ListBox
                    x:Name="PProfferList"
                    MaxHeight="232"
                    ItemContainerStyle="{StaticResource Editor.Popup.Caret}"
                    ItemTemplate="{DynamicResource Theme.Proffer.Row}"
                    Style="{StaticResource Editor.Popup.List}" />
            </Border>
        </Popup>

        <Popup
            x:Name="PSlate"
            MaxWidth="320"
            AllowsTransparency="True"
            Placement="Custom"
            StaysOpen="False">
            <Border x:Name="PSlateSheet" Style="{StaticResource Editor.Popup.Frame}">
                <ListBox
                    x:Name="PSlateList"
                    MaxHeight="232"
                    ItemContainerStyle="{StaticResource Editor.Popup.Caret}"
                    ItemTemplate="{DynamicResource Theme.Slate.Row}"
                    Style="{StaticResource Editor.Popup.List}" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
