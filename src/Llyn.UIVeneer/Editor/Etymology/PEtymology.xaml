<UserControl
    x:Class="Llyn.UIVeneer.PEtymology"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border MinHeight="360" Style="{StaticResource Theme.Input.Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="55" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Line}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                <TextBlock Margin="22,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{DynamicResource Display.Etymology}" />
            </Border>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Margin="22,18,22,22" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <ItemsControl x:Name="PEtymologySources" ItemTemplate="{DynamicResource Theme.Etymology.Item}" Style="{DynamicResource Theme.Etymology.Sources}" />
                    <Rectangle x:Name="PEtymologyTrunk" Style="{DynamicResource Theme.Etymology.Stem}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="32" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="32" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="1" Style="{DynamicResource Theme.Etymology.Root}">
                            <TextBlock x:Name="PEtymologyHeadword" Style="{DynamicResource Theme.Etymology.Headword}" />
                        </Border>
                        <Button
                            x:Name="PEtymologyInsertion"
                            Grid.Column="2"
                            Margin="6,0,0,0"
                            HorizontalAlignment="Left"
                            Content="+"
                            Style="{DynamicResource Theme.Etymology.Tool}"
                            ToolTip="{DynamicResource Input.AncestorInsert}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
