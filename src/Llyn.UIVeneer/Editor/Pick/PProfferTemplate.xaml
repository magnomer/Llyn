<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="Theme.Proffer.Row">
        <Grid x:Name="PProfferRow" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="{DynamicResource Theme.Card.SituationSize}"
                Foreground="{DynamicResource Theme.Ink}"
                TextTrimming="CharacterEllipsis">
                <Run x:Name="PProfferLead" /><Run
                    x:Name="PProfferMark"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Theme.Accent}" /><Run x:Name="PProfferTail" />
            </TextBlock>
            <TextBlock x:Name="PProfferCount" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource Theme.Muted}" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
