<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="Theme.Prospect.Row">
        <Grid x:Name="PProspectRow" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="PProspectMark"
                Margin="0,0,6,0"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{DynamicResource Theme.Accent}"
                Text="+"
                Visibility="Collapsed" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{DynamicResource Theme.Ink}"
                TextTrimming="CharacterEllipsis"><Run x:Name="PProspectName" /><Run
                x:Name="PProspectEpithet"
                Style="{DynamicResource Theme.Catalog.Epithet}" /></TextBlock>
            <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                <Image x:Name="PProspectFlag" Width="19" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" Stretch="Uniform" />
                <TextBlock x:Name="PProspectLanguage" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Theme.Muted}" />
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
