<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Llyn.UIVeneer.PProspectTemplate">

    <DataTemplate x:Key="Theme.Prospect.Row">
        <Grid Background="Transparent" PreviewMouseLeftButtonDown="PProspectHandle">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="PProspectMark"
                Margin="0,0,6,0"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{DynamicResource Theme.Accent}"
                Text="+"
                Visibility="Collapsed" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{DynamicResource Theme.Ink}"
                TextTrimming="CharacterEllipsis"><Run Text="{Binding PProspectItemName, Mode=OneWay}" /><Run
                Style="{DynamicResource Theme.Catalog.Epithet}"
                Text="{Binding PProspectItemEpithet, Mode=OneWay, StringFormat='&#x2002;{0}'}" /></TextBlock>
            <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                <Image Width="19" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" Source="{Binding PProspectItemFlag}" Stretch="Uniform" />
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Theme.Muted}" Text="{Binding PProspectItemLanguage}" />
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding PProspectItemFresh}" Value="True">
                <Setter TargetName="PProspectMark" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
