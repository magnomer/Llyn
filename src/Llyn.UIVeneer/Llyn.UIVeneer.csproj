<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Llyn.UIVeneer</AssemblyName>
    <RootNamespace>Llyn.UIVeneer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Llyn.UIDeportment\Llyn.UIDeportment.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>

    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />

    <PackageReference Include="SharpVectors.Wpf" Version="1.8.4.2" />
  </ItemGroup>

  <ItemGroup>

    <Resource Include="..\..\assets\icons\**\*.png" Link="icons\%(RecursiveDir)%(Filename)%(Extension)" />
    <Resource Include="..\..\assets\icons\**\*.svg" Link="icons\%(RecursiveDir)%(Filename)%(Extension)" />
    <Resource Include="..\..\assets\brand\icon.png" Link="brand\icon.png" />
    <Resource Include="..\..\assets\brand\icon.ico" Link="brand\icon.ico" />
  </ItemGroup>
</Project>
