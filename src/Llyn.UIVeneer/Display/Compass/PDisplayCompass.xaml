<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Theme.Compass.Choice" TargetType="Button">
        <Setter Property="Margin" Value="0,0,0,1" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PSurface" CornerRadius="8" SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="PSurfaceContent" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Compass.Number" TargetType="TextBlock">
        <Setter Property="Width" Value="17" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
    </Style>

    <DataTemplate x:Key="Theme.Compass.Row">
        <Button x:Name="PCompassRow" Style="{StaticResource Theme.Compass.Choice}">
            <Grid x:Name="PCompassIndent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PCompassNumber" Style="{StaticResource Theme.Compass.Number}" />
                <TextBlock
                    x:Name="PCompassName"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Button>
    </DataTemplate>
</ResourceDictionary>
