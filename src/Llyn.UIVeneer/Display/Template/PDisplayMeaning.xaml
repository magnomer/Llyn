<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="Display.Meaning.Card">
        <Border Style="{DynamicResource Theme.Card.Shell}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="55" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="PCardHeader" Style="{DynamicResource Theme.Card.Header}">
                    <Grid Style="{DynamicResource Theme.Card.Crown}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Theme.Card.Position}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                x:Name="PCardRank"
                                Foreground="{DynamicResource Theme.Accent}" />
                        </Border>
                        <TextBlock x:Name="PCardTitle" Grid.Column="1" Style="{DynamicResource Display.Card.Title}" />
                        <TextBlock x:Name="PCardCaption" Grid.Column="1" Style="{DynamicResource Display.Card.Kind}" Text="{DynamicResource Display.MeaningSingle}" />
                        <TextBlock x:Name="PCardPeek" Grid.Column="1" Style="{DynamicResource Theme.Card.Peek}" />
                        <ToggleButton x:Name="PCardHinge" Grid.Column="0" Grid.ColumnSpan="2" Style="{DynamicResource Theme.Card.Hinge}" />
                    </Grid>
                </Border>
                <Grid x:Name="PCardBody" Grid.Row="1" Style="{DynamicResource Theme.Card.Body}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Style="{DynamicResource Theme.Card.Gutter}" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PCardMeaning" Style="{DynamicResource Display.Card.Definition}" />
                        <ContentControl x:Name="PCardContents" ContentTemplate="{DynamicResource Display.Card.Body}" Focusable="False" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
