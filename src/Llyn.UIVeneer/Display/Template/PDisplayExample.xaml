<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment">

    <Style x:Key="Display.Card.ExampleCitation" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxWidth" Value="220" />
    </Style>

    <Style x:Key="Display.Card.Example" TargetType="Border">
        <Setter Property="Margin" Value="{DynamicResource Theme.Card.ExampleMargin}" />
        <Setter Property="Padding" Value="{DynamicResource Theme.Card.ExamplePadding}" />
    </Style>

    <Style x:Key="Display.Card.ExampleFrame" TargetType="TextBlock" BasedOn="{StaticResource Theme.Card.Frame}">
        <Setter Property="Margin" Value="{DynamicResource Theme.Card.FrameMargin}" />
    </Style>

    <DataTemplate x:Key="Display.Card.ExampleGloss">
        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
            <Image x:Name="PGlossFlag" Style="{StaticResource Theme.Gloss.Flag}" />
            <Ellipse x:Name="PGlossGlobe" Style="{StaticResource Theme.Gloss.Globe}" />
            <TextBlock
                x:Name="PGlossText"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                FontFamily="{DynamicResource Theme.Card.GlossFamily}"
                FontSize="{DynamicResource Theme.Card.GlossSize}"
                FontStyle="{DynamicResource Theme.Card.GlossStyle}"
                Foreground="{DynamicResource Theme.Muted}"
                TextWrapping="Wrap" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Display.Card.ExampleLine">
        <Grid Margin="{DynamicResource Theme.Card.ExampleLineMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Style="{DynamicResource Theme.Card.Dot}" />

            <TextBlock x:Name="PExampleFrame" Grid.Column="1" Style="{StaticResource Display.Card.ExampleFrame}" />

            <StackPanel Grid.Column="2">
                <local:PMention x:Name="PExampleText" />
                <ItemsControl x:Name="PExampleGloss" ItemTemplate="{StaticResource Display.Card.ExampleGloss}" Style="{DynamicResource Theme.Gloss.Line}" />
            </StackPanel>

            <Border Grid.Column="3" Margin="16,0,0,0">
                <TextBlock x:Name="PExampleCitation" Style="{StaticResource Display.Card.ExampleCitation}" />
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
