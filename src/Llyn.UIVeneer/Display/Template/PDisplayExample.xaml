<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIVeneer">

    <local:PSentenceConverter x:Key="Display.Card.Frame" />
    <local:PFontConverter x:Key="Display.Card.Inset" />
    <local:PMentionConverter x:Key="Display.Card.Mention" />
    <local:PGlossConverter x:Key="Display.Card.Gloss" />
    <local:PStateConverter x:Key="Display.Card.State" />
    <local:PCitationConverter x:Key="Display.Card.Citation" />

    <Style x:Key="Display.Card.ExampleCitation" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxWidth" Value="220" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Display.Card.Example" TargetType="Border">
        <Setter Property="Margin" Value="{DynamicResource Theme.Card.ExampleMargin}" />
        <Setter Property="Padding" Value="{DynamicResource Theme.Card.ExamplePadding}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding LCardDraftSentence.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Display.Card.ExampleFrame" TargetType="TextBlock" BasedOn="{StaticResource Theme.Card.Frame}">
        <Setter Property="Margin" Value="{DynamicResource Theme.Card.FrameMargin}" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="Display.Card.ExampleGloss">
        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
            <Image Style="{DynamicResource Theme.Gloss.Flag}" />
            <Ellipse Style="{DynamicResource Theme.Gloss.Globe}" />
            <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                FontFamily="{DynamicResource Theme.Card.GlossFamily}"
                FontSize="{DynamicResource Theme.Card.GlossSize}"
                FontStyle="{DynamicResource Theme.Card.GlossStyle}"
                Foreground="{DynamicResource Theme.Muted}"
                TextWrapping="Wrap">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource Display.Card.State}">
                        <Binding Path="PGlossText" />
                        <local:PLocalizationBinder PLocalizationBinderKey="Display.Unknown" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Display.Card.ExampleLine">
        <Grid Margin="{DynamicResource Theme.Card.ExampleLineMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Style="{DynamicResource Theme.Card.Dot}" />

            <TextBlock x:Name="PExampleFrame" Grid.Column="1" Style="{StaticResource Display.Card.ExampleFrame}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource Display.Card.Frame}" ConverterParameter="Head">
                        <Binding Path="LSentenceDraftParticle" />
                        <Binding Path="LSentenceDraftDependence" />
                        <Binding Path="LSentenceDraftExample.LExampleDraftText" />
                        <local:PLocalizationBinder PLocalizationBinderKey="Display.Unknown" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <StackPanel Grid.Column="2">
                <local:PMention
                    x:Name="PExampleText"
                    PMentionLanguage="{Binding LSentenceDraftExample.LExampleDraftLanguage}"
                    PMentionMention="{Binding LSentenceDraftExample.LExampleDraftMention, Converter={StaticResource Display.Card.Mention}}">
                    <local:PMention.Margin>
                        <MultiBinding Converter="{StaticResource Display.Card.Inset}">
                            <Binding Path="FontFamily" ElementName="PExampleFrame" />
                            <Binding Path="FontSize" ElementName="PExampleFrame" />
                            <Binding Path="FontFamily" RelativeSource="{RelativeSource Self}" />
                            <Binding Path="FontSize" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </local:PMention.Margin>
                    <local:PMention.PMentionText>
                        <MultiBinding Converter="{StaticResource Display.Card.Frame}" ConverterParameter="Text">
                            <Binding Path="LSentenceDraftParticle" />
                            <Binding Path="LSentenceDraftDependence" />
                            <Binding Path="LSentenceDraftExample.LExampleDraftText" />
                            <local:PLocalizationBinder PLocalizationBinderKey="Display.Unknown" />
                        </MultiBinding>
                    </local:PMention.PMentionText>
                </local:PMention>
                <ItemsControl
                    ItemTemplate="{StaticResource Display.Card.ExampleGloss}"
                    ItemsSource="{Binding LSentenceDraftExample.LExampleDraftGloss, Converter={StaticResource Display.Card.Gloss}}"
                    Style="{DynamicResource Theme.Gloss.Line}" />
            </StackPanel>

            <Border Grid.Column="3" Margin="16,0,0,0">
                <TextBlock
                    Margin="{Binding Margin, ElementName=PExampleText}"
                    FontFamily="{Binding FontFamily, ElementName=PExampleText}"
                    FontSize="{Binding FontSize, ElementName=PExampleText}"
                    Style="{StaticResource Display.Card.ExampleCitation}"
                    Text="{Binding LSentenceDraftExample.LExampleDraftReference, Converter={StaticResource Display.Card.Citation}}" />
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
