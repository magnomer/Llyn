<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Display/Template/PDisplaySituation.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Display/Template/PDisplayRegister.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Display/Template/PDisplayTranslation.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Display/Template/PDisplayExample.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Display/Template/PDisplayTag.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Media/Image/PDisplayImage.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Media/Video/PDisplayVideo.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Display/Template/PDisplayMeaning.xaml" />
        <ResourceDictionary Source="/Llyn.UIVeneer;component/Display/Template/PDisplayCollocation.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Display.Card.Title" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,34,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Card.TitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="Display.Card.Kind" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,34,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Card.TitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="Display.Card.Definition" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Theme.Card.DefinitionSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Display.Card.Expression" TargetType="TextBlock" BasedOn="{StaticResource Display.Card.Definition}">
        <Setter Property="Margin" Value="{DynamicResource Theme.Card.ExpressionMargin}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <DataTemplate x:Key="Display.Card.Body">
        <StackPanel>
            <ItemsControl x:Name="PCardSituation" ItemTemplate="{StaticResource Display.Card.SituationChip}" Style="{StaticResource Display.Card.Situation}" />
            <ItemsControl x:Name="PCardRegister" ItemTemplate="{StaticResource Display.Card.RegisterChip}" Style="{StaticResource Display.Card.Register}" />
            <ItemsControl x:Name="PCardTranslation" ItemTemplate="{StaticResource Display.Card.TranslationChip}" Style="{StaticResource Display.Card.Chips}" />
            <Border x:Name="PCardExample" Style="{StaticResource Display.Card.Example}">
                <ItemsControl x:Name="PCardSentence" ItemTemplate="{StaticResource Display.Card.ExampleLine}" />
            </Border>
            <ItemsControl x:Name="PCardTag" ItemTemplate="{StaticResource Display.Card.TagChip}" Style="{StaticResource Display.Card.Tag}" />
            <ItemsControl x:Name="PCardImage" ItemTemplate="{StaticResource Display.Card.PictureLine}" Style="{StaticResource Display.Card.Picture}" />
            <ItemsControl x:Name="PCardVideo" ItemTemplate="{StaticResource Display.Card.VideoLine}" Style="{StaticResource Display.Card.Video}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
