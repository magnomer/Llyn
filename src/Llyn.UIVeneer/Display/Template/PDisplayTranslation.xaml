<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Display.Card.Chips" TargetType="ItemsControl">
        <Setter Property="Margin" Value="{DynamicResource Theme.Card.ChipTightMargin}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Display.Card.TranslationLink" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PSurface" BorderBrush="Transparent" BorderThickness="1" Style="{DynamicResource Theme.Card.Pellet}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Display.Card.TranslationChip">
        <Button Style="{StaticResource Display.Card.TranslationLink}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Image x:Name="PLinkFlag" Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform" />
                <TextBlock x:Name="PLinkHeadword" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Accent}" />
                <TextBlock x:Name="PLinkLanguage" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Theme.Muted}" />
            </StackPanel>
        </Button>
    </DataTemplate>
</ResourceDictionary>
