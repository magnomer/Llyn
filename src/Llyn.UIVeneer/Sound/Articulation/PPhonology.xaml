<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment"
    >

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="-34,0,-34,0" Style="{StaticResource Theme.Panel.SeamRow}" />
        <Rectangle
            x:Name="PArticulationSeam"
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="-34,0,-34,0"
            Style="{StaticResource Theme.Panel.SeamRow}"
            Visibility="Collapsed" />
        <local:PSeam Grid.Row="2" Grid.Column="1" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />

        <Grid Grid.Row="0" Grid.Column="0" Margin="{StaticResource Theme.Catalog.HeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="PSequence"
                Grid.Column="0"
                Style="{StaticResource Theme.Search.Bar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton
                        x:Name="PSequenceDropper"
                        Grid.Column="0"
                        Style="{StaticResource Theme.Search.Dropper}"
                        ToolTip="{DynamicResource Sequence.Title}">
                        <local:PIconImage x:Name="PSequenceIcon" Width="24" Height="24" />
                    </ToggleButton>
                    <Rectangle Grid.Column="1" Style="{StaticResource Theme.Search.Divider}" />
                    <TextBox
                        x:Name="PProbe"
                        Grid.Column="2"
                        Style="{StaticResource Theme.Search.Field}"
                        Tag="{DynamicResource Sound.Search}" />
                    <Rectangle Grid.Column="3" Margin="2,0,5,0" Style="{StaticResource Theme.Search.Divider}" />
                    <ToggleButton
                        x:Name="PLensDropper"
                        Grid.Column="4"
                        Style="{StaticResource Theme.Search.Dropper}"
                        ToolTip="{DynamicResource Lens.Title}">
                        <Grid Width="24" Height="24">
                            <local:PIconImage x:Name="PLensIcon" Width="24" Height="24" />
                            <Ellipse
                                x:Name="PLensMark"
                                Width="6"
                                Height="6"
                                Margin="0,2,1,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Fill="{StaticResource Theme.Accent}"
                                Visibility="Collapsed" />
                        </Grid>
                    </ToggleButton>
                    <Popup
                        x:Name="PSequenceDropdown"
                        Width="252"
                        AllowsTransparency="True"
                        Placement="Bottom"
                        StaysOpen="False"
                        VerticalOffset="6">
                        <Border Margin="10" Padding="8" Style="{StaticResource Theme.Popup.Surface}">
                            <StackPanel x:Name="PSequenceList">
                                <TextBlock Margin="10,7,10,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Theme.Muted}" Text="{DynamicResource Sequence.Title}" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Popup
                        x:Name="PLensDropdown"
                        Width="190"
                        AllowsTransparency="True"
                        HorizontalOffset="-151"
                        Placement="Bottom"
                        StaysOpen="False"
                        VerticalOffset="6">
                        <Border Margin="10" Style="{StaticResource Theme.Popup.Surface}">
                            <StackPanel x:Name="PLensList" />
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ToggleButton
                x:Name="PArticulationHelper"
                Grid.Column="2"
                Style="{StaticResource Theme.Search.Helper}"
                ToolTip="{DynamicResource Articulation.Title}" />
        </Grid>

        <local:PRail Grid.Row="0" Grid.Column="1" Margin="0,0,0,18">
            <Border Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="PPhonologyFresh"
                        Content="{DynamicResource Scribe.New}"
                        Style="{StaticResource Theme.Command.Segment}" />
                    <Button
                        x:Name="PPhonologyStore"
                        Content="{DynamicResource Scribe.Save}"
                        IsEnabled="False"
                        Style="{StaticResource Theme.Command.Primary}" />
                    <Rectangle Style="{StaticResource Theme.Command.Divider}" />
                    <StackPanel x:Name="PPhonologyVoyage" Orientation="Horizontal">
                        <Button
                            x:Name="PPhonologyEarlier"
                            IsEnabled="False"
                            Style="{StaticResource Theme.Command.Segment}"
                            ToolTip="{DynamicResource Voyage.Retreat}" />
                        <Button
                            x:Name="PPhonologyLater"
                            IsEnabled="False"
                            Style="{StaticResource Theme.Command.Segment}"
                            ToolTip="{DynamicResource Voyage.Advance}" />
                    </StackPanel>
                    <StackPanel x:Name="PPhonologyChronicle" Orientation="Horizontal" Visibility="Collapsed">
                        <Button
                            x:Name="PPhonologyBackward"
                            IsEnabled="False"
                            Style="{StaticResource Theme.Command.Segment}"
                            ToolTip="{DynamicResource Chronicle.Undo}" />
                        <Button
                            x:Name="PPhonologyForward"
                            IsEnabled="False"
                            Style="{StaticResource Theme.Command.Segment}"
                            ToolTip="{DynamicResource Chronicle.Redo}" />
                    </StackPanel>
                    <Rectangle Style="{StaticResource Theme.Command.Divider}" />
                    <Button
                        x:Name="PPhonologyPortrait"
                        Content="{DynamicResource Scribe.Export}"
                        Style="{StaticResource Theme.Command.Segment}" />
                    <Button
                        x:Name="PPhonologyPress"
                        Content="{DynamicResource Scribe.Print}"
                        Style="{StaticResource Theme.Command.Segment}" />
                </StackPanel>
            </Border>
            <Border
                x:Name="PPhonologyMode"
                IsEnabled="False"
                Style="{StaticResource Theme.Command.Group}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        x:Name="PPhonologyViewer"
                        Content="{DynamicResource Scribe.View}"
                        GroupName="PPhonologyMode"
                        IsChecked="True"
                        Style="{StaticResource Theme.Command.Mode}" />
                    <RadioButton
                        x:Name="PPhonologyScribe"
                        Content="{DynamicResource Scribe.Edit}"
                        GroupName="PPhonologyMode"
                        Style="{StaticResource Theme.Command.Mode}" />
                </StackPanel>
            </Border>
        </local:PRail>

        <local:PArticulation
            x:Name="PArticulation"
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="-34,0,-34,0"
            Visibility="Collapsed" />

        <Grid Grid.Row="2" Grid.Column="0" Style="{StaticResource Theme.Catalog.Frame}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl x:Name="PInventory">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="PInventoryRow" Style="{StaticResource Theme.Catalog.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="PInventoryFlag" Grid.Column="0" Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform" />
                                    <TextBlock x:Name="PInventoryPronunciation" Grid.Column="1" Style="{StaticResource Theme.Catalog.Title}" />
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0" Orientation="Horizontal">
                                        <TextBlock MaxWidth="150" Style="{StaticResource Theme.Catalog.Meta}"><Run x:Name="PInventoryName" /><Run
                                            x:Name="PInventoryEpithet" /></TextBlock>
                                        <TextBlock Style="{StaticResource Theme.Catalog.Dot}" />
                                        <TextBlock x:Name="PInventoryLanguage" Style="{StaticResource Theme.Catalog.Meta}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="PInventoryEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Sound.Empty}" />
        </Grid>

        <Border Grid.Row="2" Grid.Column="1" Margin="0,14,0,0" ClipToBounds="True" Style="{StaticResource Theme.Panel.Surface}">
            <Grid>
                <local:PDisplay x:Name="PDisplay" />

                <local:PEditor x:Name="PEditor" Padding="30,18,30,30" Visibility="Collapsed" />

                <Button
                    x:Name="PPhonologyBin"
                    Margin="0,17,26,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    IsEnabled="False"
                    Style="{StaticResource Theme.Input.Bin}"
                    ToolTip="{DynamicResource Scribe.Delete}">
                    <local:PIconImage x:Name="PPhonologyBinIcon" Width="24" Height="24" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
