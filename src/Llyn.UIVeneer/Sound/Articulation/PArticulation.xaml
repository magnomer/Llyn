<UserControl
    x:Class="Llyn.UIVeneer.PArticulation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIVeneer">

    <UserControl.Resources>
        <Style x:Key="Articulation.Glyph" TargetType="Button">
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource Theme.Ink}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PSurface" Background="{TemplateBinding Background}" CornerRadius="9" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.SurfaceRaised}" />
                                <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PSurface" Property="Background" Value="{StaticResource Theme.AccentSoft}" />
                                <Setter Property="Foreground" Value="{StaticResource Theme.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Articulation.Header" TargetType="TextBlock">
            <Setter Property="Margin" Value="7,0,7,6" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Theme.Muted}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Articulation.Side" TargetType="TextBlock" BasedOn="{StaticResource Articulation.Header}">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <Style x:Key="Articulation.Heading" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,0,2,10" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Theme.Helper}" />
        </Style>

        <Style x:Key="Articulation.Chart" TargetType="Border" BasedOn="{StaticResource Theme.Input.Card}">
            <Setter Property="Padding" Value="16,13,16,15" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.HelperEdge}" />
        </Style>
    </UserControl.Resources>

    <Border Padding="6,14,0,8" Style="{StaticResource Theme.Panel.Helper}">
        <ScrollViewer x:Name="PArticulationLane" SizeChanged="PArticulationLaneHandle" Style="{StaticResource Theme.Scroll.Lane}">
            <Grid x:Name="PArticulationRack" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="PVowelChart" Grid.Row="0" Grid.Column="0" Style="{StaticResource Articulation.Chart}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Articulation.Heading}" Text="{DynamicResource Articulation.Vowel}" />
                        <Grid x:Name="PVowel" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border x:Name="PConsonantChart" Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource Articulation.Chart}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Articulation.Heading}" Text="{DynamicResource Articulation.Consonant}" />
                        <Grid x:Name="PConsonant" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
