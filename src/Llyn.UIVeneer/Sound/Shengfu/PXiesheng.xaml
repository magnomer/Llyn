<UserControl
    x:Class="Llyn.UIVeneer.PXiesheng"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment"
    xmlns:veneer="clr-namespace:Llyn.UIVeneer"
    >

    <UserControl.Resources>
        <Style x:Key="Theme.Grove.Key" TargetType="TextBlock" BasedOn="{StaticResource Theme.Catalog.Title}">
            <Setter Property="FontSize" Value="26" />
        </Style>

        <DataTemplate x:Key="Theme.Grove.Cell">
            <Button x:Name="PGroveRow" Style="{StaticResource Theme.Catalog.Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PGroveKey" Grid.Column="0" Style="{StaticResource Theme.Grove.Key}" />
                    <Border Grid.Column="1" Style="{StaticResource Theme.Catalog.Pellet}">
                        <TextBlock x:Name="PGroveCount" Style="{StaticResource Theme.Catalog.Tally}" />
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="-34,0,-34,0" Style="{StaticResource Theme.Panel.SeamRow}" />
        <local:QSeam Grid.Row="1" Grid.Column="1" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />
        <local:QSeam Grid.Row="1" Grid.Column="2" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />

        <Border
            x:Name="PRungBar"
            Grid.Row="0"
            Grid.Column="0"
            Margin="{StaticResource Theme.Catalog.HeaderMargin}"
            Style="{StaticResource Theme.Search.Bar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <veneer:PChoiceOrder x:Name="PXieshengOrder" Grid.Column="0" />
                <Rectangle Grid.Column="1" Style="{StaticResource Theme.Search.Divider}" />
                <TextBox
                    x:Name="PLodestar"
                    Grid.Column="2"
                    Style="{StaticResource Theme.Search.Field}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0" Style="{StaticResource Theme.Catalog.Frame}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl x:Name="PGrove" ItemTemplate="{StaticResource Theme.Grove.Cell}" />
            </ScrollViewer>
            <TextBlock
                x:Name="PGroveEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Xiesheng.GroveEmpty}" />
        </Grid>

        <Border
            Grid.Row="0"
            Grid.Column="1"
            Margin="-4,0,16,18"
            Style="{StaticResource Theme.Search.Bar}">
            <TextBox
                x:Name="PSextant"
                Style="{StaticResource Theme.Search.Field}" />
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Style="{StaticResource Theme.Catalog.Middle}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl x:Name="PKindred">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="PKindredRow" Style="{StaticResource Theme.Catalog.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="PKindredFlag" Grid.Column="0" Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Theme.Catalog.Title}"><Run x:Name="PKindredName" /><Run
                                        x:Name="PKindredEpithet"
                                        Style="{StaticResource Theme.Catalog.Epithet}" /></TextBlock>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="PKindredEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Xiesheng.KindredEmpty}" />
        </Grid>

        <veneer:PPanelRail x:Name="PXieshengRail" Grid.Row="0" Grid.Column="2" Margin="0,0,0,18" />

        <Border Grid.Row="1" Grid.Column="2" Margin="0,14,0,0" ClipToBounds="True" Style="{StaticResource Theme.Panel.Surface}">
            <Grid>
                <veneer:PDisplay x:Name="PDisplay" />

                <veneer:PStem x:Name="PXieshengStem" Visibility="Collapsed" />

                <veneer:PEditor x:Name="PEditor" Padding="30,18,30,30" Visibility="Collapsed" />

                <Button
                    x:Name="PXieshengBin"
                    Margin="0,17,26,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    IsEnabled="False"
                    Style="{StaticResource Theme.Input.Bin}"
                    ToolTip="{DynamicResource Scribe.Delete}">
                    <local:QIconImage x:Name="PXieshengBinIcon" Width="24" Height="24" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
