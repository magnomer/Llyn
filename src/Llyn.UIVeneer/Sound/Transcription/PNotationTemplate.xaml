<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="Theme.Notation.Reading">
        <Grid x:Name="PNotationReadingCell" Margin="0,3,6,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="PNotationSelector"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Style="{DynamicResource Theme.Popup.RowReading}">
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="PNotationReadingFlag" Width="19" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform" />
                    <TextBlock x:Name="PNotationReadingLabel" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="11" Visibility="Collapsed" />
                    <TextBlock
                        x:Name="PNotationReadingPhonetic"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource Theme.Phonetic}"
                        FontSize="14"
                        FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Theme.Notation.Row">
        <Border x:Name="PNotationRow" Style="{DynamicResource Theme.Popup.RowSurface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PNotationSource" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Theme.Muted}" TextTrimming="CharacterEllipsis" />
                <ItemsControl
                    x:Name="PNotationReadingList"
                    Grid.Column="1"
                    AlternationCount="8"
                    Margin="4,0,10,0"
                    VerticalAlignment="Center"
                    ItemTemplate="{DynamicResource Theme.Notation.Reading}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock
                    x:Name="PNotationNote"
                    Grid.Column="1"
                    Margin="4,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontStyle="Italic"
                    Foreground="{DynamicResource Theme.Muted}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="Collapsed" />
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
