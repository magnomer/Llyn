<UserControl
    x:Class="Llyn.UIVeneer.PYunjing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Llyn.UIDeportment;assembly=Llyn.UIDeportment"
    xmlns:veneer="clr-namespace:Llyn.UIVeneer"
    >

    <UserControl.Resources>
        <Style x:Key="Theme.Yunjing.Key" TargetType="TextBlock" BasedOn="{StaticResource Theme.Catalog.Title}">
            <Setter Property="FontSize" Value="26" />
        </Style>

        <DataTemplate x:Key="Theme.Yunjing.Cell">
            <Button x:Name="PYunjingRow" Style="{StaticResource Theme.Catalog.Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PYunjingKey" Grid.Column="0" Style="{StaticResource Theme.Yunjing.Key}" />
                    <Border Grid.Column="1" Style="{StaticResource Theme.Catalog.Pellet}">
                        <TextBlock x:Name="PYunjingCount" Style="{StaticResource Theme.Catalog.Tally}" />
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="34,20,34,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Margin="-34,0,-34,0" Style="{StaticResource Theme.Panel.SeamRow}" />
        <local:QSeam Grid.Row="1" Grid.Column="1" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />
        <local:QSeam Grid.Row="1" Grid.Column="2" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />
        <local:QSeam Grid.Row="1" Grid.Column="3" Margin="-16,0,0,-38" Style="{StaticResource Theme.Panel.SeamColumn}" />

        <Border
            x:Name="PLadder"
            Grid.Row="0"
            Grid.Column="0"
            Margin="{StaticResource Theme.Catalog.HeaderMargin}"
            Style="{StaticResource Theme.Search.Bar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <veneer:PChoiceOrder x:Name="PYunjingOrder" Grid.Column="0" />
                <Rectangle Grid.Column="1" Style="{StaticResource Theme.Search.Divider}" />
                <TextBox
                    x:Name="PPlumb"
                    Grid.Column="2"
                    Style="{StaticResource Theme.Search.Field}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0" Style="{StaticResource Theme.Catalog.Frame}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl x:Name="PShengmu" ItemTemplate="{StaticResource Theme.Yunjing.Cell}" />
            </ScrollViewer>
            <TextBlock
                x:Name="PShengmuEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Yunjing.ShengmuEmpty}" />
        </Grid>

        <Border
            x:Name="PStair"
            Grid.Row="0"
            Grid.Column="1"
            Margin="-4,0,16,18"
            Style="{StaticResource Theme.Search.Bar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <veneer:PChoiceOrder x:Name="PYunmuOrder" Grid.Column="0" />
                <Rectangle Grid.Column="1" Style="{StaticResource Theme.Search.Divider}" />
                <TextBox
                    x:Name="PFathom"
                    Grid.Column="2"
                    Style="{StaticResource Theme.Search.Field}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Style="{StaticResource Theme.Catalog.Middle}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl x:Name="PYunmu" ItemTemplate="{StaticResource Theme.Yunjing.Cell}" />
            </ScrollViewer>
            <TextBlock
                x:Name="PYunmuEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Yunjing.YunmuEmpty}" />
        </Grid>

        <Border
            Grid.Row="0"
            Grid.Column="2"
            Margin="-4,0,16,18"
            Style="{StaticResource Theme.Search.Bar}">
            <TextBox
                x:Name="PBeacon"
                Style="{StaticResource Theme.Search.Field}" />
        </Border>

        <Grid Grid.Row="1" Grid.Column="2" Style="{StaticResource Theme.Catalog.Middle}">
            <ScrollViewer Style="{StaticResource Theme.Catalog.Scroll}">
                <ItemsControl x:Name="PXiaoyun">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="PXiaoyunRow" Style="{StaticResource Theme.Catalog.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="PXiaoyunFlag" Grid.Column="0" Width="18" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Theme.Catalog.Title}"><Run x:Name="PXiaoyunName" /><Run
                                        x:Name="PXiaoyunEpithet"
                                        Style="{StaticResource Theme.Catalog.Epithet}" /></TextBlock>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="PXiaoyunEmpty"
                Style="{StaticResource Theme.Catalog.Empty}"
                Text="{DynamicResource Yunjing.XiaoyunEmpty}" />
        </Grid>

        <veneer:PPanelRail x:Name="PYunjingRail" Grid.Row="0" Grid.Column="3" Margin="0,0,0,18" />

        <Border Grid.Row="1" Grid.Column="3" Margin="0,14,0,0" ClipToBounds="True" Style="{StaticResource Theme.Panel.Surface}">
            <Grid>
                <veneer:PDisplay x:Name="PDisplay" />

                <veneer:PDiwei x:Name="PYunjingDiwei" Visibility="Collapsed" />

                <veneer:PEditor x:Name="PEditor" Padding="30,18,30,30" Visibility="Collapsed" />

                <Button
                    x:Name="PYunjingBin"
                    Margin="0,17,26,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    IsEnabled="False"
                    Style="{StaticResource Theme.Input.Bin}"
                    ToolTip="{DynamicResource Scribe.Delete}">
                    <local:QIconImage x:Name="PYunjingBinIcon" Width="24" Height="24" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
