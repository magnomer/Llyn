# Ignore all dot-prefixed directories at any depth
**/.*/

# Project-internal material
/docs-internal/
/docs-work/
/snapshots/
/import/
/gitdownload.json

# Temporary gitignore
/docs/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Ignore root-level files and folders by default.
/*

# Keep the root build inputs and their project companion files.
!/.gitignore
!/.gitattributes
!/.editorconfig
