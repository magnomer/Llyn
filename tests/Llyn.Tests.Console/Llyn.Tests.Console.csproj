<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <WarningsAsErrors>CA1416</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="Xunit.CollectionBehaviorAttribute">
      <DisableTestParallelization>true</DisableTestParallelization>
      <DisableTestParallelization_IsLiteral>true</DisableTestParallelization_IsLiteral>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Llyn.Tests.Interface/Llyn.Tests.Interface.csproj" />
    <ProjectReference Include="../../src/Llyn.UIDemeanor/Llyn.UIDemeanor.csproj" />
    <ProjectReference Include="../../src/Llyn.UITerminal/Llyn.UITerminal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Kit/TBlueprintFake.xaml" />
    <EmbeddedResource Include="Kit/TBlueprintListed.xaml" />
    <EmbeddedResource Include="Kit/TBlueprintUnlisted.xaml" />
  </ItemGroup>

</Project>
